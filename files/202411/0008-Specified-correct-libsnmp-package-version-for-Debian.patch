From: Alex Sakun <asakun@larch-networks.com>
Date: Wed, 28 Jan 2026 02:46:20 +0200
Subject: [PATCH 1/3] Specified correct libsnmp package version for Debian
 bookworm repository

---
 rules/snmpd.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/rules/snmpd.mk b/rules/snmpd.mk
index c70f30a4c..b0b2f5662 100644
--- a/rules/snmpd.mk
+++ b/rules/snmpd.mk
@@ -2,7 +2,7 @@
 
 ifeq ($(BLDENV),bookworm)
 SNMPD_VERSION = 5.9.3+dfsg
-SNMPD_VERSION_FULL = $(SNMPD_VERSION)-2
+SNMPD_VERSION_FULL = $(SNMPD_VERSION)-2+deb12u1
 else ifeq ($(BLDENV),bullseye)
 SNMPD_VERSION = 5.9+dfsg
 SNMPD_VERSION_FULL = $(SNMPD_VERSION)-4+deb11u1
