+    def is_match(self, thermal_info_dict):
+        fan_info_obj = self.get_fan_info(thermal_info_dict)
+        return len(fan_info_obj.get_absent_fans()) > 0 if fan_info_obj else False
+
+
+@thermal_json_object('fan.any.fault')
