+++ b/platform/marvell-larch-sim/docker-syncd-mrvl-prestera/syncd.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+
+function clean_up {
+    service syncd stop
+    exit
+}
+
+trap clean_up SIGTERM SIGKILL
+
+service syncd start
+
+read
