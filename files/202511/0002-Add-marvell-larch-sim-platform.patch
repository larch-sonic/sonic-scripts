diff --git a/platform/marvell-larch-sim/docker-syncd-mrvl-prestera/slan.sh b/platform/marvell-larch-sim/docker-syncd-mrvl-prestera/slan.sh
new file mode 100755
index 000000000..d53d21c04
--- /dev/null
+++ b/platform/marvell-larch-sim/docker-syncd-mrvl-prestera/slan.sh
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+
+num_port=8
+MAX_MTU=9200
+
+tap_set() {
+  for port in $(seq 1 $num_port); do
+    ip link set up dev eth$port
+    ip link set dev eth$port arp off
+    ip link set dev eth$port mtu $MAX_MTU
+  done
+}
+
+tap_set
+exec /usr/bin/slanConnector_Linux
diff --git a/platform/marvell-larch-sim/docker-syncd-mrvl-prestera/supervisord.conf b/platform/marvell-larch-sim/docker-syncd-mrvl-prestera/supervisord.conf
