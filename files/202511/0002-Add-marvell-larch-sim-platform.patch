--- /dev/null
+++ b/platform/marvell-larch-sim/sonic-platform-larch/debian/rules
@@ -0,0 +1,38 @@
+#!/usr/bin/make -f
+
+export DH_VERBOSE = 1
+
+PACKAGE_NAME=$(shell awk '/^Package:/ {print $$2}' debian/control | sed -n '1p')
+PACKAGE_VERSION=$(shell awk '/^Version:/ {print $$2}' debian/control)
+PACKAGE=${PACKAGE_NAME}_${PACKAGE_VERSION}_${DEB_TARGET_ARCH}.deb
+MOD_SRC_DIR:= $(shell pwd)
+
+%:
+	dh $@
+
+override_dh_usrlocal:
+
+binary:
+	mkdir -p debian/${PACKAGE_NAME}/etc/
+	cp -rv files/etc/ debian/${PACKAGE_NAME}/
+	
+	# Build and install sonic_platform Python module
+	cd $(MOD_SRC_DIR)/larchvm; \
+	python3 setup.py install --root=$(MOD_SRC_DIR)/debian/${PACKAGE_NAME} --install-layout=deb
+
+	# Resuming debhelper scripts
+	dh_testroot
+	dh_install
+	dh_installchangelogs
+	dh_installdocs
+	dh_systemd_enable
+	dh_installinit
+	dh_systemd_start
+	dh_link
+	dh_fixperms
+	dh_compress
+	dh_strip
+	dh_installdeb
+	dh_gencontrol
+	dh_md5sums
+	dh_builddeb
