+static int mvppnd_setup_iatu_window(struct mvppnd_dev *ppdev, int mg_cluster)
+{
+	u32 reg_addr_base, winx_offs, winx_start;
+
+	/* ATU windows are for SPI6 and above devices, skip in case this is not
+	   our device */
+	if (unlikely(ppdev->pdev.atu_win == -1))
+		return 0;
+
+	if (!mvppnd_is_valid_atu_win(ppdev))
+		return -EINVAL;
+
+	reg_addr_base = ppdev->device_data->mg_reg_base &
+			(0xFFFFFFFF - ppdev->atu_mask);
+	reg_addr_base = reg_addr_base | (mg_cluster << REG_ADDR_BASE_MG_SHIFT);
+
+	/* Go to our window (0x0100 because we need only in bound) */
+	winx_offs = ppdev->atu_offset + ppdev->pdev.atu_win * 0x0200 + 0x0100;
+
+	winx_start = ioread32(ppdev->pdev.bar0 + winx_offs + 0x08);
+	iowrite32(0, ppdev->pdev.bar0 + winx_offs + 0x0);
+	iowrite32(0x80000000, ppdev->pdev.bar0 + winx_offs + 0x04);
+	/* Start from bar2 phys addr, ignore the upper 32bits */
+	winx_start = pci_resource_start(ppdev->pdev.pdev, 2) +
+		     ppdev->pdev.atu_win * ppdev->atu_size;
+	iowrite32(winx_start, ppdev->pdev.bar0 + winx_offs + 0x08);
+	iowrite32(winx_start + ppdev->atu_mask, ppdev->pdev.bar0 + winx_offs +
+		  0x10);
+
+	iowrite32(reg_addr_base, ppdev->pdev.bar0 + winx_offs + 0x14);
+
+	ppdev->regs_offs = ppdev->pdev.atu_win * ppdev->atu_size;
+
+	pr_info("iatu: base %x offs %x start %x atu_win %u atu_size %x regs_offs %x val %x\n",
+		reg_addr_base, winx_offs, winx_start, ppdev->pdev.atu_win,
+		ppdev->atu_size, ppdev->regs_offs, ioread32(ppdev->pdev.bar0 + winx_offs + 0x14));
+	return 0;
+}
+
+static int mvppnd_setup_oatu_window(struct mvppnd_dev *ppdev, u64 base,
+				    u32 size)
+{
+	u32 winx_offs, atu_win;
+
+	/* ATU windows are for SPI6 and above devices, skip in case this is not
+	   our device */
+	if (unlikely(ppdev->pdev.atu_win == -1)) {
+		pr_info("no ATU window support\n");
+		return 0;
+	}
+
+	if (!mvppnd_is_valid_atu_win(ppdev)) {
+		pr_info("Invalid ATU window!\n");
+		return -EINVAL;
+	}
+
+	/* Go to our window (oATU) */
+	atu_win = ppdev->pdev.atu_win;
+	if (atu_win >= 3 /*MAX_OATU_CNT*/)
+		atu_win = 2 /*MAX_OATU_CNT - 1*/;
+	winx_offs = ppdev->atu_offset + atu_win * 0x0200;
+	pr_info("ATU: Writing to offset %x\n", winx_offs);
+
+	iowrite32(0, ppdev->pdev.bar0 + winx_offs + 0x0);
+	iowrite32(0x80000000, ppdev->pdev.bar0 + winx_offs + 0x4);
+	iowrite32((base & 0xFFFFFFFF) | (ppdev->sip7 ? 0 : BIT(31)), ppdev->pdev.bar0 + winx_offs + 0x8);
+	iowrite32((ppdev->sip7 ? CASPIAN_PCIE_AD_ADDR_HIGH : 0), ppdev->pdev.bar0 + winx_offs + 0xC);
+	iowrite32(((base & 0xFFFFFFFF) | (ppdev->sip7 ? 0 : BIT(31))) + size, ppdev->pdev.bar0 + winx_offs + 0x10);
+	iowrite32(base & 0xFFFFFFFF, ppdev->pdev.bar0 + winx_offs + 0x14);
+	iowrite32(base >> 32, ppdev->pdev.bar0 + winx_offs + 0x18);
+
+	return 0;
+}
