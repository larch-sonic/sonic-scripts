+
+    def get_tx_power(self):
+        """
+        Retrieves the TX power of all SFP channels
+
+        Returns:
+            A list of floats, representing TX power in mW
+            for each available channel
+            E.g., for a tranceiver with four channels: ['1.86', '1.86', '1.86', '1.86']
