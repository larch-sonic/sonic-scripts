+
+static inline void mvppnd_write_reg(struct mvppnd_dev *ppdev, u32 reg_addr,
+				    u32 val)
+{
+	u32 reg_addr_offs = reg_addr & ppdev->atu_mask;
+
+	/*dev_info(ppdev->dev, "write: 0x%x(%x,%x)=0x%x\n", reg_addr, ppdev->regs_offs, reg_addr_offs, val);*/
+
+	if (ppdev->sip7) {
+		u32 dbgr;
+
+		dbgr = mvppnd_read_reg(ppdev, 0xD4214);
+
+		dev_info(ppdev->dev, "write: 0x%x(%x,%x) val=%x GDMA DBG=0x%x AXI DBG=%x\n",
+			reg_addr, ppdev->regs_offs, reg_addr_offs, val,
+			mvppnd_read_reg(ppdev, GDMA_REG_ADDR_DBG_BASE(GDMA_NUM_FROM_CPU) + 0x18),
+			dbgr);
+
+		if ( ( (dbgr>>16) & 0xff ) < (dbgr & 0xff) )
+			prt_dbg_gdma_rx(ppdev);
+	}
+
+	iowrite32(val, ppdev->regs + ppdev->regs_offs + reg_addr_offs);
+}
