+                "type": self.get_name(),
+                "type_abbrv_name": 'N/A',
+                "vendor_rev": 'N/A',
+                "serial": 'N/A',
+                "manufacturer": 'N/A',
+                "model": 'N/A',
+                "connector": 'N/A',
+                "encoding": 'N/A',
+                "ext_identifier": 'N/A',
+                "ext_rateselect_compliance": 'N/A',
+                "cable_type": 'N/A',
+                "cable_length": 0,
+                "nominal_bit_rate": 'N/A',
+                "specification_compliance": 'N/A',
+                "vendor_date": 'N/A',
+                "vendor_oui": 'N/A',
+                "application_advertisement": "N/A",
+                "hardware_rev": 'N/A'
+            }
+
+
+        return port_info
+
+    def get_transceiver_threshold_info(self):
+        return None
+
+    def get_status(self):
+        """
+        Retrieves the operational status of the device
+        """
+        reset = self.get_reset_status()
+
+        if (reset == True):
+            status = False
+        else:
+            status = True
+
+        return status
+
diff --git a/platform/marvell-prestera/sonic-platform-larch/dqs-5000/sonic_platform/thermal.py b/platform/marvell-prestera/sonic-platform-larch/dqs-5000/sonic_platform/thermal.py
new file mode 100644
index 000000000..fae289315
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/dqs-5000/sonic_platform/thermal.py
@@ -0,0 +1,196 @@
+#!/usr/bin/env python
+
+#############################################################################
+# Pegatron Mercedes
+#
+# Thermal contains an implementation of SONiC Platform Base API and
+# provides the thermal device status which are available in the platform
+#
+#############################################################################
+
+import os
+import os.path
+
+try:
+    from sonic_platform_base.thermal_base import ThermalBase
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+
+class Thermal(ThermalBase):
+    """Platform-specific Thermal class"""
+
+    THERMAL_NAME_LIST = []
+
+    def __init__(self, thermal_index):
+        self.index = thermal_index
+
+        # Add thermal name
+        if not self.THERMAL_NAME_LIST:
+            self.THERMAL_NAME_LIST.append("CPU board temperature sensor : 1")
+            self.THERMAL_NAME_LIST.append("Main board temperature sensor : 1")
+            self.THERMAL_NAME_LIST.append("Main board temperature sensor : 2")
+            self.THERMAL_NAME_LIST.append("Main board temperature sensor : 3")
+
+        # Set thermal path
+        thermal_path = {
+            0: "/sys/class/hwmon/hwmon0",
+            1: "/sys/class/i2c-dev/i2c-4/device/4-0070",
+            2: "/sys/class/i2c-dev/i2c-4/device/4-0070",
+            3: "/sys/class/i2c-dev/i2c-4/device/4-0070",
+        }.get(self.index, None)
+
+        # Current temprature file names
+        cur_temp = {
+            0: "temp2_input",
+            1: "lm75_48_temp",
+            2: "lm75_49_temp",
+            3: "lm75_4a_temp",
+        }.get(self.index, None)
+
+        # Max temprature file names
+        max_temp = {
+            0: "temp2_max",
+            1: "",
+            2: "",
+            3: "",
+        }.get(self.index, None)
+
+        # Critical high temprature file names
+        crit_temp = {
+            0: "temp2_crit",
+            1: "",
+            2: "",
+            3: "",
+        }.get(self.index, None)
+
+        # Max temprature default values
+        # 0 - real value from temp2_max
+        # 1,2,3 - taken from SPHW_Gemini_Switch_HW Functional Specification_V0012-1
+        #         4.3.1. MCU(MB) Register Mapping Table
+        #         TS_OVER_TEMP_ALERT – TempSensor Over-Temperature Alert Register (0x52)
+        self.max_temp_def_val = {
+            0: 82.0,
+            1: 66.0,
+            2: 66.0,
+            3: 53.0,
+        }.get(self.index, None)
+
+        # Critical high temprature default values
+        # 0 - real value from temp2_crit
+        # 1,2,3 - max_temp_def_val + 20
+        self.crit_temp_def_val = {
+            0: 104.0,
+            1: 86.0,
+            2: 86.0,
+            3: 73.0,
+        }.get(self.index, None)
+
+       # Set hwmon path
+        self.cur_temp_file = "{}/{}".format(thermal_path, cur_temp)
+        self.max_temp_file = "{}/{}".format(thermal_path, max_temp) if max_temp else None
+        self.crit_temp_file = "{}/{}".format(thermal_path, crit_temp) if crit_temp else None
+        self.ss_key = self.THERMAL_NAME_LIST[self.index]
+        self.ss_index = 2
+
+    def __read_txt_file(self, file_path):
+        try:
+            with open(file_path, 'r') as fd:
+                data = fd.read()
+                return data.strip()
+        except IOError:
+            raise IOError("Unable to open %s file !" % file_path)
+
+    def __get_temp(self, temp_file):
+
+        raw_temp = self.__read_txt_file(temp_file)
+
+        if self.index == 0:
+            temp = float(raw_temp)/1000
+        else:
+            temp = float(raw_temp)
+
+        return float("{:.3f}".format(temp))
+
+    def get_temperature(self):
+        """
+        Retrieves current temperature reading from thermal
+        Returns:
+            A float number of current temperature in Celsius up to nearest thousandth
+            of one degree Celsius, e.g. 30.125
+        """
+        return self.__get_temp(self.cur_temp_file)
+
+    def get_high_threshold(self):
+        """
+        Retrieves the high threshold temperature of thermal sensor
+        Returns:
+            A float number, the high threshold temperature of thermal in Celsius
+            up to nearest thousandth of one degree Celsius, e.g. 30.125
+        """
+        if self.index == 0:
+            return self.__get_temp(self.max_temp_file)
+        else:
+            return self.max_temp_def_val
+
+    def get_high_critical_threshold(self):
+        """
+        Retrieves the high critical threshold temperature of thermal sensor
+        Actions should be taken immediately if the temperature becomes higher than the high critical
+        threshold otherwise the device will be damaged.
+
+        :return: A float number, the high critical threshold temperature of thermal in Celsius
+                 up to nearest thousandth of one degree Celsius, e.g. 30.125
+        """
+        if self.index == 0:
+            return self.__get_temp(self.crit_temp_file)
+        else:
+            return self.crit_temp_def_val
+
+    def get_low_critical_threshold(self):
+        """
+        Retrieves the low critical threshold temperature of thermal sensor
+        Actions should be taken immediately if the temperature becomes lower than the low critical
+        threshold otherwise the device will be damaged.
+
+        :return: A float number, the low critical threshold temperature of thermal in Celsius
+                 up to nearest thousandth of one degree Celsius, e.g. 30.125
+        """
+        return 0.0
+
+    def get_low_threshold(self):
+        """
+        Retrieves the low threshold temperature of thermal sensor
+        Actions should be taken if the temperature becomes lower than the low threshold.
+
+        :return: A float number, the low threshold temperature of thermal in Celsius
+                 up to nearest thousandth of one degree Celsius, e.g. 30.125
+        """
+        return 0.0
+
+    def get_name(self):
+        """
+        Retrieves the name of the thermal device
+            Returns:
+            string: The name of the thermal device
+        """
+        return self.THERMAL_NAME_LIST[self.index]
+
+    def get_presence(self):
+        """
+        Retrieves the presence of the thermal sensor
+        Returns:
+            bool: True if thermal sensor is present, False if not
+        """
+        return os.path.isfile(self.cur_temp_file)
+
+    def get_status(self):
+        """
+        Retrieves the operational status of the device
+        Returns:
+            A boolean value, True if device is operating properly, False if not
+        """
+        if not self.get_presence():
+            return False
+
+        return True
diff --git a/platform/marvell-prestera/sonic-platform-larch/dqs-5000/sysctl/zz-gemini-nmi.conf b/platform/marvell-prestera/sonic-platform-larch/dqs-5000/sysctl/zz-gemini-nmi.conf
