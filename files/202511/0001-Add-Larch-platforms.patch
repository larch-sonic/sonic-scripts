@@ -0,0 +1,31 @@
+#!/bin/bash
+
+# Platform init script for qn-sr-200
+
+qnsr200_profile()
+{
+    MAC_ADDR=$(fw_printenv -n ethaddr)
+    find /usr/share/sonic/device/*qn-sr-200* -name profile.ini | xargs sed -i "s/switchMacAddress=.*/switchMacAddress=$MAC_ADDR/g"
+    echo "qn-sr-200: Updating switch mac address ${MAC_ADDR}"
+    sudo ifconfig eth0 hw ether $MAC_ADDR
+    
+    rebrand # this platform is for customer who requires another name of nos
+    sudo modprobe optoe
+}
+
+rebrand()
+{
+    # change a console pre-login banner
+    sudo bash -c "printf 'QNOS \S \\\r \m \l \n\n' > /etc/issue"
+
+    sudo hostnamectl set-hostname qnos
+}
+
+# - Main entry
+qnsr200_profile
+
+# LOGIC to enumerate SFP eeprom devices - send 0x50 to kernel i2c driver - initialize devices
+# Enumerate the SFP eeprom device on each mux channel
+echo optoe2 0x50 > /sys/bus/i2c/devices/i2c-18/new_device
+
+exit 0
