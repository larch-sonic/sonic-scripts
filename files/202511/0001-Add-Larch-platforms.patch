+    def __get_chip_offset(self, port_idx, function):
+        if port_idx == 0:
+            if function == GpioFunction.DIS:
+                return 13
+            elif function == GpioFunction.LOS:
+                return 15
+            elif function == GpioFunction.ABS:
+                return 14
+
+        if port_idx == 1:
+            if function == GpioFunction.DIS:
+                return 7
+            elif function == GpioFunction.LOS:
+                return 6
+            elif function == GpioFunction.ABS:
+                return 5
+
+        if port_idx == 2:
+            if function == GpioFunction.DIS:
+                return 2
+            elif function == GpioFunction.LOS:
+                return 0
+            elif function == GpioFunction.ABS:
+                return 1
+
+        if port_idx == 3:
+            if function == GpioFunction.DIS:
+                return 11
+            elif function == GpioFunction.LOS:
+                return 10
+            elif function == GpioFunction.ABS:
+                return 9
