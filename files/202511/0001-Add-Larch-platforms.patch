+static int hwmon_mcu_read(struct i2c_client *client, u8 reg)
+{
+    int data = -EPERM;
+
+    mutex_lock(&hwmon_mcu_lock);
+
+    data = i2c_smbus_read_word_data(client, reg);
+
+    mutex_unlock(&hwmon_mcu_lock);
+
+    return data;
+}
+
+static int hwmon_mcu_write(struct i2c_client *client, u8 reg, u8 val)
+{
