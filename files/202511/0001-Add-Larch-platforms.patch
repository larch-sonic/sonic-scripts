diff --git a/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/chassis.py b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/chassis.py
new file mode 100644
index 000000000..6f59585b5
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/chassis.py
@@ -0,0 +1,129 @@
+#!/usr/bin/env python3
+
+#############################################################################
+# Larch LN-4332Z4-V7
+#
+# Module contains an implementation of SONiC Platform Base API and
+# provides the Chassis information which are available in the platform.
+#
+# Transceivers and PSU presence/power good come from the switch card CPLDs;
+# fans, board temperatures and PSU readings from the EC (MEC1723) through
+# Silicom's EC hwmon driver; the status LED from its silicom-mec driver.
+#
+#############################################################################
+
+try:
+    import time
+    from sonic_platform_base.chassis_base import ChassisBase
+    from sonic_platform.eeprom import Eeprom
+    from sonic_platform.fan_drawer import FanDrawer
+    from sonic_platform.fan import NUM_FAN_DRAWERS
+    from sonic_platform.led import SystemLed, LocationLed
+    from sonic_platform.psu import Psu, NUM_PSU
+    from sonic_platform.sfp import Sfp, QSFP_PORT_START, QSFP_PORT_END
+    from sonic_platform.thermal import Thermal, NUM_THERMAL
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+
+class Chassis(ChassisBase):
+    """Platform-specific Chassis class"""
+
+    def __init__(self):
+        ChassisBase.__init__(self)
+        self._eeprom = Eeprom()
+        self._psu_list = [Psu(i) for i in range(NUM_PSU)]
+        self._fan_drawer_list = [FanDrawer(i) for i in range(NUM_FAN_DRAWERS)]
+        self._fan_list = [fan for drawer in self._fan_drawer_list for fan in drawer.get_all_fans()]
+        self._thermal_list = [Thermal(i) for i in range(NUM_THERMAL)]
+        self._sfp_list = [Sfp(p) for p in range(QSFP_PORT_START, QSFP_PORT_END + 1)]
+        self._watchdog = None
+        self._status_led = SystemLed()
+        self._location_led = LocationLed()
+        # Every port starts absent, so xcvrd's first call reports the present ones
+        self._sfp_presence = {p: '0' for p in range(QSFP_PORT_START, QSFP_PORT_END + 1)}
+
+    def get_sfp(self, index):
+        # SONiC port indexes (platform.json "index") start at 1
+        if QSFP_PORT_START <= index <= QSFP_PORT_END:
+            return self._sfp_list[index - QSFP_PORT_START]
+        return None
+
+    def get_change_event(self, timeout=0):
+        """
+        Polls QSFP presence (the CPLDs raise no interrupt to the host) until
+        a port changes or timeout ms pass; timeout 0 blocks until a change.
+        Returns (True, {'sfp': {port_index: '1' inserted / '0' removed}}).
+        """
+        start = time.time()
+        sfp_dict = {}
+        while True:
+            for port, sfp in zip(range(QSFP_PORT_START, QSFP_PORT_END + 1), self._sfp_list):
+                presence = '1' if sfp.get_presence() else '0'
+                if presence != self._sfp_presence[port]:
+                    self._sfp_presence[port] = presence
+                    sfp_dict[port] = presence
+            if sfp_dict:
+                return True, {'sfp': sfp_dict}
+            if timeout and (time.time() - start) * 1000 >= timeout:
+                return True, {'sfp': sfp_dict}
+            time.sleep(1)
+
+    def get_watchdog(self):
+        # Opened on first use: only one process can hold /dev/watchdog0.
+        if self._watchdog is None:
+            try:
+                from sonic_platform.watchdog import Watchdog
+                self._watchdog = Watchdog()
+            except (ImportError, OSError):
+                return None
+        return self._watchdog
+
+    def set_status_led(self, color):
+        return self._status_led.set_state(color)
+
+    def get_status_led(self):
+        return self._status_led.get_state()
+
+    def set_uid_led(self, color):
+        return self._location_led.set_state(color)
+
+    def get_uid_led(self):
+        return self._location_led.get_state()
+
+    def get_eeprom(self):
+        return self._eeprom
+
+    def get_name(self):
+        return self._eeprom.modelstr()
+
+    def get_model(self):
+        return self._eeprom.part_number_str()
+
+    def get_serial(self):
+        return self._eeprom.serial_number_str()
+
+    def get_revision(self):
+        return self._eeprom.revision_str()
+
+    def get_base_mac(self):
+        return self._eeprom.base_mac_addr()
+
+    def get_system_eeprom_info(self):
+        return self._eeprom.system_eeprom_info()
+
+    def get_presence(self):
+        return True
+
+    def get_status(self):
+        return True
+
+    def is_replaceable(self):
+        return False
+
+    def get_position_in_parent(self):
+        return -1
+
+    def initizalize_system_led(self):
+        # Not in ChassisBase, but "show system-health" calls it (spelled so).
+        pass
diff --git a/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/cpld.py b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/cpld.py
new file mode 100644
index 000000000..d54c6276f
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/cpld.py
@@ -0,0 +1,92 @@
+#!/usr/bin/env python3
+
+#############################################################################
+# Larch LN-4332Z4-V7
+#
+# sysfs access to the switch card CPLDs, exported by the ln4332z4_cpld
+# kernel module (instantiated by ln4332z4-v7-init.sh):
+#
+#   ln4332z4_cpld_io   0x70 (QSFP 1-16) / 0x71 (QSFP 17-32) on I2C_IO:
+#                      qsfp<n>_present/_reset/_rx_los/_intl, n = 1..16
+#                      within the CPLD, first_port = its first panel port
+#   ln4332z4_cpld_ctrl 0x40 on I2C_MAIN: psu<n>_present, psu<n>_power_good,
+#                      falcon_temp, ...
+#   ln4332z4_qsfp_mux  0x70/0x71 on I2C_MUX: channel-<n> = the QSFP EEPROM
+#                      bus of panel port first_port + n
+#
+#############################################################################
+
+import glob
+import os
+
+I2C_DEVICES = "/sys/bus/i2c/devices"
+QSFP_PER_CPLD = 16
+
+
+def _device_dirs(name):
+    dirs = []
+    for path in glob.glob(os.path.join(I2C_DEVICES, "*-00*", "name")):
+        try:
+            with open(path) as f:
+                if f.read().strip() == name:
+                    dirs.append(os.path.dirname(path))
+        except OSError:
+            continue
+    return sorted(dirs)
+
+
+def read_attr(dev_dir, attr):
+    if dev_dir is None:
+        return None
+    try:
+        with open(os.path.join(dev_dir, attr)) as f:
+            return f.read().strip()
+    except OSError:
+        return None
+
+
+def read_int_attr(dev_dir, attr):
+    val = read_attr(dev_dir, attr)
+    try:
+        return int(val, 0)
+    except (TypeError, ValueError):
+        return None
+
+
+def write_attr(dev_dir, attr, value):
+    if dev_dir is None:
+        return False
+    try:
+        with open(os.path.join(dev_dir, attr), "w") as f:
+            f.write(str(value))
+        return True
+    except OSError:
+        return False
+
+
+def ctrl_cpld():
+    dirs = _device_dirs("ln4332z4_cpld_ctrl")
+    return dirs[0] if dirs else None
+
+
+def io_cpld(port):
+    """(sysfs dir, index 1..16 within the CPLD) of a QSFP panel port."""
+    for dev_dir in _device_dirs("ln4332z4_cpld_io"):
+        first = read_int_attr(dev_dir, "first_port")
+        if first is not None and first <= port < first + QSFP_PER_CPLD:
+            return dev_dir, port - first + 1
+    return None, None
+
+
+def qsfp_eeprom_bus(port):
+    """I2C bus number behind the CPLD mux channel of a QSFP panel port."""
+    addr = "0070" if port <= QSFP_PER_CPLD else "0071"
+    for dev_dir in _device_dirs("ln4332z4_qsfp_mux"):
+        if not dev_dir.endswith("-" + addr):
+            continue
+        link = os.path.join(dev_dir, "channel-%d" % ((port - 1) % QSFP_PER_CPLD))
+        try:
+            return int(os.path.basename(os.readlink(link)).split("-")[1])
+        except (OSError, IndexError, ValueError):
+            return None
+    return None
diff --git a/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/ec.py b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/ec.py
new file mode 100644
index 000000000..9afd11348
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/ec.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+
+#############################################################################
+# Larch LN-4332Z4-V7
+#
+# Telemetry owned by the EC (MEC1723), read through the hwmon device of
+# Silicom's silicom-ec-hwmon driver ("ec_hwmon_maestro", ACPI SILC1004).
+# Sensors are looked up by label, e.g. ("temp", "Ambient"), ("fan",
+# "Fan_1 RPM"), ("curr", "PSU1 Iout"), so the channel numbering of the
+# driver does not matter. Values are returned in hwmon units: m°C, mV, mA,
+# µW, RPM. The EC keeps the lowest/highest value seen in *_min/*_max.
+#
+#############################################################################
+
+import glob
+import os
+
+EC_HWMON_NAME = "ec_hwmon_maestro"
+
+
+def _read(path):
+    try:
+        with open(path) as f:
+            return f.read().strip()
+    except OSError:
+        return None
+
+
+class EcHwmon(object):
+    """Label -> sysfs attribute prefix map of the EC hwmon device."""
+
+    _dir = None
+    _labels = {}
+
+    @classmethod
+    def _scan(cls):
+        cls._dir = None
+        cls._labels = {}
+        for hwmon in glob.glob("/sys/class/hwmon/hwmon*"):
+            if _read(os.path.join(hwmon, "name")) == EC_HWMON_NAME:
+                cls._dir = hwmon
+                break
+        if cls._dir is None:
+            return
+        for label_file in glob.glob(os.path.join(cls._dir, "*_label")):
+            prefix = os.path.basename(label_file)[:-len("_label")]   # e.g. temp3
+            kind = prefix.rstrip("0123456789")
+            label = _read(label_file)
+            if label:
+                cls._labels[(kind, label)] = prefix
+
+    @classmethod
+    def _path(cls, kind, label, attr):
+        if cls._dir is None or not os.path.isdir(cls._dir):
+            cls._scan()
+        prefix = cls._labels.get((kind, label))
+        if prefix is None:
+            return None
+        return os.path.join(cls._dir, "%s_%s" % (prefix, attr))
+
+    @classmethod
+    def available(cls, kind, label):
+        return cls._path(kind, label, "input") is not None
+
+    @classmethod
+    def read(cls, kind, label, attr="input"):
+        """Raw integer value of a sensor attribute, or None."""
+        path = cls._path(kind, label, attr)
+        val = _read(path) if path else None
+        try:
+            return int(val)
+        except (TypeError, ValueError):
+            return None
+
+    @classmethod
+    def read_scaled(cls, kind, label, attr="input", divisor=1000.0):
+        val = cls.read(kind, label, attr)
+        return None if val is None else val / divisor
+
+    @classmethod
+    def read_first(cls, kind, labels, attr="input", divisor=1000.0):
+        """First available of several labels (they differ between drivers)."""
+        for label in labels:
+            if cls.available(kind, label):
+                return cls.read_scaled(kind, label, attr, divisor)
+        return None
diff --git a/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/eeprom.py b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/eeprom.py
new file mode 100644
index 000000000..ff2461aab
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/eeprom.py
@@ -0,0 +1,100 @@
+#!/usr/bin/env python3
+
+#############################################################################
+# Larch LN-4332Z4-V7
+#
+# ONIE TlvInfo system EEPROM: the host FRU on the i801 SMBus, a 512-byte
+# 24c04-type part at 0x56/0x57
+# (0x54 on this board is the DDR4 SODIMM SPD). The i801 adapter number
+# depends on probe order, so the EEPROM is found by its parent adapter name;
+# ln4332z4-v7-init.sh instantiates it.
+#
+#############################################################################
+
+import glob
+import os
+
+try:
+    from sonic_eeprom import eeprom_tlvinfo
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+SYSEEPROM_ADDR = "0056"
+I801_ADAPTER_NAME = "SMBus I801 adapter"
+
+
+def find_syseeprom_path():
+    for dev in glob.glob("/sys/bus/i2c/devices/*-" + SYSEEPROM_ADDR):
+        bus = os.path.basename(dev).split("-")[0]
+        try:
+            with open("/sys/bus/i2c/devices/i2c-%s/name" % bus) as f:
+                if f.read().startswith(I801_ADAPTER_NAME):
+                    return os.path.join(dev, "eeprom")
+        except OSError:
+            continue
+    return None
+
+
+class Eeprom(eeprom_tlvinfo.TlvInfoDecoder):
+
+    def __init__(self):
+        self.eeprom_path = find_syseeprom_path() or "/dev/null"
+        super(Eeprom, self).__init__(self.eeprom_path, 0, '', True)
+        self.eeprom_tlv_dict = dict()
+
+        try:
+            self.eeprom_data = self.read_eeprom()
+        except Exception:
+            self.eeprom_data = None
+            return
+
+        eeprom = self.eeprom_data
+        if not self.is_valid_tlvinfo_header(eeprom):
+            return
+
+        total_length = (eeprom[9] << 8) | eeprom[10]
+        tlv_index = self._TLV_INFO_HDR_LEN
+        tlv_end = self._TLV_INFO_HDR_LEN + total_length
+
+        while (tlv_index + 2) < len(eeprom) and tlv_index < tlv_end:
+            if not self.is_valid_tlv(eeprom[tlv_index:]):
+                break
+
+            tlv = eeprom[tlv_index:tlv_index + 2 + eeprom[tlv_index + 1]]
+            code = "0x%02X" % tlv[0]
+
+            if tlv[0] == self._TLV_CODE_VENDOR_EXT:
+                value = str((tlv[2] << 24) | (tlv[3] << 16) |
+                            (tlv[4] << 8) | tlv[5])
+                value += tlv[6:6 + tlv[1]].decode('ascii', 'replace')
+            else:
+                name, value = self.decoder(None, tlv)
+
+            self.eeprom_tlv_dict[code] = value
+            if eeprom[tlv_index] == self._TLV_CODE_CRC_32:
+                break
+
+            tlv_index += eeprom[tlv_index + 1] + 2
+
+    def _field(self, code):
+        # From the TLVs parsed above: the EEPROM as programmed has no CRC-32
+        # TLV, so get_tlv_field() (which checks the CRC) rejects every field.
+        return self.eeprom_tlv_dict.get("0x%02X" % code, "N/A")
+
+    def serial_number_str(self):
+        return self._field(self._TLV_CODE_SERIAL_NUMBER)
+
+    def modelstr(self):
+        return self._field(self._TLV_CODE_PRODUCT_NAME)
+
+    def part_number_str(self):
+        return self._field(self._TLV_CODE_PART_NUMBER)
+
+    def revision_str(self):
+        return self._field(self._TLV_CODE_LABEL_REVISION)
+
+    def base_mac_addr(self):
+        return self._field(self._TLV_CODE_MAC_BASE).upper()
+
+    def system_eeprom_info(self):
+        return self.eeprom_tlv_dict
