+#define REG_ADDR_GDMA_Q_SGD_BASE_LOW(gdma_num, q_num) (0x1C0000 + (0x8000 * gdma_num) + 0x800 + ((q_num) * 0x20))
+#define REG_ADDR_GDMA_Q_SGD_BASE_HIGH(gdma_num, q_num) (0x1C0000 + (0x8000 * gdma_num) + 0x800 + 0x4 + ((q_num) * 0x20))
+#define REG_ADDR_GDMA_Q_SGD_BUF_ALLOC_CTRL(gdma_num, q_num) (0x1C0000 + (0x8000 * gdma_num) + 0x800 + 0x8 + ((q_num) * 0x20))
+#define REG_ADDR_GDMA_Q_SGD_ADD_GDMA_SGD_OWN(gdma_num, q_num) (0x1C0000 + (0x8000 * gdma_num) + 0x800 + 0x10 + ((q_num) * 0x20))
+#define REG_ADDR_GDMA_Q_SGD_CHAIN_SIZE(gdma_num, q_num) (0x1C0000 + (0x8000 * gdma_num) + 0x800 + 0x1C + ((q_num) * 0x20))
+
+#define REG_ADDR_GDMA_Q_EN_STS(gdma_num, q_num)	(0x1C0000 + (0x8000 * gdma_num) + 0x1000 + ((q_num) * 0x30))
+#define REG_ADDR_GDMA_Q_RX_BUF_SZ(gdma_num, q_num)	(0x1C0000 + (0x8000 * gdma_num) + 0x1000 + 0x4 + ((q_num) * 0x30))
+#define REG_ADDR_GDMA_Q_RING_CTRL(gdma_num, q_num) (0x1C0000 + (0x8000 * gdma_num) + 0x1000 + 0xC + ((q_num) * 0x30))
+
+#define REG_ADDR_GDMA_PDI_MASTER(gdma_num) (0x1C0000 + (0x8000 * gdma_num) + 0x2800)
+#define REG_ADDR_GDMA_PDI_SLAVE(gdma_num) (0x1C0000 + (0x8000 * gdma_num) + 0x2000)
