@@ -0,0 +1,42 @@
+#!/bin/bash
+
+# Platform init script
+qnsr100_profile()
+{
+	MAC_ADDR=$(fw_printenv -n ethaddr 2>/dev/null)
+	if [ -z "$MAC_ADDR" ]; then
+	    echo "$(basename "$0"): could not read ethaddr from the U-Boot environment;"
+	    echo "$(basename "$0"): leaving switchMacAddress in profile.ini untouched" >&2
+	    return 0
+	fi
+	find /usr/share/sonic/device/*qn-sr-100* -name profile.ini | xargs sed -i "s/switchMacAddress=.*/switchMacAddress=$MAC_ADDR/g"
+	echo "qn-sr-100: Updating switch mac address ${MAC_ADDR}"
+
+    rebrand # this platform is for customer who requires another name of nos
+}
+
+rebrand()
+{
+    # change a console pre-login banner
+    sudo bash -c "printf 'QNOS \S \\\r \m \l \n\n' > /etc/issue"
+
+    # The hostname is not set here. This unit runs before CONFIG_DB exists, and
+    # hostname-config.service would overwrite whatever is set now with the value
+    # from the database. qn-sr-100-rebrand.service puts qnos into CONFIG_DB in
+    # time for that service to apply it properly.
+}
+
+# Main
+qnsr100_profile
+
+# LOGIC to enumerate SFP eeprom devices - send 0x50 to kernel i2c driver - initialize devices
+# the mux may be enumerated at number 4 or 5 so we check for the mux and skip if needed
+# Get list of the mux channels
+# Enumerate the SFP eeprom device on each mux channel
+echo optoe2 0x50 > /sys/bus/i2c/devices/i2c-0/new_device
+# Enumerate system eeprom
+echo 24c64 0x52 > /sys/bus/i2c/devices/i2c-0/new_device
+sleep 2
+
+
+exit 0
diff --git a/platform/marvell-prestera/sonic-platform-larch/qn-sr-100/scripts/qn-sr-100-rebrand.sh b/platform/marvell-prestera/sonic-platform-larch/qn-sr-100/scripts/qn-sr-100-rebrand.sh
