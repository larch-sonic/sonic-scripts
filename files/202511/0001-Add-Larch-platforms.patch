+        try:
+            port_info = SfpOptoeBase.get_transceiver_info(self)
+        except NotImplementedError:
+            pass
+        if port_info is not None:
+            port_info['hardware_rev'] = 'N/A'
+        # Temporarily use eeprom stub info
+        if port_info is None and self.get_presence():
+            port_info = {
+                "type": self.get_name(),
+                "type_abbrv_name": 'N/A',
+                "vendor_rev": 'N/A',
+                "serial": 'N/A',
