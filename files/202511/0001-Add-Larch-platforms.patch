+/*********** queues related functions ******************/
+static size_t mvppnd_num_of_rx_queues(struct mvppnd_dev *ppdev)
+{
+	size_t i, num_of_rx_queues = 0;
+
+	for (i = 0; i < NUM_OF_RX_QUEUES; i++)
+		num_of_rx_queues += ppdev->rx_queues[i] ? 1 : 0;
+
+	return num_of_rx_queues;
+}
+
+static inline int cyclic_idx(int c, size_t s)
+{
+	if (c < 0)
+		return s + c;
+
+	return c & (s - 1); /* use bitwise AND as it is faster than modulo (division) */
+}
+
+static inline void cyclic_inc(size_t *c, size_t s)
+{
+	*c = (*c + 1) & (s - 1); /* use bitwise AND as it is faster than modulo (division) */
+}
+
+static int mvppnd_queue_enabled(struct mvppnd_dev *ppdev, u32 cmd_reg_addr,
+				int queue)
+{
+	return (mvppnd_read_reg(ppdev, cmd_reg_addr) & (1 << queue));
+}
+
+static int mvppnd_queue_enabled_gdma(struct mvppnd_dev *ppdev, bool is_tx,
+				int queue)
+{
+	return (mvppnd_read_reg(ppdev,
+				REG_ADDR_GDMA_Q_EN_STS((is_tx ?
+				GDMA_NUM_FROM_CPU : GDMA_NUM_TO_CPU),queue + GDMA_KRNL_ETH_DRV_Q_OFS))
+				& GDMA_Q_EN_STS_BIT_EN);
+}
+
+static void mvppnd_enable_queue(struct mvppnd_dev *ppdev, u32 cmd_reg_addr,
+				int queue)
+{
+	if (ppdev->sip7) {
+		u32 gdma_num;
+		if (REG_ADDR_RX_QUEUE_CMD == cmd_reg_addr)
+			gdma_num = GDMA_NUM_TO_CPU;
+		else
+			gdma_num = GDMA_NUM_FROM_CPU;
+		queue += GDMA_KRNL_ETH_DRV_Q_OFS;
+		mvppnd_edit_reg_or(ppdev,
+				   REG_ADDR_GDMA_Q_EN_STS(gdma_num, queue),
+				   GDMA_Q_EN_STS_BIT_EN);
+		while (!(mvppnd_read_reg(ppdev, REG_ADDR_GDMA_Q_EN_STS(gdma_num, queue)) & GDMA_Q_EN_STS_BIT_RING_IDLE))
+			msleep(1);
+	} else
+		mvppnd_edit_reg_or(ppdev, cmd_reg_addr, 1 << queue);
+}
+
+static void mvppnd_disable_queue(struct mvppnd_dev *ppdev, u32 cmd_reg_addr,
+				 int queue)
+{
+	if (ppdev->sip7) {
+		u32 gdma_num, val;
+		if (REG_ADDR_RX_QUEUE_CMD == cmd_reg_addr)
+			gdma_num = GDMA_NUM_TO_CPU;
+		else
+			gdma_num = GDMA_NUM_FROM_CPU;
+		queue += GDMA_KRNL_ETH_DRV_Q_OFS;
+		val = mvppnd_read_reg(ppdev,
+				      REG_ADDR_GDMA_Q_EN_STS(gdma_num, queue));
+		val &= ~GDMA_Q_EN_STS_BIT_EN;
+		mvppnd_write_reg(ppdev,
+				 REG_ADDR_GDMA_Q_EN_STS(gdma_num,
+				 queue), val);
+		while (!(mvppnd_read_reg(ppdev, REG_ADDR_GDMA_Q_EN_STS(gdma_num, queue)) & GDMA_Q_EN_STS_BIT_RING_IDLE))
+			msleep(1);
+	} else
+	mvppnd_edit_reg_or(ppdev, cmd_reg_addr, 1 << (queue + 8));
+}
+
+static u32 mvppnd_read_tx_first_desc(struct mvppnd_dev *ppdev, u8 queue)
+{
+	if (ppdev->sip7) {
+		return mvppnd_read_reg(ppdev,
+				 REG_ADDR_GDMA_Q_SGD_BASE_LOW(GDMA_NUM_FROM_CPU,
+				 queue + GDMA_KRNL_ETH_DRV_Q_OFS) );
+	} else
+		return mvppnd_read_reg(ppdev, REG_ADDR_TX_FIRST_DESC + queue *
+			       REG_ADDR_TX_FIRST_DESC_OFFSET_FORMULA);
+}
+
+static void mvppnd_write_tx_first_desc(struct mvppnd_dev *ppdev, u32 val_low, u32 val_high, u32 cnt_descs)
+{
+	if (ppdev->sip7) {
+		u32 val, tout = 1000;
+		u32 queue = ppdev->tx_queue_num + GDMA_KRNL_ETH_DRV_Q_OFS;
+
+		val = mvppnd_read_reg(ppdev,
+				      REG_ADDR_GDMA_Q_EN_STS(GDMA_NUM_FROM_CPU,
+				      queue));
+		val &= ~GDMA_Q_EN_STS_BIT_EN; /* disable queue */
+		mvppnd_write_reg(ppdev,
+				      REG_ADDR_GDMA_Q_EN_STS(GDMA_NUM_FROM_CPU,
+				      queue), val);
+#if 0
+		val |= GDMA_Q_EN_STS_BIT_FLUSH; /* flush queue */
+		mvppnd_write_reg(ppdev,
+				      REG_ADDR_GDMA_Q_EN_STS(GDMA_NUM_FROM_CPU,
+				      queue), val);
+		while (mvppnd_read_reg(ppdev,
+					REG_ADDR_GDMA_Q_EN_STS(GDMA_NUM_FROM_CPU,
+					queue)) & GDMA_Q_EN_STS_BIT_FLUSH)
+						msleep(1);
+#endif
+		while (!(mvppnd_read_reg(ppdev, REG_ADDR_GDMA_Q_EN_STS(GDMA_NUM_FROM_CPU, queue)) & GDMA_Q_EN_STS_BIT_RING_IDLE))
+			msleep(1);
+
+		while (!(mvppnd_read_reg(ppdev, REG_ADDR_GDMA_Q_RING_INT_CAUSE(GDMA_NUM_FROM_CPU, queue)) & GDMA_INT_CAUSE_RING_SW_DISABLE)) {
+			msleep(1);
+			tout--;
+			if (!tout) {
+				pr_err("timeout waiting for Q %u to finish disabling itself!\n", queue);
+				break;
+			}
+		}
+
+		mvppnd_write_reg(ppdev, REG_ADDR_GDMA_Q_RING_INT_CAUSE(GDMA_NUM_FROM_CPU, queue), 0);
+		msleep(1);
+		val = mvppnd_read_reg(ppdev,
+				      REG_ADDR_GDMA_Q_RING_CTRL(GDMA_NUM_FROM_CPU,
+				      queue));
+		val &= ~GDMA_Q_RING_CTRL_TYPE_MASK;
+		/*
+		 * TX mode (from cpu), auto recycle to start of
+		 * buffer descriptor chain, extended (16 bytes)
+		 * buffer descriptor size mode:
+		 */
+		val |= (GDMA_Q_RING_CTRL_TYPE_FROM_CPU_MODE |
+			GDMA_Q_RING_CTRL_SGD_RECYCLE_CHAIN |
+			GDMA_Q_RING_CTRL_SGD_EXTEND_MODE);
+/*		val &= ~GDMA_Q_RING_CTRL_SGD_RECYCLE_CHAIN; TEST legacy mode */
+		mvppnd_write_reg(ppdev,
+				      REG_ADDR_GDMA_Q_RING_CTRL(GDMA_NUM_FROM_CPU,
+				      queue), val);
+		/* Instruct GDMA to get the buffer size from the descriptor: */
+		mvppnd_write_reg(ppdev,
+				 REG_ADDR_GDMA_Q_RX_BUF_SZ(GDMA_NUM_FROM_CPU,
+				 queue), 0x0 );
+		pr_info("%s: SGD low write %x q %u\n", __func__, val_low, queue);
+		mvppnd_write_reg(ppdev,
+				 REG_ADDR_GDMA_Q_SGD_BASE_LOW(GDMA_NUM_FROM_CPU,
+				 queue), val_low);
+		mvppnd_write_reg(ppdev,
+				 REG_ADDR_GDMA_Q_SGD_BASE_HIGH(GDMA_NUM_FROM_CPU,
+				 queue), CASPIAN_PCIE_AD_ADDR_HIGH);
+		mvppnd_write_reg(ppdev,
+				 REG_ADDR_GDMA_Q_SGD_CHAIN_SIZE(GDMA_NUM_FROM_CPU,
+				 queue), cnt_descs);
+
+		val = mvppnd_read_reg(ppdev,
+				      REG_ADDR_GDMA_Q_EN_STS(GDMA_NUM_FROM_CPU,
+				      queue));
+		val |= GDMA_Q_EN_STS_BIT_EN; /* enable queue */
+		mvppnd_write_reg(ppdev,
+				      REG_ADDR_GDMA_Q_EN_STS(GDMA_NUM_FROM_CPU,
+				      queue), val);
+		while (!(mvppnd_read_reg(ppdev, REG_ADDR_GDMA_Q_EN_STS(GDMA_NUM_FROM_CPU, queue)) & GDMA_Q_EN_STS_BIT_RING_IDLE))
+			msleep(1);
+		msleep(1);
+
+	} else {
+		mvppnd_disable_queue(ppdev, REG_ADDR_TX_QUEUE_CMD, ppdev->tx_queue_num);
+
+		mvppnd_write_reg(ppdev, REG_ADDR_TX_FIRST_DESC + ppdev->tx_queue_num *
+				 REG_ADDR_TX_FIRST_DESC_OFFSET_FORMULA, val_low);
+	}
+}
+
+static u32 mvppnd_read_rx_first_desc(struct mvppnd_dev *ppdev, u8 queue, u32 *val_high)
+{
+	if (ppdev->sip7) {
+		queue += GDMA_KRNL_ETH_DRV_Q_OFS;
+		if (val_high)
+			*val_high = mvppnd_read_reg(ppdev,
+						    REG_ADDR_GDMA_Q_SGD_BASE_HIGH(GDMA_NUM_TO_CPU,
+				 		    queue));
+		return mvppnd_read_reg(ppdev,
+				 REG_ADDR_GDMA_Q_SGD_BASE_LOW(GDMA_NUM_TO_CPU,
+				 queue));
+	} else
+		return mvppnd_read_reg(ppdev, REG_ADDR_RX_FIRST_DESC + queue *
+				       REG_ADDR_RX_FIRST_DESC_OFFSET_FORMULA);
+}
+
+static void mvppnd_write_rx_first_desc(struct mvppnd_dev *ppdev, u8 queue,
+				       u32 val_low, u32 val_high, u32 num_descs)
+{
+	/* When using more than one RX queue, after the SDMA places the first
+	   packet in some rings, it store the old next-desc-ptr (the one which
+	   CPSS puts originally) instead of the one specified as next-desc-ptr
+	   of the current descriptor. It is like it has a cache and it fetch
+	   the value from there.
+	   By writing the first descriptor pointer twice to the register, it is
+	   observed that the correct value is used, i.e the next-ptr and not
+	   the CPSS value */
+	if (ppdev->sip7) {
+		u32 val, tout = 10;
+
+		queue += GDMA_KRNL_ETH_DRV_Q_OFS;
+		val = mvppnd_read_reg(ppdev,
+				      REG_ADDR_GDMA_Q_EN_STS(GDMA_NUM_TO_CPU,
+				      queue));
+		val &= ~GDMA_Q_EN_STS_BIT_EN; /* disable queue */
+		mvppnd_write_reg(ppdev,
+				      REG_ADDR_GDMA_Q_EN_STS(GDMA_NUM_TO_CPU,
+				      queue), val);
+		while (!(mvppnd_read_reg(ppdev, REG_ADDR_GDMA_Q_EN_STS(GDMA_NUM_TO_CPU, queue)) & GDMA_Q_EN_STS_BIT_RING_IDLE))
+			msleep(1);
+		val |= GDMA_Q_EN_STS_BIT_FLUSH; /* flush queue */
+		mvppnd_write_reg(ppdev,
+				      REG_ADDR_GDMA_Q_EN_STS(GDMA_NUM_FROM_CPU,
+				      queue), val);
+		while (mvppnd_read_reg(ppdev,
+					REG_ADDR_GDMA_Q_EN_STS(GDMA_NUM_FROM_CPU,
+					queue)) & GDMA_Q_EN_STS_BIT_FLUSH) {
+				msleep(1);
+				tout--;
+				if (!tout)
+					break;
+			}
+		val &= ~GDMA_Q_EN_STS_BIT_FLUSH;
+		mvppnd_write_reg(ppdev,
+				      REG_ADDR_GDMA_Q_EN_STS(GDMA_NUM_FROM_CPU,
+				      queue), val);
+		val = mvppnd_read_reg(ppdev,
+				      REG_ADDR_GDMA_Q_RING_CTRL(GDMA_NUM_TO_CPU,
+				      queue));
+		val &= ~GDMA_Q_RING_CTRL_TYPE_MASK;
+		/*
+		 * TX mode (from cpu), auto recycle to start of
+		 * buffer descriptor chain, extended (16 bytes)
+		 * buffer descriptor size mode:
+		 */
+		val |= (GDMA_Q_RING_CTRL_TYPE_TO_CPU_PKT_MODE |
+			GDMA_Q_RING_CTRL_SGD_RECYCLE_CHAIN |
+			GDMA_Q_RING_CTRL_SGD_EXTEND_MODE);
+		mvppnd_write_reg(ppdev,
+				      REG_ADDR_GDMA_Q_RING_CTRL(GDMA_NUM_TO_CPU,
+				      queue), val);
+		/* Instruct GDMA to get the buffer size from the register: */
+		mvppnd_write_reg(ppdev,
+				 REG_ADDR_GDMA_Q_RX_BUF_SZ(GDMA_NUM_TO_CPU,
+				 queue), 0x10000 | (ppdev->max_pkt_sz /* - ppdev->dsa_tag_size*/));
+		mvppnd_write_reg(ppdev,
+				 REG_ADDR_GDMA_Q_SGD_BASE_LOW(GDMA_NUM_TO_CPU,
+				 queue), val_low);
+		mvppnd_write_reg(ppdev,
+				 REG_ADDR_GDMA_Q_SGD_BASE_HIGH(GDMA_NUM_TO_CPU,
+				 queue), CASPIAN_PCIE_AD_ADDR_HIGH);
+		mvppnd_write_reg(ppdev,
+				 REG_ADDR_GDMA_Q_SGD_CHAIN_SIZE(GDMA_NUM_TO_CPU,
+				 queue), num_descs);
+	} else {
+		mvppnd_disable_queue(ppdev, REG_ADDR_RX_QUEUE_CMD, queue);
+
+		mvppnd_write_reg(ppdev, REG_ADDR_RX_FIRST_DESC + queue *
+				 REG_ADDR_RX_FIRST_DESC_OFFSET_FORMULA, val_low);
+
+		mvppnd_disable_queue(ppdev, REG_ADDR_RX_QUEUE_CMD, queue);
+
+		mvppnd_write_reg(ppdev, REG_ADDR_RX_FIRST_DESC + queue *
+				 REG_ADDR_RX_FIRST_DESC_OFFSET_FORMULA, val_low);
+	}
+}
+
+/*********** coherent memory block *********************/
+/* We allocate one block for all dma services, then allocate from this block.
+ * Allocation from the block cannot be undone, it is too complex and not needed
+ * (unless the driver will be required to support run-time configuration
+ * changes in the future)
+ */
+static int mvppnd_alloc_device_coherent(struct mvppnd_dev *ppdev)
+{
+	size_t i, rx_rings_total_size = 0;
+	dma_addr_t d;
+	size_t size, filler_size;
+	void *v;
+
+	ppdev->coherent.buf.size = 0;
+	ppdev->coherent.mark = 0;
+
+	for (i = 0; i < NUM_OF_RX_QUEUES; i++)
+		if (ppdev->rx_queues[i])
+			rx_rings_total_size += ppdev->rx_rings_size[i];
+
+	/* RX queues */
+	size = rx_rings_total_size * sizeof(struct mvppnd_hw_desc);
+	ppdev->coherent.buf.size += max(size, PAGE_SIZE);
+
+	/* One TX queue */
+	size = TX_RING_SIZE * sizeof(struct mvppnd_hw_desc);
+	ppdev->coherent.buf.size += max(size, PAGE_SIZE);
+
+	/* Space for TX buffers (+1 for head) */
+	size = TX_RING_SIZE * ppdev->max_pkt_sz;
+	ppdev->coherent.buf.size += max(size, PAGE_SIZE);
+
+	/* Space for two MACs (first descriptor) */
+	size = ETH_ALEN * 2;
+	ppdev->coherent.buf.size += max(size, PAGE_SIZE);
+
+	/* Space for DSA (second descriptor) */
+	size = ppdev->dsa_tag_size;
+	ppdev->coherent.buf.size += max(size, PAGE_SIZE);
+
+	/* Space for RX buffers */
+	size = rx_rings_total_size * ppdev->max_pkt_sz;
+	ppdev->coherent.buf.size += max(size, PAGE_SIZE);
+
+	/* Round to power of two */
+	ppdev->coherent.buf.size = roundup_pow_of_two(ppdev->coherent.buf.size);
+
+	ppdev->coherent.buf.virt = dma_alloc_coherent(ppdev->dev,
+						      ppdev->coherent.buf.size,
+						      &ppdev->coherent.buf.dma,
+						      GFP_DMA32 | GFP_NOFS |
+						      GFP_KERNEL);
+	if (unlikely(!ppdev->coherent.buf.virt)) {
+		dev_err(ppdev->dev,
+			"Fail to allocate %ld bytes of coherent memory, masks %llx %llx\n",
+			ppdev->coherent.buf.size, *ppdev->dev->dma_mask,
+			ppdev->dev->coherent_dma_mask);
+		return -ENOMEM;
+	}
+
+	/* Make sure address is aligned with the size */
+	size = ppdev->coherent.buf.dma % ppdev->coherent.buf.size;
+	if (size) {
+		/*
+		 * Allocate the difference between the requested
+		 * size and the allocated address misalignment.
+		 * This should make the next allocation start on the
+		 * correct boundary:
+		 */
+		filler_size = ppdev->coherent.buf.size - size;
+		dev_info(ppdev->dev,
+			"Not aligned (0x%llx, 0x%lx), reallocating %lx\n",
+			ppdev->coherent.buf.dma, ppdev->coherent.buf.size, filler_size);
+
+		dma_free_coherent(ppdev->dev,
+				  ppdev->coherent.buf.size,
+				  ppdev->coherent.buf.virt,
+				  ppdev->coherent.buf.dma);
+
+		v = dma_alloc_coherent(ppdev->dev, filler_size, &d,
+				       GFP_DMA32 | GFP_NOFS | GFP_KERNEL);
+		ppdev->coherent.buf.virt =
+			dma_alloc_coherent(ppdev->dev,
+					   ppdev->coherent.buf.size,
+					   &ppdev->coherent.buf.dma,
+					   GFP_DMA32 | GFP_NOFS | GFP_KERNEL);
+		if (unlikely(!ppdev->coherent.buf.virt)) {
+			dev_err(ppdev->dev,
+				"Fail to allocate %ld bytes of coherent memory, phys1 %llx phys2 %llx\n",
+				ppdev->coherent.buf.size, d, ppdev->coherent.buf.dma);
+			return -ENOMEM;
+		}
+
+		dma_free_coherent(ppdev->dev, filler_size, v, d);
+	}
+
+	if (ppdev->coherent.buf.dma % ppdev->coherent.buf.size) {
+		dev_err(ppdev->dev,
+			"Fail to allocate aligned coherent buffer, phys %llx filler %llx size %ld masks %llx %llx\n", ppdev->coherent.buf.dma, d,
+			ppdev->coherent.buf.size, *ppdev->dev->dma_mask,
+			ppdev->dev->coherent_dma_mask);
+		return -ENOMEM;
+	}
+
+	dev_info(ppdev->dev,"coherent 0x%llx, %llx (0x%lx)\n",
+		ppdev->coherent.buf.dma, ppdev->coherent.buf.dma +
+		ppdev->coherent.buf.size, ppdev->coherent.buf.size);
+
+	mvppnd_setup_mg_window(ppdev, ppdev->mg_win[MG_WIN_COHERENT_IDX],
+			       ppdev->coherent.buf.dma,
+			       (ppdev->coherent.buf.size - 1) & 0xFFFF0000);
+
+	return 0;
+}
+
+static void mvppnd_free_device_coherent(struct mvppnd_dev *ppdev)
+{
+	if (!ppdev->coherent.buf.virt)
+		return;
+
+	dma_free_coherent(ppdev->dev, ppdev->coherent.buf.size,
+			  ppdev->coherent.buf.virt, ppdev->coherent.buf.dma);
+
+	ppdev->coherent.buf.virt = NULL;
+}
+
+static void *mvppnd_alloc_coherent(struct mvppnd_dev *ppdev, size_t size,
+				   dma_addr_t *dma)
+{
+	u64 alignment = 0x0;
+	void *free = ppdev->coherent.buf.virt + ppdev->coherent.mark;
+
+	if (ppdev->sip7) {
+		alignment = 0xF;
+	}
+
+	while (size & alignment)
+		size++;
+
+	*dma = ppdev->coherent.buf.dma + ppdev->coherent.mark;
+	BUG_ON(ppdev->coherent.mark > ppdev->coherent.buf.size);
+
+	while (*dma&alignment) {
+		ppdev->coherent.mark++;
+		*dma = ppdev->coherent.buf.dma + ppdev->coherent.mark;
+		BUG_ON(ppdev->coherent.mark > ppdev->coherent.buf.size);
+	}
+
+	ppdev->coherent.mark += size;
+
+	BUG_ON(!free);
+
+	return free;
+}
+
+/*********** buf wrappers ******************************/
+static int mvppnd_copy_skb_to_tx_buff(struct mvppnd_dev *ppdev,
+				      struct sk_buff *skb,
+				      struct mvppnd_dma_sg_buf *sgb)
+{
+	static const size_t PACKET_MIN_SIZE = ETH_ZLEN - ETH_ALEN * 2;
+	int rc = 0;
+	int i;
+
+	if (unlikely((skb_shinfo(skb)->nr_frags > MAX_FRAGS)))
+		return -EINVAL;
+
+	skb_pull(skb, ETH_ALEN * 2); /* Skip src and dest macs */
+
+	memset(ppdev->tx_buffs.virt, 0, PACKET_MIN_SIZE);
+	memcpy(ppdev->tx_buffs.virt, skb->data, skb_headlen(skb));
+	sgb->mappings[0] = ppdev->tx_buffs.dma;
+	sgb->sizes[0] = max_t(unsigned int, skb_headlen(skb),
+			      PACKET_MIN_SIZE);
+	/* Frags starts from index 1 */
+	for (i = 0; i < skb_shinfo(skb)->nr_frags; i++) {
+		const skb_frag_t *frag = &skb_shinfo(skb)->frags[i];
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4,9,0)
+		memcpy(ppdev->tx_buffs.virt + i * skb_frag_size(frag),
+		       page_to_virt(skb_frag_page(frag)),
+		       skb_frag_size(frag));
+#else
+		WARN_ONCE(1, "Older kernel, frags are not supported\n"
+#endif
+		sgb->mappings[i + 1] = ppdev->tx_buffs.dma + i *
+				       skb_frag_size(frag);
+		sgb->sizes[i + 1] = skb_frag_size(frag);
+	}
+
+	skb_push(skb, ETH_ALEN * 2); /* We are done, return to MAC header */
+	return rc;
+}
+
+/*********** rings related functions *******************/
+static void mvppnd_free_ring_dma(struct mvppnd_dev *ppdev,
+				 struct mvppnd_ring *ring, size_t size)
+{
+	int i;
+
+	if (!ring->buffs)
+		return;
+
+	for (i = 0; i < size; i++) {
+		kfree(ring->buffs[i]);
+		ring->buffs[i] = NULL;
+	}
+
+	kfree(ring->buffs);
+	ring->buffs = NULL;
+
+	kfree(ring->descs);
+	ring->descs = NULL;
+
+	ring->ring_dma = 0;
+}
+
+static int mvppnd_alloc_ring(struct mvppnd_dev *ppdev,
+			     struct mvppnd_ring *ring, size_t size)
+{
+	int rc = 0;
+	int i = 0;
+
+	ring->descs = kmalloc_array(size, sizeof(ring->descs[0]), GFP_KERNEL);
+	if (unlikely(!ring->descs))
+		return -ENOMEM;
+
+	/* TODO: Why i can't just do the next two allocs together? */
+	ring->buffs = kmalloc_array(size, sizeof(ring->buffs[0]),
+				    GFP_KERNEL);
+	if (unlikely(!ring->buffs))
+		goto free_descs;
+
+	for (i = 0; i < size; i++) {
+		ring->buffs[i] = kzalloc(sizeof(*ring->buffs[i]), GFP_KERNEL);
+		if (unlikely(!ring->buffs[i]))
+			goto free_buffs;
+	}
+
+	/* Allocate one big coherent and split it to all descs */
+	ring->descs[0] = mvppnd_alloc_coherent(ppdev, sizeof(*ring->descs[0]) *
+					       size, &ring->ring_dma);
+	/*pr_info("ring desc %u ptr %llx sz %x\n", 0, (u64)ring->descs[0], (unsigned)sizeof(*ring->descs[0]) );*/
+	XDMA_DESC_SET_NEXT(ppdev, ring->descs[0], (ring->ring_dma + sizeof(*ring->descs[0])));
+
+	for (i = 1; i < size; i++) {
+		ring->descs[i] = ring->descs[0] + i;
+		/*if (i < 4)
+			pr_info("ring desc %u ptr %llx sz %x\n", i, (u64)ring->descs[i], (unsigned)sizeof(*ring->descs[1]) );*/
+		XDMA_DESC_SET_NEXT(ppdev, ring->descs[i], (ring->ring_dma + (i + 1) * sizeof(*ring->descs[0])));
+		ring->descs[i]->cmd_sts = 0;
+	}
+
+	/* Close the ring */
+	ring->descs[size - 1]->next_desc_ptr = ring->ring_dma;
+	XDMA_DESC_SET_NEXT(ppdev, ring->descs[size - 1], ring->ring_dma);
+
+	return 0;
+
+free_buffs:
+	for (i = 0; i < size; i++)
+		kfree(ring->buffs[i]);
+	kfree(ring->buffs);
+	ring->buffs = NULL;
+
+free_descs:
+	kfree(ring->descs);
+	ring->descs = NULL;
+
+	return rc;
+}
+
+static int mvppnd_setup_tx_ring(struct mvppnd_dev *ppdev)
+{
+	int rc = 0;
+	u32 i, val, gdma_num;
+
+	if (ppdev->tx_queue_num == -1)
+		return -1;
+
+	if (ppdev->sip7) {
+#if 0
+		mvppnd_write_reg(ppdev, REG_ADDR_GDMA_SW_RST(GDMA_NUM_FROM_CPU), GDMA_RST_SW);
+		while (!(mvppnd_read_reg(ppdev, REG_ADDR_GDMA_SW_RST(GDMA_NUM_FROM_CPU)) & GDMA_RST_SW_DONE))
+			msleep(1); /* wait for reset to finish */
+		mvppnd_write_reg(ppdev, REG_ADDR_GDMA_SW_RST(GDMA_NUM_FROM_CPU), 0);
+		msleep(1);
+#endif
+		mvppnd_write_reg(ppdev, REG_ADDR_GDMA_PDI_MASTER(GDMA_NUM_FROM_CPU), GDMA_PD_MASTER_EN);
+		mvppnd_edit_reg_or(ppdev, REG_ADDR_GDMA_MISC_CFG(GDMA_NUM_FROM_CPU), GDMA_SWAP_CFG);
+		mvppnd_write_reg(ppdev, REG_ADDR_GDMA_PAYLOAD_BUF_THRES(GDMA_NUM_TO_CPU), 0x16);
+
+		for (i = 0; i < NUM_OF_RX_QUEUES; i++) {
+			/* Must disable all queues before changing SGD buffer allocation control register: */
+			gdma_num = GDMA_NUM_FROM_CPU;
+			val = mvppnd_read_reg(ppdev,
+					      REG_ADDR_GDMA_Q_EN_STS(gdma_num, i));
+			val &= ~GDMA_Q_EN_STS_BIT_EN;
+			mvppnd_write_reg(ppdev,
+					 REG_ADDR_GDMA_Q_EN_STS(gdma_num,
+					 i), val);
+			while (!(mvppnd_read_reg(ppdev, REG_ADDR_GDMA_Q_EN_STS(gdma_num, i)) & GDMA_Q_EN_STS_BIT_RING_IDLE))
+				msleep(1);
+		}
+
+		/* all TX queues disabled , can change SGD buffer allocation control register,
+		   half the allocations since we are working in extedned size buffer descriptor mode: */
+		for (i = 0; i < NUM_OF_RX_QUEUES; i++) {
+			mvppnd_write_reg(ppdev, REG_ADDR_GDMA_Q_SGD_BUF_ALLOC_CTRL(GDMA_NUM_FROM_CPU, i), 0x080a);
+		}
+	}
+
+	rc = mvppnd_alloc_ring(ppdev, &ppdev->tx_queue.ring, TX_RING_SIZE);
+	if (rc)
+		return rc;
+
+	ppdev->tx_buffs.virt =
+		mvppnd_alloc_coherent(ppdev, TX_RING_SIZE *
+				      ppdev->max_pkt_sz, &ppdev->tx_buffs.dma);
+
+	/*pr_info("%s: %llx\n", __func__, ppdev->tx_queue.ring.ring_dma);*/
+	mvppnd_write_tx_first_desc(ppdev,
+				   ppdev->tx_queue.ring.ring_dma & 0xffffffff,
+				   ppdev->tx_queue.ring.ring_dma >> 32,
+				   TX_RING_SIZE);
+
+	return 0;
+}
+
+static void mvppnd_destroy_tx_ring(struct mvppnd_dev *ppdev)
+{
+	if (ppdev->tx_queue_num == -1)
+		return;
+
+	mvppnd_write_tx_first_desc(ppdev, 0, 0, 0);
+
+	mvppnd_free_ring_dma(ppdev, &ppdev->tx_queue.ring, TX_RING_SIZE);
+}
+
+static void mvppnd_destroy_rx_rings(struct mvppnd_dev *ppdev)
+{
+	int i;
+
+	for (i = 0; i < NUM_OF_RX_QUEUES; i++) {
+		if (ppdev->rx_queues[i]) {
+			mvppnd_write_rx_first_desc(ppdev, i, 0, 0, 0);
+			mvppnd_free_ring_dma(ppdev, &ppdev->rx_queues[i]->ring,
+					     ppdev->rx_rings_size[i]);
+			kfree(ppdev->rx_queues[i]);
+			ppdev->rx_queues[i] = NULL;
+		}
+	}
+}
+
+static int mvppnd_setup_rx_rings(struct mvppnd_dev *ppdev)
+{
+	struct mvppnd_ring *r;
+	int i, j, rc = 0;
+
+	if ( (!ppdev->sip7) && (!ppdev->mg_win[MG_WIN_STREAMING1_IDX]) ) {
+		dev_err(ppdev->dev, "MG window is not set\n");
+		return -EFAULT;
+	}
+
+	if (ppdev->sip7) {
+		/* Because the way GDMA works, it has a count of the buffers
+		   Moved to the GDMA ownership from the CPU. CPSS has already
+		   put a lot of buffers there, so we must reset the GDMA to
+		   the POR settings, otherwise too many buffers will be queued
+		   and the AXI will stall. unfortunately CPSS and this driver
+		   cannot work together at the same time */
+		mvppnd_write_reg(ppdev, REG_ADDR_GDMA_SW_RST(GDMA_NUM_TO_CPU), GDMA_RST_SW);
+		while (!(mvppnd_read_reg(ppdev, REG_ADDR_GDMA_SW_RST(GDMA_NUM_TO_CPU)) & GDMA_RST_SW_DONE))
+			msleep(1); /* wait for reset to finish */
+		mvppnd_write_reg(ppdev, REG_ADDR_GDMA_SW_RST(GDMA_NUM_TO_CPU), 0);
+		msleep(1);
+		mvppnd_edit_reg_or(ppdev, REG_ADDR_GDMA_PDI_SLAVE(GDMA_NUM_TO_CPU), GDMA_PD_MASTER_EN);
+
+		mvppnd_write_reg(ppdev, REG_ADDR_GDMA_PAYLOAD_BUF_THRES(GDMA_NUM_TO_CPU), 0x200);
+		/* lower internal buffers and thresholds of GDMA to 50% of
+		   default value because we use extended (double size) buffer
+		   descriptor size mode: */
+		for (i = 0; i < NUM_OF_RX_QUEUES; i++) {
+			mvppnd_write_reg(ppdev, REG_ADDR_GDMA_Q_SGD_BUF_ALLOC_CTRL(GDMA_NUM_TO_CPU, i), 0x080a);
+		}
+	}
+
+	for (i = 0; i < NUM_OF_RX_QUEUES; i++) {
+		if (!ppdev->rx_queues[i])
+			continue;
+
+		rc = mvppnd_alloc_ring(ppdev, &ppdev->rx_queues[i]->ring,
+				       ppdev->rx_rings_size[i]);
+		if (rc)
+			goto destroy_rings;
+
+		r = &ppdev->rx_queues[i]->ring;
+
+		/* Populate ring with skbs */
+		for (j = 0; j < ppdev->rx_rings_size[i]; j++) {
+			struct mvppnd_hw_desc test, *tst = &test;
+			struct mvppnd_dma_sg_buf *sgb = r->buffs[j];
+
+			r->descs[j]->cmd_sts = ppdev->own_bit |
+					       ppdev->rx_intr_bit;
+
+			sgb->sizes[0] = ppdev->max_pkt_sz - ppdev->dsa_tag_size;
+			sgb->virt = mvppnd_alloc_coherent(ppdev, sgb->sizes[0],
+							  &sgb->mappings[0]);
+
+			XDMA_RX_DESC_SET_BUFF_SZ(ppdev, r->descs[j], sgb->sizes[0]);
+			r->descs[j]->bc = 0;
+			tst->bc = 0;
+			XDMA_DESC_SET_PTR(ppdev, tst, sgb->mappings[0]);
+			XDMA_DESC_SET_PTR(ppdev, r->descs[j], sgb->mappings[0]);
+			/*dev_info(ppdev->dev, "Setup rx ring #%d buf #%d, bd %x %x ptr %llx bc tst %x",
+				 i, j, r->descs[j]->cmd_sts, r->descs[j]->bc, sgb->mappings[0], tst->bc);*/
+		}
+		r->descs_ptr = 0;
+		r->buffs_ptr = 0;
+
+		mvppnd_write_rx_first_desc(ppdev, i,
+					   r->ring_dma & 0xffffffff,
+					   r->ring_dma >> 32,
+					   ppdev->rx_rings_size[i]);
+	}
+
+	/* recv boundaries */
+	if (ppdev->sip7) {
+		/* Probably no GDMA equivalent */
+	} else
+		mvppnd_edit_reg_or(ppdev, REG_ADDR_SDMA_CONF, 0x1);
+
+	/* Enable queues */
+	for (i = 0; i < NUM_OF_RX_QUEUES; i++)
+		if (ppdev->rx_queues[i])
+			mvppnd_enable_queue(ppdev, REG_ADDR_RX_QUEUE_CMD, i);
+
+	/*
+	 * AC5 in internal mode needs to be enabled twice for some reason,
+	 * this should not have any adverse effect on other packet processors:
+	 */
+	for (i = 0; i < NUM_OF_RX_QUEUES; i++)
+		if (ppdev->rx_queues[i]) {
+			if (!ppdev->sip7)
+				mvppnd_enable_queue(ppdev, REG_ADDR_RX_QUEUE_CMD, i);
+			else {
+				while (!(mvppnd_read_reg(ppdev, REG_ADDR_GDMA_Q_EN_STS(GDMA_NUM_FROM_CPU, i)) & GDMA_Q_EN_STS_BIT_RING_IDLE))
+					msleep(1);
+			}
+		}
+
+	if (ppdev->sip7) { /* notify GDMA on the number of RX desciptor we have passed ownership to it: */
+		for (i = 0; i < NUM_OF_RX_QUEUES; i++)
+			if (ppdev->rx_queues[i])
+				mvppnd_write_reg(ppdev,
+						 REG_ADDR_GDMA_Q_SGD_ADD_GDMA_SGD_OWN(
+						 GDMA_NUM_TO_CPU, GDMA_KRNL_ETH_DRV_Q_OFS + i),
+						 ppdev->rx_rings_size[i]);
+	}
+	return 0;
+
+destroy_rings:
+	mvppnd_destroy_rx_rings(ppdev);
+
+	return rc;
+}
+
+static void mvppnd_destroy_rings(struct mvppnd_dev *ppdev)
+{
+	mvppnd_destroy_rx_rings(ppdev);
+	mvppnd_destroy_tx_ring(ppdev);
+}
+
+/*
+ * This function is called by an external kernel module
+ * to provide RX and TX callback hook functions.
+ * If a previous registration of hooks were made,
+ * this will override the previously registered hook
+ * callback functions
+ */
+int mvppnd_register_hooks(struct net_device *ndev, struct mvppnd_ops *ops)
+{
+	struct mvppnd_switch_flow *flow;
+
+	if (!ndev)
+		return -EINVAL;
+
+	flow = netdev_priv(ndev);
+
+	flow->ppdev->ops = ops;
+
+	return 0;
+}
+EXPORT_SYMBOL(mvppnd_register_hooks);
