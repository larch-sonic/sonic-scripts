@@ -0,0 +1,77 @@
+#!/bin/bash
+
+I2C_BUS=0
+I2C_ADDR=0x18
+REG_ADDR=0x07
+
+# LED mode bits (6-7)
+MODE_ON=0    # 00
+MODE_OFF=1   # 01
+MODE_BLINK=2 # 10
+
+print_usage() {
+    echo "Usage: $0 [on|off|blink|status|get]"
+    exit 1
+}
+
+read_reg() {
+    i2cget -y $I2C_BUS $I2C_ADDR $REG_ADDR
+}
+
+write_reg() {
+    local newval=$1
+    i2cset -y $I2C_BUS $I2C_ADDR $REG_ADDR $newval
+}
+
+get_mode() {
+    local val=$(read_reg)
+    # Remove 0x prefix and convert to decimal
+    val=$((val))
+
+    # Extract bits 6-7
+    mode=$(((val >> 6) & 0x03))
+
+    case $mode in
+        $MODE_ON) echo "on" ;;
+        $MODE_OFF) echo "off" ;;
+        $MODE_BLINK) echo "blink" ;;
+        *) echo "unknown" ;;
+    esac
+}
+
+set_mode() {
+    local mode_name="$1"
+    local mode_bits
+
+    case "$mode_name" in
+        on)    mode_bits=$MODE_ON ;;
+        off)   mode_bits=$MODE_OFF ;;
+        blink) mode_bits=$MODE_BLINK ;;
+        *) echo "Invalid mode: $mode_name"; print_usage ;;
+    esac
+
+    local val=$(read_reg)
+    val=$((val & ~(0x03 << 6)))         # Clear bits 6 and 7
+    val=$((val | (mode_bits << 6)))     # Set new mode
+    write_reg 0x$(printf "%02x" $val)
+    echo "LED set to mode: $mode_name"
+}
+
+# Main
+[ $# -ne 1 ] && print_usage
+
+case "$1" in
+    on|off|blink)
+        set_mode "$1"
+        ;;
+    status)
+        echo -n "LED current mode: "
+        get_mode
+        ;;
+    get)
+        get_mode
+        ;;
+    *)
+        print_usage
+        ;;
+esac
