+        Returns:
+            A boolean, True if tx_disable is set successfully, False if not
+        """
+        if (self.port_num > 8):
+            tx_disable_bmp = (Sfp._tx_disable_bmp >> 8) & 0xFF
+        else:
+            tx_disable_bmp = Sfp._tx_disable_bmp & 0xFF
+
+        mask = 1 << (self.port_num - 1) % 8
