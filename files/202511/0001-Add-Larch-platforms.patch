+#define GET_BIT(data, bit, value)       (value) = ((data) >> (bit)) & 0x1
+#define SET_BIT(data, bit)              (data) |= (1 << (bit))
+#define CLEAR_BIT(data, bit)            (data) &= ~(1 << (bit))
+
+enum wnc_hwmon_psu_control_bits
+{
+    PSU_STATUS_BIT = 0,
+    PSU_POWER_OK_BIT,
+    PSU_PRESENCE_BIT,
+    PSU_INPUT_OK_BIT = 4,
+    PSU_ALARM_BIT = 6
+};
+
+enum wnc_hwmon_register
+{
+    PCB_REVERSION = 0,
+    FPGA_VER_1,
+    FPGA_VER_2,
+    RESET_CONTROL_1,
+    RESET_CONTROL_2,
+    RESET_CONTROL_3,
+
+    FAN_PWM_1 = 0x0e,
+    FAN_PWM_2,
+    FAN_PWM_3,
+    FAN_PWM_4,
+    FAN_PWM_5,
+    FAN_PWM_6,
+
+    FAN_1_1_RPM = 0x14,
+    FAN_1_2_RPM = 0x16,
+    FAN_2_1_RPM = 0x18,
+    FAN_2_2_RPM = 0x1a,
+    FAN_3_1_RPM = 0x1c,
+    FAN_3_2_RPM = 0x1e,
+    FAN_4_1_RPM = 0x20,
+    FAN_4_2_RPM = 0x22,
+    FAN_5_1_RPM = 0x24,
+    FAN_5_2_RPM = 0x26,
+    FAN_6_1_RPM = 0x28,
+    FAN_6_2_RPM = 0x2a,
+
+    PSU_1_CTRL = 0x2c,
+    PSU_2_CTRL,
+    
+    STATUS_LED,
+    FAN_LED,
+
+    POWER_GOOD,
+
+    WDT_CTRL = 0x33,
+    WDT_TIMEOUT,
