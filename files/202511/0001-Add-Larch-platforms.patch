--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/qn-sr-100/sonic_platform/psu.py
@@ -0,0 +1,278 @@
+try:
+    from sonic_platform_base.psu_base import PsuBase   
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+smbus_present = 1
+try:
+    import smbus
+except ImportError as e:
+    smbus_present = 0
+
+CPLD_ADDRESS = 0x33
+class Psu(PsuBase):
+    """Platform-specific Psu class"""
+
+    def __init__(self, psu_index=0):
+        PsuBase.__init__(self)
+        self.index = psu_index # 0-based index
+
+    ########  DEVICE BASE API  #########
+
+    def get_name(self):
+        """
+        Retrieves the name of the device
+
+        Returns:
+            string: The name of the device
+        """
+        return "Psu{}" + (self.index + 1)
+
+    def get_presence(self):
+        """
+        Retrieves the presence of the device
+
+        Returns:
+            bool: True if device is present, False if not
+        """
+        if smbus_present == 0:  # if called from sfputil outside of pmon
+            cmdstatus, register = cmd.getstatusoutput('sudo i2cget -y 0 0x33 0x8')
+            if cmdstatus:
+                Logger.log_warning("sfp cmdstatus i2c get failed %s" % register )
+                return False
+            register = int(register, 16)
+        else:
+            bus = smbus.SMBus(0)
+            DEVICE_REG = 0x8
+            register = bus.read_byte_data(CPLD_ADDRESS, DEVICE_REG)
+
+        if (self.index == 0):
+            plugged_bit = 2
+        elif (self.index == 1):
+            plugged_bit = 0
+        else:
+            return False
+
+        return False if register & (1 << plugged_bit) else True
+
+    def get_model(self):
+        """
+        Retrieves the model number (or part number) of the device
+
+        Returns:
+            string: Model/part number of device
+        """
+        return "N/A"
+
+    def get_serial(self):
+        """
+        Retrieves the serial number of the device
+
+        Returns:
+            string: Serial number of device
+        """
+        return "N/A"
+
+    def get_revision(self):
+        """
+        Retrieves the hardware revision of the device
+
+        Returns:
+            string: Revision value of device
+        """
+        return "N/A"
+
