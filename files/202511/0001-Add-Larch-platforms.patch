+#!/bin/sh
+set -e
+/usr/local/bin/platform_api_mgnt.sh install
+# Apply sysctl overrides immediately after platform deb install.
+# systemd-sysctl runs before rc.local installs this deb, so we must
+# apply the settings here to ensure they take effect on first boot.
+sysctl -p /etc/sysctl.d/zz-dqs5000-nmi.conf || true
+# Load MPLS modules and apply sysctl on first boot
+modprobe mpls_router || true
+modprobe mpls_iptunnel || true
+sysctl -p /etc/sysctl.d/90-mpls.conf || true
+#DEBHELPER#
