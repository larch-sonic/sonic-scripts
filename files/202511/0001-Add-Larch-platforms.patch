+                for name in files:
+                    if name.endswith("_input") and name.startswith("temp"):
+                        file_path = os.path.join(dirpath, name)
+                        value = self.get_attr_value(file_path)
+
+                        if value != 'ERR':
+                            value = float(value) / 1000
+                            temp = max(temp, value)
+
+        except Exception as e:
