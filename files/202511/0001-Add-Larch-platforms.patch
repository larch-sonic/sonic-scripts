+# along with this program.  If not, see <http://www.gnu.org/licenses/>.
+
+import threading, time 
+import common
+
+FAN_NUM = 4
+
+QSFP_START_NUM = 25
+QSFP_END_NUM = 30
+
+DEVICE_BUS = {'cpld': ['4-0060', '4-0061']}
+
+def getFanPresence(number):
+    cpld_bus = DEVICE_BUS['cpld']
+    attr_value = common.readFile(common.I2C_PREFIX + cpld_bus[1] + "/fan" + str(number+1) + "_present")
+    if (attr_value != 'ERR'):
+        attr_value = int(attr_value, 16)
+
+        if(attr_value == 0):
+            string = "Connect"
+        else:
+            string = "Disconnect"
+    return string
+
+def getFanAlert(number, position):
+    cpld_bus = DEVICE_BUS['cpld']
+    attr_value = common.readFile(common.I2C_PREFIX + cpld_bus[1] + "/fan" + str(number+1) + "_" + position + "_fault")
+    if (attr_value != 'ERR'):
+        attr_value = int(attr_value, 16)
+
+        if(attr_value == 0):
+            string = "Normal"
+        else:
+            string = "Abnormal"
+    return string
+
+def getFanRPM(number, position):
+    cpld_bus = DEVICE_BUS['cpld']
+    return common.readFile(common.I2C_PREFIX + cpld_bus[1] + "/fan" + str(number+1) + "_" + position + "_speed")
+
+def getFanPWM():
+    cpld_bus = DEVICE_BUS['cpld']
+    return common.readFile(common.I2C_PREFIX + cpld_bus[1] + "/fan_pwm")
+
+def getFan():
+    string = ''
+    result = getFanPWM()
+    string += '\n\n' + "FAN PWM: " + result.rjust(10) + "%"
+    for i in range(0,FAN_NUM):
+        # Status
+        result = getFanPresence(i)
+        string += '\n\n' + "FAN " + str(i+1) + ": " + result
+        if result == 'Disconnect':
+            continue
+
+        # Alert
+        result = getFanAlert(i, "rear")
+        string += '\n' + "     Inner Status: " + result
+
+        result = getFanAlert(i, "front")
+        string += '\n' + "     Outer Status: " + result
+
+        # Inner RPM
+        result = getFanRPM(i, "rear")
+        string += '\n' + "  Inner RPM: " + result.rjust(10) + " RPM"
+
+        # Outer RPM
+        result = getFanRPM(i, "front")
+        string += '\n' + "  Outer RPM: " + result.rjust(10) + " RPM"
+
+    return string
+
+
+def getSensors():
+    string = ''
+
+    # Fan
+    string += getFan()
+
+    return string
+
+class DeviceThread(threading.Thread):
+	def __init__(self,threadname, q):
+		threading.Thread.__init__(self,name = threadname)
+		self.queue = q
+
+	def run(self):
+		while common.RUN:
+			message = self.queue.get()
+			self.onMessage(message)
+
+	def onMessage(self, message):
+		"""
+		Commands:
+                        init            : Init devices
+                        sensors         : Read HW monitors
+		"""
+
+		if len(message.command) < 1:
+			result = self.onMessage.__doc__
+		else:
+                        if message.command[0] == 'init':
+                            result = deviceInit()
+                        elif message.command[0] == 'sensors':
+                            result = getSensors()
+                        else:
+                            result = self.onMessage.__doc__
+
+		if (message.callback is not None):
+			 message.callback(result)
+
+class PlatformStatusThread(threading.Thread):
+	def __init__(self,threadname, timer):
+		self.running = True
+		threading.Thread.__init__(self,name = threadname)
+		self.timer = timer
+
+	def run(self):
+		while common.RUN:
+			self.checkPlatformStatus()
+			time.sleep(self.timer)
+
+	def checkPlatformStatus(self):
+		total_result = common.PASS
+
+
+def deviceInit():
+	cpld_bus = DEVICE_BUS['cpld']
+	# Set QSFP reset to normal
+	for x in range(QSFP_START_NUM, QSFP_END_NUM + 1):
+		path = common.I2C_PREFIX + cpld_bus[0] + '/sfp' + str(x) + '_reset'
+		result = common.writeFile(path, "1")
+	return
