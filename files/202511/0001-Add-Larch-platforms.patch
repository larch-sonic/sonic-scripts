+static int wnc_hwmon_probe(struct i2c_client *client)
+{
+    int status;
+
+    status = sysfs_create_group(&client->dev.kobj, &wnc_hwmon_group);
+
+    if (status) {
+        goto exit;
+    }
+
+    dev_info(&client->dev, "chip found\n");
+
+    return 0;
+
