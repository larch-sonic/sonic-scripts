+
+import threading, time, syslog
+
+import common
+
+TOTAL_PORT_NUM = 56
+SFP_MAX_NUM = 48
+CPLDA_SFP_NUM = 28
+CPLDB_SFP_NUM = 12
+CPLDC_SFP_NUM = 16
+FAN_NUM = 5
+
+DEVICE_BUS = {'cpld': ['6-0074', '7-0075', '8-0076'],
+              'fan': ['4-0070'],
+              'psu': ['2-0058', '3-0059'],
+              'status_led': ['7-0075']}
+
+class DeviceThread(threading.Thread):
+    def __init__(self,threadname, q):
+        threading.Thread.__init__(self,name = threadname)
+        self.queue = q
+
+    def run(self):
+        while common.RUN:
+            message = self.queue.get()
+            self.onMessage(message)
+
+    def onMessage(self, message):
+        """
+        Commands:
+            led        : Led controls
+            locate        : Blink locator LED
+            sensors        : Read HW monitors
+        """
+
+        if len(message.command) < 1:
+            result = self.onMessage.__doc__
+        else:
+            if message.command[0] == 'init':
+                result = deviceInit()
+            elif message.command[0] == 'led':
+                result = ledControls(message.command[1:])
+            elif message.command[0] == 'locate':
+                locatethread = threading.Thread(target = locateDeviceLed)
+                locatethread.start()
+                result = 'Success'
+            elif message.command[0] == 'sensors':
+                result = getSensors()
+            else:
+                result = self.onMessage.__doc__
+
+        if (message.callback is not None):
+             message.callback(result)
+
+STATUS_ALERT = {'fan':
+                    ['wrongAirflow_alert', 'outerRPMOver_alert', 'outerRPMUnder_alert', 'outerRPMZero_alert',
+                    'innerRPMOver_alert', 'innerRPMUnder_alert', 'innerRPMZero_alert', 'notconnect_alert'],
