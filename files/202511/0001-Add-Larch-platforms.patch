+			cp $(MOD_SRC_DIR)/$${mod}/process/* debian/sonic-platform-$${mod}/usr/local/bin/process; \
+			cp $(MOD_SRC_DIR)/$${mod}/tools/pca9641 debian/sonic-platform-$${mod}/usr/local/bin/; \
+			cd $(MOD_SRC_DIR)/$${mod}; \
+			python3 setup.py install --root=$(MOD_SRC_DIR)/debian/sonic-platform-$${mod} --install-layout=deb; \
+			python3 setup.py install --root=$(MOD_SRC_DIR)/debian/sonic-platform-$${mod}-2t --install-layout=deb; \
+			cd $(MOD_SRC_DIR); \
+			continue; \
+		fi; \
+		if [ $$mod = "dqs-5000" ]; then \
+			dh_installdirs -psonic-platform-$${mod} /usr/local/bin/process; \
+			dh_installdirs -psonic-platform-$${mod} /usr/bin; \
+			dh_installdirs -psonic-platform-$${mod} /lib/systemd/system; \
+			cp $(MOD_SRC_DIR)/$${mod}/modules/*.ko debian/sonic-platform-$${mod}/$(KERNEL_SRC)/$(INSTALL_MOD_DIR); \
+			cp $(MOD_SRC_DIR)/$${mod}/utils/* debian/sonic-platform-$${mod}/usr/local/bin/; \
+			cp $(MOD_SRC_DIR)/$${mod}/scripts/* debian/sonic-platform-$${mod}/usr/bin/; \
+			cp $(MOD_SRC_DIR)/$${mod}/process/* debian/sonic-platform-$${mod}/usr/local/bin/process; \
+			cp $(MOD_SRC_DIR)/$${mod}/tools/pca9641 debian/sonic-platform-$${mod}/usr/local/bin/; \
+			cd $(MOD_SRC_DIR)/$${mod}; \
+			python3 setup.py install --root=$(MOD_SRC_DIR)/debian/sonic-platform-$${mod} --install-layout=deb; \
+			cd $(MOD_SRC_DIR); \
+			continue; \
+		fi; \
+		if [ $$mod = "pegatron-fm6256-f" ]; then \
+			dh_installdirs -psonic-platform-$${mod} /usr/local/bin/process; \
+			dh_installdirs -psonic-platform-$${mod} /usr/bin; \
+			dh_installdirs -psonic-platform-$${mod} /lib/systemd/system; \
+			cp $(MOD_SRC_DIR)/$${mod}/modules/*.ko debian/sonic-platform-$${mod}/$(KERNEL_SRC)/$(INSTALL_MOD_DIR); \
+			cp $(MOD_SRC_DIR)/$${mod}/utils/* debian/sonic-platform-$${mod}/usr/local/bin/; \
+			cp $(MOD_SRC_DIR)/$${mod}/scripts/* debian/sonic-platform-$${mod}/usr/bin/; \
+			cp $(MOD_SRC_DIR)/$${mod}/process/* debian/sonic-platform-$${mod}/usr/local/bin/process; \
