+        redis_client.hset('ASIC_SENSORS|ASIC_SENSORS_POLLER_INTERVAL','interval','10')
+
+        thermal = Thermal(0)
+        self._thermal_list.append(thermal)
+
+    def __init_sfp(self):
+        for index in range(self.SFP_PORT_START, self.SFP_PORT_END+1):
