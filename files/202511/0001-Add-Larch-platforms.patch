+static void print_frame(struct mvppnd_dev *ppdev, const char *data, size_t len,
+			bool rx)
+{
+	char *b;
+	int i;
+
+	return;
+
+	b = kmalloc(8196, GFP_KERNEL);
+
+	if (!b)
+		return;
+
+	b[0] = 0;
+	dev_dbg(ppdev->dev, "----------------------------\n");
+	dev_dbg(ppdev->dev, "%s: %ld bytes\n", rx ? "RX" : "TX",
+		len);
+	for (i = 0; i < len; i++) {
+		if (rx && ((i == 12) || (i == 12 + 16)))
+			sprintf(b, "%s\n", b);
+		sprintf(b, "%s 0x%x", b, data[i]);
+	}
+
+	dev_dbg(ppdev->dev, "%s\n", b);
+	dev_dbg(ppdev->dev, "----------------------------\n");
+
+	kfree(b);
+}
