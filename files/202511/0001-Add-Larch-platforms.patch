diff --git a/platform/marvell-prestera/sonic-platform-larch/drivers/armhf/cpssEnabler/linuxNoKernelModule/drivers/Makefile b/platform/marvell-prestera/sonic-platform-larch/drivers/armhf/cpssEnabler/linuxNoKernelModule/drivers/Makefile
