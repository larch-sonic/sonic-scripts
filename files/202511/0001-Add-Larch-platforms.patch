diff --git a/platform/marvell-prestera/larch-static/boot/dts/README.md b/platform/marvell-prestera/larch-static/boot/dts/README.md
new file mode 100644
index 000000000..910da2f14
--- /dev/null
+++ b/platform/marvell-prestera/larch-static/boot/dts/README.md
@@ -0,0 +1,19 @@
+# Device tree sources for the prebuilt blobs in ../
+
+The `.dtb` files one directory up are committed as binaries, which makes any change to them
+unreviewable — a diff of a blob says nothing. This directory holds the source of a blob that has been
+modified, so the next reader can see what it contains and what changed.
+
+A source here is produced from, and compiled back to, the blob with `dtc`:
+
+```
+dtc -I dtb -O dts -o dts/<board>.dts ../<board>.dtb     # read the blob
+dtc -I dts -O dtb -o ../<board>.dtb  dts/<board>.dts     # write it back
+```
+
+The round trip is exact: decompiling the rebuilt blob reproduces the source byte for byte, so the only
+differences in the blob are the ones visible in the source diff. `dtc` prints warnings while compiling
+these sources; they come from the original blobs and are not introduced by the edits.
+
+Only boards whose blob has been edited have their source here; the rest still have no source in this
+repository.
diff --git a/platform/marvell-prestera/larch-static/boot/dts/ac5x-ln38xx.dts b/platform/marvell-prestera/larch-static/boot/dts/ac5x-ln38xx.dts
new file mode 100644
index 000000000..bb0862338
--- /dev/null
+++ b/platform/marvell-prestera/larch-static/boot/dts/ac5x-ln38xx.dts
@@ -0,0 +1,411 @@
+/dts-v1/;
+
+/ {
+	model = "Marvell RD-AC5X Board";
+	compatible = "marvell,rd-ac5x\0marvell,ac5x\0marvell,ac5";
+	interrupt-parent = <0x01>;
+	#address-cells = <0x02>;
+	#size-cells = <0x02>;
+
+	cpus {
+		#address-cells = <0x02>;
+		#size-cells = <0x00>;
+
+		cpu-map {
+
+			cluster0 {
+
+				core0 {
+					cpu = <0x02>;
+				};
+
+				core1 {
+					cpu = <0x03>;
+				};
+			};
+		};
+
+		cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x00 0x00>;
+			enable-method = "psci";
+			next-level-cache = <0x04>;
+			phandle = <0x02>;
+		};
+
+		cpu@1 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
