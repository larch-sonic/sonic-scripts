index 000000000..99509aab3
--- /dev/null
+++ b/device/larch/x86_64-larch_gemini/gemini-hw_bfd/port_config.ini
@@ -0,0 +1,57 @@
+#  name         lanes         alias             speed      autoneg    fec      index
+Ethernet0       0             twenty5GigE0      25000      off        none     1
+Ethernet1       1             twenty5GigE1      25000      off        none     2
+Ethernet2       2             twenty5GigE2      25000      off        none     3
+Ethernet3       3             twenty5GigE3      25000      off        none     4
+Ethernet4       4             twenty5GigE4      25000      off        none     5
+Ethernet5       5             twenty5GigE5      25000      off        none     6
+Ethernet6       6             twenty5GigE6      25000      off        none     7
