+static int silicom_ec_emi_lock(void)
+{
+	mutex_lock(&io_mutex);
+	return 0;
+}
+
+static int silicom_ec_emi_unlock(void)
+{
+	mutex_unlock(&io_mutex);
+	return 0;
+}
+
+int silicom_ec_sys_write(struct silicom_ec_hwmon *hw, unsigned int offset, unsigned int val);
+int silicom_ec_sys_write(struct silicom_ec_hwmon *hw, unsigned int offset, unsigned int val)
+{
+	int ret;
+
+	ret = silicom_ec_emi_lock();
+	if (ret)
+		return ret;
+
+	outw((offset & ~3), hw->io_addr->start + 2);
+	outw(val, hw->io_addr->start + 4 + (offset & 3));
+
+	silicom_ec_emi_unlock();
+
+	return 0;
+}
+
+int silicom_ec_sys_read(struct silicom_ec_hwmon *hw, unsigned int offset, unsigned int *val);
+int silicom_ec_sys_read(struct silicom_ec_hwmon *hw, unsigned int offset, unsigned int *val)
+{
+	int ret;
+
+	ret = silicom_ec_emi_lock();
+	if (ret)
+		return ret;
+
+	outw((offset & ~3), hw->io_addr->start + 2);
+	*val = inw(hw->io_addr->start + 4 + (offset & 3));
+
+	silicom_ec_emi_unlock();
+
+	return 0;
+}
