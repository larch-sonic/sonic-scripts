+# /etc/systemd/system/sonic-utilities-proxy.service
+[Unit]
+Description=SONiC CLI proxy (show/config)
+After=network.target
+
+[Service]
+User=root
+Environment=PYTHONUNBUFFERED=1
+# In-process intfutil/portstat in the warm daemon (~2x faster show interfaces status).
+# Set to 0 or remove to restore per-user sudo subprocess isolation.
+Environment=SHOW_PROXY_INPROCESS_AS_DAEMON=1
+# Reuse Redis/ConfigDB connectors across proxied commands (helps show interfaces counters).
+Environment=SHOW_PROXY_DB_POOL=1
+ExecStart=/usr/local/bin/uvicorn server:app --host 127.0.0.1 --port 8787 --workers 1
+Restart=always
+RestartSec=1
+
+[Install]
+WantedBy=multi-user.target
