+#!/bin/bash
+set -euo pipefail
+PROXY_URL="http://127.0.0.1:8787"
+CLI_PROXY_DISABLED_FLAG="/etc/sonic/.cli_proxy_disabled"
+
+# Get the current user running this command
+CURRENT_USER=$(id -un)
+
+# If CLI proxy is disabled, run the real command directly
+if [[ -f "$CLI_PROXY_DISABLED_FLAG" ]]; then
+  exec /usr/local/bin/config_fallback "$@"
+fi
+
+# Commands that are better run directly (TTY/streaming/long-running)
+LONG_BYPASS=("reload" "load_minigraph" "load" "save" "spanning-tree")
+
+if [[ "${1-}" == "__complete__" ]]; then
+  cword="$2"; shift 2
+  payload=$(jq -cn --argjson c "$cword" --argjson w "$(printf '%s\n' "$@" | jq -R . | jq -s .)" \
+    '{prog:"config", cword:$c, words:$w}')
+  curl -sS -H 'Content-Type: application/json' -d "$payload" "$PROXY_URL/complete" \
+    | jq -r '.candidates[]?' || true
+  exit 0
+fi
+
+if (( $# >= 1 )); then
+  sub="$1"
+  for x in "${LONG_BYPASS[@]}"; do
+    if [[ "$sub" == "$x" ]]; then
+      exec /usr/local/bin/config_fallback "$@"
+    fi
+  done
+fi
+
+# Resolve any file-path arguments to absolute paths before sending to the proxy.
+# The proxy server runs with CWD '/', so relative paths must be resolved here
+# while the user's working directory is still active.
+normalized=()
+for arg in "$@"; do
+  if [[ -e "$arg" ]]; then
+    normalized+=("$(realpath -- "$arg")")
+  else
+    normalized+=("$arg")
+  fi
+done
+
+# Otherwise — through the proxy (fast/common commands) - pass user to proxy
+payload=$(jq -cn --arg u "$CURRENT_USER" --argjson a "$(printf '%s\n' "${normalized[@]}" | jq -R . | jq -s .)" '{prog:"config", args:$a, user:$u}')
+resp=$(curl -sS -w '\n%{http_code}' -H 'Content-Type: application/json' -d "$payload" "$PROXY_URL/run") || {
+  echo "config-proxy error: transport failed" >&2; exit 127; }
+body=$(printf '%s' "$resp" | sed '$d'); code=$(printf '%s' "$resp" | tail -n1)
+if [[ "$code" -ge 200 && "$code" -lt 300 ]]; then
+  printf '%s' "$body" | jq -j '.stdout // empty'
+  printf '%s' "$body" | jq -j '.stderr // empty' >&2
+  exit "$(printf '%s' "$body" | jq -r '.exit_code')"
+fi
+echo "config-proxy error: HTTP $code" >&2
+printf '%s\n' "$body" | jq -r '.stderr // empty' >&2 || true
+exit 1
