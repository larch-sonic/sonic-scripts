+********************************************************************************
+* intDriver.c
+*
+* DESCRIPTION:
+*       mvIntDrv - A driver which passes interrupts to user-space
+*                  Usage:
+*                     fd=open("/dev/mvIntDrv",O_RDWR);
+*                     write(fd, "eI", 2)    will enable irq I (0..255)
+*                     write(fd, "dI", 2)    will disable irq I (0..255)
+*                     write(fd, "EIIII", 5) will enable irq I (0..0xffffffff)
+*                     write(fd, "DIIII", 5) will disable irq I (0..0xffffffff)
+*                     write(fd, "mBDF",4)   will enable MSI interrupts
+*                                           Here B=PCI bus (binary)
+*                                           Here D=PCI device (binary)
+*                                           Here F=PCI device functin (binary)
+*                     write(fd, "MddBDF",6) will enable MSI interrupts
+*                                           Here dd=PCI domain, LE
+*                                           Here B=PCI bus (binary)
+*                                           Here D=PCI device (binary)
+*                                           Here F=PCI device functin (binary)
+*                     X=write(fd, "cI", 2) will connect irq I (0..255)
+*                     X=write(fd, "CIIII", 5) will connect irq I (0..0xffffffff)
+*
+*                     read(fd,NULL,X) will wait for irq
+*
+*******************************************************************************/
+#define MV_DRV_NAME     "mvIntDrv"
+#include "mvDriverTemplate.h"
+
+#include <linux/pci.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/list.h>
+#include <linux/hashtable.h>
+#include <linux/delay.h>
+
+#define MAX_INTERRUPTS 2048 /* Support MSI-X */
+#define SIP7_ATU_CNT 32
+#define MSI_X_CLIENT_ATU_WIN_NUM 30
+#define MSI_X_OFS     0x20000
+#define ID_MASK_OFFSET 0xC
+
+#define CLR_MSI_X_SRC(sl) \
+	if (sl->msi_x_client) \
+		*(u32 *)(sl->msi_x_client + MSI_X_OFS + ID_MASK_OFFSET) = sl->irq_offset
+
+/* #define DBG_CVOE */
+
+#ifdef DBG_CVOE
+#define DBGL(x) \
+		pr_err("cvoe msg %s at line %d func %s\n", x, __LINE__, __func__); \
+		msleep(9)
+#else
+#define DBGL(x)
+#endif
+
+enum irq_slot_state {
+	IRQ_SLOT_STATE_UNALLOCATED,
+	IRQ_SLOT_STATE_ALLOCATED,
+	IRQ_SLOT_STATE_READY_FOR_REALLOCATION /* after user-space termination, ready for quick re-allocation */
+};
+
+/* Character device context */
+static struct mvchrdev_ctx *chrdrv_ctx;
+
+static atomic_t mvIntDrvNumOpened = ATOMIC_INIT(0);
+
+struct interrupt_slot {
+	enum irq_slot_state	state;
+	atomic_t		depth; /* keep track of enable/disable */
+	unsigned int		irq;
+	unsigned int		irq_offset;
+	struct semaphore	sem; /* The semaphore on which the user waits */
+	struct semaphore	close_sem; /* Sync disconnect with read */
+	struct tasklet_struct	tasklet;
+	struct pci_dev		*pdev;
+	void __iomem 		*bar2;
+	void __iomem 		*msi_x_client;
+	struct hlist_node	irq_hash_list;
+};
+
+/* To hold list of devices we enabled MSI on */
+struct mvintdrv_pci_dev {
+	struct list_head list;
+	struct pci_dev *pdev;
+};
+
+struct mvintdrv_file_priv {
+	struct list_head msi_enabled_pdevs;
+};
+
+static struct interrupt_slot *mvIntDrv_slots;
+static DECLARE_HASHTABLE(mvIntDrv_slots_hash, 11);
+DEFINE_MUTEX(alloc_mtx); /* The mutex which protects slot allocations */
+
+static bool msi_used;
+
+static unsigned int get_atu_win_size(struct pci_dev *pdev, unsigned bar_num)
+{
+	unsigned win_sz = 0x1;
+	unsigned bar_size = pci_resource_len(pdev, bar_num);
+
+	while (win_sz < (bar_size / SIP7_ATU_CNT) )
+		win_sz <<= 1;
+
+	if (win_sz > (bar_size / SIP7_ATU_CNT))
+		win_sz <<= 1;
+
+#ifdef DBG_CVOE
+	pr_err("atu win size = %x\n", win_sz);
+#endif
+	return win_sz;
+}
+
+static int find_interrupt_slot(unsigned int irq, bool warn)
+{
+	struct interrupt_slot *sl;
+
+	DBGL("start");
+	hash_for_each_possible_rcu(mvIntDrv_slots_hash, sl, irq_hash_list, irq) {
+		if ( (sl->irq == irq) && (sl->state == IRQ_SLOT_STATE_ALLOCATED) )
+			return sl-mvIntDrv_slots;
+	}
+
+	if (warn)
+		printk(KERN_WARNING "%s: No slot allocated for IRQ %d\n",
+		       MV_DRV_NAME, irq);
+
+	DBGL("end");
+	return -ENOENT;
+}
+
+static irqreturn_t prestera_tl_ISR(int irq, void *param)
+{
+	struct tasklet_struct *tl = (struct tasklet_struct *)param;
+	struct interrupt_slot *sl = (struct interrupt_slot *)tl->data;
+
+	BUG_ON(!sl);
+
+    /* handle last interrupt after process termination
+     * disregarding to (sl->state==IRQ_SLOT_STATE_ALLOCATED)
+     */
+	atomic_dec(&sl->depth);
+	/* Disable the interrupt vector */
+	disable_irq_nosync(irq);
+	/* Enqueue the PP task BH in the tasklet */
+	tasklet_hi_schedule(tl);
+
+	return IRQ_HANDLED;
+}
+
+void mvPresteraBh(unsigned long data)
+{
+	/* Awake any reading process */
+	up(&((struct interrupt_slot *)data)->sem);
+#ifdef DBG_CVOE
+	pr_info("mvPresteraBh: irq %u offset %u\n",
+		((struct interrupt_slot *)data)->irq,
+		((struct interrupt_slot *)data)->irq_offset);
+#endif
+}
+
+/**
+ *	alloc_interrupt_slot - Allocate interupt slot
+ *	@irq: Interrupt number
+ *
+ *	Allocates and initialize interupt slot
+ *
+ *	Returns the index of the entry in interrupts array
+ */
+static unsigned int alloc_interrupt_slot(unsigned int irq, unsigned irq_offset, struct pci_dev *pdev)
+{
+	struct interrupt_slot *sl;
+	int slot, ret;
+
+	DBGL("start");
+	mutex_lock(&alloc_mtx);
+
+	for (slot = 0; slot < MAX_INTERRUPTS; slot++)
+		if ( (mvIntDrv_slots[slot].state == IRQ_SLOT_STATE_READY_FOR_REALLOCATION) &&
+		     (mvIntDrv_slots[slot].irq == irq) ) {
+			/* Interrupt was already allocated to a killed process. Just reuse it without requesting
+			   IRQ again. IRQ is already disabled so no need to disable it now: */
+			sl = &(mvIntDrv_slots[slot]);
+			sl->irq = irq;
+			pr_info("Performing irq %d reallocation...\n", sl->irq);
+			sema_init(&sl->sem, 0);
+			sema_init(&sl->close_sem, 0);
+			up(&sl->close_sem);
+			tasklet_init(&sl->tasklet, mvPresteraBh,
+				     (unsigned long)sl);
+			atomic_set(&sl->depth, -1);
+			sl->state = IRQ_SLOT_STATE_ALLOCATED;
+			mutex_unlock(&alloc_mtx);
+			return slot;
+
+		}
+
+	for (slot = 0; slot < MAX_INTERRUPTS; slot++)
+		if (mvIntDrv_slots[slot].state == IRQ_SLOT_STATE_UNALLOCATED) {
+			sl = &(mvIntDrv_slots[slot]);
+			sl->irq = irq;
+			sl->irq_offset = irq_offset;
+			sl->pdev = pdev;
+			DBGL("before iomap");
+			if (pdev) {
+				DBGL("before pci enable");
+				ret = pci_enable_device(pdev);
+				if (ret) {
+					mutex_unlock(&alloc_mtx);
+					pr_err("Cannot enable pci device, %d\n", ret);
+					return MAX_INTERRUPTS;
+				}
+				sl->bar2 = pci_iomap(pdev, 2, 0);
+				if (!sl->bar2) {
+					mutex_unlock(&alloc_mtx);
+					pr_err("Cannot pci iomap bar 2!\n");
+					return MAX_INTERRUPTS;
+				}
+				sl->msi_x_client = sl->bar2 + (MSI_X_CLIENT_ATU_WIN_NUM * get_atu_win_size(pdev, 2));
+				DBGL("after iomap");
+			}
+			sema_init(&sl->sem, 0);
+			sema_init(&sl->close_sem, 0);
+			up(&sl->close_sem);
+			tasklet_init(&sl->tasklet, mvPresteraBh,
+				     (unsigned long)sl);
+			DBGL("before request irq");
+			ret = request_irq(irq, prestera_tl_ISR, IRQF_SHARED,
+					MV_DRV_NAME, (void *)&sl->tasklet);
+			if (ret) {
+				pr_err("Can not assign IRQ %u to mvIntDrv, err %d\n",
+				      irq, ret);
+				mutex_unlock(&alloc_mtx);
+				return MAX_INTERRUPTS;
+			}
+			atomic_set(&sl->depth, -1);
+			disable_irq(irq);
+			hash_add_rcu(mvIntDrv_slots_hash, &sl->irq_hash_list, sl->irq);
+			DBGL("before MSIX clr");
+			CLR_MSI_X_SRC(sl);
+			sl->state = IRQ_SLOT_STATE_ALLOCATED;
+			mutex_unlock(&alloc_mtx);
+			DBGL("OK");
+			return slot;
+		}
+
+	mutex_unlock(&alloc_mtx);
+	DBGL("MAX");
+	return MAX_INTERRUPTS;
+}
+
+static void synch_irq_state(struct interrupt_slot *sl, int target_value)
+{
+	while (atomic_read(&sl->depth) < (target_value < 0 ? target_value : 0)) {
+		atomic_inc(&sl->depth);
+		enable_irq(sl->irq);
+	}
+
+	while (atomic_read(&sl->depth) > (target_value > 0 ? target_value : 0)) {
+		atomic_dec(&sl->depth);
+		disable_irq(sl->irq);
+	}
+}
+
+/**
+ *	free_interrupt_slot - Free interupt slot
+ *	@slot: Index of an entry in interrupt array to free
+ *
+ *	Undoes all the steps of slot allocation
+ *
+ *	Note: This function assumes sl->irq is in "disable" state
+ */
+static void free_interrupt_slot(int slot)
+{
+	struct interrupt_slot *sl = &(mvIntDrv_slots[slot]);
+
+	down(&sl->close_sem);
+	/* In inconsistent state (ex race between disable_irq in ISR and
+	   disable_irq in release event) synch to stable state before freeing
+	   the IRQ. IRQ must be disabled at the end. */
+	synch_irq_state(sl, -1);
+	up(&sl->close_sem);
+	if (!msi_used) { /* MSI wil BUG() the kernel unless free_irq() is called */
+		pr_info("Leaving irq %d ready for reallocation...\n", sl->irq);
+		tasklet_kill(&(sl->tasklet));
+		sl->state = IRQ_SLOT_STATE_READY_FOR_REALLOCATION;
+		return;
+	}
+
+	free_irq(sl->irq, (void*)&(sl->tasklet));
+	tasklet_kill(&(sl->tasklet));
+	sl->state = IRQ_SLOT_STATE_UNALLOCATED;
+	sl->irq = 0;
+	sl->irq_offset = 0;
+	if (sl->pdev) {
+		if (sl->bar2)
+			iounmap(sl->bar2);
+		sl->pdev = NULL;
+		sl->bar2 = NULL;
+		sl->msi_x_client = NULL;
+	}
+	hash_del_rcu(&sl->irq_hash_list);
+}
+
+static int intConnect(unsigned int irq, unsigned irq_offset, struct pci_dev *pdev)
+{
+	int slot;
+
+	DBGL("start");
+	if (pdev) {
+		irq = pci_irq_vector(pdev, irq_offset);
+#ifdef DBG_CVOE
+		pr_info("%s: irq_offset %u ==> irq %u\n", __func__, irq_offset, irq);
+#endif
+	}
+	slot = find_interrupt_slot(irq, false);
+	if (slot != -ENOENT) {
+		printk(KERN_ERR "%s: irq number %d already connected\n",
+		       MV_DRV_NAME, irq);
+		return -EINVAL;
+	}
+
+	DBGL("before alloc");
+	slot = alloc_interrupt_slot(irq, irq_offset, pdev);
+	if (unlikely(slot == MAX_INTERRUPTS)) {
+		printk(KERN_ERR "%s: no free slots\n", __func__);
+		return -EFAULT;
+	}
+
+	DBGL("after alloc");
+	printk(KERN_DEBUG "%s: connected IRQ - %u slot %d\n", __func__, irq,
+	       slot);
+
+	return slot + 1;
+}
+
+static int intDisConnect(unsigned int irq)
+{
+	int slot;
+
+	slot = find_interrupt_slot(irq, true);
+	if (slot == -ENOENT)
+		return -EINVAL;
+
+	/*
+	 * free_interrupt_slot assumes that IRQ state is disabled so userspace
+	 * must ensure this before triggering disconnect
+	 */
+	free_interrupt_slot(slot);
+	printk(KERN_DEBUG "%s: disconnected IRQ - %u slot %d\n", __func__, irq,
+	       slot);
+
+	return slot;
+}
+
+static int mvintdrv_pdev_enable_msi(struct pci_dev *pdev, unsigned count)
+{
+	int rc;
+	unsigned int flags;
+
+	DBGL("start");
+	msi_used = true;
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4,8,0)
+	dev_info(&pdev->dev, "Enabling MSI, legacy IRQ number is %d\n",
+		 pci_irq_vector(pdev, 0));
+#else
+	dev_info(&pdev->dev, "Enabling MSI, legacy IRQ number is %d\n",
+		 pdev->irq);
+#endif
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4,9,0)
+	flags = (count > 32 ? PCI_IRQ_MSIX : (count > 1 ? PCI_IRQ_MSI : PCI_IRQ_ALL_TYPES));
+	dev_info(&pdev->dev, "pci_msi_vec_count() = %d\n", pci_msi_vec_count(pdev));
+	rc = pci_alloc_irq_vectors_affinity(pdev, 1, count, flags, NULL);
+	if (rc != count)
+		dev_err(&pdev->dev, "pci_alloc_irq_vectors() returned %d! count = %u flag = %x\n",
+			rc, count, flags);
+	rc = rc >= 1 ? 0 : -1;
+#else
+	WARN_ON(count > 1);
+	rc = pci_enable_msi(pdev);
+#endif
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4,8,0)
+	dev_info(&pdev->dev, "MSI IRQ number is %d (requested %u)\n", (rc < 0) ? -1 :
+		 pci_irq_vector(pdev, 0), count);
+#else
+	dev_info(&pdev->dev, "MSI IRQ number is %d\n", (rc < 0) ? -1 :
+		 pdev->irq);
+#endif
+	DBGL("end");
+
+	return rc;
+}
+
+static int mvintdrv_enable_msi(struct file *f, int domain, unsigned int bus,
+			       unsigned int dev, unsigned int func, unsigned count)
+{
+#ifdef CONFIG_PCI_MSI
+	struct mvintdrv_pci_dev *mv_pdev;
+	struct pci_dev *pdev;
+
+	DBGL("start");
+	msi_used = true;
+#ifdef DBG_CVOE
+	pr_err("mvintdrv_enable_msi cnt %x\n", count);
+#endif
+	pdev = pci_get_domain_bus_and_slot(domain, bus, PCI_DEVFN(dev, func));
+	if (pdev) {
+		struct mvintdrv_file_priv *priv;
+		int rc;
+
+		priv = (struct mvintdrv_file_priv *)f->private_data;
+		if (pci_dev_msi_enabled(pdev)) {
+			printk(KERN_DEBUG "%s: MSI already enabled\n",
+			       MV_DRV_NAME);
+			pci_dev_put(pdev);
+			return 0;
+		}
+
+		rc = mvintdrv_pdev_enable_msi(pdev, count);
+		if (!rc) {
+			/*
+			 * Add to global list so we can disable MSI on driver
+			 * driver exit
+			 */
+			mv_pdev = kmalloc(sizeof(*mv_pdev), GFP_KERNEL);
+			mv_pdev->pdev = pdev;
+			list_add(&mv_pdev->list, &priv->msi_enabled_pdevs);
+		} else {
+			pci_dev_put(pdev);
+		}
+
+		return rc;
+	} else {
+		printk(KERN_ERR "%s: Fail to find PCI device\n", MV_DRV_NAME);
+		return -EINVAL;
+	}
+#else
+	printk(KERN_ERR "%s: MSI requested however CONFIG_PCI_MSI is not enabled in the kernel build\n",
+	       MV_DRV_NAME);
+	return -EIO;
+#endif
+}
+
+/**
+ * Call the proper function to disable MSI according to kernel version in use
+ */
+static void mvintdrv_pdev_disable_msi(struct pci_dev *pdev)
+{
+	dev_info(&pdev->dev, "Disabling MSI\n");
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4,9,0)
+	pci_free_irq_vectors(pdev);
+#else
+	pci_disable_msi(pdev);
+#endif
+}
+
+/**
+ * Disable MSI for all devices of a given file descriptor, called when file
+ * descriptor is closed
+ */
+static void mvintdrv_disable_msi_devs(struct file *f)
+{
+#ifdef CONFIG_PCI_MSI
+	struct mvintdrv_file_priv *priv =
+		(struct mvintdrv_file_priv *)f->private_data;
+	struct list_head *p, *q;
+
+	list_for_each_safe(p, q, &(priv->msi_enabled_pdevs)) {
+		struct mvintdrv_pci_dev *mv_pdev;
+		mv_pdev = list_entry(p, struct mvintdrv_pci_dev, list);
+		mvintdrv_pdev_disable_msi(mv_pdev->pdev);
+		pci_dev_put(mv_pdev->pdev);
+		list_del(p);
+		kfree(mv_pdev);
+	}
+#endif
+}
+
+/**
+ * Disable MSI for device identified by DBDF
+ */
+static int mvintdrv_disable_msi(int domain, unsigned int bus, unsigned int dev,
+				unsigned int func)
+{
+#ifdef CONFIG_PCI_MSI
+	struct pci_dev *pdev;
+
+	pdev = pci_get_domain_bus_and_slot(domain, bus, PCI_DEVFN(dev, func));
+	if (pdev) {
+		mvintdrv_pdev_disable_msi(pdev);
+		pci_dev_put(pdev);
+		return 0;
+	} else {
+		printk(KERN_ERR "%s: Fail to find PCI device %d:%d:%d.%d\n",
+		       MV_DRV_NAME, domain, bus, dev, func);
+		return -EINVAL;
+	}
+#else
+	printk(KERN_ERR "%s: MSI requested however CONFIG_PCI_MSI is not enabled in the kernel build\n",
+	       MV_DRV_NAME);
+	return -EIO;
+#endif
+}
+
+static ssize_t mvIntDrv_write(struct file *f, const char *buf, size_t siz, loff_t *off)
+{
+	struct interrupt_slot *sl;
+	unsigned int irq = -1;
+	char cmdBuf[16] = { 0 };
+#ifdef DBG_CVOE
+	char dbgs[16];
+#endif
+	int slot;
+
+	/* Write 2 bytes:
+	 * 'c' intNo       - connect interrupt, returns slot+1
+	 * 'd' intNo       - disable interrupt
+	 * 'e' intNo       - enable interrupt
+	 * 'q' intNo       - query interrupt, whether other drivers are still
+	 *                   attached to it
+	 * 'C' i i i i     - connect interrupt, returns slot+1
+	 * 'P' i i i i s s domain, bus, dev func - connect 32-bit MSI-X interrupt number,
+						   followed by 16-bit interrupt offset from PP first one,
+						   and finally DBDF. returns slot+1
+	 * 'R' i i i i     - remove interrupt, returns slot+1
+	 * 'D' i i i i     - disable interrupt
+	 * 'E' i i i i     - enable interrupt
+	 * 'Q' i i i i     - query interrupt, whether other drivers are still
+	 *                   attached to it
+	 * 'm' bus, dev func - enable MSI interrupts for pci device
+	 * 'M' domain, bus, dev func - enable MSI interrupts for pci device
+	 * 's' bus, dev func - disable MSI/X interrupts for pci device
+	 * 'S' domain, bus, dev func - disable MSI/X interrupts for pci device
+	 *
+	 * 'x' bus, dev func, num - enable 'num' MSI-X interrupts for pci device
+	 * 'X' domain, bus, dev func, num - enable 'num' MSI-X interrupts for pci device
+	 * note: num is encoded as 16-bit unsigned short
+	 *
+	 * return <!0 - error, slot for connect, 0 for enable/disable, 0/1 for Q
+	 * (query) */
+
+	if (copy_from_user(cmdBuf, buf, ((siz < 16) ? siz : 16))) {
+		printk(KERN_ERR "%s: EFAULT\n", __func__);
+		return -EFAULT;
+	}
+#ifdef DBG_CVOE
+	memcpy(dbgs, cmdBuf, 16);
+	dbgs[15]='\0';
+#endif
+	DBGL(dbgs);
+
+	switch (cmdBuf[0]) {
+	case 'c':
+		/* Fall through */
+	case 'd':
+		/* Fall through */
+	case 'e':
+		/* Fall through */
+	case 'r':
+		/* Fall through */
+	case 'q':
+		irq = (unsigned int)cmdBuf[1];
+		break;
+	case 'C':
+		/* Fall through */
+	case 'D':
+		/* Fall through */
+	case 'E':
+		/* Fall through */
+	case 'R':
+		/* Fall through */
+	case 'Q':
+		/* Fall through */
+	case 'P':
+		memcpy(&irq, cmdBuf + 1, 4);
+		break;
+	}
+
+	printk(KERN_DEBUG "%s: %c(%x, %x, %x, %x, %x, %x, %x, %x, %x, %x, %x)\n", MV_DRV_NAME, cmdBuf[0],
+	       cmdBuf[1], cmdBuf[2], cmdBuf[3], cmdBuf[4], cmdBuf[5], cmdBuf[6], cmdBuf[7], cmdBuf[8],
+		cmdBuf[9], cmdBuf[10], cmdBuf[11]);
+
+	if (cmdBuf[0] == 'P') {
+
+		struct pci_dev *pdev;
+
+		pdev = pci_get_domain_bus_and_slot(
+						(((cmdBuf[8]<<8)&0xff00) |
+						(cmdBuf[7]&0xff)),
+						(unsigned)cmdBuf[9],
+						PCI_DEVFN(
+						(unsigned)cmdBuf[10],
+						(unsigned)cmdBuf[11]));
+
+		return intConnect(irq, *(unsigned short *)&cmdBuf[5], pdev);
+	}
+
+	if (cmdBuf[0] == 'c' || cmdBuf[0] == 'C')
+		return intConnect(irq, 0, NULL);
+
+	if (cmdBuf[0] == 'r' || cmdBuf[0] == 'R')
+		return intDisConnect(irq);
+
+	if (cmdBuf[0] == 'd' || cmdBuf[0] == 'D') {
+		slot = find_interrupt_slot(irq, true);
+		if (slot == -ENOENT)
+			return -EINVAL;
+		sl = &(mvIntDrv_slots[slot]);
+		atomic_dec(&sl->depth);
+		disable_irq(irq);
+		return 0;
+	}
+
+	if (cmdBuf[0] == 'e' || cmdBuf[0] == 'E') {
+		slot = find_interrupt_slot(irq, true);
+		if (slot == -ENOENT)
+			return -EINVAL;
+		sl = &(mvIntDrv_slots[slot]);
+		atomic_inc(&sl->depth);
+		enable_irq(irq);
+		return 0;
+	}
+
+	if (cmdBuf[0] == 'm')
+		return mvintdrv_enable_msi(f, 0, (unsigned)cmdBuf[1],
+					   (unsigned)cmdBuf[2],
+					   (unsigned)cmdBuf[3], 1);
+
+	if (cmdBuf[0] == 'M')
+		return mvintdrv_enable_msi(f, (((cmdBuf[2]<<8)&0xff00) |
+					   (cmdBuf[1]&0xff)),
+					   (unsigned)cmdBuf[3],
+					   (unsigned)cmdBuf[4],
+					   (unsigned)cmdBuf[5], 1);
+
+	if (cmdBuf[0] == 'x')
+		return mvintdrv_enable_msi(f, 0, (unsigned)cmdBuf[1],
+					   (unsigned)cmdBuf[2],
+					   (unsigned)cmdBuf[3],
+					   *(unsigned short *)(&cmdBuf[4]));
+
+	if (cmdBuf[0] == 'X')
+		return mvintdrv_enable_msi(f, (((cmdBuf[2]<<8)&0xff00) |
+					   (cmdBuf[1]&0xff)),
+					   (unsigned)cmdBuf[3],
+					   (unsigned)cmdBuf[4],
+					   (unsigned)cmdBuf[5],
+					   *(unsigned short *)(&cmdBuf[6]));
+
+	if (cmdBuf[0] == 's')
+		return mvintdrv_disable_msi(0, (unsigned)cmdBuf[1],
+					    (unsigned)cmdBuf[2],
+					    (unsigned)cmdBuf[3]);
+
+	if (cmdBuf[0] == 'S')
+		return mvintdrv_disable_msi((((cmdBuf[2]<<8)&0xff00) |
+					   (cmdBuf[1]&0xff)),
+					   (unsigned)cmdBuf[3],
+					   (unsigned)cmdBuf[4],
+					   (unsigned)cmdBuf[5]);
+
+	if (cmdBuf[0] == 'q' || cmdBuf[0] == 'Q')
+		return find_interrupt_slot(irq, false) != -ENOENT;
+
+	printk(KERN_ERR "%s: Invalid command '%c'\n", MV_DRV_NAME, cmdBuf[0]);
+
+	return -EINVAL;
+}
+
+static ssize_t mvIntDrv_read(struct file *f, char *buf, size_t siz, loff_t *off)
+{
+	struct interrupt_slot *sl;
+	int slot = (int)siz - 1;
+
+	DBGL("start");
+	if (slot < 0 || slot >= MAX_INTERRUPTS) {
+		DBGL("bad slot id range");
+		return -EINVAL;
+	}
+
+        DBGL("slot range OK");
+	sl = &(mvIntDrv_slots[slot]);
+	if (sl->state != IRQ_SLOT_STATE_ALLOCATED) {
+		DBGL("bad slot");
+		return -EINVAL;
+	}
+
+	DBGL("slot OK");
+	/*
+	 * MSI-X - write the ID MASK offset with the irq offset in the switch
+	 *	   irq list to clear the MSI-X source, so it can be generated
+	 *	   again:
+	 */
+	CLR_MSI_X_SRC(sl);
+
+	/* Enable the interrupt vector */
+	atomic_inc(&sl->depth);
+	enable_irq(sl->irq);
+
+	DBGL("get sem");
+	if (down_interruptible(&sl->sem)) {
+		down(&sl->close_sem);
+		atomic_dec(&sl->depth);
+		disable_irq(sl->irq);
+		up(&sl->close_sem);
+		DBGL("EINTR");
+		return -EINTR;
+	}
+
+	DBGL("done OK");
+#ifdef DBG_CVOE
+	pr_info("read handler: irq %u offset %u\n", sl->irq, sl->irq_offset);
+#endif
+	return 0;
+}
+
+static int mvIntDrv_open(struct inode *inode, struct file *file)
+{
+	struct mvintdrv_file_priv *priv;
+
+	atomic_inc(&mvIntDrvNumOpened);
+	DBGL("start");
+
+	priv = kmalloc(sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	INIT_LIST_HEAD(&priv->msi_enabled_pdevs);
+
+	file->private_data = priv;
+
+	return 0;
+}
+
+static int mvIntDrv_release(struct inode *inode, struct file *file)
+{
+	if (atomic_dec_and_test(&mvIntDrvNumOpened)) {
+		/* Cleanup */
+		int slot;
+		struct interrupt_slot *sl;
+
+		for (slot = 0; slot < MAX_INTERRUPTS; slot++) {
+			sl = &(mvIntDrv_slots[slot]);
+			if (sl->state != IRQ_SLOT_STATE_ALLOCATED)
+				continue;
+			/* free_interrupt_slot assumes that IRQ state is disabled and we are cool
+			 * with that since in both cases, waiting for interrupt or servicing an
+			 * interrupt - IRQ is disabled.
+			 * In abnormal case where the process dies while waiting for interrupt,
+			 * the down_interruptible will exits and disable_irq will be called. On
+			 * the other hand, the ISR function make sure the IRQ is disabled while
+			 * servicing an interrupt */
+			free_interrupt_slot(slot);
+		}
+	}
+
+	mvintdrv_disable_msi_devs(file);
+
+	kfree(file->private_data);
+
+	return 0;
+}
+
+static struct file_operations mvIntDrv_fops = {
+	.read = mvIntDrv_read,
+	.write = mvIntDrv_write,
+	.open = mvIntDrv_open,
+	.release = mvIntDrv_release /* A.K.A close */
+};
+
+void mvintdrv_exit(void)
+{
+	int slot;
+
+	struct interrupt_slot *sl;
+
+	/*
+	* Clean ready for reallocation irq entries and free them,
+	* in order to avoid kernel WARN on reboot
+	*/
+	for (slot = 0; slot < MAX_INTERRUPTS; slot++) {
+		sl = &(mvIntDrv_slots[slot]);
+		if (sl->state == IRQ_SLOT_STATE_READY_FOR_REALLOCATION) {
+			free_irq(sl->irq, (void*)&(sl->tasklet));
+			tasklet_kill(&(sl->tasklet));
+			sl->state = IRQ_SLOT_STATE_UNALLOCATED;
+			sl->irq = 0;
+		}
+	}
+
+	mvchrdev_cleanup(chrdrv_ctx);
+	kfree(mvIntDrv_slots);
+}
+
+int mvintdrv_init(void)
+{
+	chrdrv_ctx = mvchrdev_init(MV_DRV_NAME, &mvIntDrv_fops);
+	if (!chrdrv_ctx)
+		return -EIO;
+
+	mvIntDrv_slots = kmalloc_array(MAX_INTERRUPTS, sizeof(struct interrupt_slot),
+					GFP_KERNEL | __GFP_ZERO);
+
+	if (!mvIntDrv_slots)
+		return -ENOMEM;
+
+	hash_init(mvIntDrv_slots_hash);
+	return 0;
+}
