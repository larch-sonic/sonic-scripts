+
+    if alert > 0:
+        result = 'Warning'
+    else:
+        result = 'Normal'
+
+    return result
+
+DEVICE_INIT = {'led': [['set', 'sys_led', 'green'], ['set', 'pwr_led', 'green'], ['set', 'fan_led', 'green']]}
+def deviceInit():
