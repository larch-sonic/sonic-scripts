+            cmdstatus, register = cmd.getstatusoutput('sudo i2cget -y 0 0x33 0x6')
+            if cmdstatus:
+                sonic_logger.log_warning("sfp cmdstatus i2c get failed %s" % register )
+                return False
+            register = int(register, 16)
+        else:
+            bus = smbus.SMBus(0)
+            DEVICE_ADDRESS = 0x33
+            DEVICE_REG = 0x6
+            register = bus.read_byte_data(DEVICE_ADDRESS, DEVICE_REG)
+
+        register = register & (1 << (self.port_num-SFP_PORT_START))
+        if register == 0:
+            return False
+
+        return True
