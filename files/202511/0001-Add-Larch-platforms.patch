@@ -0,0 +1,63 @@
+#!/bin/bash
+# cli_proxy - enable or disable the SONiC CLI proxy service
+#
+# Usage: cli_proxy enable|disable|status
+#
+# When disabled, 'show' and 'config' commands bypass the proxy and run
+# the real sonic-utilities commands directly. This is useful for community
+# SONiC test suites that require a stable CLI without proxy-related errors.
+#
+# By default, the CLI proxy is enabled. In-process child CLI optimization is
+# controlled by SHOW_PROXY_INPROCESS_AS_DAEMON in sonic-utilities-proxy.service
+# (enabled by default there). When set, matched intfutil/portstat run as the
+# daemon user, not as the CLI caller. Disable via: systemctl edit <service>
+
+set -euo pipefail
+
+CLI_PROXY_DISABLED_FLAG="/etc/sonic/.cli_proxy_disabled"
+PROXY_SERVICE="sonic-utilities-proxy.service"
+
+usage() {
+    echo "Usage: $0 {enable|disable|status}"
+    echo ""
+    echo "  enable   - Enable the CLI proxy (default behavior)"
+    echo "  disable  - Disable the CLI proxy; show/config run directly"
+    echo "  status   - Show current CLI proxy state"
+    exit 1
+}
+
+if [[ $# -ne 1 ]]; then
+    usage
+fi
+
+case "$1" in
+    enable)
+        rm -f "$CLI_PROXY_DISABLED_FLAG"
+        systemctl start "$PROXY_SERVICE" 2>/dev/null || true
+        echo "CLI proxy enabled."
+        ;;
+    disable)
+        touch "$CLI_PROXY_DISABLED_FLAG"
+        echo "CLI proxy disabled. 'show' and 'config' will run directly."
+        ;;
+    status)
+        if [[ -f "$CLI_PROXY_DISABLED_FLAG" ]]; then
+            echo "CLI proxy: disabled"
+        else
+            if systemctl is-active --quiet "$PROXY_SERVICE" 2>/dev/null; then
+                echo "CLI proxy: enabled (service running)"
+            else
+                echo "CLI proxy: enabled (service not running)"
+            fi
+            if systemctl show -p Environment "$PROXY_SERVICE" 2>/dev/null \
+                | grep -qE 'SHOW_PROXY_INPROCESS(_AS_DAEMON|_UNSAFE)?=1'; then
+                echo "CLI proxy: in-process child CLIs as daemon user (see service unit)"
+            else
+                echo "CLI proxy: per-user sudo subprocesses (in-process disabled)"
+            fi
+        fi
+        ;;
+    *)
+        usage
+        ;;
+esac
