+#!/usr/bin/env python3
+
+import sys
+from sonic_py_common import logger
+
+# Define CPLD device mapping
+CPLD_CONFIG = {
+    'A': {'addr': 0x74, 'bus': 5, 'regs': [(13, 20, 0x17), (21, 28, 0x18), (29, 36, 0x19), (37, 40, 0x1A)]},
+    'B': {'addr': 0x75, 'bus': 6, 'regs': [(1, 8, 0x22), (9, 12, 0x23)]},
+    'C': {'addr': 0x76, 'bus': 7, 'regs': [(41, 48, 0x12), (49, 56, 0x14)]}
+}
+
+# LED color mapping based on link speed
+SPEED_TO_LED = {
+    '1000': 1, '10000': 1, '25000': 0,
+    '100000': 0, '50000': 0, '40000': 1, '20000': 1
+}
+
+SYSLOG_IDENTIFIER = "led"
+sonic_logger = logger.Logger(SYSLOG_IDENTIFIER)
+
+
+def get_sysfs_path(bus, addr):
+    # Convert to bus-addr format used in sysfs (e.g., 5-0074)
+    return f"/sys/bus/i2c/drivers/hwmon_cpld/{bus}-{addr:04x}/reg_rw"
+
+
+def read_i2c_byte(bus, addr, reg):
+    path = get_sysfs_path(bus, addr)
+    try:
+        # Write the register to access
+        with open(path, "w") as f:
+            f.write(f"0x{reg:X}\n")  # write to set current_reg
+
+        # Read the value
+        with open(path, "r") as f:
+            value = f.read().strip()
+        return int(value, 16)
+    except Exception as e:
+        raise IOError(f"sysfs read failed at {path} reg 0x{reg:X}: {e}")
+
+
+def write_i2c_byte(bus, addr, reg, value):
+    path = get_sysfs_path(bus, addr)
+    try:
+        with open(path, "w") as f:
+            f.write(f"0x{reg:X} 0x{value:X}\n")
+    except Exception as e:
+        raise IOError(f"sysfs write failed at {path} reg 0x{reg:X}: {e}")
+
+
+def set_port_led_color(port_name: str, port_speed: str):
+    sonic_logger.log_info(f"Configure LED for {port_name} ({port_speed})")
+
+    try:
+        port_num = int(port_name.replace('Ethernet', ''))
+    except ValueError:
+        raise ValueError(f"Invalid port name format: {port_name}")
+
+    if port_speed not in SPEED_TO_LED:
+        raise ValueError(f"Unsupported port speed: {port_speed}")
+
+    if port_num > 48:
+        port_num = 48 + (port_num - 48) // 4
+
+    port_num += 1
+    led_color = SPEED_TO_LED[port_speed]
+
+    for cpld, cfg in CPLD_CONFIG.items():
+        for start, end, reg in cfg['regs']:
+            if start <= port_num <= end:
+                bit_offset = port_num - start
+                i2c_bus = cfg['bus']
+                i2c_addr = cfg['addr']
+
+                try:
+                    current_value = read_i2c_byte(i2c_bus, i2c_addr, reg)
+                    if led_color:
+                        new_value = current_value | (1 << bit_offset)
+                    else:
+                        new_value = current_value & ~(1 << bit_offset)
+                    write_i2c_byte(i2c_bus, i2c_addr, reg, new_value)
+                    sonic_logger.log_info(f"Set LED for {port_name} ({port_speed}) on CPLD {cpld}: 0x{new_value:02X}")
+                    return
+                except Exception as e:
+                    raise IOError(f"sysfs I2C access failed for {port_name} on bus {i2c_bus}, addr 0x{i2c_addr:02X}, reg 0x{reg:02X}: {e}")
+    raise ValueError(f"Port {port_name} does not map to a known CPLD register")
