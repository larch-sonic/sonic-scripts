+			       arg3);
+			iowrite32(arg3, ppdev->pdev.bar0 + ATU_OFFS + arg1 *
+				  0x0200 + arg2);
+			break;
+
+		case 0x2:
+			if (argc != 2) {
+				printk("Expecting 1 arg (print_packets_interval)\n");
+				return -EINVAL;
+			}
+			ppdev->print_packets_interval = arg1;
+			break;
+
+		default:
+			printk("Invalid command 0x%x\n", cmd);
+			return -EINVAL;
