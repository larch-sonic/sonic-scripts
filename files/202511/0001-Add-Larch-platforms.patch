+class _InProcessPopen:
+    """Small Popen-compatible object for cached Python child CLIs."""
+
+    def __init__(self, args, *pargs, **kwargs):
+        self.args = args
+        self.returncode = None
+        self._text_mode = bool(kwargs.get('text') or kwargs.get('universal_newlines'))
+        self._stdout_pipe_requested = kwargs.get('stdout') == subprocess.PIPE
+        self._stderr_pipe_requested = kwargs.get('stderr') == subprocess.PIPE
+        self._stdout_value = ''
+        self._stderr_value = ''
+        self.stdout = None
+        self.stderr = None
+        self._run(args)
+
+    def _run(self, args) -> None:
+        argv = [str(arg) for arg in list(args)]
+        payload = _run_inprocess_child(argv, get_run_as_user())
+        self.returncode = payload["exit_code"]
+        self._stdout_value = payload["stdout"]
+        self._stderr_value = payload["stderr"]
+
+        if self._stdout_pipe_requested:
+            self.stdout = io.StringIO(self._stdout_value)
+        elif self._stdout_value:
+            sys.stdout.write(self._stdout_value)
+
+        if self._stderr_pipe_requested:
+            self.stderr = io.StringIO(self._stderr_value)
+        elif self._stderr_value:
+            # Write to fd 2 so _invoke_click_runner's dup2 capture stays in stderr.
+            try:
+                data = self._stderr_value
+                if isinstance(data, str):
+                    data = data.encode()
+                os.write(2, data)
+            except OSError:
+                pass
+
+    def communicate(self, input=None, timeout=None):
+        out = self._stdout_value if self._stdout_pipe_requested else None
+        err = self._stderr_value if self._stderr_pipe_requested else None
+        if not self._text_mode:
+            out = out.encode() if out is not None else None
+            err = err.encode() if err is not None else None
+        return out, err
+
+    def poll(self):
+        return self.returncode
+
+    def wait(self, timeout=None):
+        return self.returncode
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        return False
+
+    def terminate(self):
+        return None
+
+    def kill(self):
+        return None
+
+
+class _ProxyPopen(_OriginalPopen):
+    """Popen wrapper that uses cached child CLIs or runs as the caller."""
+
+    def __new__(cls, args, *pargs, **kwargs):
+        if _is_safe_inprocess_child(args, kwargs):
+            return _InProcessPopen(args, *pargs, **kwargs)
+        return super().__new__(cls)
+
+    def __init__(self, args, *pargs, **kwargs):
+        user = get_run_as_user()
+        if user:
+            if isinstance(args, list):
+                args = ['sudo', '-u', user] + list(args)
+            elif isinstance(args, str):
+                args = f'sudo -u {user} {args}'
+        super().__init__(args, *pargs, **kwargs)
+
