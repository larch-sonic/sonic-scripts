+static void mvppnd_save_mg_wins(struct mvppnd_dev *ppdev, long bitmask)
+{
+	int i, j;
+
+	memset(ppdev->mg_win, 0, sizeof(ppdev->mg_win));
+	for (i = 0, j = 0; i < NUM_OF_MG_WINDOWS; i++)
+		if (test_bit(i, &bitmask))
+			ppdev->mg_win[j++] = i;
+}
