index 000000000..7160752a4
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/dqs-5000/sysctl/zz-gemini-nmi.conf
@@ -0,0 +1,7 @@
+# Disable panic on unrecovered/unknown NMI for the Gemini platform.
+# During shutdown the PCH generates an NMI (reason 0x28/0x38) before the
+# hardware reset. Without this override the kernel panics unnecessarily.
+# Must be named zz-* to apply AFTER vmcore-sysctl.conf (v < z alphabetically).
+kernel.unknown_nmi_panic=0
+kernel.panic_on_unrecovered_nmi=0
+kernel.panic_on_io_nmi=0
