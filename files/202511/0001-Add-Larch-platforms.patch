+			mvppnd_read_reg(ppdev, REG_ADDR_VENDOR));
+		dev_dbg(ppdev->dev, "device: 0x%x\n",
+			mvppnd_read_reg(ppdev, REG_ADDR_DEVICE));
+		dev_dbg(ppdev->dev, "rxdesc: 0x%x\n",
+			mvppnd_read_reg(ppdev, REG_ADDR_RX_FIRST_DESC));
