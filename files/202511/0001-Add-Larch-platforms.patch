+        26: 27,
+        27: 28,
+        28: 29,
+        29: 30,
+        30: 31,
+        31: 32,
+        32: 33,
+        33: 34,
+        34: 35,
+        35: 36,
+        36: 37,
+        37: 38,
+        38: 39,
+        39: 40,
+        40: 41,
+        41: 42,
+        42: 43,
+        43: 44,
+        44: 45,
+        45: 46,
+        46: 47,
+        47: 48,
+        48: 49,
+        49: 50,
+        50: 51,
+        51: 52,
+        52: 53,
+        53: 54,
+        54: 55,
+        55: 56,
+    }
+
+    def __init__(self, index, sfp_type):
+        SfpOptoeBase.__init__(self)
+        self.sfp_type = sfp_type
+        self.port_type = sfp_type
+        self.index = index
+        p_num = self.port_to_i2c_mapping[self.index]
+        if (self.index < 12):
+            i2c_prs = '6-0075'
+            i2c_eep = '6-0050'
+        elif (self.index >= 12) and (self.index < 40):
+            i2c_prs = '5-0074'
+            i2c_eep = '5-0050'
+        else:
+            i2c_prs = '7-0076'
+            i2c_eep = '7-0050'
+
+        self.eeprom_path = EEPROM_PATH.format(i2c_eep, p_num)
+        self.prs_path    = PRS_PATH.format(i2c_prs, p_num)
+
+    def get_name(self):
+        return "QSFP28 or later" if self.sfp_type == 'QSFP' else "SFP/SFP+/SFP28"
+
+    def get_presence(self):
+        """
+        Retrieves the presence of the sfp
+        Returns : True if sfp is present and false if it is absent
+        """
+        try:
+            with open(self.prs_path, 'r') as sfp_presence:
+                presence = int(sfp_presence.read(), 16)
+            # we have inverted values, 0 means prence
+            if presence == 0:
+                presence = 1
+            else:
+                presence = 0
+
+        except IOError:
+            return False
+        return presence
+
+        return False
+
+    def get_reset_status(self):
+        """
+        Retrives the reset status of SFP
+        """
+        reset_status = False
+        return reset_status
+
+    def get_lpmode(self):
+        """
+        Retrieves the lpmode(low power mode) of this SFP
+        """
+        lpmode_state = False
+        return lpmode_state
+
+    def reset(self):
+        """
+        Reset the SFP and returns all user settings to their default state
+        """
+        return False
+
+    def set_lpmode(self, lpmode):
+        """
+        Sets the lpmode(low power mode) of this SFP
+        """
+        return False
+
+    def get_eeprom_path(self):
+        return self.eeprom_path
+
+    def get_transceiver_info(self):
+        port_info = None
+        try:
+            port_info = SfpOptoeBase.get_transceiver_info(self)
+        except NotImplementedError:
+            pass
+        if port_info is not None:
+            port_info['hardware_rev'] = 'N/A'
+        # Temporarily use eeprom stub info
+        if port_info is None and self.get_presence():
+            port_info = {
+                "type": self.get_name(),
+                "type_abbrv_name": 'N/A',
+                "vendor_rev": 'N/A',
+                "serial": 'N/A',
+                "manufacturer": 'N/A',
+                "model": 'N/A',
+                "connector": 'N/A',
+                "encoding": 'N/A',
+                "ext_identifier": 'N/A',
+                "ext_rateselect_compliance": 'N/A',
+                "cable_type": 'N/A',
+                "cable_length": 0,
+                "nominal_bit_rate": 'N/A',
+                "specification_compliance": 'N/A',
+                "vendor_date": 'N/A',
+                "vendor_oui": 'N/A',
+                "application_advertisement": "N/A",
+                "hardware_rev": 'N/A'
+            }
+
+
+        return port_info
+
+    def get_transceiver_threshold_info(self):
+        return None
+
+    def get_status(self):
+        """
+        Retrieves the operational status of the device
+        """
+        reset = self.get_reset_status()
+
+        if (reset == True):
+            status = False
+        else:
+            status = True
+
+        return status
+
