+    empty result for this platform.
+    """
+
+    def get_transceiver_dom_flags(self):
+        raise NotImplementedError
+
+    def get_transceiver_dom_real_value(self):
+        raise NotImplementedError
+
+    def get_transceiver_status_flags(self):
+        raise NotImplementedError
+
+    def get_transceiver_vdm_flags(self):
