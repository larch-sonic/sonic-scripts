+class SetFanSpeedAction(ThermalPolicyActionBase):
+   JSON_FIELD_SPEED = "speed"
+
+   def __init__(self):
+      self.speed = None
+
+   def load_from_json(self, json_obj):
+      if self.JSON_FIELD_SPEED in json_obj:
+         speed = float(json_obj[self.JSON_FIELD_SPEED])
