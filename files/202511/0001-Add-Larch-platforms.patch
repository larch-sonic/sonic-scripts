@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+"""
+Split (breakout) LEDs for ln4332z4-v7 (Silicom MHO-200).
+
+Each QSFP-DD port has a Link/ACT LED (top) and a Split LED (bottom). This
+lights the Split LED of every split port (CPLD IO 0x1A-0x1B, amber).
+
+The CPLDs also have a lane mode (HW Programmer Guide 5.4): CTRL 0x10 bit 4
+enables the /1../4 lane LEDs and the cycle button, CTRL 0x13-0x16 mark
+ports split with 2 lanes per sub-port, and IO 0x16-0x17 make the port's
+Link/ACT LED show the selected lane. On the board that Link/ACT LED stays
+amber on every lane whatever the Falcon LED stream carries, so lane mode
+is kept off (Link/ACT shows the first sub-port) until Silicom tells which
+stream data the CPLD expects. IO 0x16-0x17 do not light the Split LED.
+
+A port is split when CONFIG_DB has more than one PORT entry with its panel
+index. The table is polled, so the LEDs follow breakout changes and
+config reload.
+"""
+
+import logging
+import logging.handlers
+import sys
+import time
+
+from swsscommon.swsscommon import ConfigDBConnector
+from sonic_platform import cpld
+
+INTERVAL = 5
+NUM_QSFP = 32
+
+log = logging.getLogger("split_led")
+
+
+def split_ports(ports):
+    """Set of the split panel ports."""
+    subports = {}
+    for entry in ports.values():
+        try:
+            index = int(entry["index"])
+        except (KeyError, ValueError):
+            continue
+        subports[index] = subports.get(index, 0) + 1
+    return {i for i, n in subports.items() if n > 1}
+
+
+def mask(ports, first, count=8):
+    """Bits of ports first..first+count-1, bit 0 = port first."""
+    return sum(1 << (p - first) for p in ports if first <= p < first + count)
+
+
+def registers(split):
+    """{(sysfs dir, attribute): value} the CPLDs need for these ports."""
+    regs = {}
+    ctrl = cpld.ctrl_cpld()
+    if ctrl:
+        # lane mode off (see above)
+        regs[(ctrl, "split_enable")] = 0
+        for first in range(1, NUM_QSFP + 1, 8):
+            regs[(ctrl, "split_ports_%d_%d" % (first, first + 7))] = 0
+    for first in (1, 17):
+        io, _ = cpld.io_cpld(first)
+        if io:
+            regs[(io, "led_split_amber_lo")] = mask(split, first)
+            regs[(io, "led_split_amber_hi")] = mask(split, first + 8)
+            regs[(io, "led_split_green_lo")] = 0
+            regs[(io, "led_split_green_hi")] = 0
+    return regs
+
+
+def apply(regs):
+    for (dev_dir, attr), value in regs.items():
+        if cpld.read_int_attr(dev_dir, attr) == value:
+            continue
+        if cpld.write_attr(dev_dir, attr, value):
+            log.info("%s = 0x%02x", attr, value)
+        else:
+            log.warning("cannot write %s to %s", attr, dev_dir)
+
+
+def main():
+    log.setLevel(logging.INFO)
+    handler = logging.handlers.SysLogHandler(address="/dev/log")
+    handler.setFormatter(logging.Formatter("split_led: %(message)s"))
+    log.addHandler(handler)
+    log.addHandler(logging.StreamHandler(sys.stdout))
+
+    config_db = ConfigDBConnector()
+    config_db.connect(wait_for_init=True)
+    last = None
+    while True:
+        try:
+            ports = config_db.get_table("PORT")
+        except Exception as e:
+            # the database is restarting (config reload): reconnect
+            log.warning("cannot read CONFIG_DB: %s", e)
+            time.sleep(INTERVAL)
+            config_db.connect(wait_for_init=True)
+            continue
+        split = split_ports(ports)
+        if split != last:
+            log.info("split ports %s", sorted(split) or "none")
+            last = split
+        # write on every pass: puts back what a CPLD lost (switch card reset)
+        apply(registers(split))
+        time.sleep(INTERVAL)
+
+
+if __name__ == "__main__":
+    main()
