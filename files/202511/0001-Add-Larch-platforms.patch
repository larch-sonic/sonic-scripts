+static unsigned int get_atu_win_size(struct mvppnd_dev *ppdev, struct pci_dev *pdev, unsigned bar_num)
+{
+	unsigned win_sz = 0x1;
+	unsigned atu_num = ppdev->sip7 ? SIP7_ATU_CNT : NUM_OF_ATU_WINDOWS_SIP6;
+	unsigned bar_size = pci_resource_len(pdev, bar_num);
+
+	while (win_sz < (bar_size / atu_num) )
+		win_sz <<= 1;
+
+	if (win_sz > (bar_size / atu_num))
+		win_sz <<= 1;
+
+#ifdef DBG_CVOE
+	pr_err("atu win size = %x\n", win_sz);
+#endif
+	return win_sz;
+}
