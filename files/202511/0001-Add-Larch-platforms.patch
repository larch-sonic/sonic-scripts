+++ b/platform/marvell-prestera/sonic-platform-larch/wnc-rsem-w1-32/sonic_platform/fan.py
@@ -0,0 +1,212 @@
+#!/usr/bin/env python3
+
+#############################################################################
+# WNC Phantom
+#
+# Module contains an implementation of SONiC Platform Base API and
+# provides the fan status which are available in the platform
+#
+#############################################################################
+
+
+import os.path
+
+try:
+    from sonic_platform_base.fan_base import FanBase
+    from .helper import APIHelper
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+I2C_FAN_PATH = "/sys/bus/i2c/devices/5-0066"
+I2C_PSU_PATH = "/sys/bus/i2c/devices/5-0066"
+
+FANTRAY_NAME_LIST = ["FANTRAY-1", "FANTRAY-2",
+                     "FANTRAY-3", "FANTRAY-4",
+                     "FANTRAY-5", "FANTRAY-6"]
+FAN_NAME_LIST = ["inner", "outer"]
+
+PSU_NAME_LIST = ["PSU1", "PSU2"]
+PSU_I2C_BUS =  [16, 17]
+PSU_I2C_ADDR =  [0x58, 0x58]
+PSU_I2C_HWMON = "/sys/class/i2c-adapter/i2c-{0}/{0}-{1:04x}/hwmon"
+PSU_FAN_NAME_LIST = ["FAN1"]
+
+FAN_MAX_RPM = [20300, 23300]
+FAN_MID_RPM = [11000, 12300]
+FAN_MIN_RPM = [2000, 2300]
+
+class Fan(FanBase):
+    """Platform-specific Fan class"""
+
+    def __init__(self, fan_tray_index, fan_index=0, is_psu_fan=False, psu_index = 0):
+        self.index = fan_index
+        self._api_helper = APIHelper()
+        self.fan_tray_index = fan_tray_index
+        self.is_psu_fan = is_psu_fan
+        if is_psu_fan:
+            self._i2c_hwmon_path = PSU_I2C_HWMON.format(PSU_I2C_BUS[psu_index], PSU_I2C_ADDR[psu_index])
+            self._hwmon_path = os.path.join(self._i2c_hwmon_path, self._api_helper._get_hwmon_name(self._i2c_hwmon_path))
+            self.fan_speed = os.path.join(self._hwmon_path, "fan1_input")
+            self.fan_present= os.path.join(I2C_FAN_PATH, "psu{}_present".format(psu_index + 1))
+            self.psu_index = psu_index
+        else:
+            self.fan_present = os.path.join(I2C_FAN_PATH, "fan{}_present".format(self.fan_tray_index + 1))
+            self.fan_pwm = os.path.join(I2C_FAN_PATH, "fan{}_pwm".format(self.fan_tray_index + 1))
+            self.fan_direction = os.path.join(I2C_FAN_PATH, "fan{}_direction".format(self.fan_tray_index + 1))
+            self.fan_speed = os.path.join(I2C_FAN_PATH, "fan{}_{}_rpm".format(self.fan_tray_index + 1, FAN_NAME_LIST[self.index]))
+            self.fan_led = os.path.join(I2C_FAN_PATH, "fan{}_led".format(self.fan_tray_index + 1))
+        FanBase.__init__(self)
+
+    def get_direction(self):
+        """
+        Retrieves the direction of fan
+        Returns:
+            A string, either FAN_DIRECTION_INTAKE or FAN_DIRECTION_EXHAUST
+            depending on fan direction
+        """
+        if self.is_psu_fan:
+            return self.FAN_DIRECTION_EXHAUST
+
+        attr_value = self._api_helper.read_int_from_file(self.fan_direction)
+        if (attr_value is not None):
+            if (attr_value == 0):
+                return self.FAN_DIRECTION_EXHAUST
+            else:
+                return self.FAN_DIRECTION_INTAKE
+
+        return self.FAN_DIRECTION_EXHAUST
+
+    def get_speed(self):
+        """
+        Retrieves the speed of fan as a percentage of full speed
+        Returns:
+            (5000*60)/ (hi*255+lo)
+            hi - always 0.
+            lo - value from i2c
+        """
+        speed = 0
+        if self.get_presence():
+            if self.is_psu_fan:
+                return self._api_helper.read_int_from_file(self.fan_speed)
+
+            attr_value = self._api_helper.read_int_from_file(self.fan_speed)
+            if (attr_value):
+                speed = int(5000*60/attr_value)
+        return speed
+
+    def get_target_speed(self):
+        """
+        Retrieves the target (expected) speed of the fan
+        Returns:
+            An integer, the percentage of full fan speed, in the range 0 (off)
+                 to 100 (full speed)
+        """
+        target = 0
+        if self.get_presence():
+            if self.is_psu_fan:
+                return self._api_helper.read_int_from_file(self.fan_speed)
+
+            attr_value = self._api_helper.read_int_from_file(self.fan_pwm)
+            if (attr_value):
+                if attr_value < 128:
+                    target = int(FAN_MIN_RPM[self.index]+
+                                 (FAN_MID_RPM[self.index]-FAN_MIN_RPM[self.index])*attr_value/128)
+                else:
+                    target = int(FAN_MID_RPM[self.index]+
+                                 (FAN_MAX_RPM[self.index]-FAN_MID_RPM[self.index])*(attr_value-128)/128)
+
+        return target
+
+    def get_speed_tolerance(self):
+        """
+        Retrieves the speed tolerance of the fan
+        Returns:
+            An integer, the percentage of variance from target speed which is
+                 considered tolerable
+        """
+        return 15
+
+    def set_speed(self, speed):
+        """
+        Sets the fan speed
+        Args:
+            speed: An integer, the percentage of full fan speed to set fan to,
+                   in the range 0 (off) to 100 (full speed)
+        Returns:
+            A boolean, True if speed is set successfully, False if not
+
+        """
+        return False
+
+    def set_status_led(self, color):
+        """
+        Sets the state of the fan module status LED
+        Args:
+            color: A string representing the color with which to set the
+                   fan module status LED
+        Returns:
+            bool: True if status LED state is set successfully, False if not
+        """
+        if self.is_psu_fan:
+            return False
+
+        if self.get_presence():
+            if (color == self.STATUS_LED_COLOR_OFF):
+                attr_value = 0
+            else:
+                attr_value = 1
+            self._api_helper.write_txt_file(self.fan_led, attr_value)
+            return True
+
+        return False
+
+
+    def get_status_led(self):
+        """
+        Gets the state of the fan status LED
+
+        Returns:
+            A string, one of the predefined STATUS_LED_COLOR_* strings above
+        """
+        if self.is_psu_fan:
+            return self.STATUS_LED_COLOR_OFF
+
+        if self.get_presence():
+            attr_value = self._api_helper.read_int_from_file(self.fan_led)
+            if (attr_value):
+                return self.STATUS_LED_COLOR_GREEN
+
+        return self.STATUS_LED_COLOR_OFF
+
+    def get_name(self):
+        """
+        Retrieves the name of the device
+            Returns:
+            string: The name of the device
+        """
+        if self.is_psu_fan:
+            fan_name = PSU_NAME_LIST[self.psu_index] + "_" + PSU_FAN_NAME_LIST[self.index]
+        else:
+            fan_name = FANTRAY_NAME_LIST[self.fan_tray_index] + "_" + FAN_NAME_LIST[self.index]
+
+        return fan_name
+
+    def get_status(self):
+        """
+        Retrieves the status of the FAN
+        Returns:
+            bool: True if FAN is present, False if not
+        """
+        return self.get_presence()
+
+    def get_presence(self):
+        """
+        Retrieves the presence of the FAN
+        Returns:
+            bool: True if FAN is present, False if not
+        """
+        attr_value = self._api_helper.read_int_from_file(self.fan_present)
+        if (attr_value is not None and attr_value == 0):
+            return True
+
+        return False
