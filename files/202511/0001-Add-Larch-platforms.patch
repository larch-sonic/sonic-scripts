+/* Descriptor related macros */
+#undef BIT_MASK
+#define BIT_MASK(numOfBits) ((1ULL << numOfBits) - 1)
+#define FIELD_MASK_NOT(offset, len) (~(BIT_MASK((len)) << (offset)))
+#define U32_SET_FIELD(data, offset, length, val) \
+	(data) = (((data) & FIELD_MASK_NOT((offset), (length))) | \
+		  ((val) << (offset)))
+
+/**
+ *
+ * @brief describe the GDMA descriptor : 4 words. (extended mode)
+ *      each descriptor supports 48 bits of buffer address , in order to remove any
+ *      dependency on buffer location in the memory
+ *  NOTE: it is generic for PDI2MEM (TO_CPU)  ,MEM2PDI (FROM-CPU)
+ *  word   start bit | num of bits  | field name
+ *   0        0,         1             OWN
+ *   0        1,         3             RESERVED_0
+ *   0        4,         2             FAILURE_CODE (     for FROM-CPU , single bit)
+ *   0        5,         1             VALID        (only for FROM-CPU)
+ *   0        6,         1             F
+ *   0        7,         1             L
+ *   0        8,         5             AXI_ATTR_PROFILE
+ *   0       13,         1             OPCODE
+ *   0       14,        16             BUFFER_BYTE_COUNT
+ *   0,      30,         2             BUFFER_DST_ADDR_LOW_0_1
+ *   1        0,        32             BUFFER_DST_ADDR_LOW_2_33
+ *   2       64,        16             RESERVED_1
+ *   2       80,        16             RESERVED_2
+ *   3       96,        14             BUFFER_DST_ADDR_HIGH_34_47
+ *   3      110,        28             RSVD
+*/
+
+#define GDMA_ADDR_BITS01_MASK 0xC0000000
+#define GDMA_ADDR_BITS01_SHIFT 30
+#define GDMA_ADDR_BITS2_33_SHIFT 2
+#define GDMA_ADDR_BITS34_47_SHIFT 34
+
+/*
+ * Note: GDMA has the byte count - 1 set in bits 14..29
+ *       of word0 (first word). It is pure incident that
+ *       it looks like the same as SDMA but with the values
+ *       flipped in roles (e.g. this is not a mistake!)
+ */
+#define GDMA_DESC_SET_BYTE_CNT(word0, val) \
+	(U32_SET_FIELD(word0, 14, 16, (val - 1)))
+
+#define TX_DESC_SET_BYTE_CNT(bc, val) \
+	(U32_SET_FIELD(bc, 16, 14, val))
+
+#define RX_DESC_SET_BYTE_CNT(bc, val) \
+	bc = 0; \
+	(U32_SET_FIELD(bc, 16, 14, val))
+
+#define XDMA_TX_DESC_SET_BYTE_CNT(ppdev, descptr, val) \
+	if (ppdev->sip7) \
+		GDMA_DESC_SET_BYTE_CNT(descptr->cmd_sts, val); \
+	else \
+		TX_DESC_SET_BYTE_CNT(descptr->bc, val)
+
+#define XDMA_RX_DESC_SET_BYTE_CNT(ppdev, descptr, val) \
+	if (ppdev->sip7) \
+		GDMA_DESC_SET_BYTE_CNT(descptr->cmd_sts, val); \
+	else {\
+		RX_DESC_SET_BYTE_CNT(descptr->bc, val); \
+	}
+
+#define SDMA_RX_DESC_GET_BYTE_CNT(bc) \
+	((bc >> 16) & 0x3FFF)
+/* GDMA HW register uses the real size - 1 : */
+#define GDMA_RX_DESC_GET_BYTE_CNT(word0) \
+	(((word0 >> 14) & 0xFFFF) + 1)
+#define XDMA_RX_DESC_GET_BYTE_CNT(ppdev, descptr) \
+	ppdev->sip7 ? GDMA_RX_DESC_GET_BYTE_CNT(descptr->cmd_sts) \
+		    : SDMA_RX_DESC_GET_BYTE_CNT(descptr->bc)
+
+#define RX_DESC_SET_BUFF_SIZE(bc, val) \
+	bc = __builtin_bswap32(bc); \
+	U32_SET_FIELD(bc, 0, 14, val); \
+	bc = __builtin_bswap32(bc);
+
+#define XDMA_RX_DESC_SET_BUFF_SZ(ppdev, descptr, val) \
+	if (ppdev->sip7) \
+		GDMA_DESC_SET_BYTE_CNT(descptr->cmd_sts, val); \
+	else \
+		RX_DESC_SET_BUFF_SIZE(descptr->bc, val)
+
+#define CLR_MSI_X_SRC(ppdev, irq_offset) \
+	if (ppdev->msi_x_client_regs) \
+		*(u32 *)(ppdev->msi_x_client_regs + MSI_X_OFS + ID_MASK_OFFSET) = irq_offset
+
+#define XDMA_DESC_SET_NEXT(ppdev, descptr, val) \
+	if (!ppdev->sip7) \
+		descptr->next_desc_ptr = val;
+
+/* pointer in GDMA is spread all over the descriptor, use a macro which
+   hides the descriptor pointer difference between SDMA and GDMA.
+   For GDMA, force bits 64:32 to be 0x2, so GDMA AXI transactions will be
+   routed towards the PCIe:  */
+#define XDMA_DESC_SET_PTR(ppdev, descptr, ptr) \
+	if (ppdev->sip7) { \
+		descptr->cmd_sts &= ~GDMA_ADDR_BITS01_MASK; \
+		descptr->cmd_sts |= (ptr << GDMA_ADDR_BITS01_SHIFT) & GDMA_ADDR_BITS01_MASK; \
+		descptr->bc = (((ptr >> GDMA_ADDR_BITS2_33_SHIFT) & 0x3FFFFFFF) | \
+		 (CASPIAN_PCIE_AD_ADDR_HIGH << (32 - GDMA_ADDR_BITS2_33_SHIFT))); \
+		descptr->next_desc_ptr = 0; \
+	} \
+	else \
+		descptr->buf_addr = ptr;
+
+#define XDMA_DESC_GET_PTR(ppdev, descptr, ptr) \
+	if (ppdev->sip7) { \
+		ptr = 0; \
+		ptr |= ((descptr->cmd_sts & GDMA_ADDR_BITS01_MASK) >> GDMA_ADDR_BITS01_SHIFT); \
+		ptr |= (u64)descptr->bc << GDMA_ADDR_BITS2_33_SHIFT; \
+		ptr |= (u64)descptr->next_desc_ptr << GDMA_ADDR_BITS34_47_SHIFT; \
+		ptr -= (((unsigned long long)CASPIAN_PCIE_AD_ADDR_HIGH)<<32LLU); \
+	} \
+	else \
+		ptr = descptr->buf_addr;
+
