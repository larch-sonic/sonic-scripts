+class Sfp(SfpBase):
+    """Platform-specific Sfp class"""
+
+    PORT_EEPROM_PATH = '/sys/bus/i2c/devices/0-0050/eeprom' # TODO: or 0-0051 ???
+
+    CPLD_ADDRESS = 0x70
+    ZSFP_PORT_TO_CONTROL_REG_MAP = {
+        13: 0x0e,
+        14: 0x0e,
+        15: 0x0d,
+        16: 0x0d,
+        17: 0x0c,
+        18: 0x0c
+    }
+
+    def __init__(self, index, sfp_type):
+        SfpBase.__init__(self)
+
+        self.port_num = index # 1-based physical port number
+        self.sfp_type = sfp_type
+        self.dom_supported = False
+        self.dom_temp_supported = False
+        self.dom_volt_supported = False
+        self.dom_rx_power_supported = False
+        self.dom_tx_power_supported = False
+        self.calibration = 0
+
+        if self.sfp_type != "COPPER":
+            self.tx_disable(False)
+
+    def _convert_string_to_num(self, value_str):
+        if "-inf" in value_str:
+            return 'N/A'
+        elif "Unknown" in value_str:
+            return 'N/A'
+        elif 'dBm' in value_str:
+            t_str = value_str.rstrip('dBm')
+            return float(t_str)
+        elif 'mA' in value_str:
+            t_str = value_str.rstrip('mA')
+            return float(t_str)
+        elif 'C' in value_str:
+            t_str = value_str.rstrip('C')
+            return float(t_str)
+        elif 'Volts' in value_str:
+            t_str = value_str.rstrip('Volts')
+            return float(t_str)
+        else:
+            return 'N/A'
+
+    def _dom_capability_detect(self):
+        if not self.get_presence():
+            self.dom_supported = False
+            self.dom_temp_supported = False
+            self.dom_volt_supported = False
+            self.dom_rx_power_supported = False
+            self.dom_tx_power_supported = False
+            self.calibration = 0
+            return
+
+        sfpi_obj = sff8472InterfaceId()
+        if sfpi_obj is None:
+            return None
+        sfp_dom_capability_raw = self.__read_eeprom_specific_bytes(
+            XCVR_DOM_CAPABILITY_OFFSET, XCVR_DOM_CAPABILITY_WIDTH)
+        if sfp_dom_capability_raw is not None:
+            sfp_dom_capability = int(sfp_dom_capability_raw[0], 16)
+            self.dom_supported = (sfp_dom_capability & 0x40 != 0)
+            if self.dom_supported:
+                self.dom_temp_supported = True
+                self.dom_volt_supported = True
+                self.dom_rx_power_supported = True
+                self.dom_tx_power_supported = True
+                if sfp_dom_capability & 0x20 != 0:
+                    self.calibration = 1
+                elif sfp_dom_capability & 0x10 != 0:
+                    self.calibration = 2
+                else:
+                    self.calibration = 0
+            else:
+                self.dom_temp_supported = False
+                self.dom_volt_supported = False
+                self.dom_rx_power_supported = False
+                self.dom_tx_power_supported = False
+                self.calibration = 0
+
+            if len(sfp_dom_capability_raw) >= 2:
+                self.dom_tx_disable_supported = (int(sfp_dom_capability_raw[1], 16) & 0x40 != 0)
+            else:
+                self.dom_tx_disable_supported = False
+
+    def __read_eeprom_specific_bytes_raw(self, offset, num_bytes):
+        if not os.path.exists(self.PORT_EEPROM_PATH):
+            sonic_logger.log_error("path %s is not exist" % self.PORT_EEPROM_PATH)
+            return None
+
+        sysfsfile_eeprom = None
+
+        try:
+            sysfsfile_eeprom = open(self.PORT_EEPROM_PATH, mode="rb", buffering=0)
+            sysfsfile_eeprom.seek(offset)
+            raw = sysfsfile_eeprom.read(num_bytes)
+        except Exception as e:
+            pass
+        finally:
+            if sysfsfile_eeprom:
+                sysfsfile_eeprom.close()
+        return raw
+
+    def __read_eeprom_specific_bytes(self, offset, num_bytes):
+
+        raw = self.__read_eeprom_specific_bytes_raw(offset, num_bytes)
+        if raw is None:
+            return None
+
+        eeprom_raw = []
+        for i in range(0, num_bytes):
+            eeprom_raw.append("0x00")
+
+        for n in range(0, num_bytes):
+            eeprom_raw[n] = hex(raw[n])[2:].zfill(2)
+
+        return eeprom_raw
+
+    def __read_sfp_register(self, reg_addr):
+        if smbus_present == 0:  # if called from sfputil outside of pmon
+            cmdstatus, value = cmd.getstatusoutput('sudo i2cget -y 0 {} {}'.format(self.CPLD_ADDRESS, reg_addr))
+            if cmdstatus:
+                sonic_logger.log_warning("Failed to retrieve register value %s", cmdstatus)
+                return None
+            value = int(value, 16)
+        else:
+            bus = smbus.SMBus(0)
+            try:
+                value = bus.read_byte_data(self.CPLD_ADDRESS, reg_addr)
+            except Exception as e:
+                sonic_logger.log_warning("Failed to retrieve register value")
+
+        return value
+
+########  DEVICE BASE API  #########
+
+    def get_name(self):
+        """
+        Retrieves the name of the device
+
+        Returns:
+            string: The name of the device
+        """
+        return "Ethernet{}".format(self.port_num - 1)
+
+    def get_presence(self):
+        """
+        Retrieves the presence of the device
+
+        Returns:
+            bool: True if device is present, False if not
+        """
+
+        if self.sfp_type == "COPPER":
+            return False
+        elif self.sfp_type == "SFP":
+            reg_addr = 0x13
+            offset_bit = self.port_num - SFP_PORT_START
+        elif self.sfp_type == "ZSFP":
+            """
+            in case of zsfp we have 3 registers for all 6 of the zsfp`s.
+            Everyone with 3 different statuses
+            [0] - presence of ZSFP N
+            [1] - signal loss of ZSFP N
+            [2] - transmitter fault of ZSFP N
+            [3] - unused
+            [4] - presence of ZSFP N+1
+            [5] - signal loss of ZSFP N+1
+            [6] - transmitter fault of ZSFP N+1
+            [7] - unused
+            """
+            reg_addr = self.ZSFP_PORT_TO_CONTROL_REG_MAP.get(self.port_num, 0x0)
+            offset_bit = 4 if self.port_num % 2 == 0 else 0 #bit in register, indicator of presence of the zsfp
+
+        value = self.__read_sfp_register(reg_addr)
+        # 0:Module inserted
+        # 1:Module absent
+        if value & (1 << (offset_bit)):
+            return False
+
+        return True
+
+    def get_model(self):
+        """
+        Retrieves the model number (or part number) of the device
+
+        Returns:
+            string: Model/part number of device
