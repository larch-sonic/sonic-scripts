+						attr_rx_ring_size);
+	int i;
+	char *p = buf;
+
+	strcpy(buf, "");
+
+	for (i = 0; i < NUM_OF_RX_QUEUES; i++) {
+		if (!ppdev->rx_queues[i])
+			continue;
+
