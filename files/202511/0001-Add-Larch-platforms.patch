+def _child_cli_entry(name: str, module):
+    """Return the callable entry point for a warmed child CLI module."""
+    if name in ("sfpshow", "acl-loader", "sfputil", "pfcwd"):
+        from utilities_common.general import load_db_config
+        load_db_config()
+        if name == "pfcwd" and hasattr(module, "get_pfcwd_clis"):
+            return module.get_pfcwd_clis()
+        return module.cli
+    entry = getattr(module, "main", None)
+    if entry is None:
+        raise RuntimeError(f"child CLI has no entry point: {name!r}")
+    return entry
+
+
+def _run_inprocess_child(argv: List[str], user: Optional[str] = None) -> dict:
+    """Execute a warmed child CLI in-process and return a /run payload."""
+    argv = _normalize_popen_argv(argv)
+    name = _command_name(argv)
+    module = _CHILD_CLI_MODULES.get(name or "")
+    if module is None:
+        raise RuntimeError(f"child CLI not warmed: {name!r}")
+
+    entry = _child_cli_entry(name or "", module)
+    stdout_buf = io.StringIO()
+    stderr_buf = io.StringIO()
+    old_argv = sys.argv[:]
+    returncode = 1
+
+    with _INPROCESS_LOCK:
+        with _usercache_as_caller(user):
+            # In-process CLIs run as the daemon (root). Nested subprocess.Popen
+            # calls must not get sudo -u <caller> from _ProxyPopen (breaks ipintutil
+            # netns exec and other root-only operations).
+            old_run_as_user = get_run_as_user()
+            set_run_as_user(None)
+            sys.argv = [str(arg) for arg in argv]
+            try:
+                with contextlib.redirect_stdout(stdout_buf), contextlib.redirect_stderr(stderr_buf):
+                    try:
+                        entry()
+                        returncode = 0
+                    except SystemExit as e:
+                        if isinstance(e.code, int):
+                            returncode = e.code
+                        elif e.code is None:
+                            returncode = 0
+                        else:
+                            returncode = 1
+                    except Exception as e:
+                        stderr_buf.write(f"{type(e).__name__}: {e}\n")
+                        returncode = 1
+            finally:
+                sys.argv = old_argv
+                set_run_as_user(old_run_as_user)
+
+    return {
+        "stdout": stdout_buf.getvalue(),
+        "stderr": stderr_buf.getvalue(),
+        "exit_code": int(returncode),
+    }
+
