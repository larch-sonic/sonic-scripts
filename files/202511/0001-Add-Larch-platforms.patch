index 000000000..ee390d55d
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/debian/sonic-platform-ln4332z4-v7.postinst
@@ -0,0 +1,33 @@
+#!/bin/sh
+# postinst script for sonic-platform-ln4332z4-v7
+#
+# see: dh_installdeb(1)
+
+chmod a+x /usr/local/bin/ln4332z4-v7-init.sh
+chmod a+x /usr/local/bin/ln4332z4-v7-falcon-temp.sh
+chmod a+x /usr/local/bin/ln4332z4-v7-reset-button.py
+chmod a+x /usr/local/bin/ln4332z4-v7-split-led.py
+chmod +x /usr/local/bin/show
+chmod +x /usr/local/bin/cli_proxy
+chmod +x /usr/local/bin/config
+chmod +x /usr/local/bin/show_fallback
+chmod +x /usr/local/bin/config_fallback
+depmod -a
+systemctl restart kmod
+# Apply MPLS sysctl after kmod loads mpls modules on first boot
+sysctl -p /etc/sysctl.d/90-mpls.conf || true
+# The host needs the platform API too (decode-syseeprom, init script)
+pip3 install /usr/share/sonic/device/x86_64-larch_ln4332z4-v7/sonic_platform-1.0-py3-none-any.whl || true
+systemctl enable ln4332z4-v7-init.service
+systemctl start ln4332z4-v7-init.service
+# This runs from rc.local on the first boot and the service is ordered after
+# database.service, which waits for rc.local: queue the start, don't wait.
+systemctl enable ln4332z4-v7-falcon-temp.service
+systemctl start --no-block ln4332z4-v7-falcon-temp.service
+systemctl enable ln4332z4-v7-reset-button.service
+systemctl start --no-block ln4332z4-v7-reset-button.service
+systemctl enable ln4332z4-v7-split-led.service
+systemctl start --no-block ln4332z4-v7-split-led.service
+systemctl enable sonic-utilities-proxy.service
+systemctl start sonic-utilities-proxy.service
+exit 0
