diff --git a/platform/marvell-prestera/sonic-platform-larch/ln3524xgf-6z-v1/sonic_platform/chassis.py b/platform/marvell-prestera/sonic-platform-larch/ln3524xgf-6z-v1/sonic_platform/chassis.py
