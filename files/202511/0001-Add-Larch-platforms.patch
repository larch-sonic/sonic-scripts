+#define QSFP_MODSELN_ADDRESS        0x17
+#define QSFP_LOW_POWER_ADDRESS      0x18
+#define CPLD_SERIAL_LED_BIT         3
+#define CPLD_EEPROM_WRITE_BIT       2
