+static int mvppnd_is_our_win(struct mvppnd_dev *ppdev, u8 win)
+{
+	int i;
+
+	for (i = 0; i < sizeof(ppdev->mg_win); i++)
+		if (win == ppdev->mg_win[i])
+			return true;
+
+	return false;
