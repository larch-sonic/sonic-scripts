+
+import threading, socket, time
+import queue, select, functools
+import argparse, sys, re
+from datetime import datetime
+
+import common, device
+
+HOST = ''
+SOCKET_LIST = []
+SOCKET_MAX_CLIENT = 10
+QUEUES = []
+THREADS = []
+FUNCS = {}
+
+class GlobalThread(threading.Thread):
+    def __init__(self,threadname, q):
+        threading.Thread.__init__(self,name = threadname)
+        self.queue = q
+
+    def run(self):
+        while common.RUN:
+            message = self.queue.get()
+            self.onMessage(message)
+
+    def onMessage(self, message):
+        """
+        Commands:
+            uninstall    : Uninstall platform drivers
+        """
+        if len(message.command) < 1:
+            result = self.onMessage.__doc__
+        else:
+            if message.command[0] == 'uninstall':
+                common.RUN = False
+                doUninstall()
+                result = 'Success'
+            else:
+                result = self.onMessage.__doc__
+        if (message.callback is not None):
+            message.callback(result)
+
+class messageObject(object):
+    def __init__(self, command, callback):
+        super(messageObject, self).__init__()
+        self.command = command
+        self.callback = callback
+
+def callback(sock, result):
+    sock.sendall(result.encode())
+
+def messageHandler():
+    server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    server_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+    server_socket.bind((HOST, common.SOCKET_PORT))
+    server_socket.listen(SOCKET_MAX_CLIENT)
+    SOCKET_LIST.append(server_socket)
+
+    while(common.RUN):
+        ready_to_read,ready_to_write,in_error = select.select(SOCKET_LIST,[],[],0)
+        for sock in ready_to_read:
+            if sock == server_socket:
+                sockfd, addr = server_socket.accept()
+                SOCKET_LIST.append(sockfd)
+            else:
+                try:
+                    data = sock.recv(common.SOCKET_RECV_BUFFER)
+                    if data:
+                        cb = functools.partial(callback, sock)
+                        cmdlist = data.decode().split()
+
+                        if cmdlist[0] not in common.CMD_TYPE:
+                            callback(sock, 'Fail')
+                            continue
+
+                        msg = messageObject(cmdlist[1:], cb)
+                        FUNCS[cmdlist[0]].put(msg)
+                        continue
+                    else:
+                        if sock in SOCKET_LIST:
+                            SOCKET_LIST.remove(sock)
+                except:
+                    raise
+        time.sleep(0.2)
+
+    server_socket.close()
+
+def setupThreads():
+    global THREADS, QUEUES
+
+    # Queues
+    # Global
+    queueGlobal = queue.Queue()
+    QUEUES.append(queueGlobal)
+    FUNCS['global'] = queueGlobal
+
+    # Device
+    queueDevice = queue.Queue()
+    QUEUES.append(queueDevice)
+    FUNCS['device'] = queueDevice
+
+    # Threads
+    # Global
+    threadGlobal = GlobalThread('Global Handler', queueGlobal)
+    THREADS.append(threadGlobal)
+
+    # Device
+    threadDevice = device.DeviceThread('Device Handler', queueDevice)
+    THREADS.append(threadDevice)
+
+    # Check platform status
+    threadPlatformStatus = device.PlatformStatusThread('Platform Status Handler', 0.3)
+    THREADS.append(threadPlatformStatus)
+
+def functionInit():
+    setupThreads()
+    for thread in THREADS:
+        thread.start()
+
+def deviceInit():
+    msg = messageObject(['init'], None)
+    FUNCS['device'].put(msg)
+
+
+# Platform definitions
+
+MODULES = ['i2c_dev', 'i2c_mux_pca954x', 'at24', 'hwmon_mcu', 'hwmon_cpld', 'hwmon_psu', 'hwmon_sfp']
+
+MUXES   = ['pca9544:0x72:i2c-0','pca9548:0x73:i2c-0']
+
+DEVICES =   [   # CPLD
+                'hwmon_cpld:0x74:i2c-5',
+                'hwmon_cpld:0x75:i2c-6',
+                'hwmon_cpld:0x76:i2c-7',
+
+                # PSU
+                'dps460:0x58:i2c-1',
+                'dps460:0x59:i2c-2',
+                '24c02:0x50:i2c-1',
+                '24c02:0x51:i2c-2',
+
+                # SFP
+                'hwmon_sfpA:0x50:i2c-5',
+                'hwmon_sfpB:0x50:i2c-6',
+                'hwmon_sfpC:0x50:i2c-7',
+
+                # MCU
+                'hwmon_mcu:0x70:i2c-4',
+
+                # EEPROM
+                '24c02:0x54:i2c-8',
+            ]
+
+SFP_TOTAL_NUM = 56
+SFP_I2C_START = 50
+SFP_FIRST_QSFP = 49
+SFP_EEPROM_ADDR = '0x50'
+
+# Platform initialize
+
+def addModule(module):
+    _,status,_ = common.doBash(f'lsmod | grep \"{module}\"')
+    if status:
+        common.doBash(f'modprobe {module}')
+
+def initDevice(device):
+    init_command = 'echo {} {} > /sys/bus/i2c/devices/{}/new_device'.format(*device.split(':'))
+    common.doBash(init_command)
+
+def initSfpEeprom():
+    for i in range(1, SFP_TOTAL_NUM + 1):
+        # use optoe1 for QSFP and SFP,
+        # this a workaround for kernel panic with access to 0x51 address
+        driver = 'optoe1' if i >= SFP_FIRST_QSFP else 'optoe1'
+        init_command = 'echo {} {} > /sys/bus/i2c/devices/i2c-{}/new_device'.format(driver, SFP_EEPROM_ADDR, SFP_I2C_START + i)
+        common.doBash(init_command)
+        init_command = 'echo Ethernet{} > /sys/bus/i2c/devices/{}-0050/port_name'.format(i, SFP_I2C_START + i)
+        common.doBash(init_command)
+
+def initTransceivers():
+    common.doBash('/usr/sbin/i2cset -y 10 0x22 0x0c 0x00')
+    common.doBash('/usr/sbin/i2cset -y 10 0x22 0x0d 0x00')
+    common.doBash('/usr/sbin/i2cset -y 10 0x22 0x0e 0x00')
+    common.doBash('/usr/sbin/i2cset -y 10 0x22 0x04 0xff')
+    common.doBash('/usr/sbin/i2cset -y 10 0x22 0x05 0xff')
+    common.doBash('/usr/sbin/i2cset -y 10 0x22 0x06 0xff')
+    common.doBash('/usr/sbin/i2cset -y 11 0x23 0x0c 0x00')
+    common.doBash('/usr/sbin/i2cset -y 11 0x23 0x0d 0x00')
+    common.doBash('/usr/sbin/i2cset -y 11 0x23 0x0e 0x00')
+    common.doBash('/usr/sbin/i2cset -y 11 0x23 0x04 0xff')
+    common.doBash('/usr/sbin/i2cset -y 11 0x23 0x05 0xff')
+    common.doBash('/usr/sbin/i2cset -y 11 0x23 0x06 0xff')
+    common.doBash('/usr/sbin/i2cset -y 12 0x38 0x03 0x00')
+    common.doBash('/usr/sbin/i2cset -y 12 0x38 0x01 0xff')
+    common.doBash('/usr/sbin/i2cset -f -y 5 0x74 0x09 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 5 0x74 0x0a 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 5 0x74 0x0b 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 5 0x74 0x0c 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 5 0x74 0x0d 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 5 0x74 0x0e 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 5 0x74 0x0f 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 5 0x74 0x10 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 5 0x74 0x11 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 5 0x74 0x12 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 5 0x74 0x13 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 5 0x74 0x14 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 5 0x74 0x15 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 5 0x74 0x16 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 6 0x75 0x05 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 6 0x75 0x06 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 6 0x75 0x07 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 6 0x75 0x08 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 6 0x75 0x09 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 6 0x75 0x0A 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 7 0x76 0x09 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 7 0x76 0x0a 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 7 0x76 0x0b 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 7 0x76 0x0c 0x00')
+    common.doBash('/usr/sbin/i2cset -f -y 7 0x76 0x10 0x55')
+    common.doBash('/usr/sbin/i2cset -f -y 7 0x76 0x11 0x55')
+    #serial led enable
+    common.doBash('/usr/sbin/i2cset -f -y 5 0x74 0x02 0x06')
+    common.doBash('/usr/sbin/i2cset -f -y 6 0x75 0x01 0x0a')
+    common.doBash('/usr/sbin/i2cset -f -y 7 0x76 0x02 0x0a')
+
+def getBuiltVersion():
+    file_path = '/etc/sonic/sonic_version.yml'
+    date_pattern = r":\s*(.+)"
+    commit_pattern = r":\s*'([a-fA-F0-9]+)'"
+
+    built_date = None
+    built_commit = None
+
+    with open(file_path, 'r') as file:
+        for line in file:
+            if "build_date" in line:
+                m = re.search(date_pattern, line)
+                if m:
+                    built_date = m.group(1)
+            elif "commit_id" in line:
+                m = re.search(commit_pattern, line)
+                if m:
+                    built_commit = m.group(1)
+
+    if not built_date or not built_commit:
+        raise ValueError("Error: Could not extract built date or built commit.")
+
+    formatted_date = datetime.strptime(built_date, "%a %b %d %H:%M:%S %Z %Y").strftime("%Y%m%d")
+
+    return f"build_version: 'D-Link-SONiC_{formatted_date}_1.00-{built_commit}'"
+
+def changeSoftwareVersion():
+    file_path = '/etc/sonic/sonic_version.yml'
+    version_pattern = r"build_version:\s*'.*?'"
+    content = None
+
+    with open(file_path, "r") as file:
+        content = file.read()
+
+    updated_content = re.sub(version_pattern, getBuiltVersion(), content)
+
+    with open(file_path, "w") as file:
+        file.write(updated_content)
+
+
+def doInstall():
+    changeSoftwareVersion()
+    common.RUN = True
+    common.doBash('depmod -a')
+    list(map(addModule, MODULES))
+    common.doBash('pca9641 init')
+    time.sleep(1)
+    list(map(initDevice, MUXES))
+    time.sleep(2)
+    common.doBash('echo -2 | tee /sys/bus/i2c/drivers/pca954x/*-00*/idle_state')
+    list(map(initDevice, DEVICES))
+    # initSfpEeprom()
+    functionInit()
+    deviceInit()
+    initTransceivers()
+    messageHandler()
+
+
+# Platform uninitialize
+
+def removeModule(module):
+    common.doBash(f'modprobe -rq {module.split(" ")[0]}')
+
+def deinitDevice(device):
+    deinit_command = 'echo {} > /sys/bus/i2c/devices/{}/delete_device'.format(*device.split(':')[1:])
+    common.doBash(deinit_command)
+
+def deinitSfpEeprom():
+    for i in range(1, SFP_TOTAL_NUM + 1):
+        deinit_command = 'echo {} > /sys/bus/i2c/devices/i2c-{}/delete_device'.format(SFP_EEPROM_ADDR, SFP_I2C_START + i)
+        common.doBash(deinit_command)
+
+def doUninstall():
+    #deinitSfpEeprom()
+    list(map(deinitDevice, reversed(DEVICES)))
+    list(map(deinitDevice, reversed(MUXES)))
+    common.doBash('pca9641 deinit')
+    list(map(removeModule, MODULES))
+
+
+# Main
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('-i', '--install', action='store_true', help='install and init i2c bus')
+    parser.add_argument('-u', '--uninstall', action='store_true', help='uninstall and deinit i2c bus')
+    args = parser.parse_args()
+
+    if len(sys.argv) == 1:
+        print ('Error! Please specify at least one option.')
+        parser.print_help()
+
+    if args.install:
+        doInstall()
+
+    elif args.uninstall:
+        doUninstall()
+
+if __name__ == "__main__":
+    main()
