+						attr_mg_win);
+	int win_mask;
+
+	if (ppdev->sip7) return 0; /* no MG in SIP7 */
+
+	if (sscanf(buf, "0x%x", &win_mask) != 1) {
+		netdev_err(ppdev->sdev.flows[0]->ndev, "Invalid input\n");
+		goto out;
+	}
+
+	mvppnd_save_mg_wins(ppdev, win_mask);
+out:
+	return count;
+}
