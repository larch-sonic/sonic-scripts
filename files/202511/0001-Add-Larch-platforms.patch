+#!/usr/bin/env python3
+import os, sys, json, pwd, urllib.request, urllib.error
+
+PROXY = os.environ.get("SONIC_CLI_PROXY", "http://127.0.0.1:8787")
+
+REAL_SHOW = "/usr/local/bin/show_fallback"
+
+CLI_PROXY_DISABLED_FLAG = "/etc/sonic/.cli_proxy_disabled"
+
+LONG_BYPASS_PREFIXES = [
+    ("techsupport",),
+    ("spanning-tree",),
+    ("runningconfiguration",),
+    ("running-config",),
+    ("running-configuration",),
+    ("ip", "bgp"),
+    ("ipv6", "bgp"),
+]
+
+# Commands that bypass the proxy AND require root (run via sudo show_fallback)
+ROOT_BYPASS_PREFIXES = [
+    ("system-health",),
+]
+
+def get_current_user():
+    """Get the username of the calling user."""
+    return pwd.getpwuid(os.getuid()).pw_name
+
+def post(path, obj):
+    data = json.dumps(obj).encode("utf-8")
+    req = urllib.request.Request(PROXY + path, data=data, headers={"Content-Type":"application/json"})
+    with urllib.request.urlopen(req, timeout=120) as r:
+        return json.loads(r.read().decode("utf-8"))
+
+def starts_with(words, prefix):
+    return len(words) >= len(prefix) and tuple(words[:len(prefix)]) == tuple(prefix)
+
+def should_bypass(args):
+    if not args:
+        return False
+    for pfx in LONG_BYPASS_PREFIXES:
+        if starts_with(args, pfx):
+            return True
+    return False
+
+def should_root_bypass(args):
+    if not args:
+        return False
+    for pfx in ROOT_BYPASS_PREFIXES:
+        if starts_with(args, pfx):
+            return True
+    return False
+
+def exec_real_show(args):
+    if os.path.exists(REAL_SHOW):
+        os.execv(REAL_SHOW, [REAL_SHOW] + args)
+    raise FileNotFoundError(REAL_SHOW)
+
+def exec_real_show_as_root(args):
+    sudo = "/usr/bin/sudo"
+    if os.path.exists(REAL_SHOW):
+        os.execv(sudo, [sudo, REAL_SHOW] + args)
+    raise FileNotFoundError(REAL_SHOW)
+
+def main(argv):
+    user = get_current_user()
+
+    # If CLI proxy is disabled, always run the real command directly
+    if os.path.exists(CLI_PROXY_DISABLED_FLAG):
+        exec_real_show(argv[1:])
+
+    # special hidden mode for completion
+    if len(argv) >= 2 and argv[1] == "__complete__":
+        # args: __complete__ <cword> <words...>
+        try:
+            cword = int(argv[2])
+            words = argv[3:]
+        except Exception:
+            print("", end="")
+            return 0
+        try:
+            resp = post("/complete", {"prog":"show","words":words,"cword":cword})
+            for c in resp.get("candidates", []):
+                if c:
+                    print(c)
+            return 0
+        except Exception:
+            # no completion if proxy down
+            return 0
+        
+    args = argv[1:]
+
+    # bypass for long/tty-sensitive commands
+    if should_bypass(args):
+        exec_real_show(args)
+
+    # bypass for commands that require root privileges
+    if should_root_bypass(args):
+        exec_real_show_as_root(args)
+
+    # normal execution - pass user to proxy
+    try:
+        resp = post("/run", {"prog":"show", "args":argv[1:], "user":user})
+        stdout = resp.get("stdout","")
+        stderr = resp.get("stderr","")
+        if stdout:
+            sys.stdout.write(stdout)
+        if stderr:
+            sys.stderr.write(stderr)
+        return int(resp.get("exit_code", 0))
+    except Exception as e:
+        # Fallback: call real binary if proxy not available
+        real = "/usr/local/bin/show_fallback"
+        if os.path.exists(real):
+            os.execv(real, [real] + argv[1:])
+        print(f"show-proxy error: {e}", file=sys.stderr)
+        return 1
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
