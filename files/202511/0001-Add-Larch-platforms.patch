+#define MSIX_GDMA1_RING_RESERVED 15 /* Number of reservedi (unused) entries after first 16 */
+
+#define REG_ADDR_BASE_CASPIAN_GDMA	0x7C400000
+
+/*
+ * All GDMA addresses must go out with bits [64:32]==0x2,
+ * so address decoder will route AXI transactions to the
+ * PCIe unit. Then we need using the PCIE oATU unit to
+ * translate the addresses back to the original addresses
+ * before they will be sent out to the host CPU
+ */
+#define CASPIAN_PCIE_AD_ADDR_HIGH	0x2
+
+#define INT_GLBL_CNM_AGGR_BIT (1 << 1)
+#define INT_CNM_AGGR_GDMA3_BIT (1 << 8)
+
+/* on tree #1 : */
+/* global interrupt tree: */
+#define CASPIAN_REG_ADDR_GLBL_INT_SUM_CAUSE 0xC0200
+#define CASPIAN_REG_ADDR_GLBL_INT_SUM_MASK  0xC0204
+
+/* CnM aggregation interrupt: */
+#define CASPIAN_REG_ADDR_AGGR_INT_SUM_CAUSE 0xC02A0
+#define CASPIAN_REG_ADDR_AGGR_INT_SUM_MASK  0xC02A4
+
