+#define GET_SFP_STATUS_ADDRESS(idx, reg) \
+        if(idx < CPLDB_SFP_NUM) \
+            reg = SFP_1_12_STATUS_BASE + (idx / 2); \
+        else if(idx < CPLDA_SFP_NUM + CPLDB_SFP_NUM)    \
+            reg = SFP_13_40_STATUS_BASE + ((idx-CPLDB_SFP_NUM) / 2);  \
