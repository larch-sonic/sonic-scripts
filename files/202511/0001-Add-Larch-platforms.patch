+if _INPROCESS_ENABLED:
+    _warmup_child_clis()
+# Always patch Popen so subprocess fallbacks honor sudo -u <req.user>.
+subprocess.Popen = _ProxyPopen
+
+# -------------------------------
+# Load Click CLIs (show/config)
+# -------------------------------
+import click
+from click.testing import CliRunner
+
+
+from show.main import cli as show_cli  # type: ignore
+from config.main import config as config_cli
+
+def _get_cli(prog: str):
+    if prog == "show":
+        return show_cli
+    if prog == "config":
+        return config_cli
+    raise HTTPException(status_code=400, detail=f"unknown prog={prog!r}")
+
+# -------------------------------
+# FastAPI app
+# -------------------------------
+app = FastAPI(title="SONiC CLI proxy", version="2.9")
+
+runner = CliRunner(mix_stderr=True)
+SEM = asyncio.Semaphore(int(os.getenv("SHOW_PROXY_MAX_CONCURRENCY", "4")))
+
+# CliRunner.invoke() rebinds the process-global sys.stdout/sys.stderr, and
+# _invoke_click() additionally redirects fd 2 process-wide via os.dup2. Both
+# touch shared process state, so two concurrent invocations from the executor
+# would interleave their output and return one command's stdout as another
+# command's response. Serialize the whole capture/invoke section.
+_INVOKE_LOCK = threading.Lock()
+
+# -------------------------------
+# Models
+# -------------------------------
+class RunRequest(BaseModel):
+    # prog is optional for backward compatibility: default "show"
+    prog: Optional[str] = "show"
+    args: List[str]
+    timeout: Optional[float] = 60.0
+    # user to run subprocesses as (for cache isolation)
+    user: Optional[str] = None
+
+class CompleteRequest(BaseModel):
+    prog: str                 # "show" | "config"
+    words: List[str]          # ["show","interfaces","st"]...
+    cword: int                # index of the word under the cursor
+
+# -------------------------------
+# Helpers
+# -------------------------------
+def _invoke_click_runner(cli_obj, args: List[str]) -> dict:
+    """Run Click via CliRunner; caller must hold _INVOKE_LOCK."""
+    fd2_backup = os.dup(2)
+    try:
+        r_fd, w_fd = os.pipe()
+        try:
+            os.dup2(w_fd, 2)
+        finally:
+            os.close(w_fd)
+
+        captured_stderr: List[bytes] = []
+
+        def _drain_pipe():
+            while True:
+                try:
+                    chunk = os.read(r_fd, 4096)
+                    if not chunk:
+                        break
+                    captured_stderr.append(chunk)
+                except OSError:
+                    break
+
+        drain_thread = threading.Thread(target=_drain_pipe, daemon=True)
+        drain_thread.start()
+
+        try:
+            res = runner.invoke(cli_obj, args, catch_exceptions=True)
+        finally:
+            os.dup2(fd2_backup, 2)
+
+        drain_thread.join(timeout=2.0)
+        os.close(r_fd)
+    finally:
+        os.close(fd2_backup)
+
+    subprocess_stderr = b"".join(captured_stderr).decode(errors="replace")
+    payload = {
+        "stdout": res.output or "",
+        "stderr": subprocess_stderr,
+        "exit_code": int(res.exit_code),
+    }
+    if res.exception and not isinstance(res.exception, SystemExit):
+        err_line = f"{type(res.exception).__name__}: {res.exception}"
+        payload["stderr"] = (payload["stderr"] + "\n" + err_line).lstrip("\n")
+        payload["exit_code"] = payload["exit_code"] or 1
+    return payload
+
+
+def _reset_configdb_caches() -> None:
+    """Drop process-wide caches that hold CONFIG_DB-derived values.
+
+    The daemon imports the show/config CLIs once, when the service starts,
+    which on a booting switch is before config-setup has loaded CONFIG_DB.
+    Whatever those imports cache is then served for the life of the process:
+    sonic_py_common.device_info keeps the platform/hwsku dictionary in a module
+    global, so `show version` and `show platform summary` printed
+    "HwSKU: None" on a freshly installed switch until the service was
+    restarted (Redmine #35885), while the very same call from a short-lived
+    python process returned the right value. A `config reload` that changes the
+    hwsku would go stale the same way, so refresh per command rather than once
+    at startup. The version info (sonic_ver_info) comes from a static file and
+    is deliberately left cached.
+    """
+    try:
+        from sonic_py_common import device_info
+        device_info.hw_info_dict = {}
+    except Exception:
+        pass
+    # sfpshow and sfputil load the logical -> physical port map once per
+    # process, from the PORT table. A port breakout changes that table, and the
+    # map kept from before it made "show interfaces transceiver eeprom" fail
+    # with "Unable to get first subport" for the new sub-ports. Let them
+    # reload it on their next run.
+    try:
+        from utilities_common import platform_sfputil_helper
+        platform_sfputil_helper.platform_porttab_mapping_read = False
+    except Exception:
+        pass
+
+
+def _invoke_click(cli_obj, args: List[str], user: Optional[str] = None):
+    """Run a warmed CLI command via Click; in-process child CLIs via Popen hook."""
+    set_run_as_user(user)
+    _INVOKE_LOCK.acquire()
+    try:
+        _reset_configdb_caches()
+        return _invoke_click_runner(cli_obj, args)
+    finally:
+        _INVOKE_LOCK.release()
+        set_run_as_user(None)
+
+def _collect_candidates_for_command(cmd: click.BaseCommand) -> List[str]:
+    """Return a list of subcommands and options for the current command."""
+    cands: List[str] = []
+
+    # subcommands, if this is a group / multi-command
+    if isinstance(cmd, click.MultiCommand):
+        try:
+            subs = cmd.list_commands(click.Context(cmd, resilient_parsing=True)) or []
+        except Exception:
+            subs = list(getattr(cmd, "commands", {}).keys() or [])
+        cands.extend(subs)
+
+    # options (short/long)
+    try:
+        for p in getattr(cmd, "params", []):
+            if isinstance(p, click.Option):
+                for o in p.opts + p.secondary_opts:
+                    if o:
+                        cands.append(o)
+    except Exception:
+        pass
+
+    # deduplicate while preserving order
+    seen = set()
+    out: List[str] = []
+    for c in cands:
+        if c and c not in seen:
+            out.append(c)
+            seen.add(c)
+    return out
+
+def _descend_command(cli_obj, tokens: List[str]) -> click.BaseCommand:
+    """
+    Descend the command tree according to completed tokens (exact matches).
+    Return the "current" command (group or leaf).
+    """
+    cmd: click.BaseCommand = cli_obj
+    for t in tokens:
+        if isinstance(cmd, click.MultiCommand):
+            sub = cmd.get_command(click.Context(cmd, resilient_parsing=True), t)
+            if sub is None:
+                break
+            cmd = sub
+        else:
+            break
+    return cmd
+
+# -------------------------------
+# Endpoints
+# -------------------------------
+@app.get("/healthz")
+async def healthz():
+    return PlainTextResponse("ok")
+
+@app.get("/version")
+async def version():
+    return JSONResponse({"version": app.version})
+
+@app.post("/run")
+async def run_cmd(req: RunRequest):
+    prog = (req.prog or "show").strip().lower()
+    cli_obj = _get_cli(prog)
+    if not req.args:
+        raise HTTPException(status_code=400, detail="args must be non-empty")
+
+    async with SEM:
+        loop = asyncio.get_running_loop()
+        # Pass user to _invoke_click so subprocesses run as the calling user
+        payload = await loop.run_in_executor(
+            None,
+            lambda: _invoke_click(cli_obj, req.args, req.user)
+        )
+        # always 200; client (shim) exits with exit_code
+        return JSONResponse(payload, status_code=200)
+
+@app.post("/complete")
+async def complete(req: CompleteRequest):
+    cli_obj = _get_cli(req.prog.strip().lower())
+
+    words = list(req.words)
+    cword = int(req.cword)
+
+    # if the first token is the program name, drop it
+    if words and words[0] == req.prog:
+        words = words[1:]
+        cword = max(0, cword - 1)   # <<< IMPORTANT: decrement the index!
+
+    # determine incomplete token and the "trail" to the current command
+    if cword >= len(words):
+        incomplete = ""
+        trail = words[:]            # everything completed, cursor after word/space
+    else:
+        incomplete = words[cword]
+        trail = words[:cword]
+
+    cmd = _descend_command(cli_obj, trail)
+    cands = _collect_candidates_for_command(cmd)
+
+    if incomplete:
+        cands = [c for c in cands if c.startswith(incomplete)]
+
+    return JSONResponse({"candidates": cands})
