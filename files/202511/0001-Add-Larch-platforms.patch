@@ -0,0 +1,9 @@
+# Disable panic on unrecovered/unknown NMI for the WNC RSEM-W1-32 platform.
+# During Marvell Falcon ASIC initialization (syncd startup), the SAI library
+# triggers PCIe transactions that cause the chipset to assert an NMI with
+# unknown reason (0x3d on port 0x61, i.e., neither SERR nor IOCHK).
+# The kernel cmdline unknown_nmi_panic=0 is overridden by vmcore-sysctl.conf;
+# this file (zz- prefix) re-overrides it after vmcore-sysctl.conf runs.
+kernel.unknown_nmi_panic=0
+kernel.panic_on_unrecovered_nmi=0
+kernel.panic_on_io_nmi=0
