+#EEPROM_PATH = '/sys/bus/i2c/devices/{}-0050/eeprom'
+EEPROM_PATH = '/sys/bus/i2c/devices/{}/sfp{}_eeprom'
+SFP_I2C_START = 50
+
+class Sfp(SfpOptoeBase):
