+        raise NotImplementedError
+
+    def __get_gpio_num(self, function: GpioFunction):
+        i2c_base = '/sys/devices/platform/cp0/cp0:config-space@f2000000/' 
+
+        bus_id, chip_addr, port_idx = self.__get_chip_path_components()
