+	/* The following are only relevant for TX or FROM_CPU: */
+	GDMA_CMD_BIT_VALID	= (1 << 5),
+	GDMA_CMD_BIT_FIRST	= (1 << 6),
+	GDMA_CMD_BIT_LAST	= (1 << 7),
