+#!/bin/sh
+# postinst script for sonic-platform-ln3824g
+#
+# see: dh_installdeb(1)
+
+chmod a+x /usr/local/bin/canisminor-init.sh
+chmod +x /usr/local/bin/show
+chmod +x /usr/local/bin/cli_proxy
+chmod +x /usr/local/bin/config
+chmod +x /usr/local/bin/show_fallback
+chmod +x /usr/local/bin/config_fallback
+depmod -a
+systemctl restart kmod
+# Apply MPLS sysctl after kmod loads mpls modules on first boot
+sysctl -p /etc/sysctl.d/90-mpls.conf || true
+systemctl enable canisminor-init.service
+systemctl start canisminor-init.service
+systemctl enable sonic-utilities-proxy.service
+systemctl start sonic-utilities-proxy.service
+exit 0
