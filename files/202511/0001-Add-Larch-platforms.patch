+static inline void mvppnd_edit_reg_or(struct mvppnd_dev *ppdev, u32 reg_addr,
+				      u32 value)
+{
+	u32 v;
+
+	v = mvppnd_read_reg(ppdev, reg_addr);
+	v |= value;
+	mvppnd_write_reg(ppdev, reg_addr, v);
+}
