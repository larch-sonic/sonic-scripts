+static int get_id_from_attr_name(const char *name)
+{
+    int id;
+
+    if (strstr(name, "qsfp") == NULL && strstr(name, "sfpS") != NULL) {
+        if (strstr(name, "sfpS") != name) {
+            printk(KERN_ERR "get_sfpS device_attribute has strange name %s", name);
+            return -1;
+        }
+        id = simple_strtol(&name[4], NULL, 10);
+        if (id < 1 || id > 2) {
+            printk(KERN_ERR "get_sfpS device_attribute has strange number %d", id);
+            return -2;
+        }
+        return id;
+    }
+
+    if (strstr(name, "qsfp") == NULL) {
+        printk(KERN_ERR "get_qsfp device_attribute has strange name %s", name);
+        return -1;
+    }
+
+    if (strstr(name, "qsfp") != name) {
+        printk(KERN_ERR "get_qsfp device_attribute has strange name %s", name);
+        return -1;
+    }
+
+    id = simple_strtol(&name[4], NULL, 10);
+    if (id < 1 || id > 32) {
+        printk(KERN_ERR "get_qsfp device_attribute has strange number %d", id);
+        return -2;
+    }
+    return id;
+}
