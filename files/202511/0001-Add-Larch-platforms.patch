+static ssize_t fan_input_show(struct device *dev, struct device_attribute *devattr,
+			       char *buf)
+{
+	struct sensor_device_attribute *attr = to_sensor_dev_attr(devattr);
+
+	u8 high = 0;
+	u8 low = 0;
+
+	if (attr->index == 0) {
+		ec_read(0x73, &low);
+		ec_read(0x74, &high);
+	} else {
+		ec_read(0x75, &low);
+		ec_read(0x76, &high);
+	}
+
+	return sprintf(buf, "%d\n", (high << 8 | low));
+}
+
+static ssize_t fan_status_show(struct device *dev, struct device_attribute *devattr,
+				char *buf)
+{
+	struct sensor_device_attribute *attr = to_sensor_dev_attr(devattr);
+	struct silicom_data *data = dev_get_drvdata(dev);
+	acpi_handle handle = acpi_device_handle(data->acpi_dev);
+	struct acpi_buffer buffer = { ACPI_ALLOCATE_BUFFER, NULL };
+	struct acpi_buffer format = { sizeof("NN"), "NN" };
+	union acpi_object *obj;
+	struct ecfw_fan_entry fan;
+	struct acpi_buffer fanentry = { sizeof(fan),  &fan };
+	acpi_status status;
+
+	status = acpi_evaluate_object(handle, "FRTS", NULL, &buffer);
+	if (!ACPI_FAILURE(status)) {
+		obj = buffer.pointer;
+		if (!obj || obj->type != ACPI_TYPE_PACKAGE || obj->package.count != 2) {
+			dev_err(handle, "Invalid FRTS");
+			goto out;
+		}
+
+		status = acpi_extract_package(&obj->package.elements[1], &format, &fanentry);
+
+		if (ACPI_FAILURE(status)) {
+			dev_err(handle, "Invalid FRTS Entry");
+			goto out;
+		} else {
+			dev_err(handle, "Temperature: %d", (int)fan.temp);
+			dev_err(handle, "RPM: %d", (int)fan.rpm);
+		}
+	}
+out:
+	return sprintf(buf, "%d\n", attr->index);
+}
+
+static SENSOR_DEVICE_ATTR_RO(fan1_input, fan_input, 0);
+static SENSOR_DEVICE_ATTR_RO(fan2_input, fan_input, 1);
+static SENSOR_DEVICE_ATTR_RO(fan1_status, fan_status, 0);
+static SENSOR_DEVICE_ATTR_RO(fan2_status, fan_status, 1);
+
+static struct attribute *ecfw_fan_attrs[] = {
+	&sensor_dev_attr_fan1_input.dev_attr.attr,
+	&sensor_dev_attr_fan1_status.dev_attr.attr,
+	&sensor_dev_attr_fan2_input.dev_attr.attr,
+	&sensor_dev_attr_fan2_status.dev_attr.attr,
+	NULL
+};
+
+static const struct attribute_group ecfw_fan_group = {
+	.attrs = ecfw_fan_attrs,
+};
+
+static ssize_t pwm_show(struct device *dev, struct device_attribute *devattr,
+			char *buf)
+{
+	struct sensor_device_attribute *attr = to_sensor_dev_attr(devattr);
+	uint8_t value;
+
+	switch (attr->index) {
+	case 0:
+		ec_read(0x3D, &value);
+		break;
+	case 1:
+		ec_read(0x3E, &value);
+		break;
+	default:
+		return 0;
+	}
+	return sprintf(buf, "%u\n", value);
+}
+
+static ssize_t pwm_store(struct device *dev, struct device_attribute *devattr,
+			  const char *buf, size_t count)
+{
+	struct sensor_device_attribute *attr = to_sensor_dev_attr(devattr);
+	struct silicom_data *data = dev_get_drvdata(dev);
+	long val;
+	uint8_t enable;
+	int err;
+
+	err = kstrtol(buf, 10, &val);
+	if (err)
+		return err;
+
+	/* TBD, may interfere with \_TZ operations */
+	mutex_lock(&data->lock);
+	ec_read(0x4d, &enable);
+	ec_write(0x4d, enable|2);
+	ec_write(0x41, attr->index);
+	ec_write(0x43, (uint8_t)(val >> 8));
+	ec_write(0x44, (uint8_t)val);
+	ec_write(0x3A, 0x1A);           /* update PWM cmd */
+	mutex_unlock(&data->lock);
+
+	return count;
+}
+
+static SENSOR_DEVICE_ATTR_RW(pwm1, pwm, 0);
+static SENSOR_DEVICE_ATTR_RW(pwm2, pwm, 1);
+
+static struct attribute *ecfw_pwm_attrs[] = {
+	&sensor_dev_attr_pwm1.dev_attr.attr,
+	&sensor_dev_attr_pwm2.dev_attr.attr,
+	NULL
+};
+
+static const struct attribute_group ecfw_pwm_group = {
+	.attrs = ecfw_pwm_attrs,
+};
+
+static ssize_t temp_show(struct device *dev, struct device_attribute *devattr,
+			 char *buf)
+{
+	struct sensor_device_attribute *attr = to_sensor_dev_attr(devattr);
+	struct silicom_data *data = dev_get_drvdata(dev);
+	uint16_t value;
+	uint8_t val;
+
+	mutex_lock(&data->lock);
+	switch (attr->index) {
+	case 0:
+		ec_read(0x93, &val);
+		value = val;
+		ec_read(0x94, &val);
+		value |= val << 8;
+		break;
+	case 1:
+		ec_read(0x95, &val);
+		value = val;
+		ec_read(0x96, &val);
+		value |= val << 8;
+		break;
+	case 2:
+		ec_read(0x97, &val);
+		value = val;
+		ec_read(0x98, &val);
+		value |= val << 8;
+		break;
+	case 3:
+		ec_read(0x99, &val);
+		value = val;
+		ec_read(0x9A, &val);
+		value |= val << 8;
+		break;
+	default:
+		pr_err("Unknown temp input index\n");
+		mutex_unlock(&data->lock);
+		return 0;
+	}
+	mutex_unlock(&data->lock);
+	return sprintf(buf, "%u\n", value*1000);
+
+}
+
+static SENSOR_DEVICE_ATTR_RO(temp1, temp,  0);
+static SENSOR_DEVICE_ATTR_RO(temp2, temp,  1);
+static SENSOR_DEVICE_ATTR_RO(temp3, temp,  2);
+static SENSOR_DEVICE_ATTR_RO(temp4, temp,  3);
+
+static struct attribute *ecfw_temp_attrs[] = {
+	&sensor_dev_attr_temp1.dev_attr.attr,
+	&sensor_dev_attr_temp2.dev_attr.attr,
+	&sensor_dev_attr_temp3.dev_attr.attr,
+	&sensor_dev_attr_temp4.dev_attr.attr,
+	NULL
+};
+
+static const struct attribute_group ecfw_temp_group = {
+	.attrs = ecfw_temp_attrs,
+};
+
+enum event_types {
+	HOTKEY = 1
+};
+
+static void ecbtn_acpi_notify(acpi_handle handle,  u32 event, void *context)
+{
+	struct platform_device *device = context;
+	struct acpi_device *acpi_dev = ACPI_COMPANION(&device->dev);
+	u8 ev_type = HOTKEY;
+
+	switch (event) {
+	case ACPI_BUTTON_NOTIFY_SWBTN_PRESSED:
+		pr_info("reset pressed\n");
+		break;
+	case ACPI_BUTTON_NOTIFY_SWBTN_RELEASE:
+		pr_info("reset released\n");
+		break;
+	default:
+		pr_err("silicom_mec unknown notify event: 0x%x\n", event);
+	}
+	acpi_bus_generate_netlink_event(acpi_dev->pnp.device_class,
+			dev_name(&acpi_dev->dev), ev_type, event);
+}
+
+static int silicom_gpio_chip_init(struct platform_device *device)
+{
+	int err;
+	struct silicom_data *data = dev_get_drvdata(&device->dev);
+	const struct acpi_device_id *acpi_dev_id;
+
+	acpi_dev_id = acpi_match_device(device_ids, &device->dev);
+	if (acpi_dev_id) {
+		silicom_gpio_chip.names = gpio_names[acpi_dev_id->driver_data];
+		silicom_gpio_chip.ngpio = gpio_channel_nums[acpi_dev_id->driver_data];
+		data->gpio_channels = gpio_channels[acpi_dev_id->driver_data];
+		err = devm_gpiochip_add_data(&device->dev, &silicom_gpio_chip, gpio_channels[acpi_dev_id->driver_data]);
+	}
+
+	if (err) {
+		dev_err(&device->dev, "Failed to register gpiochip: %d\n", err);
+		return err;
+	}
+
+	data->gpiochip = &silicom_gpio_chip;
+	data->ngpio = silicom_gpio_chip.ngpio;
+	silicom_data_ptr = data;
+
+	return 0;
+}
+
+static ssize_t rstbtn_soft_show(struct device *dev, struct device_attribute *attr,
+				char *buf)
+{
+	struct silicom_data *data = dev_get_drvdata(dev);
+	acpi_handle handle = acpi_device_handle(data->acpi_dev);
+	acpi_status status;
+	unsigned long long value;
+
+	if (acpi_has_method(handle, "RSTG")) {
+		status = acpi_evaluate_integer(handle, "RSTG", NULL, &value);
+		if (ACPI_FAILURE(status))
+			value = -1;
+	} else {
+		pr_err("BIOS does not support soft reset button, please update your BIOS");
+		return -ENODEV;
+	}
+
+	return sprintf(buf, "%u\n", (int)value);
+}
+
+static ssize_t rstbtn_soft_store(struct device *dev, struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct silicom_data *data = dev_get_drvdata(dev);
+	acpi_handle handle = acpi_device_handle(data->acpi_dev);
+	int err, val;
+
+	err = kstrtoint(buf, 0, &val);
+
+	if (err)
+		return err;
+
+	if (val == 0 || val == 1) {
+		if (acpi_has_method(handle, "RSTB")) {
+			acpi_execute_simple_method(handle, "RSTB", val);
+		} else {
+			pr_err("BIOS does not support soft reset button, please update your BIOS");
+			return -ENODEV;
+		}
+	}
+
+	return count;
+}
+
+static ssize_t rstbtn_status_show(struct device *dev, struct device_attribute *attr,
+				  char *buf)
+{
+	struct silicom_data *data = dev_get_drvdata(dev);
+	acpi_handle handle = acpi_device_handle(data->acpi_dev);
+	acpi_status status;
+	unsigned long long value;
+
+	if (acpi_has_method(handle, "RSTS")) {
+		status = acpi_evaluate_integer(handle, "RSTS", NULL, &value);
+		if (ACPI_FAILURE(status))
+			value = -1;
+	} else {
+		pr_err("BIOS does not have reset button status method, please upgrade your BIOS");
+		value = -1;
+	}
+
+	return sprintf(buf, "%u\n", (int)value);
+}
+
+static DEVICE_ATTR_RW(rstbtn_soft);
+static DEVICE_ATTR_RO(rstbtn_status);
+
+static struct attribute *rstbtn_sysfs_entries[] = {
+	&dev_attr_rstbtn_soft.attr,
+	&dev_attr_rstbtn_status.attr,
+	NULL,
+};
+
+static const struct attribute_group rstbtn_attr_group = {
+	.name   = NULL,
+	.attrs  = rstbtn_sysfs_entries,
+};
+
+static int silicom_mec_probe(struct platform_device *device)
+{
+	int ret;
+	struct acpi_device *acpi_dev;
+	struct silicom_data *data;
+	struct ecfw_led *led;
+	struct ecfw_button *button;
+	struct input_dev *input;
+	acpi_handle handle;
+	acpi_status status;
+	int i;
+
+	data = devm_kzalloc(&device->dev, sizeof(*data), GFP_KERNEL);
+
+	if (!data)
+		return -ENOMEM;
+
+	dev_set_drvdata(&device->dev, data);
+	data->platform_device = device;
+
+	ret = silicom_gpio_chip_init(device);
+
+	if (ret)
+		goto fail_platform;
+
+	acpi_dev = ACPI_COMPANION(&device->dev);
+	data->acpi_dev = acpi_dev;
+
+	for (i = 0; i < 2; i++) {
+		led = devm_kzalloc(&device->dev, sizeof(*led), GFP_KERNEL);
+		ret = ecfw_init_led(&device->dev, led, 3, i);
+		if (ret)
+			goto out;
+
+		data->mc_led_array[i] = led;
+		led->data = data;
+	}
+
+	for (i = 2; i < 14; i++) {
+		led = devm_kzalloc(&device->dev, sizeof(*led), GFP_KERNEL);
+		ret = ecfw_init_led(&device->dev, led, 1, i);
+		if (ret)
+			goto out;
+		data->gpio_led_array[i-2] = led;
+		led->data = data;
+	}
+
+	mutex_init(&data->lock);
+
+	/*
+	 * setup button as an input device
+	 */
+	button = devm_kzalloc(&device->dev, sizeof(*button), GFP_KERNEL);
+	if (!button)
+		goto fail_input;
+
+	button->input = input = devm_input_allocate_device(&device->dev);
+	if (!input) {
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	data->button = button;
+
+	snprintf(button->phys, sizeof(button->phys), "%s/button/input0", "ecfw");
+
+	ret = sparse_keymap_setup(input, silicom_array_keymap, NULL);
+	input->name = "ECFW Recessed Button";
+	input->phys = button->phys;
+	input->id.bustype = BUS_HOST;
+	input->dev.parent = &device->dev;
+
+	if (ret)
+		goto out;
+
+	ret = input_register_device(input);
+	if (ret)
+		goto out;
+
+	handle = ACPI_HANDLE(&device->dev);
+	status = acpi_install_notify_handler(handle,
+					     ACPI_DEVICE_NOTIFY,
+					     ecbtn_acpi_notify,
+					     device);
+	if (ACPI_FAILURE(status)) {
+		dev_err(&device->dev, "Error installing notify handler\n");
+		return -EIO;
+	}
+	if (acpi_has_method(handle, "RSTB")) {
+		ret = sysfs_create_group(&acpi_dev->dev.kobj, &rstbtn_attr_group);
+
+		if (ret)
+			goto out;
+		acpi_execute_simple_method(handle, "RSTB", 1);
+	}
+
+	return 0;
+
+	input_free_device(input);
+out:
+fail_input:
+	pr_err("Unable to allocate Silicom-Checkpoint MEC172x input device\n");
+fail_platform:
+	pr_err("Unable to allocate Silicom-Checkpoint MEC172x platform device\n");
+	return ret;
+}
+
+#if (LINUX_VERSION_CODE < KERNEL_VERSION(6,11,0))
+static int silicom_mec_remove(struct platform_device *device)
+#else
+static void silicom_mec_remove(struct platform_device *device)
+#endif
+{
+	struct silicom_data *data = platform_get_drvdata(device);
+	acpi_handle handle = ACPI_HANDLE(&device->dev);
+
+	ecfw_remove_led_files(data);
+
+	sysfs_remove_group(&(ACPI_COMPANION(&device->dev)->dev.kobj), &rstbtn_attr_group);
+	acpi_remove_notify_handler(handle, ACPI_DEVICE_NOTIFY,
+				   ecbtn_acpi_notify);
+	mutex_destroy(&data->lock);
+
+#if (LINUX_VERSION_CODE < KERNEL_VERSION(6,11,0))
+	return 0;
+#endif
+}
+
+static struct platform_driver silicom_driver = {
+	.driver = {
+		.name = "silicom-mec",
+		.acpi_match_table = device_ids,
+	},
+	.probe = silicom_mec_probe,
+	.remove = silicom_mec_remove,
+};
+
+module_platform_driver(silicom_driver);
diff --git a/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/modules/tlv-reader.c b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/modules/tlv-reader.c
new file mode 100644
index 000000000..2474fc068
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/modules/tlv-reader.c
@@ -0,0 +1,254 @@
+// tlv-reader.c
+//
+// TLVInfo EEPROM reader (256-byte only)
+// Behavior:
+//   • Reads 256B from I2C EEPROM
+//   • Detects TLVInfo signature
+//   • If TLV length > 256B: warn, skip CRC, still search for tag
+//   • If CRC fails: warn, still search for tag
+//   • Searches all buses if bus < 0
+//
+// API:
+//   int tlv_read_tag(int bus, u16 addr, u8 tag,
+//		      char *outbuf, size_t outsz, u8 *outlen);
+//
+//   Returns 0 if tag found, negative errno otherwise.
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/i2c.h>
+#include <linux/slab.h>
+#include <linux/crc32.h>
+#include <linux/string.h>
+#include <linux/version.h>
+#include "tlv-reader.h"
+
+#define EEPROM_LEN      256
+#define TLV_HDR_LEN     11
+#define TLV_CRC_TAG     0xFE
+#define MAX_I2C_BUS     256
+
+static int i2c_buses = 32;
+module_param(i2c_buses, int, 0644);
+MODULE_PARM_DESC(i2c_buses,
+                 "Number of I2C buses to scan when bus < 0");
+
+/* --------------------------------------------------------------------
+ * Read the 256-byte EEPROM at (adapter, addr)
+ * --------------------------------------------------------------------
+ */
+static int eeprom_read_256(struct i2c_adapter *adap,
+			   u16 addr,
+			   u8 *buf)
+{
+    struct i2c_client *client;
+    int ret, off = 0;
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5,5,0)
+    client = i2c_new_dummy_device(adap, addr);
+#else
+    client = i2c_new_dummy(adap, addr);
+#endif
+    if (IS_ERR(client))
+	return PTR_ERR(client);
+
+    /* Try block reads first */
+    while (off < EEPROM_LEN) {
+	int chunk = min(EEPROM_LEN - off, I2C_SMBUS_BLOCK_MAX);
+	ret = i2c_smbus_read_i2c_block_data(client, off, chunk, &buf[off]);
+	if (ret <= 0)
+	    goto slow_path;
+	off += ret;
+    }
+
+    i2c_unregister_device(client);
+    return 0;
+
+slow_path:
+    /* Retry with individual byte reads */
+    for (off = 0; off < EEPROM_LEN; off++) {
+	s32 v = i2c_smbus_read_byte_data(client, off);
+	if (v < 0) {
+	    ret = v;
+	    goto out;
+	}
+	buf[off] = (u8)v;
+    }
+    ret = 0;
+
+out:
+    i2c_unregister_device(client);
+    return ret;
+}
+
+/* --------------------------------------------------------------------
+ * TLVInfo helpers
+ * --------------------------------------------------------------------
+ */
+
+static bool tlv_has_signature(const u8 *e)
+{
+    return !memcmp(e, "TlvInfo", 7);
+}
+
+static u16 tlv_total_length(const u8 *e)
+{
+    return ((u16)e[8] << 8) | e[9];
+}
+
+static int tlv_validate_crc(const u8 *e)
+{
+    u16 total = tlv_total_length(e);
+    u16 end = TLV_HDR_LEN + total;
+
+    /* CRC TLV must be fully inside 256B */
+    if (end + 6 > EEPROM_LEN)
+	return -EINVAL;
+
+    if (e[end] != TLV_CRC_TAG)
+	return -EINVAL;
+
+    if (e[end + 1] != 4)
+	return -EINVAL;
+
+    u32 stored_crc =
+	((u32)e[end + 2] << 24) |
+	((u32)e[end + 3] << 16) |
+	((u32)e[end + 4] <<  8) |
+	 (u32)e[end + 5];
+
+    /* CRC covers TLVs excluding CRC TLV */
+    u32 calc_crc = crc32(0, &e[TLV_HDR_LEN], total - 6);
+
+    return (stored_crc == calc_crc) ? 0 : -EIO;
+}
+
+static int tlv_find_tag(const u8 *e,
+			u8 tag,
+			char *outbuf,
+			size_t outsz,
+			u8 *outlen)
+{
+    u16 total = tlv_total_length(e);
+    u16 idx = TLV_HDR_LEN;
+    u16 end = min_t(u16, TLV_HDR_LEN + total, EEPROM_LEN - 6);
+
+    while (idx + 2 <= end) {
+	u8 t = e[idx];
+	u8 len = e[idx + 1];
+
+	if (t == TLV_CRC_TAG)
+	    return -ENOENT;
+
+	if (idx + 2 + len > end)
+	    return -EINVAL;
+
+	if (t == tag) {
+	    size_t copy = min_t(size_t, len, outsz - 1);
+	    memcpy(outbuf, &e[idx + 2], copy);
+	    outbuf[copy] = '\0';
+	    if (outlen)
+		*outlen = copy;
+	    return 0;
+	}
+
+	idx += 2 + len;
+    }
+
+    return -ENOENT;
+}
+
+/* --------------------------------------------------------------------
+ * Try a single bus
+ * --------------------------------------------------------------------
+ */
+static int try_bus(int bus,
+		   u16 addr,
+		   u8 tag,
+		   char *outbuf,
+		   size_t outsz,
+		   u8 *outlen)
+{
+    struct i2c_adapter *adap;
+    u8 *buf;
+    int ret;
+    u16 total;
+
+    adap = i2c_get_adapter(bus);
+    if (!adap)
+	return -ENODEV;
+
+    buf = kzalloc(EEPROM_LEN, GFP_KERNEL);
+    if (!buf) {
+	i2c_put_adapter(adap);
+	return -ENOMEM;
+    }
+
+    ret = eeprom_read_256(adap, addr, buf);
+    if (ret)
+	goto out;
+
+    if (!tlv_has_signature(buf)) {
+	ret = -ENOMSG;
+	goto out;
+    }
+
+    total = tlv_total_length(buf);
+
+    if (TLV_HDR_LEN + total + 6 > EEPROM_LEN) {
+	pr_warn("TLVInfo total length (%u bytes) exceeds 256-byte EEPROM; CRC skipped\n",
+		total);
+    } else {
+	ret = tlv_validate_crc(buf);
+	if (ret)
+	    pr_warn("TLVInfo CRC failed: %d (continuing anyway)\n", ret);
+    }
+
+    /* Search for desired tag */
+    ret = tlv_find_tag(buf, tag, outbuf, outsz, outlen);
+
+out:
+    kfree(buf);
+    i2c_put_adapter(adap);
+    return ret;
+}
+
+/* --------------------------------------------------------------------
+ * Public API
+ * --------------------------------------------------------------------
+ */
+int tlv_read_tag(int bus,
+		 u16 addr,
+		 u8 tag,
+		 char *outbuf,
+		 size_t outsz,
+		 u8 *outlen)
+{
+    int ret, buses = min(i2c_buses, MAX_I2C_BUS);
+
+    if (!outbuf || outsz < 2)
+	return -EINVAL;
+
+    if (bus >= 0)
+	return try_bus(bus, addr, tag, outbuf, outsz, outlen);
+
+    /* Search mode: iterate all I²C buses */
+    for (int b = 0; b < buses; b++) {
+	ret = try_bus(b, addr, tag, outbuf, outsz, outlen);
+
+	if (ret == 0)
+	    return 0;
+
+	/* Skip only expected “not found” errors and keep searching */
+	if (ret == -ENODEV || ret == -ENXIO || ret == -ENOMSG)
+	    continue;
+    }
+
+    return -ENOENT;
+}
+EXPORT_SYMBOL_GPL(tlv_read_tag);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Jeff Lackey");
+MODULE_DESCRIPTION("TLVInfo EEPROM reader");
+
diff --git a/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/modules/tlv-reader.h b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/modules/tlv-reader.h
new file mode 100644
index 000000000..e713d2807
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/modules/tlv-reader.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * tlv-reader.h
+ *
+ * Public API for reading ONIE TLVInfo fields from an I2C EEPROM.
+ *
+ * This header is used by other kernel modules that depend on
+ * tlv-reader.c (which must be built and loaded separately).
+ *
+ * The helper supports:
+ *   - Reading a 256-byte TLVInfo EEPROM at a given (bus, addr)
+ *   - Optional scanning of all I2C buses when bus < 0
+ *   - Signature detection ("TlvInfo")
+ *   - Optional CRC validation (warn-only)
+ *   - TLV tag lookup
+ *
+ * The helper guarantees:
+ *   - It never reads beyond 256 bytes
+ *   - It returns the first matching TLV tag found
+ *   - It prints warnings instead of failing when length/CRC exceed safe bounds
+ */
+
+#ifndef _TLV_READER_H_
+#define _TLV_READER_H_
+
+#include <linux/types.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * tlv_read_tag() - Read TLVInfo tag from I2C EEPROM
+ *
+ * @bus:      I2C bus number, or <0 to search all buses up to max_i2c_bus
+ * @addr:     7-bit I2C address of EEPROM (e.g. 0x56)
+ * @tag:      TLV tag to search for
+ * @outbuf:   Output buffer (must be non-NULL)
+ * @outsz:    Size of output buffer (>=2 recommended)
+ * @outlen:   Optional: returns number of bytes copied
+ *
+ * Return:
+ *    0        Success, tag found and copied to outbuf
+ *   -ENOENT   Tag not found
+ *   -ENOMSG   TLVInfo signature not present on EEPROM
+ *   -EINVAL   Invalid args or TLV structure malformed
+ *   -EIO      CRC mismatch (but typically treated as warning only)
+ *   -ENODEV   I2C bus does not exist
+ *   -EFAULT   Other read/IO errors
+ *
+ * Notes:
+ *   - Only the first 256 bytes of EEPROM are examined.
+ *   - If TLVInfo declares a size >256B, the function warns and continues.
+ *   - CRC check failures also generate warnings but do not block tag lookup.
+ */
+int tlv_read_tag(int bus,
+                 u16 addr,
+                 u8  tag,
+                 char *outbuf,
+                 size_t outsz,
+                 u8 *outlen);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _TLV_READER_H_ */
+
