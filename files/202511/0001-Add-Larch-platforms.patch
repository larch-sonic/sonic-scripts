+static ssize_t
+hwmon_sfp_bin_read(struct file *filp, struct kobject *kobj,
+        struct bin_attribute *attr,
+        char *buf, loff_t off, size_t count)
+{
+    int num;
+    struct hwmon_sfp_data *sfp;
+    ssize_t retval = 0;
+
+    sfp = dev_get_drvdata(container_of(kobj, struct device, kobj));
+
+    mutex_lock(&sfp->lock);
+
+    num = hwmon_sfp_select (attr);
+    if (num >= 0)
+        retval = hwmon_sfp_read(sfp, buf, off, count, num);
+    hwmon_sfp_deselect (attr);
+
+    mutex_unlock(&sfp->lock);
+    return retval;
+}
