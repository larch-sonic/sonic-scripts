+#define GET_BIT(data, bit, value)       (value) = ((data) >> (bit)) & 0x1
+#define SET_BIT(data, bit)              (data) |= (1 << (bit))
+#define CLEAR_BIT(data, bit)            (data) &= ~(1 << (bit))
