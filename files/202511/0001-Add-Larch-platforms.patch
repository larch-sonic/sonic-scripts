+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+
+import os
+import sys
+import json
+import pwd
+import asyncio
+import subprocess
+import threading
+import importlib
+import importlib.util
+import contextlib
+import io
+from importlib.machinery import SourceFileLoader
+from typing import List, Optional
+
+from fastapi import FastAPI, HTTPException
+from starlette.responses import JSONResponse, PlainTextResponse
+from pydantic import BaseModel
+
+# -------------------------------
+# Thread-local storage for run-as-user
+# -------------------------------
+_thread_local = threading.local()
+
+def get_run_as_user() -> Optional[str]:
+    """Get the user to run subprocesses as (thread-local)."""
+    return getattr(_thread_local, 'run_as_user', None)
+
+def set_run_as_user(user: Optional[str]) -> None:
+    """Set the user to run subprocesses as (thread-local)."""
+    _thread_local.run_as_user = user
+
+# -------------------------------
+# Monkey-patch subprocess.Popen to run selected Python child CLIs in-process.
+# -------------------------------
+_OriginalPopen = subprocess.Popen
+_INPROCESS_LOCK = threading.RLock()
+_CHILD_CLI_MODULES = {}
+
+_CHILD_CLI_PATHS = {
+    'intfutil': '/usr/local/bin/intfutil',
+    'portstat': '/usr/local/bin/portstat',
+    'queuestat': '/usr/local/bin/queuestat',
+    'pfcstat': '/usr/local/bin/pfcstat',
+    'switchstat': '/usr/local/bin/switchstat',
+    'sfpshow': '/usr/local/bin/sfpshow',
+    'fdbshow': '/usr/local/bin/fdbshow',
+    'dropstat': '/usr/local/bin/dropstat',
+    'flow_counters_stat': '/usr/local/bin/flow_counters_stat',
+    'watermarkstat': '/usr/local/bin/watermarkstat',
+    'lldpshow': '/usr/local/bin/lldpshow',
+    'ipintutil': '/usr/local/bin/ipintutil',
+    'nbrshow': '/usr/local/bin/nbrshow',
+    'acl-loader': '/usr/local/bin/acl-loader',
+    'decode-syseeprom': '/usr/local/bin/decode-syseeprom',
+    'sfputil': '/usr/local/bin/sfputil',
+    'pfcwd': '/usr/local/bin/pfcwd',
+    'pg-drop': '/usr/local/bin/pg-drop',
+}
+
+_ACL_LOADER_SHOW_SUBCOMMANDS = frozenset({
+    'table',
+    'rule',
+    'session',
+    'policer',
+})
+
+_INTFUTIL_READONLY_COMMANDS = frozenset({
+    'status',
+    'description',
+    'autoneg',
+    'fec',
+    'link_training',
+})
+
+_SFPSHOW_READONLY_SUBCOMMANDS = frozenset({
+    'status',
+    'eeprom',
+    'info',
+    'presence',
+    'pm',
+})
+
+_SFPUTIL_READONLY_SHOW_SUBCOMMANDS = frozenset({
+    'lpmode',
+    'error-status',
+})
+
+_PFCWD_READONLY_SHOW_SUBCOMMANDS = frozenset({
+    'config',
+    'stats',
+})
+
+_FLOW_COUNTERS_MUTATING_OPTIONS = {
+    '-c', '--clear',
+    '-d', '--delete',
+}
+
+_WATERMARK_TYPES = frozenset({
+    'pg_headroom',
+    'pg_shared',
+    'q_shared_uni',
+    'q_shared_multi',
+    'buffer_pool',
+    'headroom_pool',
+    'q_shared_all',
+})
+
+_PORTSTAT_MUTATING_OPTIONS = {
+    '-c', '--clear',
+    '-d', '--delete',
+    '-D', '--delete-all',
+}
+
+_QUEUESTAT_MUTATING_OPTIONS = {
+    '-c', '--clear',
+    '-d', '--delete',
+}
+
+_PFCSTAT_MUTATING_OPTIONS = {
+    '-c', '--clear',
+    '-d', '--delete',
+}
+
+_SWITCHSTAT_MUTATING_OPTIONS = {
+    '-c', '--clear',
+    '-ds', '--delete',
+    '-da', '--delete-all',
+    '-T', '--tag',
+}
+
+_DB_POOL_ENABLED = os.getenv("SHOW_PROXY_DB_POOL", "1") == "1"
+
+
+def _inprocess_as_daemon_enabled() -> bool:
+    """True when matched child CLIs may run in the daemon process.
+
+    When enabled, matched child CLIs run in the warm daemon process instead of a
+    sudo subprocess. Process credentials stay as the daemon user, but UserCache
+    paths are aligned to req.user so counter cache files match clear commands
+    run by the same CLI user.
+    """
+    for name in (
+        "SHOW_PROXY_INPROCESS_AS_DAEMON",
+        "SHOW_PROXY_INPROCESS_UNSAFE",  # explicit alias
+        "SHOW_PROXY_INPROCESS",         # legacy alias
+    ):
+        if os.getenv(name, "0") == "1":
+            return True
+    return False
+
+
+_INPROCESS_ENABLED = _inprocess_as_daemon_enabled()
+
+
+def _load_child_cli(name: str, path: str):
+    if not os.path.exists(path):
+        return None
+
+    if name == "acl-loader":
+        try:
+            import acl_loader.main as mod
+            return mod
+        except Exception as e:
+            print(f"[warmup:{name}] warning: {e}", file=sys.stderr)
+            return None
+
+    if name == "pfcwd":
+        try:
+            import pfcwd.main as mod
+            return mod
+        except Exception as e:
+            print(f"[warmup:{name}] warning: {e}", file=sys.stderr)
+            return None
+
+    if name == "sfputil":
+        try:
+            import sfputil.main as mod
+            return mod
+        except Exception as e:
+            print(f"[warmup:{name}] warning: {e}", file=sys.stderr)
+            return None
+
+    try:
+        loader = SourceFileLoader(f'_sonic_cli_proxy_{name}', path)
+        spec = importlib.util.spec_from_loader(loader.name, loader)
+        if spec is None:
+            return None
+        module = importlib.util.module_from_spec(spec)
+        loader.exec_module(module)
+        return module
+    except Exception as e:
+        print(f"[warmup:{name}] warning: {e}", file=sys.stderr)
+        return None
+
+
+def _warmup_child_clis() -> None:
+    for name, path in _CHILD_CLI_PATHS.items():
+        module = _load_child_cli(name, path)
+        if module is not None:
+            _CHILD_CLI_MODULES[name] = module
+
+
+def _command_name(args) -> Optional[str]:
+    if not isinstance(args, (list, tuple)) or not args:
+        return None
+    return os.path.basename(str(args[0]))
+
+
+def _normalize_popen_argv(argv: List[str]) -> List[str]:
+    """Strip leading sudo [-u USER] wrappers from a Popen argv list."""
+    argv = [str(arg) for arg in argv]
+    i = 0
+    while i < len(argv):
+        if argv[i] != "sudo":
+            break
+        i += 1
+        if i < len(argv) and argv[i] == "-u":
+            i += 2
+    return argv[i:]
+
+
+def _install_db_pool() -> None:
+    """Reuse Redis/ConfigDB connectors across in-process child CLI calls.
+
+    Enabled by default (SHOW_PROXY_DB_POOL=1). Set to 0 to open fresh DB connectors
+    per command instead of reusing them across proxied show/config calls.
+    """
+    if not _DB_POOL_ENABLED:
+        return
+
+    try:
+        import sonic_py_common.multi_asic as ma
+    except Exception as e:
+        print(f"[warmup:db_pool] warning: {e}", file=sys.stderr)
+        return
+
+    if getattr(ma, "_cli_proxy_db_pool", False):
+        return
+
+    _orig_cfg = ma.connect_config_db_for_ns
+    _orig_all = ma.connect_to_all_dbs_for_ns
+    _cfg_pool = {}
+    _db_pool = {}
+
+    def _pooled_config(namespace=ma.DEFAULT_NAMESPACE):
+        if namespace not in _cfg_pool:
+            _cfg_pool[namespace] = _orig_cfg(namespace)
+        return _cfg_pool[namespace]
+
+    def _pooled_all(namespace=ma.DEFAULT_NAMESPACE):
+        if namespace not in _db_pool:
+            _db_pool[namespace] = _orig_all(namespace)
+        return _db_pool[namespace]
+
+    ma.connect_config_db_for_ns = _pooled_config
+    ma.connect_to_all_dbs_for_ns = _pooled_all
+    ma._cli_proxy_db_pool = True
+
+    try:
+        _pooled_config(ma.DEFAULT_NAMESPACE)
+        _pooled_all(ma.DEFAULT_NAMESPACE)
+    except Exception as e:
+        print(f"[warmup:db_pool] warning: {e}", file=sys.stderr)
+
+
+@contextlib.contextmanager
+def _usercache_as_caller(user: Optional[str]):
+    """Use the CLI caller's uid for UserCache paths (/tmp/cache/<app>/<uid>).
+
+    In-process child CLIs run as the daemon user, but stat CLIs store per-user
+    counter snapshots. Without this, admin's show counters and sonic_clear would
+    read/write different cache directories.
+    """
+    if not user:
+        yield
+        return
+
+    try:
+        from utilities_common.cli import UserCache
+        uid = pwd.getpwnam(user).pw_uid
+    except Exception:
+        yield
+        return
+
+    orig_init = UserCache.__init__
+
+    def _patched_init(self, app_name=None, tag=None):
+        orig_init(self, app_name, tag)
+        self.uid = uid
+        suffix = str(uid) if tag is None else f"{uid}-{tag}"
+        self.cache_directory_suffix = suffix
+        self.cache_directory = os.path.join(self.cache_directory_app, suffix)
+
+    UserCache.__init__ = _patched_init
+    try:
+        yield
+    finally:
+        UserCache.__init__ = orig_init
+
+
+def _default_display() -> str:
+    try:
+        from utilities_common import constants
+        from sonic_py_common import device_info, multi_asic
+
+        if not multi_asic.is_multi_asic() and not device_info.is_chassis():
+            return constants.DISPLAY_ALL
+        return constants.DISPLAY_EXTERNAL
+    except Exception:
+        return "frontend"
