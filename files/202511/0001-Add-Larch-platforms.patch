+static u8 mvppnd_our_queue_idx(struct mvppnd_dev *ppdev, int queue)
+{
+	int i;
+
+	for (i = NUM_OF_RX_QUEUES - 1; i >= 0; i--)
+		if (ppdev->rx_queues[i] == queue)
+			return i;
+
+	return NUM_OF_RX_QUEUES;
+}
