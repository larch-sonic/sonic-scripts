+def _is_safe_inprocess_child(args, kwargs) -> bool:
+    if not _INPROCESS_ENABLED:
+        return False
+    if kwargs.get("shell"):
+        return False
+    if not _popen_uses_stdout_pipe(kwargs):
+        return False
+    if not _popen_uses_text_mode(kwargs):
+        return False
+    if kwargs.get("stderr") == subprocess.STDOUT:
+        return False
+
+    if not isinstance(args, (list, tuple)):
+        return False
+
+    argv = _normalize_popen_argv([str(arg) for arg in args])
+    name = _command_name(argv)
+    if name not in _CHILD_CLI_MODULES:
+        return False
+
+    if name == "lldpshow":
+        return _is_lldpshow_argv(argv)
+
+    if name == "ipintutil":
+        return _is_ipintutil_argv(argv)
+
+    if name == "nbrshow":
+        return _is_nbrshow_argv(argv)
+
+    if name == "acl-loader":
+        return _is_acl_loader_show_argv(argv)
+
+    if name == "decode-syseeprom":
+        return _is_decode_syseeprom_argv(argv)
+
+    if name == "intfutil":
+        return _is_intfutil_readonly_argv(argv)
+
+    if name == "sfpshow":
+        return _is_sfpshow_readonly_argv(argv)
+
+    if name == "sfputil":
+        return _is_sfputil_show_argv(argv)
+
+    if name == "pfcwd":
+        return _is_pfcwd_show_argv(argv)
+
+    if name == "pg-drop":
+        return _is_pg_drop_show_argv(argv)
+
+    if name == "fdbshow":
+        return _is_fdbshow_argv(argv)
+
+    if name == "dropstat":
+        return _is_dropstat_show_argv(argv)
+
+    if name == "flow_counters_stat":
+        return _is_flow_counters_stat_argv(argv)
+
+    if name == "watermarkstat":
+        return _is_watermarkstat_argv(argv)
+
+    if name == "portstat":
+        if _argv_has_option(argv, _PORTSTAT_MUTATING_OPTIONS):
+            return False
+        return _is_portstat_counters_argv(argv)
+
+    if name == "queuestat":
+        return _is_queuestat_counters_argv(argv)
+
+    if name == "pfcstat":
+        return _is_pfcstat_counters_argv(argv)
+
+    if name == "switchstat":
+        return _is_switchstat_counters_argv(argv)
+
+    return False
