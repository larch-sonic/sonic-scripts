+        elif port_idx == 2: 
+            return '3'
+        elif port_idx == 3: 
+            return '5'
+        elif port_idx == 4: 
+            return '4'
+        elif port_idx == 5: 
+            return '7'
+        elif port_idx == 6: 
+            return '6'
+        elif port_idx == 7: 
