+static struct kobject *sfp_kobj;
+
+static int __init sfp_init(void)
+{
+    int status;
+    int i, k;
+    unsigned int j, jmax;
+    int base;
+    struct gpio_desc *desc;
+
+    /*
+     * Create the group under /sys/wnc_sfp (kernel_kobj->parent == /sys),
+     * which is where the SONiC platform sfp.py driver reads presence from.
+     */
+    sfp_kobj = kobject_create_and_add("wnc_sfp", kernel_kobj->parent);
+    if (!sfp_kobj) {
+        printk(KERN_ERR "Error = kobject_create_and_add wnc_sfp\n");
+        return -ENOMEM;
+    }
+
+    status = sysfs_create_group(sfp_kobj, &wnc_sfp_group);
+    if (status != 0) {
+        printk(KERN_ERR "Error, status(%d) = sysfs_create_group\n", status);
+        kobject_put(sfp_kobj);
+        return status;
+    }
+
+    /* Initialize QSFP ports via TCA6424 chips */
+    k = 0;
+    for (i = 0; i < TCA6424_CNT; i++) {
+        if (k >= QSFP_CNT)
+            break;
+
+        base = find_gpio_base_by_label(tca6424_labels[i]);
+        if (base < 0) {
+            status = base;
+            goto err;
+        }
+
+        j = base;
+        jmax = base + TCA6424_GPIO_CNT;
+
+        while (j < jmax) {
+            arr_gpio_Q[k].Int = j;
+            gpio_request(arr_gpio_Q[k].Int, "sysfs");
+            desc = gpio_to_desc(arr_gpio_Q[k].Int);
+            if (!desc) { status = -EINVAL; goto err; }
+            gpiod_direction_input(desc);
+            gpiod_export(desc, false);
+
+            arr_gpio_Q[k].Present = j + 1;
+            gpio_request(arr_gpio_Q[k].Present, "sysfs");
+            desc = gpio_to_desc(arr_gpio_Q[k].Present);
+            if (!desc) { status = -EINVAL; goto err; }
+            gpiod_direction_input(desc);
+            gpiod_export(desc, false);
+
+            arr_gpio_Q[k].Lowpower = j + 2;
+            gpio_request(arr_gpio_Q[k].Lowpower, "sysfs");
+            desc = gpio_to_desc(arr_gpio_Q[k].Lowpower);
+            if (!desc) { status = -EINVAL; goto err; }
+            gpiod_direction_output(desc, false);
+            gpiod_export(desc, false);
+            arr_gpio_Q[k].LowpowerValue = 0;
+
+            arr_gpio_Q[k].Reset = j + 3;
+            gpio_request(arr_gpio_Q[k].Reset, "sysfs");
+            desc = gpio_to_desc(arr_gpio_Q[k].Reset);
+            if (!desc) { status = -EINVAL; goto err; }
+            gpiod_direction_output(desc, false);
+            gpiod_export(desc, false);
+            arr_gpio_Q[k].ResetValue = 1;
+
+            k++;
+            j += 4;
+            if (k >= QSFP_CNT)
+                break;
+        }
+    }
+
+    /* Initialize SFP ports via TCA6408 chip (10-0021) */
+    base = find_gpio_base_by_label(tca6408_label);
+    if (base < 0) {
+        status = base;
+        goto err;
+    }
+
+    k = 0;
+    j = base;
+    jmax = base + TCA6408_GPIO_CNT;
+
+    while (j < jmax) {
+        arr_gpio_S[k].RXLos = j;
+        gpio_request(arr_gpio_S[k].RXLos, "sysfs");
+        desc = gpio_to_desc(arr_gpio_S[k].RXLos);
+        if (!desc) { status = -EINVAL; goto err; }
+        gpiod_direction_input(desc);
+        gpiod_export(desc, false);
+
+        arr_gpio_S[k].Present = j + 1;
+        gpio_request(arr_gpio_S[k].Present, "sysfs");
+        desc = gpio_to_desc(arr_gpio_S[k].Present);
+        if (!desc) { status = -EINVAL; goto err; }
+        gpiod_direction_input(desc);
+        gpiod_export(desc, false);
+
+        arr_gpio_S[k].TXEnable = j + 2;
+        gpio_request(arr_gpio_S[k].TXEnable, "sysfs");
+        desc = gpio_to_desc(arr_gpio_S[k].TXEnable);
+        if (!desc) { status = -EINVAL; goto err; }
+        gpiod_direction_output(desc, false);
+        gpiod_export(desc, false);
+
+        arr_gpio_S[k].TXFault = j + 3;
+        gpio_request(arr_gpio_S[k].TXFault, "sysfs");
+        desc = gpio_to_desc(arr_gpio_S[k].TXFault);
+        if (!desc) { status = -EINVAL; goto err; }
+        gpiod_direction_input(desc);
+        gpiod_export(desc, false);
+
+        k++;
+        if (k >= SFP_CNT)
+            break;
+        j += 4;
+    }
+
+    return 0;
+
+err:
+    printk(KERN_ERR "Error, status(%d) = sfp_init\n", status);
+    sysfs_remove_group(sfp_kobj, &wnc_sfp_group);
+    kobject_put(sfp_kobj);
+    return status;
+}
+
+static void __exit sfp_exit(void)
+{
+    int i;
+    struct gpio_desc *desc;
+
+    for (i = 0; i < QSFP_CNT; i++) {
+        if (gpio_is_valid(arr_gpio_Q[i].Int)) {
+            desc = gpio_to_desc(arr_gpio_Q[i].Int);
+            if (desc) gpiod_unexport(desc);
+            gpio_free(arr_gpio_Q[i].Int);
+        }
+        if (gpio_is_valid(arr_gpio_Q[i].Present)) {
+            desc = gpio_to_desc(arr_gpio_Q[i].Present);
+            if (desc) gpiod_unexport(desc);
+            gpio_free(arr_gpio_Q[i].Present);
+        }
+        if (gpio_is_valid(arr_gpio_Q[i].Reset)) {
+            desc = gpio_to_desc(arr_gpio_Q[i].Reset);
+            if (desc) gpiod_unexport(desc);
+            gpio_free(arr_gpio_Q[i].Reset);
+        }
+        if (gpio_is_valid(arr_gpio_Q[i].Lowpower)) {
+            desc = gpio_to_desc(arr_gpio_Q[i].Lowpower);
+            if (desc) gpiod_unexport(desc);
+            gpio_free(arr_gpio_Q[i].Lowpower);
+        }
+    }
+
+    for (i = 0; i < SFP_CNT; i++) {
+        if (gpio_is_valid(arr_gpio_S[i].RXLos)) {
+            desc = gpio_to_desc(arr_gpio_S[i].RXLos);
+            if (desc) gpiod_unexport(desc);
+            gpio_free(arr_gpio_S[i].RXLos);
+        }
+        if (gpio_is_valid(arr_gpio_S[i].Present)) {
+            desc = gpio_to_desc(arr_gpio_S[i].Present);
+            if (desc) gpiod_unexport(desc);
+            gpio_free(arr_gpio_S[i].Present);
+        }
+        if (gpio_is_valid(arr_gpio_S[i].TXEnable)) {
+            desc = gpio_to_desc(arr_gpio_S[i].TXEnable);
+            if (desc) gpiod_unexport(desc);
+            gpio_free(arr_gpio_S[i].TXEnable);
+        }
+        if (gpio_is_valid(arr_gpio_S[i].TXFault)) {
+            desc = gpio_to_desc(arr_gpio_S[i].TXFault);
+            if (desc) gpiod_unexport(desc);
+            gpio_free(arr_gpio_S[i].TXFault);
+        }
+    }
+
+    sysfs_remove_group(sfp_kobj, &wnc_sfp_group);
+    kobject_put(sfp_kobj);
+}
+
+module_init(sfp_init);
+module_exit(sfp_exit);
