+            bus_id = '3'
+            group_id = math.ceil((self.port_num - 24) / 4)
+            chip_addr = chip_addr_map[group_id]
+            port_idx = (self.port_num - 24) % 4
+        else:
+            raise NotImplementedError
+        
+        return bus_id, chip_addr, port_idx 
