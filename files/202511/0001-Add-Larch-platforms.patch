+/*********** tx functions ******************************/
+static int mvppnd_xmit_buf(struct mvppnd_dev *ppdev,
+			   struct mvppnd_switch_flow *flow, const char *macs,
+			   struct mvppnd_dma_sg_buf *sgb,
+			   u32 vtag32)
+{
+	bool sdma_took, wait_too_long;
+	size_t wr_ptr, wr_ptr_first, wr_next;
+	size_t total_bytes = 0;
+	u32 tmp_next_desc_ptr; /* TODO: Working in 'list' mode */
+	u32 own_bit = ppdev->own_bit, crc_bit = ppdev->crc_bit,
+		      tx_last_bit = ppdev->tx_last_bit,
+		      tx_first_bit = ppdev->tx_first_bit,
+		      valid_bit = ppdev->valid_bit;
+	unsigned long jiffs; /* Wait for SDMA to take the desc */
+	int data_ptr;
+	int ret;
+	u8 *dsa_ptr;
+
+	if (!sgb->mappings[0])
+		return -EINVAL;
+
+	wr_ptr = cyclic_idx(ppdev->tx_queue.ring.descs_ptr, TX_RING_SIZE);
+	wr_ptr_first = wr_ptr;
+
+	/* MAC */
+	memcpy(ppdev->mac.virt, macs, ETH_ALEN * 2);
+	XDMA_DESC_SET_PTR(ppdev, ppdev->tx_queue.ring.descs[wr_ptr], ppdev->mac.dma);
+	XDMA_TX_DESC_SET_BYTE_CNT(ppdev, ppdev->tx_queue.ring.descs[wr_ptr],
+			     ETH_ALEN * 2);
+	total_bytes += ETH_ALEN * 2;
+	/*
+	dev_dbg(&ppdev->pdev->dev, "MACs: desc %d, len %d (%ld), ptr 0x%llx\n",
+		wr_ptr, ETH_ALEN * 2, total_bytes, ppdev->mac.dma);
+	*/
+	cyclic_inc(&wr_ptr, TX_RING_SIZE);
+
+	/* DSA */
+	print_dsa(flow->ndev->name, "tx", (u8 *)flow->config_tx_dsa);
+	memcpy(ppdev->dsa.virt, flow->config_tx_dsa, flow->config_tx_dsa_size);
+	dsa_ptr = (u8 *)ppdev->dsa.virt;
+	if ( (!(*dsa_ptr & 0x20)) && (vtag32 & VTAG32_PRESENT) ) {
+		/*
+		 * if user did not define vlan tag in DSA tag, but incoming
+		 * packet has a tag, then copy the tag from the skb to the DSA tag.
+		 * So if the user wants to pass both untagged and tagged data,
+		 * he needs to define the DSA tag as untagged (which is the default).
+		 */
+		*dsa_ptr |= 0x20; /* target tagged with VLAN */
+		dsa_ptr[2] = ((vtag32 >> 8) & 0xe0) |
+				0x10 /* another DSA word exists - must for eDSA */ |
+				((vtag32 & 0xf00) >> 8);
+		dsa_ptr[3] = vtag32 & 0xff;
+	}
+	XDMA_DESC_SET_PTR(ppdev, ppdev->tx_queue.ring.descs[wr_ptr], ppdev->dsa.dma);
+	XDMA_TX_DESC_SET_BYTE_CNT(ppdev, ppdev->tx_queue.ring.descs[wr_ptr],
+			     flow->config_tx_dsa_size);
+	ppdev->tx_queue.ring.descs[wr_ptr]->cmd_sts &= (~(tx_first_bit | tx_last_bit));
+	ppdev->tx_queue.ring.descs[wr_ptr]->cmd_sts |= (own_bit |
+						      crc_bit | valid_bit);
+	/*
+	dev_dbg(&ppdev->pdev->dev, "DSA : desc %d, len %d (%ld), ptr 0x%llx\n",
+		wr_ptr, DSA_SIZE_SIP7, total_bytes, ppdev->dsa.dma);
+	*/
+	total_bytes += flow->config_tx_dsa_size;
+	cyclic_inc(&wr_ptr, TX_RING_SIZE);
+
+	/* Data */
+	data_ptr = 0;
+	while (sgb->mappings[data_ptr]) {
+		XDMA_DESC_SET_PTR(ppdev, ppdev->tx_queue.ring.descs[wr_ptr],
+			sgb->mappings[data_ptr]);
+		sgb->sizes[data_ptr] += CRC_SIZE;
+		XDMA_TX_DESC_SET_BYTE_CNT(ppdev, ppdev->tx_queue.ring.descs[wr_ptr],
+				     sgb->sizes[data_ptr]);
+		total_bytes += sgb->sizes[data_ptr];
+		ppdev->tx_queue.ring.descs[wr_ptr]->cmd_sts &= (~(tx_first_bit | tx_last_bit));
+		ppdev->tx_queue.ring.descs[wr_ptr]->cmd_sts |=
+			(own_bit | crc_bit | valid_bit);
+#ifdef MVPPND_DEBUG_DATA_PATH
+		dev_info(ppdev->dev,
+			"data: desc %ld, len %ld (%ld, %ld), ptr 0x%llx\n",
+			wr_ptr, sgb->sizes[data_ptr],
+			total_bytes - flow->config_tx_dsa_size, total_bytes,
+			sgb->mappings[data_ptr]);
+#endif
+
+		data_ptr++;
+		/* We have more? */
+		if ((data_ptr < ARRAY_SIZE(sgb->mappings) - 1) &&
+		     sgb->mappings[data_ptr])
+			cyclic_inc(&wr_ptr, TX_RING_SIZE);
+		else
+			break;
+	}
+
+	/* Last descriptor - add last */
+	ppdev->tx_queue.ring.descs[wr_ptr]->cmd_sts |= tx_last_bit;
+	/* TODO: For some reason ring does not work so for now let's use list */
+	tmp_next_desc_ptr = ppdev->tx_queue.ring.descs[wr_ptr]->next_desc_ptr;
+	XDMA_DESC_SET_NEXT(ppdev, ppdev->tx_queue.ring.descs[wr_ptr], 0);
+
+	wr_next = wr_ptr;
+	cyclic_inc(&wr_next, TX_RING_SIZE);
+	ppdev->tx_queue.ring.descs[wr_next]->cmd_sts = 0; /* invalidate next descriptor */
+	/*pr_info("%s: dmaptr %llx\n", __func__, ppdev->tx_queue.ring.ring_dma);*/
+	if (!ppdev->sip7)
+		mvppnd_write_tx_first_desc(ppdev,
+					   ppdev->tx_queue.ring.ring_dma & 0xffffffff,
+					   ppdev->tx_queue.ring.ring_dma >> 32,
+					   TX_RING_SIZE);
+
+	/* We are ready, let's update the first descriptor - ownership, CRC &
+	   first */
+	ppdev->tx_queue.ring.descs[wr_ptr_first]->cmd_sts &= (~tx_last_bit);
+	ppdev->tx_queue.ring.descs[wr_ptr_first]->cmd_sts |=
+		own_bit | crc_bit | tx_first_bit | valid_bit;
+
+	/* Flush descriptors before enabling the queue */
+	mb();
+
+	if (!ppdev->sip7)
+		mvppnd_enable_queue(ppdev, REG_ADDR_TX_QUEUE_CMD, ppdev->tx_queue_num);
+
+	if (ppdev->sip7) { /* tell GDMA how many desciptors have we passed to its ownership: */
+		mb();
+		mdelay(1);
+		mvppnd_write_reg(ppdev,
+				 REG_ADDR_GDMA_Q_SGD_ADD_GDMA_SGD_OWN(
+				 GDMA_NUM_FROM_CPU, ppdev->tx_queue_num + GDMA_KRNL_ETH_DRV_Q_OFS),
+				 data_ptr + 2);
+	}
+
+	jiffs = jiffies;
+	do {
+		sdma_took = ((ppdev->tx_queue.ring.descs[wr_ptr]->cmd_sts &
+			     own_bit) != own_bit);
+		wait_too_long = (jiffies_to_usecs(jiffies - jiffs) >
+				 TX_WAIT_FOR_CPU_OWENERSHIP_USEC);
+		if (unlikely(ppdev->sip7))
+			msleep(1);
+		else
+			mb();
+	} while (!sdma_took && !wait_too_long);
+
+	/* check again if buffer is still not free: */
+	wait_too_long = ((ppdev->tx_queue.ring.descs[wr_ptr]->cmd_sts &
+                             own_bit) == own_bit);
+
+	/*
+	dev_dbg(&ppdev->pdev->dev,
+		"Took %d usec to SDMA to take the descriptor\n",
+		jiffies_to_usecs(jiffies - jiffs));
+	*/
+
+	/* TODO: For some reason ring does not work so for now let's use list */
+	if (!ppdev->sip7) {
+		ppdev->tx_queue.ring.descs_ptr = 0;
+		XDMA_DESC_SET_NEXT(ppdev, ppdev->tx_queue.ring.descs[wr_ptr], tmp_next_desc_ptr);
+	} else {
+	/* TODO: GDMA - The ring thing */
+		cyclic_inc(&wr_ptr, TX_RING_SIZE);
+		ppdev->tx_queue.ring.descs_ptr = wr_ptr;
+	}
+	if (wait_too_long) {
+		ret = -EIO;
+		tx_tout++; /* increment counter indicating SDMA TX timeout occured */
+		if (ppdev->sip7) {
+			pr_err("TX TOUT q %d first desc ptr %llx frst idx %lu bd sts %x addr %x nxt idx %lu bd sts %x addr %x wr idx %lu bd sts %x addr %x en_q %x num_pass_own %u qnum %u tot_bytes %u\n",
+				ppdev->tx_queue_num,
+				ppdev->tx_queue.ring.ring_dma,
+				wr_ptr_first,
+				ppdev->tx_queue.ring.descs[wr_ptr_first]->cmd_sts,
+				ppdev->tx_queue.ring.descs[wr_ptr_first]->bc,
+				wr_ptr_first + 1,
+				ppdev->tx_queue.ring.descs[wr_ptr_first + 1]->cmd_sts,
+				ppdev->tx_queue.ring.descs[wr_ptr_first + 1]->bc,
+				wr_next - 1,
+				ppdev->tx_queue.ring.descs[wr_next - 1]->cmd_sts,
+				ppdev->tx_queue.ring.descs[wr_next - 1]->bc,
+				mvppnd_read_reg(ppdev,REG_ADDR_GDMA_Q_EN_STS(GDMA_NUM_FROM_CPU,
+				ppdev->tx_queue_num + GDMA_KRNL_ETH_DRV_Q_OFS))
+				& GDMA_Q_EN_STS_BIT_EN, data_ptr + 2, ppdev->tx_queue_num, (u32)total_bytes);
+
+				prt_dbg_gdma_tx(ppdev, ppdev->tx_queue.ring.descs[wr_ptr_first], ppdev->tx_queue.ring.descs[wr_ptr_first + 1], ppdev->tx_queue.ring.descs[wr_next]);
+
+		} else {
+			pr_err("TX TOUT q %d first desc ptr %llx frst idx %lu bd sts %x addr %x wr idx %lu bd sts %x addr %x en_q %x vendor %x devid %x \n",
+				ppdev->tx_queue_num,
+				ppdev->tx_queue.ring.ring_dma,
+				wr_ptr_first,
+				ppdev->tx_queue.ring.descs[wr_ptr_first]->cmd_sts,
+				ppdev->tx_queue.ring.descs[wr_ptr_first]->buf_addr,
+				wr_ptr,
+				ppdev->tx_queue.ring.descs[wr_ptr]->cmd_sts,
+				ppdev->tx_queue.ring.descs[wr_ptr]->buf_addr,
+				mvppnd_read_reg(ppdev, REG_ADDR_TX_QUEUE_CMD),
+				mvppnd_read_reg(ppdev, REG_ADDR_VENDOR),
+				mvppnd_read_reg(ppdev, REG_ADDR_DEVICE) );
+			pr_err(
+"rej %x LW %x NDP %x CTDP %x cur %x cfg %x glbl ctrl %x ext glbl ctrl %x lpbck %x\n",
+				mvppnd_read_reg(ppdev, 0x28F4 ),
+				mvppnd_read_reg(ppdev, 0x2604 + ppdev->tx_queue_num*0x10),
+				mvppnd_read_reg(ppdev, 0x2608 + ppdev->tx_queue_num*0x10),
+				mvppnd_read_reg(ppdev, 0x2684),
+				mvppnd_read_reg(ppdev, 0x26C0 + ppdev->tx_queue_num*4),
+				mvppnd_read_reg(ppdev, 0x2800),
+				mvppnd_read_reg(ppdev, 0x58),
+				mvppnd_read_reg(ppdev, 0x5C),
+				mvppnd_read_reg(ppdev, 0x64)
+								);
+		}
+	}
+	else
+		ret = total_bytes - ETH_ALEN * 2 - flow->config_tx_dsa_size;
+
+#ifdef MVPPND_DEBUG_DATA_PATH
+	dev_info(ppdev->dev, "Total sent %d\n", ret);
+#endif
+
+	return ret;
+}
+
+static bool mvppnd_rings_empty(struct mvppnd_dev *ppdev)
+{
+	struct mvppnd_ring *r = NULL;
+	u32 rxqs, own_bit = ppdev->own_bit;
+
+	for(rxqs = 0; rxqs< NUM_OF_RX_QUEUES; rxqs++) {
+		if (ppdev->rx_queues[rxqs]) {
+			r = &ppdev->rx_queues[rxqs]->ring;
+			if((r->descs[r->descs_ptr]->cmd_sts &
+			    own_bit) != own_bit) {
+				rings_not_empty++;
+				return false;
+			}
+		}
+	}
+
+	rings_empty++;
+	return true;
+}
