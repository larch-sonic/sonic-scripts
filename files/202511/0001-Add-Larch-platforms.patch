+static int silicom_ec_temp_is_visible(const struct silicom_ec_hwmon *hw, u32 attr, int channel)
+{
+	const struct silicom_ec_sdata *tbl;
+	int tbl_size;
+
+	tbl = hw->bdata->tables[hwmon_temp];
+	tbl_size = hw->bdata->table_size[hwmon_temp];
+
+	if (channel >= tbl_size)
+		return 0;
+
+	switch (attr) {
+	case hwmon_temp_input:
+	case hwmon_temp_label:
+	case hwmon_temp_type:
+		return 0444;
+	case hwmon_temp_max:
+		if (tbl[channel].reg_max)
+			return 0444;
+		break;
+	case hwmon_temp_crit:
+		if (tbl[channel].reg_crit)
+			return 0444;
+		break;
+	case hwmon_temp_min:
+		if (tbl[channel].reg_min)
+			return 0444;
+		break;
+	case hwmon_temp_alarm:
+		if (tbl[channel].reg_alarm)
+			return 0444;
+		break;
+	default:
+		break;
+	}
+	return 0;
+}
