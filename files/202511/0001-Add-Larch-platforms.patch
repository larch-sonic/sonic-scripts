index 000000000..9c8768610
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/qn-sr-200/scripts/qn-sr-200-rebrand.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+# This platform ships for a customer who wants the NOS to identify itself as
+# QNOS, so the factory hostname is qnos rather than sonic.
+#
+# The name is written into CONFIG_DB rather than applied with hostnamectl, and
+# this runs before hostname-config.service, so the stock hostname-config.sh is
+# what actually applies it. That keeps /etc/hostname and /etc/hosts consistent
+# with each other - setting the hostname directly leaves the old name in
+# /etc/hosts, which is what the stock script exists to avoid.
+
+DEFAULT_HOSTNAME='qnos'
+
+current=$(sonic-db-cli CONFIG_DB HGET 'DEVICE_METADATA|localhost' hostname 2>/dev/null)
+
+# Only claim the name while it is still the stock default. Anything an operator
+# has configured is theirs, and this must not fight it on every boot.
+if [ -z "$current" ] || [ "$current" = "sonic" ]; then
+    sonic-db-cli CONFIG_DB HSET 'DEVICE_METADATA|localhost' hostname "$DEFAULT_HOSTNAME" > /dev/null
+    echo "qn-sr-200: hostname set to $DEFAULT_HOSTNAME"
+fi
