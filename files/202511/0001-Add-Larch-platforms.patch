+static const struct attribute_group hwmon_cpldA_group = { .attrs = hwmon_cpldA_attributes};
+static const struct attribute_group hwmon_cpldB_group = { .attrs = hwmon_cpldB_attributes};
+static const struct attribute_group hwmon_cpldC_group = { .attrs = hwmon_cpldC_attributes};
+
+static void hwmon_cpld_add_client(struct i2c_client *client)
+{
+    struct cpld_client_node *node = kzalloc(sizeof(struct cpld_client_node), GFP_KERNEL);
+
+    if (!node) {
+        dev_dbg(&client->dev, "Can't allocate cpld_client_node (0x%x)\n", client->addr);
+        return;
+    }
+
+    node->client = client;
+
+    mutex_lock(&list_lock);
+    list_add(&node->list, &cpld_client_list);
+    mutex_unlock(&list_lock);
+}
+
+static void hwmon_cpld_remove_client(struct i2c_client *client)
+{
+    struct list_head        *list_node = NULL;
+    struct cpld_client_node *cpld_node = NULL;
+    int found = 0;
+
+    mutex_lock(&list_lock);
+
+    list_for_each(list_node, &cpld_client_list)
+    {
+        cpld_node = list_entry(list_node, struct cpld_client_node, list);
+
+        if (cpld_node->client == client) {
+            found = 1;
+            break;
+        }
+    }
+
+    if (found) {
+        list_del(list_node);
+        kfree(cpld_node);
+    }
+
+    mutex_unlock(&list_lock);
+}
+
+static int hwmon_cpld_probe(struct i2c_client *client)
+{
+    int status;
+
+    if (!i2c_check_functionality(client->adapter, I2C_FUNC_SMBUS_BYTE_DATA)) {
+        dev_dbg(&client->dev, "i2c_check_functionality failed (0x%x)\n", client->addr);
+        status = -EIO;
+        goto exit;
+    }
+
+    /* Register sysfs hooks */
+    switch(client->addr)
+    {
+        case CPLDA_ADDRESS:
+            status = sysfs_create_group(&client->dev.kobj, &hwmon_cpldA_group);
+            break;
+        case CPLDB_ADDRESS:
+            status = sysfs_create_group(&client->dev.kobj, &hwmon_cpldB_group);
+            break;
+        case CPLDC_ADDRESS:
+            status = sysfs_create_group(&client->dev.kobj, &hwmon_cpldC_group);
+            break;
+        default:
+            dev_dbg(&client->dev, "i2c_check_CPLD failed (0x%x)\n", client->addr);
+            status = -EIO;
+            goto exit;
+            break;
+    }
+
+    if (status) {
+        goto exit;
+    }
+
+    dev_info(&client->dev, "chip found\n");
+    hwmon_cpld_add_client(client);
+
+    return 0;
+
+exit:
+    return status;
+}
+
+static void hwmon_cpld_remove(struct i2c_client *client)
+{
+    switch(client->addr)
+    {
+        case CPLDA_ADDRESS:
+            sysfs_remove_group(&client->dev.kobj, &hwmon_cpldA_group);
+            break;
+        case CPLDB_ADDRESS:
+            sysfs_remove_group(&client->dev.kobj, &hwmon_cpldB_group);
+            break;
+        case CPLDC_ADDRESS:
+            sysfs_remove_group(&client->dev.kobj, &hwmon_cpldC_group);
+            break;
+        default:
+            dev_dbg(&client->dev, "i2c_remove_CPLD failed (0x%x)\n", client->addr);
+            break;
+    }
+
+
+    hwmon_cpld_remove_client(client);
+}
+
+static const struct i2c_device_id hwmon_cpld_id[] = {
+    { "hwmon_cpld", 0 },
+    {}
+};
+MODULE_DEVICE_TABLE(i2c, hwmon_cpld_id);
+
+static struct i2c_driver hwmon_cpld_driver = {
+    .class      = I2C_CLASS_HWMON,
+    .driver = {
+        .name = "hwmon_cpld",
+    },
+    .probe      = hwmon_cpld_probe,
+    .remove     = hwmon_cpld_remove,
+    .id_table   = hwmon_cpld_id,
+    .address_list = normal_i2c,
+};
+
+static int __init hwmon_cpld_init(void)
+{
+    mutex_init(&list_lock);
+
+    return i2c_add_driver(&hwmon_cpld_driver);
+}
+
+static void __exit hwmon_cpld_exit(void)
+{
+    i2c_del_driver(&hwmon_cpld_driver);
+}
+
+MODULE_AUTHOR("Dmytro Kukhno <dkukhno@larch-networks.com>");
+MODULE_DESCRIPTION("hwmon_cpld driver");
+MODULE_LICENSE("GPL");
+
+module_init(hwmon_cpld_init);
+module_exit(hwmon_cpld_exit);
