+static struct kobject *sfp_kobj;
+
+static int __init sfp_init(void)
+{
+    int status;
+    int i;
+    int k;
+    unsigned j;
+    unsigned jmax;
+    /*printk(KERN_DEBUG "Init SFP moduled");*/
+
+    sfp_kobj = kobject_create_and_add("wnc_sfp", kernel_kobj->parent);
+
+    status = sysfs_create_group(sfp_kobj, &wnc_sfp_group);
+    if (status != 0) {
+        printk(KERN_ERR "Error, status(%d) = sysfs_create_group",status);
+        return status ;
+    }
+
+    k=0;
+    for(i=0; i < TCA6424_CNT; i++)  {
+
+        if (k >= QSFP_CNT) break;
+
+        j = (SFP_GPIO_BASE - i * TCA6424_GPIO_CNT) ;
+        jmax = ARCH_GPIO_BASE - i * TCA6424_GPIO_CNT;
+        while( j < jmax ) {
+            arr_gpio_Q[k].Int = j;
+            gpio_request(arr_gpio_Q[k].Int, "sysfs");
+            gpio_direction_input(arr_gpio_Q[k].Int);
+            //gpio_set_debounce(arr_gpio_Q[k].Int,200);
+            
+            /*printk(KERN_DEBUG "export gpio%d qsfp%d_int",arr_gpio_Q[k].Int,k);*/
+
+            arr_gpio_Q[k].Present = j+1;
+            gpio_request(arr_gpio_Q[k].Present, "sysfs");
+            //gpio_set_debounce(arr_gpio_Q[k].Present,200);
+            gpio_direction_input(arr_gpio_Q[k].Present);
+            
+            /*printk(KERN_DEBUG "export gpio%d qsfp%d_present",arr_gpio_Q[k].Present,k);*/
+
+            arr_gpio_Q[k].Lowpower = j+2;
+            gpio_request(arr_gpio_Q[k].Lowpower, "sysfs");
+            //gpio_direction_output(arr_gpio_Q[k].Lowpower,false); Temporary Stub
+            
+            /*printk(KERN_DEBUG "export gpio%d qsfp%d_lowpower",arr_gpio_Q[k].Lowpower,k);*/
+            arr_gpio_Q[k].LowpowerValue = 0 ;
+
+            arr_gpio_Q[k].Reset = j+3;
+            gpio_request(arr_gpio_Q[k].Reset, "sysfs");
+            //gpio_direction_output(arr_gpio_Q[k].Reset, false); Temporary Stub
+            
+            /*printk(KERN_DEBUG "export gpio%d qsfp%d_reset",arr_gpio_Q[k].Reset,k);*/
+            arr_gpio_Q[k].ResetValue = 1 ;
+
+            k++;
+            j = j + 4;
+            if (k >= QSFP_CNT) break;
+        }
+    }
+
+    k=0;
+
+    j = (ARCH_GPIO_BASE - TCA6424_CNT * TCA6424_GPIO_CNT - TCA6408_GPIO_CNT) ;
+    jmax = j + TCA6408_GPIO_CNT;
+    while( j < jmax) {
+        arr_gpio_S[k].RXLos = j;
+        gpio_request(arr_gpio_S[k].RXLos, "sysfs");
+        gpio_direction_input(arr_gpio_S[k].RXLos);
+        //gpio_set_debounce(arr_gpio_S[k].RXLos,200);
+        /*printk(KERN_DEBUG "export gpio%d sfp%d_rxlos",j,k);*/
+
+        arr_gpio_S[k].Present = j+1;
+        gpio_request(arr_gpio_S[k].Present, "sysfs");
+        //gpio_set_debounce(arr_gpio_S[k].Present,200);
+        gpio_direction_input(arr_gpio_S[k].Present);
+        /*printk(KERN_DEBUG "export gpio%d sfp%d_present",arr_gpio_S[k].Present,k);*/
+
+        arr_gpio_S[k].TXEnable = j+2;
+        gpio_request(arr_gpio_S[k].TXEnable, "sysfs");
+        //gpio_direction_output(arr_gpio_S[k].TXEnable, false); Temporary Stub
+        /*printk(KERN_DEBUG "export gpio%d sfp%d_txenable",arr_gpio_S[k].TXEnable,k);*/
+
+        arr_gpio_S[k].TXFault = j+3;
+        gpio_request(arr_gpio_S[k].TXFault, "sysfs");
+        gpio_direction_input(arr_gpio_S[k].TXFault);
+        /*printk(KERN_DEBUG "export gpio%d sfp%d_txfault",j+3,k);*/
+        k++;
+        if (k >= SFP_CNT) break;
+        j = j + 4;
+    }
+
+    if (status)
+        printk("error: sysfs_create_group");
+
+    return status;
+}
+
+static void __exit sfp_exit(void)
+{
+    int i;
+    /*printk(KERN_DEBUG "De init SFP module");*/
+
+    for (i=0; i<QSFP_CNT; i++) {
+
+
+        gpio_free(arr_gpio_Q[i].Int);
+        /*printk(KERN_DEBUG "free gpio%d arr_gpio_Q[%d].Int",arr_gpio_Q[i].Int,i);*/
+
+        gpio_free(arr_gpio_Q[i].Present);
+        /*printk(KERN_DEBUG "free gpio%d arr_gpio_Q[%d].Present",arr_gpio_Q[i].Present,i);*/
+
+        gpio_free(arr_gpio_Q[i].Reset);
+        /*printk(KERN_DEBUG "free gpio%d arr_gpio_Q[%d].Reset",arr_gpio_Q[i].Reset,i);*/
+
+        gpio_free(arr_gpio_Q[i].Lowpower);
+        /*printk(KERN_DEBUG "free gpio%d arr_gpio_Q[%d].Lowpower",arr_gpio_Q[i].Lowpower,i);*/
+    }
+
+    for (i=0; i<SFP_CNT; i++) {
+
+        gpio_free(arr_gpio_S[i].RXLos);
+        /*printk(KERN_DEBUG "free gpio%d arr_gpio_S[%d].Int",arr_gpio_S[i].RXLos,i);*/
+
+        gpio_free(arr_gpio_S[i].Present);
+        /*printk(KERN_DEBUG "free gpio%d arr_gpio_S[%d].Present",arr_gpio_S[i].Present,i);*/
+
+        gpio_free(arr_gpio_S[i].TXEnable);
+        /*printk(KERN_DEBUG "free gpio%d arr_gpio_S[%d].TXEnable",arr_gpio_S[i].TXEnable,i);*/
+
+        gpio_free(arr_gpio_S[i].TXFault);
+        /*printk(KERN_DEBUG "free gpio%d arr_gpio_S[%d].TXFault",arr_gpio_S[i].TXFault,i);*/
+    }
+
+    sysfs_remove_group(sfp_kobj, &wnc_sfp_group);
+    kobject_del(sfp_kobj);
+}
+
+module_init(sfp_init);
+module_exit(sfp_exit);
