diff --git a/device/larch/x86_64-DQS-5000-56ZS-A1/D-LINK_DQS-5000-56ZS-A1/buffers_config.j2 b/device/larch/x86_64-DQS-5000-56ZS-A1/D-LINK_DQS-5000-56ZS-A1/buffers_config.j2
