@@ -0,0 +1,42 @@
+#!/bin/bash
+
+# Platform init script
+qnsr50_profile()
+{
+	MAC_ADDR=$(fw_printenv -n ethaddr 2>/dev/null)
+	if [ -z "$MAC_ADDR" ]; then
+	    echo "$(basename "$0"): could not read ethaddr from the U-Boot environment;"
+	    echo "$(basename "$0"): leaving switchMacAddress in profile.ini untouched" >&2
+	    return 0
+	fi
+	find /usr/share/sonic/device/*qn-sr-50* -name profile.ini | xargs sed -i "s/switchMacAddress=.*/switchMacAddress=$MAC_ADDR/g"
+	echo "qn-sr-50: Updating switch mac address ${MAC_ADDR}"
+
+    rebrand # this platform is for customer who requires another name of nos
+}
+
+rebrand()
+{
+    # change a console pre-login banner
+    sudo bash -c "printf 'QNOS \S \\\r \m \l \n\n' > /etc/issue"
+
+    # The hostname is not set here. This unit runs before CONFIG_DB exists, and
+    # hostname-config.service would overwrite whatever is set now with the value
+    # from the database. qn-sr-50-rebrand.service puts qnos into CONFIG_DB in
+    # time for that service to apply it properly.
+}
+
+# Main
+qnsr50_profile
+
+# LOGIC to enumerate SFP eeprom devices - send 0x50 to kernel i2c driver - initialize devices
+# the mux may be enumerated at number 4 or 5 so we check for the mux and skip if needed
+# Get list of the mux channels
+# Enumerate the SFP eeprom device on each mux channel
+echo optoe2 0x50 > /sys/bus/i2c/devices/i2c-0/new_device
+# Enumerate system eeprom
+echo 24c64 0x52 > /sys/bus/i2c/devices/i2c-0/new_device
+sleep 2
+
+
+exit 0
diff --git a/platform/marvell-prestera/sonic-platform-larch/qn-sr-50/scripts/qn-sr-50-rebrand.sh b/platform/marvell-prestera/sonic-platform-larch/qn-sr-50/scripts/qn-sr-50-rebrand.sh
new file mode 100755
index 000000000..11ca34bc6
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/qn-sr-50/scripts/qn-sr-50-rebrand.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+# This platform ships for a customer who wants the NOS to identify itself as
+# QNOS, so the factory hostname is qnos rather than sonic.
+#
+# The name is written into CONFIG_DB rather than applied with hostnamectl, and
+# this runs before hostname-config.service, so the stock hostname-config.sh is
+# what actually applies it. That keeps /etc/hostname and /etc/hosts consistent
+# with each other - setting the hostname directly leaves the old name in
+# /etc/hosts, which is what the stock script exists to avoid.
+
+DEFAULT_HOSTNAME='qnos'
+
+current=$(sonic-db-cli CONFIG_DB HGET 'DEVICE_METADATA|localhost' hostname 2>/dev/null)
+
+# Only claim the name while it is still the stock default. Anything an operator
+# has configured is theirs, and this must not fight it on every boot.
+if [ -z "$current" ] || [ "$current" = "sonic" ]; then
+    sonic-db-cli CONFIG_DB HSET 'DEVICE_METADATA|localhost' hostname "$DEFAULT_HOSTNAME" > /dev/null
+    echo "qn-sr-50: hostname set to $DEFAULT_HOSTNAME"
+fi
