+static umode_t silicom_ec_is_visible(const void *data,
+				     enum hwmon_sensor_types type,
+				     u32 attr, int channel)
+{
+	const struct silicom_ec_hwmon *hw = data;
+
+	switch (type) {
+	case hwmon_temp:
+		return silicom_ec_temp_is_visible(hw, attr, channel);
+	case hwmon_in:
+		return silicom_ec_in_is_visible(hw, attr, channel);
+	case hwmon_curr:
+		return silicom_ec_curr_is_visible(hw, attr, channel);
+	case hwmon_fan:
+		return silicom_ec_fan_is_visible(hw, attr, channel);
+	case hwmon_power:
+		return silicom_ec_power_is_visible(hw, attr, channel);
+	default:
+		break;
+	}
+	return 0;
+}
