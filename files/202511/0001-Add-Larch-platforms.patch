+static int silicom_ec_hwmon_probe(struct platform_device *pdev)
+{
+	struct silicom_ec_hwmon *hw;
+	const struct acpi_device_id *acpi_id;
+	const struct resource *res;
+	struct device *hwmon_dev, *dev = &pdev->dev;
+	int i;
+	int ret;
+
+	res = platform_get_resource(pdev, IORESOURCE_IO, 0);
+	if (!res) {
+		dev_dbg(dev, "Couldn't find IO resource\n");
+		return -ENXIO;
+	}
+
+	hw = devm_kzalloc(dev, sizeof(*hw), GFP_KERNEL);
+	if (!hw)
+		return -ENOMEM;
+
+	hw->io_addr = devm_request_region(dev, res->start, resource_size(res),
+					  dev_name(dev));
+	if (!hw->io_addr) {
+		dev_dbg(dev, "Couldn't reserve IO resource\n");
+		goto no_request;
+	}
+
+	hw->dev = dev;
+	platform_set_drvdata(pdev, hw);
+
+	acpi_id = acpi_match_device(pdev->dev.driver->acpi_match_table,
+				    &pdev->dev);
+
+	if (!acpi_id) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	{
+	    const char *pn;
+	    char val[64];
+	    u8 len, tag = 0x52;
+	    int ret = 0;
+
+	    pn = dmi_get_system_info(DMI_PRODUCT_NAME);
+	    if (pn) {
+		dev_info(&pdev->dev, "DMI product name: \"%s\"\n", pn);
+	    } else {
+		dev_warn(&pdev->dev, "Failed to read DMI system info.\n");
+	    }
+
+	    ret = tlv_read_tag(-1, 0x56, tag, val, sizeof(val), &len);
+	    if (ret) {
+		dev_warn(&pdev->dev, "Failed to read TLV tag %02x: %d\n", tag, ret);
+	    } else {
+		val[63] = '\0';
+		pn = val;
+		dev_info(&pdev->dev, "TLV tag %02x (%u bytes): \"%s\"\n", tag, len, val);
+	    }
+
+	    if (pn) {
+		int i;
+		for (i = 0; pn_series_150[i]; i++) {
+		    if (strstr(pn, pn_series_150[i])) {
+			dev_info(&pdev->dev, "%s is a match (matched on %s)\n", pn, pn_series_150[i]);
+			series_200 = 0;
+			break;
+		    }
+		}
+		for (i = 0; pn_series_200[i]; i++) {
+		    if (strstr(pn, pn_series_200[i])) {
+			dev_info(&pdev->dev, "%s is a match (matched on %s)\n", pn, pn_series_200[i]);
+			series_200 = 1;
+			break;
+		    }
+		}
+	    }
+	}
+
+	if (series_200) {
+		hw->bdata = (const struct silicom_ec_hwmon_board_data *)silicom_ec_alt_hwmon_ids[acpi_id->driver_data].driver_data;
+		hw->chip.info = hw->bdata->hinfo;
+		hw->chip.ops = &silicom_ec_hwmon_ops;
+
+		hw->hw_name = devm_kstrdup(dev, silicom_ec_alt_hwmon_ids[acpi_id->driver_data].name, GFP_KERNEL);
+	} else {
+		hw->bdata = (const struct silicom_ec_hwmon_board_data *)silicom_ec_hwmon_ids[acpi_id->driver_data].driver_data;
+		hw->chip.info = hw->bdata->hinfo;
+		hw->chip.ops = &silicom_ec_hwmon_ops;
+
+		hw->hw_name = devm_kstrdup(dev, silicom_ec_hwmon_ids[acpi_id->driver_data].name, GFP_KERNEL);
+	}
+
+	if (!hw->hw_name)
+		return -ENOMEM;
+
+	for (i = 0; hw->hw_name[i]; i++) {
+		if (hwmon_is_bad_char(hw->hw_name[i]))
+			hw->hw_name[i] = '_';
+	}
+
+	hwmon_dev = devm_hwmon_device_register_with_info(dev, hw->hw_name, 
+							 hw, &hw->chip, NULL);
+
+	return PTR_ERR_OR_ZERO(hwmon_dev);
+	if (IS_ERR(hwmon_dev))
+		return PTR_ERR(hwmon_dev);
+
+	return 0;
+
+no_request:
+out:
+	return -ENODEV;
+
+}
+
+#if (LINUX_VERSION_CODE < KERNEL_VERSION(6,11,0))
+static int silicom_ec_hwmon_remove(struct platform_device *pdev)
+#else
+static void silicom_ec_hwmon_remove(struct platform_device *pdev)
+#endif
+{
+	/*
+	 * Larch: the hwmon device is devm-registered and released with the
+	 * platform device; hwmon_device_unregister(hw->dev) here was called
+	 * on the platform device itself and would crash on rmmod.
+	 */
+
+#if (LINUX_VERSION_CODE < KERNEL_VERSION(6,11,0))
+	return 0;
+#endif
+}
+
+static struct platform_driver silicom_ec_hwmon_driver = {
+	.probe = silicom_ec_hwmon_probe,
+	.remove = silicom_ec_hwmon_remove,
+	.driver = {
+		.name = "silicom-ec-hwmon",
+		.acpi_match_table = ACPI_PTR(silicom_ec_hwmon_acpi_match),
+	},
+};
+
+module_platform_driver(silicom_ec_hwmon_driver);
