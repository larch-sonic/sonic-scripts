+import os
+import sys
+
+try:
+    from sonic_platform_base.sonic_xcvr.sfp_optoe_base import SfpOptoeBase
+    from sonic_py_common import logger
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+if sys.version_info[0] < 3:
+    import commands as cmd
+else:
+    import subprocess as cmd
+
+smbus_present = 1
+
+try:
+    import smbus
+except ImportError as e:
+    smbus_present = 0
+
+
+# SFP PORT numbers
+SFP_PORT_START = 1
+SFP_PORT_END = 12
+
+QSFP_PORT_START = 13
+QSFP_PORT_END = 14
+
+SYSLOG_IDENTIFIER = "xcvrd"
+sonic_logger = logger.Logger(SYSLOG_IDENTIFIER)
+
+class Sfp(SfpOptoeBase):
+    """Platform-specific Sfp class"""
+
+    PORT_EEPROM_PATH = '/sys/bus/i2c/devices/18-0050/eeprom'
+
+    CPLD_ADDRESS = 0x75
+    QSFP_PORT_PRESENT_REG = 0x0F
+    SFP_PORT_TO_PRESENT_REG_MAP = {
+        1: 0x11,
+        2: 0x11,
+        3: 0x11,
+        4: 0x11,
+        5: 0x11,
+        6: 0x11,
+        7: 0x11,
+        8: 0x11,
+        9: 0x12,
+        10: 0x12,
+        11: 0x12,
+        12: 0x12
+    }
+
+    def __init__(self, index, sfp_type):
+        SfpOptoeBase.__init__(self)
+
+        self.port_num = index # 1-based physical port number
+        self.sfp_type = sfp_type
+        self.port_type = sfp_type
+        self.eeprom_path = self.PORT_EEPROM_PATH
+
+    def __read_eeprom_specific_bytes_raw(self, offset, num_bytes):
+        if not os.path.exists(self.PORT_EEPROM_PATH):
+            sonic_logger.log_error("path %s is not exist" % self.PORT_EEPROM_PATH)
+            return None
+
+        sysfsfile_eeprom = None
+
+        try:
+            sysfsfile_eeprom = open(self.PORT_EEPROM_PATH, mode="rb", buffering=0)
+            sysfsfile_eeprom.seek(offset)
+            raw = sysfsfile_eeprom.read(num_bytes)
+        except Exception as e:
+            pass
+        finally:
+            if sysfsfile_eeprom:
+                sysfsfile_eeprom.close()
+        return raw
+
+    def __read_eeprom_specific_bytes(self, offset, num_bytes):
+
+        raw = self.__read_eeprom_specific_bytes_raw(offset, num_bytes)
+        if raw is None:
+            return None
+
+        eeprom_raw = []
+        for i in range(0, num_bytes):
+            eeprom_raw.append("0x00")
+
+        for n in range(0, num_bytes):
+            eeprom_raw[n] = hex(raw[n])[2:].zfill(2)
+
+        return eeprom_raw
+
+
+    def __read_sfp_register(self, reg_addr):
+        if smbus_present == 0:  # if called from sfputil outside of pmon
+            cmdstatus, value = cmd.getstatusoutput('sudo i2cget -y 18 {} {}'.format(self.CPLD_ADDRESS, reg_addr))
+            if cmdstatus:
+                sonic_logger.log_warning("Failed to retrieve register value %s", cmdstatus)
+                return None
+            value = int(value, 16)
+        else:
+            bus = smbus.SMBus(18)
+            try:
+                value = bus.read_byte_data(self.CPLD_ADDRESS, reg_addr)
+            except Exception as e:
+                sonic_logger.log_warning("Failed to retrieve register value")
+
+        return value
+
+########  DEVICE BASE API  #########
+
+    def get_name(self):
+        """
+        Retrieves the name of the device
+
+        Returns:
+            string: The name of the device
+        """
+        return "Ethernet{}".format(self.port_num - 1)
+
+    def get_presence(self):
+        """
+        Retrieves the presence of the device
+
+        Returns:
+            bool: True if device is present, False if not
+        """
+        if self.sfp_type == "SFP":
+            reg_addr = self.SFP_PORT_TO_PRESENT_REG_MAP.get(self.port_num, 0x0)
+            offset_bit = self.port_num - SFP_PORT_START
+            if reg_addr == 0x12:
+                offset_bit -= 8
+        elif self.sfp_type == "QSFP":
+            reg_addr = self.QSFP_PORT_PRESENT_REG
+            offset_bit = self.port_num - QSFP_PORT_START
+
+        value = self.__read_sfp_register(reg_addr)
+
+        # 0:Module inserted
+        # 1:Module absent
+        if value & (1 << (offset_bit)):
+            return False
+
+        return True
+
+    def get_status(self):
+        """
+        Retrieves the operational status of the device
+
+        Returns:
+            A boolean value, True if device is operating properly, False if not
+        """
+        return not self.get_reset_status()
+
+    def get_position_in_parent(self):
+        """
+        Retrieves 1-based relative physical position in parent device. If the agent cannot determine the parent-relative position
+        for some reason, or if the associated value of entPhysicalContainedIn is '0', then the value '-1' is returned
+        Returns:
+            integer: The 1-based relative physical position in parent device or -1 if cannot determine the position
+        """
+        return self.port_num
+
+    def is_replaceable(self):
+        """
+        Indicate whether this device is replaceable.
+        Returns:
+            bool: True if it is replaceable.
+        """
+        return True
+
+########  SFP BASE API  #########
+
+    def get_transceiver_info(self):
+        DEVICE_ADDRESS = self.CPLD_ADDRESS
+        DEVICE_REG = 0x0A
+        channel = self.port_num
+
+        if smbus_present == 0:  # if called from sfputil outside of pmon
+            cmdstatus, output = cmd.getstatusoutput('sudo i2cset -y 18 {} {} {}'.format(DEVICE_ADDRESS, DEVICE_REG, channel))
+            if cmdstatus:
+                sonic_logger.log_error("Failed to write channel %s into mux", output)
+                return {}
+        else:
+            bus = smbus.SMBus(18)
+            try:
+                bus.write_byte_data(DEVICE_ADDRESS, DEVICE_REG, channel)
+            except:
+                sonic_logger.log_error("Failed to write channel number into mux")
+                return {}
+
+        port_info = None
+        try:
+            port_info = SfpOptoeBase.get_transceiver_info(self)
+        except NotImplementedError:
+            pass
+        if port_info is not None:
+            port_info['hardware_rev'] = 'N/A'
+        # Temporarily use eeprom stub info
+        if port_info is None and self.get_presence():
+            port_info = {
+                "type": self.get_name(),
+                "type_abbrv_name": 'N/A',
+                "vendor_rev": 'N/A',
+                "serial": 'N/A',
+                "manufacturer": 'N/A',
+                "model": 'N/A',
+                "connector": 'N/A',
+                "encoding": 'N/A',
+                "ext_identifier": 'N/A',
+                "ext_rateselect_compliance": 'N/A',
+                "cable_type": 'N/A',
+                "cable_length": 0,
+                "nominal_bit_rate": 'N/A',
+                "specification_compliance": 'N/A',
+                "vendor_date": 'N/A',
+                "vendor_oui": 'N/A',
+                "application_advertisement": "N/A",
+                "hardware_rev": 'N/A'
+            }
+
+        return port_info
+
+    def get_transceiver_threshold_info(self):
+        return None
+
+    def get_reset_status(self):
+        """
+        Retrieves the reset status of SFP
+
+        Returns:
+            A Boolean, True if reset enabled, False if disabled
+        """
+        return False
+
+    def get_rx_los(self):
+        """
+        Retrieves the RX LOS (loss-of-signal) status of SFP
+
+        Returns:
+            A list of boolean values, representing the RX LOS status
+            of each available channel, value is True if SFP channel
+            has RX LOS, False if not.
+            E.g., for a tranceiver with four channels: [False, False, True, False]
+            Note : RX LOS status is latched until a call to get_rx_los or a reset.
+        """
+        #  SFP RX_Los Control Register (0x13): SFP1 - SFP8
+        #  SFP RX_Los Control Register (0x14): SFP9 - SFP12
+        # 0:Normal operation
+        # 1:Transmitter Disable
+        DEVICE_REG = 0x13
+        offset_bit = self.port_num - SFP_PORT_START
+
+        if self.port_num > 8:
+            DEVICE_REG = 0x14
+            offset_bit -= 8
+
+        value = self.__read_sfp_register(DEVICE_REG)
+        
+        value = value & (1 << (offset_bit))
+
+        if value == 0:
+            return [False]
+        
+        return [True]
+
+    def get_tx_fault(self):
+        """
+        Retrieves the TX fault status of SFP
+
+        Returns:
+            A list of boolean values, representing the TX fault status
+            of each available channel, value is True if SFP channel
+            has TX fault, False if not.
+            E.g., for a tranceiver with four channels: [False, False, True, False]
+            Note : TX fault status is lached until a call to get_tx_fault or a reset.
+        """
+        #  SFP TX_Fault Control Register (0x15): SFP1 - SFP8
+        #  SFP TX_Fault Control Register (0x16): SFP9 - SFP12
+        # 0:Normal operation
+        # 1:Transmitter Disable
+        DEVICE_REG = 0x15
+        offset_bit = self.port_num - SFP_PORT_START
+
+        if self.port_num > 8:
+            DEVICE_REG = 0x16
+            offset_bit -= 8
+
+        value = self.__read_sfp_register(DEVICE_REG)
+        
+        value = value & (1 << (offset_bit))
+
+        if value == 0:
+            return [False]
+        
+        return [True]
+
+    def get_tx_disable(self):
+        """
+        Retrieves the tx_disable status of this SFP
+
+        Returns:
+            A list of boolean values, representing the TX disable status
+            of each available channel, value is True if SFP channel
+            is TX disabled, False if not.
+            E.g., for a tranceiver with four channels: [False, False, True, False]
+        """
+        #  SFP TX_Disable Control Register (0x17): SFP1 - SFP8
+        #  SFP TX_Disable Control Register (0x18): SFP9 - SFP12
+        # 0:Normal operation
+        # 1:Transmitter Disable
+        DEVICE_REG = 0x17
+        offset_bit = self.port_num - SFP_PORT_START
+
+        if self.port_num > 8:
+            DEVICE_REG = 0x18
+            offset_bit -= 8
+
+        value = self.__read_sfp_register(DEVICE_REG)
+        
+        value = value & (1 << (offset_bit))
+
+        if value == 0:
+            return [False]
+        
+        return [True]
+
+    def get_tx_disable_channel(self):
+        """
+        Retrieves the TX disabled channels in this SFP
+
+        Returns:
+            A hex of 4 bits (bit 0 to bit 3 as channel 0 to channel 3) to represent
+            TX channels which have been disabled in this SFP.
+            As an example, a returned value of 0x5 indicates that channel 0
+            and channel 2 have been disabled.
+        """
+        raise NotImplementedError
+
+    def get_lpmode(self):
+        """
+        Retrieves the lpmode (low power mode) status of this SFP
+
+        Returns:
+            A Boolean, True if lpmode is enabled, False if disabled
+        """
+        return False
+
+    def get_power_override(self):
+        """
+        Retrieves the power-override status of this SFP
+
+        Returns:
+            A Boolean, True if power-override is enabled, False if disabled
+        """
+        return False
+
+    def reset(self):
+        """
+        Reset SFP and return all user module settings to their default srate.
+
+        Returns:
+            A boolean, True if successful, False if not
+        """
+        # RJ45 and SFP ports not resettable
+        return False
+
+    def tx_disable(self, tx_disable):
+        """
+        Disable SFP TX for all channels
+
+        Args:
+            tx_disable : A Boolean, True to enable tx_disable mode, False to disable
+                         tx_disable mode.
+
+        Returns:
+            A boolean, True if tx_disable is set successfully, False if not
+        """
+                #  SFP TX_Disable Control Register (0x17): SFP1 - SFP8
+        #  SFP TX_Disable Control Register (0x18): SFP9 - SFP12
+        # 0:Normal operation
+        # 1:Transmitter Disable
+        DEVICE_REG = 0x17
+        offset_bit = self.port_num - SFP_PORT_START
+
+        if self.port_num > 8:
+            DEVICE_REG = 0x18
+            offset_bit -= 8
+
+        value = self.__read_sfp_register(DEVICE_REG)
+
+        bit_value = value & (1 << (offset_bit))
+        if (bit_value != 0 and tx_disable == True) or (bit_value == 0 and tx_disable == False) :
+            # nothing to do
+            return True
+        
+        if tx_disable == True:
+            new_value  = value | (1 << offset_bit)
+        else:
+            new_value  = value & ~(1 << offset_bit)
+
+        if smbus_present == 0:  # if called from sfputil outside of pmon
+            cmdstatus, output = cmd.getstatusoutput('sudo i2cset -y 18 {} {} {}'.format(self.CPLD_ADDRESS, DEVICE_REG, new_value))
+            if cmdstatus:
+                sonic_logger.log_warning("Failed to set register value %s", cmdstatus)
+                return False
+        else:
+            bus = smbus.SMBus(18)
+            try:
+                output = bus.write_byte_data(self.CPLD_ADDRESS, DEVICE_REG, new_value)
+            except Exception as e:
+                sonic_logger.log_warning("Failed to set register value")
+                return False
+
+        return True
+
+    def tx_disable_channel(self, channel, disable):
+        """
+        Sets the tx_disable for specified SFP channels
+
+        Args:
+            channel : A hex of 4 bits (bit 0 to bit 3) which represent channel 0 to 3,
+                      e.g. 0x5 for channel 0 and channel 2.
+            disable : A boolean, True to disable TX channels specified in channel,
+                      False to enable
+
+        Returns:
+            A boolean, True if successful, False if not
+        """
+        # if (channel != 0):
+        #     return False
+
+        # return self.tx_disable(disable)
+        raise NotImplementedError
+
+    def set_lpmode(self, lpmode):
+        """
+        Sets the lpmode (low power mode) of SFP
+
+        Args:
+            lpmode: A Boolean, True to enable lpmode, False to disable it
+            Note  : lpmode can be overridden by set_power_override
+
+        Returns:
+            A boolean, True if lpmode is set successfully, False if not
+        """
+        return False
+
+    def set_power_override(self, power_override, power_set):
+        """
+        Sets SFP power level using power_override and power_set
+
+        Args:
+            power_override :
+                    A Boolean, True to override set_lpmode and use power_set
+                    to control SFP power, False to disable SFP power control
+                    through power_override/power_set and use set_lpmode
+                    to control SFP power.
+            power_set :
+                    Only valid when power_override is True.
+                    A Boolean, True to set SFP to low power mode, False to set
+                    SFP to high power mode.
+
+        Returns:
+            A boolean, True if power-override and power_set are set successfully,
+            False if not
+        """
+        raise NotImplementedError
+
+    def read_eeprom(self, offset, num_bytes):
+        """
+        read eeprom specfic bytes beginning from a random offset with size as num_bytes
+
+        Args:
+             offset :
+                     Integer, the offset from which the read transaction will start
+             num_bytes:
+                     Integer, the number of bytes to be read
+
+        Returns:
+            bytearray, if raw sequence of bytes are read correctly from the offset of size num_bytes
+            None, if the read_eeprom fails
+        """
+        return bytearray(self.__read_eeprom_specific_bytes_raw(offset, num_bytes))
+
+
+    def get_error_description(self):
+        """
+        Retrives the error descriptions of the SFP module
+
+        Returns:
+            String that represents the current error descriptions of vendor specific errors
+            In case there are multiple errors, they should be joined by '|',
+            like: "Bad EEPROM|Unsupported cable"
+        """
+        if not self.get_presence():
+            return self.SFP_STATUS_UNPLUGGED
+        return self.SFP_STATUS_OK
