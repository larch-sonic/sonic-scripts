+
+class FanDrawer(FanDrawerBase):
+    """Platform-specific Fan class"""
+
+    def __init__(self, fantray_index, fans_per_tray, idx_offset=0):
+        FanDrawerBase.__init__(self)
+        
+        # FanTray indexing is 0-based in platforms (do not know why)
+        self.fantrayindex = fantray_index
+        self._fans_per_tray = fans_per_tray
+        self._idx_offset = idx_offset
+        
+        self.__initialize_fan_drawer()
+
+    def __initialize_fan_drawer(self):
+        from sonic_platform.fan import Fan
+        
+        # Fan indexing is 1-based in platforms (do not know why either)
+        for i in range(1, self._fans_per_tray+1):
+            idx = i + self._idx_offset
+            self._fan_list.append(Fan(idx, self.fantrayindex, self._idx_offset))
