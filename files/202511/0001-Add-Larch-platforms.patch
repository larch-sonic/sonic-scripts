+#!/usr/bin/env python3
+
+#############################################################################
+# WNC Phantom
+#
+# Thermal contains an implementation of SONiC Platform Base API and
+# provides the thermal device status which are available in the platform
+#
+#############################################################################
+
+import os
+import os.path
+
+try:
+    from sonic_platform_base.thermal_base import ThermalBase
+    from .helper import APIHelper
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+THERMAL_INFO = {
+    0: {
+        "F2B_max": 50,
+        "F2B_max_crit": 55,
+        "B2F_max": 59,
+        "B2F_max_crit": 64,
+        "postion": "cpu",
+        "name": "PSU1 temp sensor",
+        "i2c_bus": 4,
+        "i2c_addr": 0x4a,
+    },
+    1: {
+        "F2B_max": 54,
+        "F2B_max_crit": 59,
+        "B2F_max": 61,
+        "B2F_max_crit": 66,
+        "postion": "cpu",
+        "name": "PSU2 temp sensor",
+        "i2c_bus": 4,
+        "i2c_addr": 0x4b,
+    },
+    2: {
+        "F2B_max": 80,
+        "F2B_max_crit": 85,
+        "B2F_max": 80,
+        "B2F_max_crit": 85,
+        "postion": "asic",
+        "name": "ASIC temp sensor",
+        "i2c_bus": 4,
+        "i2c_addr": 0x4c,
+    },
+    3: {
+        "F2B_max": 42,
+        "F2B_max_crit": 47,
+        "B2F_max": 56,
+        "B2F_max_crit": 61,
+        "postion": "cpu",
+        "name": "Rear-panel temp sensor",
+        "i2c_bus": 28,
+        "i2c_addr": 0x4e,
+    },
+    4: {
+        "F2B_max": 51,
+        "F2B_max_crit": 56,
+        "B2F_max": 56,
+        "B2F_max_crit": 61,
+        "postion": "cpu",
