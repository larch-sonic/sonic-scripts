@@ -0,0 +1,34 @@
+#!/bin/bash
+
+# Platform init script for qn-sr-400
+
+qn-sr-400_profile()
+{
+    MAC_ADDR=$(fw_printenv -n ethaddr)
+    find /usr/share/sonic/device/*qn-sr-400* -name profile.ini | xargs sed -i "s/switchMacAddress=.*/switchMacAddress=$MAC_ADDR/g"
+    echo "qn-sr-400: Updating switch mac address ${MAC_ADDR}"
+    sudo ifconfig eth0 hw ether $MAC_ADDR
+    
+    sudo modprobe optoe
+    # all peripheral related i2c devices are instantiated via device tree
+
+    echo "pmbus 0x58" > /sys/bus/i2c/devices/i2c-3/new_device
+    echo "24c02 0x50" > /sys/bus/i2c/devices/i2c-3/new_device
+    echo "pmbus 0x58" > /sys/bus/i2c/devices/i2c-4/new_device
+    echo "24c02 0x50" > /sys/bus/i2c/devices/i2c-4/new_device
+
+    rebrand # this platform is for customer who requires another name of nos
+}
+
+rebrand()
+{
+    # change a console pre-login banner
+    sudo bash -c "printf 'QNOS \S \\\r \m \l \n\n' > /etc/issue"
+
+    sudo hostnamectl set-hostname qnos
+}
+
+# - Main entry
+qn-sr-400_profile
+
+exit 0
