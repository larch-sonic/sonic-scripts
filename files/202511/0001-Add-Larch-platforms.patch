diff --git a/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/led.py b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/led.py
new file mode 100644
index 000000000..85587344c
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/led.py
@@ -0,0 +1,136 @@
+#!/usr/bin/env python3
+
+#############################################################################
+# Larch LN-4332Z4-V7
+#
+# System LEDs, as the HW Programmer Guide (table 21) and the user manual
+# (3.4) define them:
+#   Power / system status (power icon): RGB LED 0 of Silicom's silicom-mec
+#     driver (/sys/class/leds/rgb), found on the board by lighting each EC
+#     LED in turn. The OS shows only "green" (running) and "blinking green"
+#     (booting); white/blue are the EC's own states.
+#   Alert (!): "blink red = system fault", software controlled. It did not
+#     respond to any silicom-mec LED and stays red, so a fault cannot be
+#     shown yet: the power LED stays green and set_state() returns False.
+#   PSU status: driven by the CPLD from the PSU OK signals.
+#   Location (house icon, same LED on the rear): "blink blue when the
+#     location beacon is turned on via SW and button" (PG table 22). It is
+#     the single-color EC LED 5, gpio_3 of silicom-mec.
+# Blinking uses the timer trigger: the driver hands it to the EC as a
+# hardware blink for the RGB LED; the single-color LEDs have none, so the
+# kernel blinks the location LED itself. Either way 1 s on / 1 s off.
+#
+#############################################################################
+
+import os
+
+POWER_LED_DIR = "/sys/class/leds/rgb"
+LOCATION_LED_DIR = "/sys/class/leds/gpio_3"
+LOCATION_ON = 100        # max_brightness of the single-color EC LEDs
+BLINK_DELAY_MS = 1000
+GREEN = "0 255 0"       # multi_intensity: red green blue
+
+
+def _read(path):
+    try:
+        with open(path) as f:
+            return f.read().strip()
+    except OSError:
+        return None
+
+
+def _write(path, value):
+    try:
+        with open(path, "w") as f:
+            f.write(str(value))
+        return True
+    except OSError:
+        return False
+
+
+class SystemLed(object):
+    """The system status as shown by the power and alert LEDs."""
+
+    def __init__(self, led_dir=POWER_LED_DIR):
+        self._dir = led_dir
+        self._state = None      # last state requested by this process
+
+    def _attr(self, name):
+        return os.path.join(self._dir, name)
+
+    def _set_power_led(self, mode):
+        """mode: "off", "on" or "blink" (always green)."""
+        # take the LED from the EC; stop a previous blink first
+        ok = _write(self._attr("host_owned"), 1) and _write(self._attr("trigger"), "none")
+        if mode == "off":
+            return ok and _write(self._attr("brightness"), 0)
+        ok = ok and _write(self._attr("multi_intensity"), GREEN) \
+            and _write(self._attr("brightness"), 255)
+        if mode == "blink":
+            ok = ok and _write(self._attr("trigger"), "timer") \
+                and _write(self._attr("delay_on"), BLINK_DELAY_MS) \
+                and _write(self._attr("delay_off"), BLINK_DELAY_MS)
+        return ok
+
+    def set_state(self, state):
+        if state == "off":
+            ok = self._set_power_led("off")
+        elif state == "green":
+            ok = self._set_power_led("on")
+        elif state == "blinking green":
+            ok = self._set_power_led("blink")
+        else:
+            # a fault: the OS is up, so the power LED stays green; the
+            # alert LED is not controllable yet
+            self._set_power_led("on")
+            ok = False
+        self._state = state
+        return ok
+
+    def get_state(self):
+        if self._state is not None:
+            return self._state
+        # another process set it: read the power LED back from the driver
+        # (while blinking, brightness follows the blink phase)
+        if "[timer]" in (_read(self._attr("trigger")) or ""):
+            return "blinking green"
+        if _read(self._attr("brightness")) in (None, "0"):
+            return "off"
+        return "green" if _read(self._attr("multi_intensity")) == GREEN else "off"
+
+
+class LocationLed(object):
+    """The location (UID) beacon: "blinking blue" (the documented state),
+    "blue" or "off".
+
+    The rear location button toggles it while the EC owns the LED. Software
+    has to take the LED from the EC (host_owned) and the driver cannot hand
+    it back, so after the first set_state() only software drives it, until
+    the next reboot. While the EC owns it, its state cannot be read.
+    """
+
+    def __init__(self, led_dir=LOCATION_LED_DIR):
+        self._dir = led_dir
+
+    def _attr(self, name):
+        return os.path.join(self._dir, name)
+
+    def set_state(self, state):
+        if state not in ("off", "blue", "blinking blue"):
+            return False
+        ok = _write(self._attr("host_owned"), 1) and _write(self._attr("trigger"), "none")
+        if state == "off":
+            return ok and _write(self._attr("brightness"), 0)
+        ok = ok and _write(self._attr("brightness"), LOCATION_ON)
+        if state == "blinking blue":
+            ok = ok and _write(self._attr("trigger"), "timer") \
+                and _write(self._attr("delay_on"), BLINK_DELAY_MS) \
+                and _write(self._attr("delay_off"), BLINK_DELAY_MS)
+        return ok
+
+    def get_state(self):
+        if _read(self._attr("host_owned")) != "1":
+            return "off"
+        if "[timer]" in (_read(self._attr("trigger")) or ""):
+            return "blinking blue"
+        return "off" if _read(self._attr("brightness")) in (None, "0") else "blue"
