diff --git a/platform/marvell-prestera/sonic-platform-larch/drivers/armhf/cpssEnabler/linuxNoKernelModule/drivers/manual_make.sh b/platform/marvell-prestera/sonic-platform-larch/drivers/armhf/cpssEnabler/linuxNoKernelModule/drivers/manual_make.sh
