+
+#ifndef _LINUX_I2C_MUX_ACCTON_CPLD_H
+#define _LINUX_I2C_MUX_ACCTON_CPLD_H
+
+/* Platform data for the accton CPLD I2C multiplexers */
+
+struct accton_cpld_mux_platform_data {
+	int num_modes;
+	unsigned int mux_type;
+};
