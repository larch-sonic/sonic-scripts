index 000000000..a6191d3e2
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/qn-sr-50/scripts/qn-sr-50-init.sh
@@ -0,0 +1,34 @@
+#!/bin/bash
+
+# Platform init script
+qnsr50_profile()
+{
+	MAC_ADDR=$(fw_printenv -n ethaddr)
+	find /usr/share/sonic/device/*qn-sr-50* -name profile.ini | xargs sed -i "s/switchMacAddress=.*/switchMacAddress=$MAC_ADDR/g"
+	echo "qn-sr-50: Updating switch mac address ${MAC_ADDR}"
+
+    rebrand # this platform is for customer who requires another name of nos
+}
+
+rebrand()
+{
+    # change a console pre-login banner
+    sudo bash -c "printf 'QNOS \S \\\r \m \l \n\n' > /etc/issue"
+
+    sudo hostnamectl set-hostname qnos
+}
+
+# Main
+qnsr50_profile
+
+# LOGIC to enumerate SFP eeprom devices - send 0x50 to kernel i2c driver - initialize devices
+# the mux may be enumerated at number 4 or 5 so we check for the mux and skip if needed
+# Get list of the mux channels
+# Enumerate the SFP eeprom device on each mux channel
+echo optoe2 0x50 > /sys/bus/i2c/devices/i2c-0/new_device
+# Enumerate system eeprom
+echo 24c64 0x52 > /sys/class/i2c-adapter/i2c-0/new_device
+sleep 2
+
+
+exit 0
