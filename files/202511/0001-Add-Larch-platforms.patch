+
+smbus_present = 1
+try:
+    import smbus
+except ImportError as e:
+    smbus_present = 0
+
+_fan_path_patterns = {
+    "ALARM":"fan{}_alarm",
+    "SPEED":"fan{}_input",
+    "MIN":"fan{}_min"
+}
+
+_fan_idx_to_controller = {
+    1: 1,
+    2: 1,
+    3: 1,
+    4: 2,
+    5: 2,
+}
+
+_fan_idx_to_controller_idx = {
+    1: 1,
+    2: 2,
