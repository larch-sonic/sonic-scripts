+/* Dynamically find gpio_base by gpiochip label */
+static int find_gpio_base_by_label(const char *label)
+{
+    struct gpio_device *gdev;
+    struct gpio_chip *gc;
+    int base;
+
+    gdev = gpio_device_find_by_label(label);
+    if (!gdev) {
+        printk(KERN_ERR "wnc_sfp: gpiochip with label '%s' not found!\n", label);
+        return -ENODEV;
+    }
+
+    gc = gpio_device_get_chip(gdev);
+    if (!gc) {
+        gpio_device_put(gdev);
+        return -ENODEV;
+    }
+
+    base = gc->base;
+    gpio_device_put(gdev);
+
+    return base;
+}
