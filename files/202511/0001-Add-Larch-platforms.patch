@@ -0,0 +1,90 @@
+#!/usr/bin/env python3
+
+#############################################################################
+# Larch LN-4332Z4-V7
+#
+# Two hot-swap PSUs (PSU1 left, PSU2 right). Presence and power good come
+# from CPLD CTRL register 0x2 (cpld.py). The PSUs' PMBus and FRU (0x58/0x59,
+# 0x50/0x51) are on the EC's I2C_TEL bus: the EC reports their output
+# current, input power and temperatures (ec.py), but not the output voltage,
+# model or serial number. The PSU LED is driven by the CPLD itself.
+#
+#############################################################################
+
+try:
+    from sonic_platform_base.psu_base import PsuBase
+    from sonic_platform import cpld
+    from sonic_platform.ec import EcHwmon
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+NUM_PSU = 2
+
+# PSU temperature limit from the HW Programmer Guide sensor list (Appendix D).
+PSU_TEMP_HIGH_THRESHOLD = 80.0
+
+
+class Psu(PsuBase):
+    """Platform-specific Psu class"""
+
+    def __init__(self, index):
+        PsuBase.__init__(self)
+        self.index = index      # 0-based
+
+    def _attr(self, name):
+        return cpld.read_int_attr(cpld.ctrl_cpld(), "psu%d_%s" % (self.index + 1, name))
+
+    def get_name(self):
+        return "PSU-%d" % (self.index + 1)
+
+    def get_presence(self):
+        return self._attr("present") == 1
+
+    def get_powergood_status(self):
+        return self._attr("power_good") == 1
+
+    def get_status(self):
+        return self.get_presence() and self.get_powergood_status()
+
+    def _ec(self, kind, labels, divisor=1000.0):
+        n = self.index + 1
+        return EcHwmon.read_first(kind, [l % n for l in labels], divisor=divisor)
+
+    def get_voltage(self):
+        return None
+
+    def get_current(self):
+        return self._ec("curr", ["PSU%d Iout"])
+
+    def get_power(self):
+        # input power; the label differs between the MHO-150/180 and 200 tables
+        return self._ec("power", ["PSU%d " + ("Left" if self.index == 0 else "Right") + " Pwr",
+                                  "PSU%d Pwr"], divisor=1000000.0)
+
+    def get_temperature(self):
+        return self._ec("temp", ["PSU%d Temp Amb"])
+
+    def get_temperature_high_threshold(self):
+        return PSU_TEMP_HIGH_THRESHOLD
+
+    def get_model(self):
+        return "N/A"
+
+    def get_serial(self):
+        return "N/A"
+
+    def get_revision(self):
+        return "N/A"
+
+    def get_status_led(self):
+        return self.STATUS_LED_COLOR_GREEN if self.get_status() else self.STATUS_LED_COLOR_AMBER
+
+    def set_status_led(self, color):
+        # The CPLD drives the PSU LED from the PSU OK signals.
+        return False
+
+    def get_position_in_parent(self):
+        return self.index + 1
+
+    def is_replaceable(self):
+        return True
diff --git a/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/sfp.py b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/sfp.py
