+#!/usr/bin/env python3
+#
+# This program is free software: you can redistribute it and/or modify
+# it under the terms of the GNU General Public License as published by
+# the Free Software Foundation, either version 3 of the License, or
+# (at your option) any later version.
+#
+# This program is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program.  If not, see <http://www.gnu.org/licenses/>.
+
+import threading, socket, time
+import queue, select, functools
+import argparse, sys
+
+import common, device
+
+HOST = ''
+SOCKET_LIST = []
+SOCKET_MAX_CLIENT = 10
+QUEUES = []
+THREADS = []
+FUNCS = {}
+
+class GlobalThread(threading.Thread):
+    def __init__(self,threadname, q):
+        threading.Thread.__init__(self,name = threadname)
+        self.queue = q
+
+    def run(self):
+        while common.RUN:
+            message = self.queue.get()
+            self.onMessage(message)
+
+    def onMessage(self, message):
+        """
+        Commands:
+            uninstall    : Uninstall platform drivers
+        """
+        if len(message.command) < 1:
+            result = self.onMessage.__doc__
+        else:
+            if message.command[0] == 'uninstall':
+                common.RUN = False
+                doUninstall()
+                result = 'Success'
+            else:
+                result = self.onMessage.__doc__
+        if (message.callback is not None):
+            message.callback(result)
+
+class messageObject(object):
+    def __init__(self, command, callback):
+        super(messageObject, self).__init__()
+        self.command = command
+        self.callback = callback
+
+def callback(sock, result):
+    sock.sendall(result.encode())
+
+def messageHandler():
+    server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    server_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+    server_socket.bind((HOST, common.SOCKET_PORT))
+    server_socket.listen(SOCKET_MAX_CLIENT)
+    SOCKET_LIST.append(server_socket)
+
+    while(common.RUN):
+        ready_to_read,ready_to_write,in_error = select.select(SOCKET_LIST,[],[],0)
+        for sock in ready_to_read:
+            if sock == server_socket:
+                sockfd, addr = server_socket.accept()
+                SOCKET_LIST.append(sockfd)
+            else:
+                try:
+                    data = sock.recv(common.SOCKET_RECV_BUFFER)
+                    if data:
+                        cb = functools.partial(callback, sock)
+                        cmdlist = data.decode().split()
+
+                        if cmdlist[0] not in common.CMD_TYPE:
+                            callback(sock, 'Fail')
+                            continue
+
+                        msg = messageObject(cmdlist[1:], cb)
+                        FUNCS[cmdlist[0]].put(msg)
+                        continue
+                    else:
+                        if sock in SOCKET_LIST:
+                            SOCKET_LIST.remove(sock)
+                except:
+                    raise
+        time.sleep(0.2)
+
+    server_socket.close()
+
+def setupThreads():
+    global THREADS, QUEUES
+
+    # Queues
+    # Global
+    queueGlobal = queue.Queue()
+    QUEUES.append(queueGlobal)
+    FUNCS['global'] = queueGlobal
+
+    # Device
+    queueDevice = queue.Queue()
+    QUEUES.append(queueDevice)
+    FUNCS['device'] = queueDevice
+
+    # Threads
+    # Global
+    threadGlobal = GlobalThread('Global Handler', queueGlobal)
+    THREADS.append(threadGlobal)
+
+    # Device
+    threadDevice = device.DeviceThread('Device Handler', queueDevice)
+    THREADS.append(threadDevice)
+
+    # Check platform status
+    threadPlatformStatus = device.PlatformStatusThread('Platform Status Handler', 0.3)
+    THREADS.append(threadPlatformStatus)
+
+# Platform initialize
+KERNEL_MODULE = ['i2c_dev', 'i2c-mux-pca954x force_deselect_on_exit=1', 'gpio-pca953x','at24', 'lm75', 'wnc_hwmon', 'dps1600' ]
+
+PCA9548 = ['i2c-1:0x70', 'i2c-0:0x71', 'i2c-0;9545:0x70','i2c-0:0x74','i2c-10:0x72','i2c-11:0x73','i2c-12:0x72','i2c-13:0x73' ,'i2c-14:0x72','i2c-15:0x73']
+
+TCA6424_DEVICE = ['i2c-10:0x22', 'i2c-11:0x23','i2c-12:0x22','i2c-13:0x23','i2c-14:0x22','i2c-15:0x23']
+
+TCA6408_DEVICE = ['i2c-10:0x21']
+
+GT24C02A_DEVICE = ['i2c-0:0x54']
+
+TEMP_DEVICE = ['i2c-4:lm75:0x4a','i2c-4:lm75:0x4b','i2c-4:lm75:0x4c','i2c-4:lm75:0x4d','i2c-28:lm75:0x4e','i2c-1:lm75:0x4f']
+
+PSU_DEVICE = ['i2c-16:dps1600:0x58','i2c-17:dps1600:0x58']
+
+HWMON_DEVICE = ['i2c-5:wnc_hwmon:0x66']
+
+QSFP_I2C_RANGES = [(30, 35), (38, 43), (46, 51), (54, 59), (62, 67), (70, 73)]
+
+def installSystemEeprom():
+    for s in GT24C02A_DEVICE:
+        cmd = "echo \"24c02 %s\" > /sys/bus/i2c/devices/%s/new_device " % (s.split(':')[1], s.split(':')[0])
+        print("installSystemEeprom() %s" % cmd)
+        common.doBash(cmd)
+
+def installMux():
+    for s in PCA9548 :
+        if ";" not in s:
+            i = s.split(':')[0]
+            a = s.split(':')[1]
+            cmd = "echo \"pca9548 %s\" > /sys/bus/i2c/devices/%s/new_device" % (a,i)
+        else:
+            i = s.split(':')[0].split(';')[0]
+            d = s.split(':')[0].split(';')[1]
+            a = s.split(':')[1]
+            cmd = "echo \"pca%s %s\" > /sys/bus/i2c/devices/%s/new_device" % (d,a,i)
+        print("installMux(): %s" % cmd)
+        common.doBash(cmd)
+
+def installTCA6424():
+    for s in TCA6424_DEVICE :
+        cmd = "echo \"tca6424 %s\" > /sys/bus/i2c/devices/%s/new_device " % (s.split(':')[1], s.split(':')[0])
+        print("installTCA6424() %s" % cmd)
+        common.doBash(cmd)
+    for s in TCA6408_DEVICE:
+        cmd = "echo \"tca6408 %s\" > /sys/bus/i2c/devices/%s/new_device " % (s.split(':')[1], s.split(':')[0])
+        print("installTCA6408() %s" % cmd)
+        common.doBash(cmd)
+    cmd = "modprobe wnc_sfp"
+    common.doBash(cmd)
+
+
+def install_QSFP_eeprom_for_i2c_range(i2c_first, i2c_last):
+    for i in range(i2c_first, i2c_last + 1):
+        cmd = "echo \"wnc_sfp_e 0x50\" > /sys/bus/i2c/devices/i2c-%s/new_device " % i
+        print(cmd)
+        common.doBash(cmd)
+    cmd = "modprobe wnc_sfp_e"
+    common.doBash(cmd)
+
+def install_QSFP_eeprom():
+    list(map(lambda r : install_QSFP_eeprom_for_i2c_range(*r), QSFP_I2C_RANGES))
+
+def install_hwmon():
+    for s in TEMP_DEVICE :
+        cmd = "echo \"%s %s\" > /sys/bus/i2c/devices/%s/new_device " % (s.split(':')[1], s.split(':')[2], s.split(':')[0])
+        print(cmd)
+        common.doBash(cmd)
+    for s in PSU_DEVICE :
+        cmd = "echo \"%s %s\" > /sys/bus/i2c/devices/%s/new_device " % (s.split(':')[1], s.split(':')[2], s.split(':')[0])
+        print(cmd)
+        common.doBash(cmd)
+    for s in HWMON_DEVICE :
+        cmd = "echo \"%s %s\" > /sys/bus/i2c/devices/%s/new_device " % (s.split(':')[1], s.split(':')[2], s.split(':')[0])
+        print(cmd)
+        common.doBash(cmd)
+
+def checkDriver():
+    for i in range(0, len(KERNEL_MODULE)):
+        k_m = KERNEL_MODULE[i]
+        if (' ' in k_m):
+            k_m = k_m.split(' ')[0]
+        _,status,_ = common.doBash("lsmod | grep " + k_m)
+        if status:
+            common.doBash("modprobe " + KERNEL_MODULE[i])
+
+def doInstall():
+    common.doBash("depmod -a")
+    checkDriver()
+    installSystemEeprom() 
+    installMux()
+    installTCA6424()
+    install_QSFP_eeprom()
+    install_hwmon()
+
+def functionInit():
+    setupThreads()
+    for thread in THREADS:
+        thread.start()
+
+def deviceInit():
+    msg = messageObject(['init'], None)
+    FUNCS['device'].put(msg)
+
+# Platform uninitialize
+def uninstall_hwmon():
+    for s in TEMP_DEVICE :
+        cmd = "echo \"%s\" > /sys/bus/i2c/devices/%s/delete_device " % (s.split(':')[2], s.split(':')[0])
+        print(cmd)
+        common.doBash(cmd)
+    for s in PSU_DEVICE :
+        cmd = "echo \"%s\" > /sys/bus/i2c/devices/%s/delete_device " % (s.split(':')[2], s.split(':')[0])
+        print(cmd)
+        common.doBash(cmd)
+    for s in HWMON_DEVICE :
+        cmd = "echo \"%s\" > /sys/bus/i2c/devices/%s/delete_device " % (s.split(':')[2], s.split(':')[0])
+        print(cmd)
+        common.doBash(cmd)
+
+def doUninstall():
+    uninstall_hwmon()
+
+    cmd = "modprobe -rq wnc_sfp"
+    common.doBash(cmd)
+    cmd = "modprobe -rq wnc_sfp_e"
+    common.doBash(cmd)
+
+    r = PCA9548;
+    r.reverse();
+    for s in r  :
+        if ";" not in s:
+            i = s.split(':')[0]
+            a = s.split(':')[1]
+            cmd = "echo \"%s\" > /sys/bus/i2c/devices/%s/delete_device" % (a,i)
+        else:
+            i = s.split(':')[0].split(';')[0]
+            d = s.split(':')[0].split(';')[1]
+            a = s.split(':')[1]
+            cmd = "echo \"%s\" > /sys/bus/i2c/devices/%s/delete_device" % (a,i)
+        print("doUninstall(): %s" % cmd)
+        common.doBash(cmd)
+
+    for i in range(0, len(KERNEL_MODULE)):
+        common.doBash("modprobe -rq " + KERNEL_MODULE[i])
+
+def main():
+    args = common.sys.argv[1:]
+
+    if len(args[0:]) < 1:
+        common.sys.exit(0)
+    if args[0] == 'mux':
+        installMux()
+        common.sys.exit(0)
+    if args[0] == '6424':
+        installTCA6424()
+        common.sys.exit(0)
+    if args[0] == 'sfp':
+        install_QSFP_eeprom()
+        common.sys.exit(0)
+    if args[0] == 'uninstall':
+        doUninstall()
+    if args[0] == 'install':
+        doInstall()
+    elif args[0] == 'run':
+        #common.RUN = True
+        #functionInit()
+        #deviceInit()
+        #messageHandler()
+        common.sys.exit(0)
+
+    common.sys.exit(0)
+
+if __name__ == "__main__":
+    main()
