+    def get_rx_los(self):
+        """
+        Retrieves the RX LOS (loss-of-signal) status of SFP
+
+        Returns:
+            A list of boolean values, representing the RX LOS status
+            of each available channel, value is True if SFP channel
+            has RX LOS, False if not.
+            E.g., for a tranceiver with four channels: [False, False, True, False]
+            Note : RX LOS status is latched until a call to get_rx_los or a reset.
+        """
+        if self.sfp_type == "COPPER":
+            return [False]
+        elif self.sfp_type == "SFP":
+            reg_addr = 0x12
+            offset_bit = self.port_num - SFP_PORT_START
+        elif self.sfp_type == "ZSFP":
+            """
+            in case of zsfp we have 3 registers for all 6 of the zsfp`s.
+            Everyone with 3 different statuses
+            [0] - presence of ZSFP N
+            [1] - signal loss of ZSFP N
+            [2] - transmitter fault of ZSFP N
+            [3] - unused
+            [4] - presence of ZSFP N+1
+            [5] - signal loss of ZSFP N+1
+            [6] - transmitter fault of ZSFP N+1
+            [7] - unused
+            """
+            reg_addr = self.ZSFP_PORT_TO_CONTROL_REG_MAP.get(self.port_num, 0x0)
+            presence_bit_number = 5 if self.port_num % 2 == 0 else 1 #bit in register, indicator of presence of the zsfp
+            offset_bit = presence_bit_number
+
+        sfpstatus = self.__read_sfp_register(reg_addr)
+        sfpstatus = sfpstatus & (1 << (offset_bit))
+        if sfpstatus == 0:
+            return [False]
+        return [True]
+
+    def get_tx_fault(self):
+        """
+        Retrieves the TX fault status of SFP
+
+        Returns:
+            A list of boolean values, representing the TX fault status
+            of each available channel, value is True if SFP channel
+            has TX fault, False if not.
+            E.g., for a tranceiver with four channels: [False, False, True, False]
+            Note : TX fault status is lached until a call to get_tx_fault or a reset.
+        """
+        if self.sfp_type == "COPPER":
+            return [False]
+        elif self.sfp_type == "SFP":
+            reg_addr = 0x11
+            offset_bit = self.port_num - SFP_PORT_START
+        elif self.sfp_type == "ZSFP":
+            """
+            in case of zsfp we have 3 registers for all 6 of the zsfp`s.
+            Everyone with 3 different statuses
+            [0] - presence of ZSFP N
+            [1] - signal loss of ZSFP N
+            [2] - transmitter fault of ZSFP N
+            [3] - unused
+            [4] - presence of ZSFP N+1
+            [5] - signal loss of ZSFP N+1
+            [6] - transmitter fault of ZSFP N+1
+            [7] - unused
+            """
+            reg_addr = self.ZSFP_PORT_TO_CONTROL_REG_MAP.get(self.port_num, 0x0)
+            presence_bit_number = 6 if self.port_num % 2 == 0 else 2 #bit in register, indicator of presence of the zsfp
+            offset_bit = presence_bit_number
+
+        sfpstatus = self.__read_sfp_register(reg_addr)
+        sfpstatus = sfpstatus & (1 << (offset_bit))
+        if sfpstatus == 0:
+            return [False]
+        return [True]
+
+    def get_tx_disable(self):
+        """
+        Retrieves the tx_disable status of this SFP
+
+        Returns:
+            A list of boolean values, representing the TX disable status
+            of each available channel, value is True if SFP channel
+            is TX disabled, False if not.
+            E.g., for a tranceiver with four channels: [False, False, True, False]
+        """
+        #  SFP Status Control Register #4 (0x14): SFP5 - SFP12
+        # ZSFP Status Control Register #4 (0x0F): ZSFP13 - ZSFP18
+        # 0:Normal operation
+        # 1:Transmitter Disable
+        DEVICE_ADDRESS = self.CPLD_ADDRESS
+        if self.sfp_type == "SFP":
+            DEVICE_REG = 0x14
+        elif self.sfp_type == "ZSFP":
+            DEVICE_REG = 0x0F
+
+        if smbus_present == 0:  # if called from sfputil outside of pmon
+            cmdstatus, value = cmd.getstatusoutput('sudo i2cget -y 0 {} {}'.format(DEVICE_ADDRESS, DEVICE_REG))
+            if cmdstatus:
+                sonic_logger.log_warning("Failed to retrieve register value %s", cmdstatus)
+                return [False]
+            value = int(value, 16)
+        else:
+            bus = smbus.SMBus(0)
+            try:
+                value = bus.read_byte_data(DEVICE_ADDRESS, DEVICE_REG)
+            except Exception as e:
+                sonic_logger.log_warning("Failed to retrieve register value")
+
+        if self.port_num >= ZSFP_PORT_START:
+             offset_bit = self.port_num - ZSFP_PORT_START
+        elif self.port_num >= SFP_PORT_START:
+            offset_bit = self.port_num - SFP_PORT_START
+
+        value = value & (1 << (offset_bit))
+
+        if value == 0:
+            return [False]
+        
+        return [True]
+
