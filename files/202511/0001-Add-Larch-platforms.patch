+#!/usr/bin/env python3
+
+#############################################################################
+# WNC Phantom
+#
+# Module contains an implementation of SONiC Platform Base API and
+# provides the PSUs status which are available in the platform
+#
+#############################################################################
+
+import os
+import logging
+
+try:
+    from sonic_platform_base.psu_base import PsuBase
+    from sonic_platform.fan import Fan
+    from .helper import APIHelper
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+I2C_PATH = "/sys/class/i2c-adapter/i2c-{0}/{0}-{1:04x}/hwmon"
+
+PSU_INFO = {
+    0: {
+        "name": "PSU-1",
+        "i2c_bus": 16,
+        "i2c_addr": 0x58,
+        "num_fans": 1,
+    },
+    1: {
+        "name": "PSU-2",
+        "i2c_bus": 17,
+        "i2c_addr": 0x58,
+        "num_fans": 1,
+    }
+}
+
+class Psu(PsuBase):
+    """Platform-specific Psu class"""
+
+    I2C_PSU_PATH = "/sys/bus/i2c/devices/5-0066/"
+
+    def __init__(self, psu_index):
+        PsuBase.__init__(self)
+        self._api_helper = APIHelper()
+        self.index = psu_index
+        self._psu_info = PSU_INFO[self.index]
+
+        self._i2c_hwmon_path = I2C_PATH.format(self._psu_info["i2c_bus"], self._psu_info["i2c_addr"])
+        self._hwmon_path = os.path.join(self._i2c_hwmon_path, self._api_helper._get_hwmon_name(self._i2c_hwmon_path))
+
+        self.psu_presence = os.path.join(self.I2C_PSU_PATH, 'psu{}_present'.format(self.index + 1))
+        self.psu_status = os.path.join(self.I2C_PSU_PATH ,'psu{}_status'.format(self.index + 1))
+        self.psu_power_good = os.path.join(self.I2C_PSU_PATH ,'psu{}_power_ok'.format(self.index + 1))
+
+        self.psu_vin = os.path.join(self._hwmon_path, "in1_input")
+        self.psu_vout = os.path.join(self._hwmon_path, "in2_input")
+        self.psu_iin = os.path.join(self._hwmon_path, "curr1_input")
+        self.psu_iout = os.path.join(self._hwmon_path, "curr2_input")
+        self.psu_pin = os.path.join(self._hwmon_path, "power1_input")
+        self.psu_pout = os.path.join(self._hwmon_path, "power2_input")
+        self.psu_temp = os.path.join(self._hwmon_path, "temp1_input")
+        self.psu_temp_max = os.path.join(self._hwmon_path, "temp1_max")
+
+        self.psu_model = os.path.join(self._hwmon_path, "psu_mfr_model")
+        self.psu_serial = os.path.join(self._hwmon_path, "psu_mfr_serial")
+
+        for fan_index in range(0, self._psu_info["num_fans"]):
+            fan = Fan(0, fan_index, is_psu_fan=True, psu_index = self.index)
+            self._fan_list.append(fan)
+
+    def get_name(self):
+        """
+        Retrieves the name of the device
+            Returns:
+            string: The name of the device
+        """
+        return self._psu_info.get("name", "N/A")
+
+    def get_presence(self):
+        """
+        Retrieves the presence of the PSU
+        Returns:
+            bool: True if PSU is present, False if not
+        """
+        attr_file = self.psu_presence
+        attr_value = self._api_helper.read_int_from_file(attr_file)
+
+        if (attr_value is not None and attr_value == 0):
+            # Check for PSU presence
+            return True
+
+        return False
+
+
+    def get_status(self):
+        """
+        Retrieves the operational status of the device
+        Returns:
+            A boolean value, True if device is operating properly, False if not
+        """
+        attr_file = self.psu_status
+        attr_value = self._api_helper.read_int_from_file(attr_file)
+
+        if (attr_value):
+            return True
+
+        return False
+
+    def get_voltage(self):
+        """
+        Retrieves current PSU voltage output
+        Returns:
+            A float number, the output voltage in volts,
+            e.g. 12.1
+        """
+        psu_voltage = self._api_helper._get_hwmon_value(self.psu_vout)
+        return float(psu_voltage) / 1000
+
+    def get_current(self):
+        """
+        Retrieves present electric current supplied by PSU
+        Returns:
+            A float number, the electric current in amperes, e.g 15.4
+        """
+        psu_current = self._api_helper._get_hwmon_value(self.psu_iout)
+        return float(psu_current) / 1000
+
+    def get_power(self):
+        """
+        Retrieves current energy supplied by PSU
+        Returns:
+            A float number, the power in watts, e.g. 302.6
+        """
+        psu_power = self._api_helper._get_hwmon_value(self.psu_pout)
+        return float(psu_power) / 1000
+
+    def get_powergood_status(self):
+        """
+        Retrieves the powergood status of PSU
+
+        Returns:
+            A boolean, True if PSU has stablized its output voltages and passed all
+            its internal self-tests, False if not.
+        """
+        attr_value = self._api_helper.read_int_from_file(self.psu_power_good)
+
+        if (attr_value):
+            return True
+
+        return False
+
+    def get_temperature(self):
+        """
+        Retrieves current temperature reading from PSU
+        Returns:
+            A float number of current temperature in Celsius up to nearest thousandth
+            of one degree Celsius, e.g. 30.125
+            there are three temp sensors , we choose one of them
+        """
+        psu_temperature = self._api_helper._get_hwmon_value(self.psu_temp)
+        return float(psu_temperature) / 1000
+
+    def get_temperature_high_threshold(self):
+        """
+        Retrieves the high threshold temperature of PSU
+        Returns:
+            A float number, the high threshold temperature of PSU in Celsius
+            up to nearest thousandth of one degree Celsius, e.g. 30.125
+            there are three temp sensors , we choose one of them
+        """
+        psu_temperature = self._api_helper._get_hwmon_value(self.psu_temp_max)
+        return float(psu_temperature) / 1000
+
+    def get_model(self):
+        """
+        Retrieves the model number (or part number) of the device
+        Returns:
+            string: Model/part number of device
+        """
+        model = self._api_helper.read_txt_file(self.psu_model);
+        if model is None:
+            model = 'N/A'
+        return model
+
+    def get_serial(self):
+        """
+        Retrieves the serial number of the device
+        Returns:
+            string: Serial number of device
+        """
+        serial = 'N/A'
+        return serial
+
+    def is_replaceable(self):
+        """
+        Indicate whether this device is replaceable.
+        Returns:
+            bool: True if it is replaceable.
+        """
+        return True
