+        base = i2c_base + 'f2701100.i2c/i2c-1/i2c-' + bus_id + '/' + bus_id + '-00' + chip_addr + '/gpio/'
+        gpio_base_num = int(os.listdir(base)[0].partition('gpiochip')[2])
+
+        offset = self.__get_chip_offset(port_idx, function)
+
+        return gpio_base_num + offset
