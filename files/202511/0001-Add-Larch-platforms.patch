+static const struct net_device_ops mvppnd_netdev_ops = {
+	.ndo_open		= mvppnd_open,
+	.ndo_stop		= mvppnd_stop,
+	.ndo_start_xmit		= mvppnd_start_xmit,
+	.ndo_validate_addr	= eth_validate_addr,
