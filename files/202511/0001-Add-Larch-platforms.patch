+static int silicom_ec_hwmon_read_string(struct device *dev,
+					enum hwmon_sensor_types type,
+					u32 attr, int channel, const char **string)
+{
+	struct silicom_ec_hwmon *hw = dev_get_drvdata(dev);
+	const struct silicom_ec_sdata *data;
+
+	data = find_sensor_data(hw, type, channel);
+	if (IS_ERR(data))
+		return PTR_ERR(data);
+	*string = data->label;
+
+	return 0;
+}
