+static const struct silicom_ec_sdata *
+find_sensor_data(struct silicom_ec_hwmon *hw, enum hwmon_sensor_types type,
+		 int channel)
+{
+	const struct silicom_ec_sdata *tbl;
+
+	tbl = hw->bdata->tables[type];
+	if (!tbl)
+		return ERR_PTR(-EOPNOTSUPP);
+
+	return &tbl[channel];
+}
+
+static int do_sensor_write(struct silicom_ec_hwmon *hw,
+			   const struct silicom_ec_sdata *data,
+			   unsigned int regoff, long val)
+{
+	int ret;
+
+	ret = silicom_ec_sys_write(hw, regoff, val);
+
+	return ret;
+}
+
+static int do_sensor_read(struct silicom_ec_hwmon *hw,
+			  const struct silicom_ec_sdata *data,
+			  unsigned int regoff, long *val)
+{
+	unsigned int regval;
+	int ret;
+
+	ret = silicom_ec_sys_read(hw, regoff, &regval);
+	if (ret)
+		return ret;
+
+	*val = regval;
+
+	return 0;
+}
+
+static int silicom_ec_hwmon_write(struct device *dev, enum hwmon_sensor_types type,
+				 u32 attr, int channel, long val)
+{
+	struct silicom_ec_hwmon *hw = dev_get_drvdata(dev);
+	unsigned int reg = 0;
+	const struct silicom_ec_sdata *data;
+
+	data = find_sensor_data(hw, type, channel);
+	if (IS_ERR(data))
+		return PTR_ERR(data);
+
+	switch(type) {
+	case hwmon_fan:
+		switch(attr) {
+		case hwmon_fan_target:
+			reg = data->reg_target;
+			break;
+		default:
+			return -EOPNOTSUPP;
+		}
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	if (!reg)
+		return -EOPNOTSUPP;
+
+	return do_sensor_write(hw, data, reg, val);
+}
+
+static int silicom_ec_hwmon_read(struct device *dev, enum hwmon_sensor_types type,
+				 u32 attr, int channel, long *val)
+{
+	struct silicom_ec_hwmon *hw = dev_get_drvdata(dev);
+	unsigned int reg = 0;
+	const struct silicom_ec_sdata *data;
+	long value, mult_value = 0, cfg, cfg_value;
+	int ret;
+
+	data = find_sensor_data(hw, type, channel);
+	if (IS_ERR(data))
+		return PTR_ERR(data);
+
+	switch (type) {
+	case hwmon_temp:
+		switch (attr) {
+		case hwmon_temp_input:
+			reg = data->reg_input;
+			break;
+		case hwmon_temp_max:
+			reg = data->reg_max;
+			break;
+		case hwmon_temp_min:
+			reg = data->reg_min;
+			break;
+		case hwmon_temp_crit:
+			reg = data->reg_crit;
+			break;
+		case hwmon_temp_type:
+			*val = data->type;
+			return 0;
+		default:
+			return -EOPNOTSUPP;
+		}
+		break;
+	case hwmon_in:
+		switch (attr) {
+		case hwmon_in_input:
+			reg = data->reg_input;
+			break;
+		case hwmon_in_max:
+			reg = data->reg_max;
+			break;
+		case hwmon_in_min:
+			reg = data->reg_min;
+			break;
+		default:
+			return -EOPNOTSUPP;
+		}
+		break;
+	case hwmon_curr:
+		switch (attr) {
+		case hwmon_curr_input:
+			reg = data->reg_input;
+			break;
+		case hwmon_curr_max:
+			reg = data->reg_max;
+			break;
+		case hwmon_curr_min:
+			reg = data->reg_min;
+			break;
+		default:
+			return -EOPNOTSUPP;
+		}
+		break;
+	case hwmon_power:
+		switch (attr) {
+		case hwmon_power_input:
+			reg = data->reg_input;
+			cfg = data->reg_cfg;
+			break;
+		default:
+			return -EOPNOTSUPP;
+		}
+		break;
+	case hwmon_fan:
+		switch (attr) {
+		case hwmon_fan_input:
+			reg = data->reg_input;
+			break;
+		case hwmon_fan_target:
+			reg = data->reg_target;
+			break;
+		default:
+			return -EOPNOTSUPP;
+		}
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	if (!reg)
+		return -EOPNOTSUPP;
+
+	ret = do_sensor_read(hw, data, reg, &value);
+	if (ret)
+		return ret;
+
+	dev_dbg(dev, ">>>>> calculation:      value=%ld\n", value);
+	ret = do_sensor_read(hw, data, data->multiplier, &mult_value);
+	if (ret) {
+		dev_dbg(dev, ">>>>> calculation: failed to get mult_value\n");
+	} else {
+		value <<= mult_value;
+		dev_dbg(dev, ">>>>> calculation:   value<<%ld=%ld\n", mult_value, value);
+	}
+
+	if (type == hwmon_power) {
+		if (cfg) { //(strcmp(data->label, "Board Power") == 0) {
+			dev_dbg(dev, "power calculation:        cfg=0x%lx\n", cfg);
+			ret = do_sensor_read(hw, data, cfg, &cfg_value);
+			dev_dbg(dev, "power calculation:  cfg_value=%ld\n", cfg_value);
+			data = find_sensor_data(hw, hwmon_in, cfg_value);
+			ret = do_sensor_read(hw, data, data->reg_input, &mult_value);
+		} else { // if (strstr(data->label, "PSU")) {
+			mult_value = (long)1000;
+		}
+		dev_dbg(dev, "power calculation: mult_value=%ld\n", mult_value);
+		value *= mult_value;
+		dev_dbg(dev, "power calculation: value*%ld=%ld\n", mult_value, value);
+	}
+
+	*val = value;
+
+	return 0;
+}
