+    u8 reg = MB_FW_UG_REG;
+    long val = 0;
+
+    if (kstrtol(buf, 16, &val))
+    {
+        return -EINVAL;
+    }
+
+    if(val)
+        hwmon_mcu_write(client, reg, FW_UPGRADE_COMMAND);
+    else
+        hwmon_mcu_write(client, reg, 0xff);
+
+    DBG(printk(KERN_ALERT "%s - addr: 0x%x, reg: %x, data: %x\r\n", __func__, client->addr, reg, FW_UPGRADE_COMMAND));
+
+    return count;
