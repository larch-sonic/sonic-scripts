diff --git a/platform/marvell-prestera/sonic-platform-larch/cn9130-eps6800/scripts/cn9130-eps6800-init.sh b/platform/marvell-prestera/sonic-platform-larch/cn9130-eps6800/scripts/cn9130-eps6800-init.sh
