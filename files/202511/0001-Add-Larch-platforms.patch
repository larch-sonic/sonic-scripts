--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/sfp.py
@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+
+#############################################################################
+# Larch LN-4332Z4-V7
+#
+# 32x QSFP-DD. Sideband signals (ModPrsL, ResetL, IntL, RxLOS) come from the
+# CPLD IOs on I2C_IO; there is no LPMode line, so low power mode is set over
+# CMIS by SfpOptoeBase. The EEPROM of a port is reached through the CPLD mux
+# on I2C_MUX, one optoe3 device per mux channel (see cpld.py).
+#
+#############################################################################
+
+try:
+    import os
+    import time
+    from sonic_platform_base.sonic_xcvr.sfp_optoe_base import SfpOptoeBase
+    from sonic_platform import cpld
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+QSFP_PORT_START = 1
+QSFP_PORT_END = 32
+
+RESET_HOLD_SEC = 0.5
+
+
+class Sfp(SfpOptoeBase):
+    """Platform-specific Sfp class"""
+
+    def __init__(self, index):
+        assert QSFP_PORT_START <= index <= QSFP_PORT_END
+        SfpOptoeBase.__init__(self)
+        self.port_num = index
+        self._io = (None, None)
+
+    def _io_attr(self, signal):
+        """(CPLD IO sysfs dir, attribute name) of a sideband signal."""
+        dev_dir, n = self._io
+        if dev_dir is None or not os.path.isdir(dev_dir):
+            self._io = cpld.io_cpld(self.port_num)
+            dev_dir, n = self._io
+        if dev_dir is None:
+            return None, None
+        return dev_dir, "qsfp%d_%s" % (n, signal)
+
+    def _read_signal(self, signal):
+        dev_dir, attr = self._io_attr(signal)
+        return cpld.read_int_attr(dev_dir, attr)
+
+    def _write_signal(self, signal, value):
+        dev_dir, attr = self._io_attr(signal)
+        return cpld.write_attr(dev_dir, attr, value)
+
+    def get_eeprom_path(self):
+        bus = cpld.qsfp_eeprom_bus(self.port_num)
+        if bus is None:
+            # SfpOptoeBase opens the path directly: "" fails as an OSError
+            return ""
+        return "/sys/bus/i2c/devices/%d-0050/eeprom" % bus
+
+    def get_name(self):
+        return "QSFP-DD %d" % self.port_num
+
+    def get_position_in_parent(self):
+        return self.port_num
+
+    def is_replaceable(self):
+        return True
+
+    def get_presence(self):
+        return self._read_signal("present") == 1
+
+    def get_status(self):
+        return self.get_presence()
+
+    def get_reset_status(self):
+        return self._read_signal("reset") == 1
+
+    def reset(self):
+        if not self._write_signal("reset", 1):
+            return False
+        time.sleep(RESET_HOLD_SEC)
+        return self._write_signal("reset", 0)
diff --git a/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/thermal.py b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/thermal.py
