@@ -0,0 +1,240 @@
+#!/usr/bin/env python3
+
+#############################################################################
+# Pegatron Mercedes
+#
+# Module contains an implementation of SONiC Platform Base API and
+# provides the Chassis information which are available in the platform
+#
+#############################################################################
+
+import time
+
+try:
+    from sonic_platform_base.chassis_base import ChassisBase
+    from sonic_platform.thermal import Thermal
+    from sonic_platform.psu import Psu
+    from sonic_platform.fan import Fan
+    from sonic_platform.fan_drawer import FanDrawer
+    from sonic_platform.sfp import Sfp
+    from sonic_platform.eeprom import Eeprom
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+NUM_FAN_TRAY = 5
+NUM_FAN = 2
+NUM_PSU = 2
+NUM_THERMAL = 4
+NUM_SFP = 56
+IDX_QSFP_FIRST = 48
+SYSLED_PATH = "/sys/bus/i2c/devices/6-0075/sys_led"
+FANLED_PATH = "/sys/bus/i2c/devices/6-0075/fan_led"
+PWRLED_PATH = "/sys/bus/i2c/devices/6-0075/pwr_led"
+
+class Chassis(ChassisBase):
+    """Platform-specific Chassis class"""
+
+    def __init__(self):
+        ChassisBase.__init__(self)
+        self.presence_list = ['0']*NUM_SFP
+        self.config_data = {}
+        for index in range(0, NUM_THERMAL):
+            thermal = Thermal(index)
+            self._thermal_list.append(thermal)
+        for index in range(0, NUM_PSU):
+            psu = Psu(index)
+            self._psu_list.append(psu)
+        for fantray_index in range(0, NUM_FAN_TRAY):
+            fan_drawer = FanDrawer(fantray_index, NUM_FAN)
+            self._fan_drawer_list.append(fan_drawer)
+            self._fan_list.extend(fan_drawer.get_all_fans())
+        for index in range(0, NUM_SFP):
+            type = 'SFP' if index < IDX_QSFP_FIRST else 'QSFP'
+            sfp_node = Sfp(index, type)
+            self._sfp_list.append(sfp_node)
+        self._eeprom = Eeprom()
+        self.SYSLED_MODES = {
+            "00" : self.STATUS_LED_COLOR_GREEN,
+            "01" : self.STATUS_LED_COLOR_AMBER,
+            "02" : self.STATUS_LED_COLOR_OFF,
+            "03" : "blink_green",
+            "04" : "blink_amber"
+        }
+
+    def __read_txt_file(self, file_path):
+        try:
+            with open(file_path, 'r') as fd:
+                data = fd.read()
+                return data.strip()
+        except IOError:
+            logging.error("Unable to read ", file_path, " file !")
+            return False
+
+    def __write_txt_file(self, file_path, value):
+        value_str = str(value).strip()
+    
+        # Check if the file already has the desired value
+        current_value = self.__read_txt_file(file_path)
+        if current_value == value_str:
+            return True
+
+        # Otherwise, write the new value
+        try:
+            with open(file_path, 'w') as fd:
+                fd.write(str(value))
+        except IOError:
+            logging.error("Unable to write ", file_path, " file !")
+            return False
+        return True
+
+    def get_eeprom(self):
+        return self._eeprom
+
+    def get_name(self):
+        """ 
+        Retrieves the name of the chassis
+        Returns:
+            string: The name of the chassis
+        """
+        return self._eeprom.modelstr()
+
+    def get_presence(self):
+        """ 
+        Retrieves the presence of the chassis
+        Returns:
+            bool: True if chassis is present, False if not
+        """
+        return True
+
+    def get_model(self):
+        """ 
+        Retrieves the model number (or part number) of the chassis
+        Returns:
+            string: Model/part number of chassis
+        """
+        return self._eeprom.modelstr()
+
+    def get_serial(self):
+        """
+        Retrieves the serial number of the chassis (Service tag)
+        Returns:
+            string: Serial number of chassis
+        """
+        return self._eeprom.serial_number_str()
+
+    def get_revision(self):
+        """
+        Retrieves the revision number of the chassis (Service tag)
+        Returns:
+            string: Revision number of chassis
+        """
+        return self._eeprom.revision_str()
+    
+    def get_sfp(self, index):
+        """
+        Retrieves sfp represented by (1-based) index <index>
+        Args:
+            index: An integer, the index (1-based) of the sfp to retrieve.
+            The index should be the sequence of physical SFP ports in a chassis,
+            starting from 1.
+            For example, 1 for first SFP port in the chassis and so on.
+        Returns:
+            An object dervied from SfpBase representing the specified sfp
+        """
+        sfp = None
+        try:
+            # The index will start from 1
+            sfp = self._sfp_list[index-1]
+        except IndexError:
+            pass
+
+        return sfp
+
+    def get_change_event(self, timeout=0):
+        """
+        Returns a nested dictionary containing all devices which have
+        experienced a change at chassis level
+
+        Args:
+            timeout: Timeout in milliseconds (optional). If timeout == 0,
+                this method will block until a change is detected.
+
+        Returns:
+            (bool, dict):
+                - True if call successful, False if not;
+                - A nested dictionary where key is a device type,
+                  value is a dictionary with key:value pairs in the
+                  format of {'device_id':'device_event'},
+                  where device_id is the device ID for this device and
+                        device_event,
+                             status='1' represents device inserted,
+                             status='0' represents device removed.
+                  Ex. {'fan':{'0':'0', '2':'1'}, 'sfp':{'11':'0'}}
+                      indicates that fan 0 has been removed, fan 2
+                      has been inserted and sfp 11 has been removed.
+        """
+        start_time = time.time() * 1000;
+        sfp_dict = {}
+        events_dict = { 'sfp': sfp_dict }
+
+        while True:
+            for x in range(0, NUM_SFP):
+                if True == self.get_sfp(x).get_presence():
+                    presence = '1'
+                else:
+                    presence = '0'
+                if presence != self.presence_list[x]:
+                    self.presence_list[x] = presence
+                    sfp_dict[int(x)] = presence
+
+            if len(sfp_dict) > 0:
+                return True, events_dict
+
+            if timeout:
+                time.sleep(1)
+                now_time = time.time() * 1000
+                if (now_time - start_time >= timeout):
+                    return True, events_dict
+
+    def initizalize_system_led(self):
+        """
+        This function is not defined in chassis base class,
+        system-health command would invoke chassis.initizalize_system_led(),
+        add this stub function just to let the command sucessfully execute
+        """
+        pass
+
+    def _set_led(self, path, color):
+        mode = None
+        for key, val in self.SYSLED_MODES.items():
+            if val == color:
+                mode = key
+                break
+        if mode is None:
+            return False
+        else:
+            return self.__write_txt_file(path, mode)
+
+    def get_status_led(self):
+        val = self.__read_txt_file(SYSLED_PATH)
+        return self.SYSLED_MODES[val] if val in self.SYSLED_MODES else "UNKNOWN"
+
+    def set_status_led(self, color):
+        self._set_led (SYSLED_PATH, color)
+
+    def _init_leds(self):
+        self._set_led (FANLED_PATH, self.STATUS_LED_COLOR_GREEN)
+        self._set_led (PWRLED_PATH, self.STATUS_LED_COLOR_GREEN)
+
+    def get_reboot_cause(self):
+        """
+        Retrieves the cause of the previous reboot
+        Returns:
+            A tuple (string, string) where the first element is a string
+            containing the cause of the previous reboot. This string must be
+            one of the predefined strings in this class. If the first string
+            is "REBOOT_CAUSE_HARDWARE_OTHER", the second string can be used
+            to pass a description of the reboot cause.
+        """
+
+        return (ChassisBase.REBOOT_CAUSE_NON_HARDWARE, "Unknown")
