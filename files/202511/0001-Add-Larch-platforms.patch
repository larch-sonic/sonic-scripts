+#!/bin/bash
+
+# Platform init script for ln3548xgf-6z-v5
+
+
+ln3548xgf-6z-v5_profile()
+{
+    MAC_ADDR=$(fw_printenv -n ethaddr)
+    find /usr/share/sonic/device/*ln3548xgf-6z-v5* -name profile.ini | xargs sed -i "s/switchMacAddress=.*/switchMacAddress=$MAC_ADDR/g"
+    echo "ln3548xgf-6z-v5: Updating switch mac address ${MAC_ADDR}"
+    ifconfig eth0 hw ether $MAC_ADDR
+
+    modprobe optoe
+
+    echo pmbus 0x3c > /sys/class/i2c-adapter/i2c-2/new_device
+    echo 24c02 0x38 > /sys/class/i2c-adapter/i2c-2/new_device
+    echo pmbus 0x3d > /sys/class/i2c-adapter/i2c-2/new_device
+    echo 24c02 0x39 > /sys/class/i2c-adapter/i2c-2/new_device
+    #echo max31785 0x54 > /sys/class/i2c-adapter/i2c-2/new_device
+    echo pca9555 0x21 > /sys/class/i2c-adapter/i2c-2/new_device
+
+    # modprobe hid_mcp2221
+}
+
+# - Main entry
+ln3548xgf-6z-v5_profile
+
+exit 0
