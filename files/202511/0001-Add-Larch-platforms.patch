diff --git a/device/larch/arm64-larch_ln3548xgf-6z-v1/ln3548xgf-6z-v1/pg_profile_lookup.ini b/device/larch/arm64-larch_ln3548xgf-6z-v1/ln3548xgf-6z-v1/pg_profile_lookup.ini
