+
+#define GET_BIT(data, bit, value)       (value) = ((data) >> (bit)) & 0x1
+#define SET_BIT(data, bit)              (data) |= (1 << (bit))
+#define CLEAR_BIT(data, bit)            (data) &= ~(1 << (bit))
+
+enum wnc_hwmon_psu_control_bits
+{
+    PSU_STATUS_BIT = 0,
+    PSU_POWER_OK_BIT,
+    PSU_PRESENCE_BIT,
+    PSU_INPUT_OK_BIT = 4,
+    PSU_ALARM_BIT = 6
+};
+
+enum wnc_hwmon_register
+{
+    PCB_REVERSION = 0,
+    FPGA_VER_1,
+    FPGA_VER_2,
+    RESET_CONTROL_1,
+    RESET_CONTROL_2,
+    RESET_CONTROL_3,
+
+    FAN_PWM_1 = 0x0e,
+    FAN_PWM_2,
+    FAN_PWM_3,
+    FAN_PWM_4,
+    FAN_PWM_5,
+    FAN_PWM_6,
+
+    FAN_1_1_RPM = 0x14,
+    FAN_1_2_RPM = 0x16,
+    FAN_2_1_RPM = 0x18,
+    FAN_2_2_RPM = 0x1a,
+    FAN_3_1_RPM = 0x1c,
+    FAN_3_2_RPM = 0x1e,
+    FAN_4_1_RPM = 0x20,
+    FAN_4_2_RPM = 0x22,
+    FAN_5_1_RPM = 0x24,
+    FAN_5_2_RPM = 0x26,
+    FAN_6_1_RPM = 0x28,
+    FAN_6_2_RPM = 0x2a,
+
+    PSU_1_CTRL = 0x2c,
+    PSU_2_CTRL,
+    
+    STATUS_LED,
+    FAN_LED,
+
+    POWER_GOOD,
+
+    WDT_CTRL = 0x33,
+    WDT_TIMEOUT,
+    FAN_PRESENT,
+    FAN_DIRECTION,
+
+};
+
+static struct mutex wnc_hwmon_lock;
+
+static int wnc_hwmon_read(struct i2c_client *client, u8 reg)
+{
+    int data = -EPERM;
+
+    mutex_lock(&wnc_hwmon_lock);
+
+    data = i2c_smbus_read_word_data(client, reg);
+
+    mutex_unlock(&wnc_hwmon_lock);
+
+    return data;
+}
+
+static int wnc_hwmon_write(struct i2c_client *client, u8 reg, u8 val)
+{
+    int ret = -EIO;
+
+    mutex_lock(&wnc_hwmon_lock);
+
+    ret = i2c_smbus_write_byte_data(client, reg, val);
+
+    mutex_unlock(&wnc_hwmon_lock);
+
+    return ret;
+}
+
+static ssize_t get_fan_pwm(struct device *dev, struct device_attribute *da,
+             char *buf)
+{
+    struct i2c_client *client = to_i2c_client(dev);
+    struct sensor_device_attribute *attr = to_sensor_dev_attr(da);
+    u8 data = 0;
+    u8 reg = FAN_PWM_1 + attr->index;
+
+    data = wnc_hwmon_read(client, reg);
+    DBG(printk(KERN_ALERT "%s - addr: 0x%x, reg: %x, data: %x\r\n", __func__, client->addr, reg, data));
+
+    return sprintf(buf, "%d\n", data);
+}
+
+static ssize_t set_fan_pwm(struct device *dev, struct device_attribute *da,
+             const char *buf, size_t count)
+{
+    struct i2c_client *client = to_i2c_client(dev);
+    struct sensor_device_attribute *attr = to_sensor_dev_attr(da);
+    u8 reg = FAN_PWM_1 + attr->index;
+    long val = 0;
+
+    if (kstrtol(buf, 10, &val))
+    {
+        return -EINVAL;
+    }
+
+    DBG(printk(KERN_ALERT "%s - addr: 0x%x, reg: %x, val: %x\r\n", __func__, client->addr, reg, val));
+    wnc_hwmon_write(client, reg, val);
+
+    return count;
+}
+
+static ssize_t get_fan_inner_rpm(struct device *dev, struct device_attribute *da,
+             char *buf)
+{
+    struct sensor_device_attribute *attr = to_sensor_dev_attr(da);
+    struct i2c_client *client = to_i2c_client(dev);
+    u16 data = 0;
+    u8 reg = FAN_1_1_RPM + attr->index*4;
+
+    data = wnc_hwmon_read(client, reg);
+    DBG(printk(KERN_ALERT "%s - addr: 0x%x, reg: %x, data: %x\r\n", __func__, client->addr, reg, data));
+
+    return sprintf(buf, "%d\n", data);
+}
+
+static ssize_t get_fan_outer_rpm(struct device *dev, struct device_attribute *da,
