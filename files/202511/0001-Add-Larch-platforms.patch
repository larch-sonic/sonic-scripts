+    u8 reg = (QSFP_RESET_ADDRESS_BASE + attr->index % QSFP_FIRST_PORT / 4), data = 0;
+    long val = 0;
+
+    if (kstrtol(buf, 16, &val))
+    {
+        return -EINVAL;
