+
+	sz = sscanf(buf, "%x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x",
+		    &dsa[0], &dsa[1], &dsa[2], &dsa[3], &dsa[4], &dsa[5],
+		    &dsa[6], &dsa[7], &dsa[8], &dsa[9], &dsa[10], &dsa[11],
+		    &dsa[12], &dsa[13], &dsa[14], &dsa[15], &dsa[16], &dsa[17],
+		    &dsa[18], &dsa[19]);
