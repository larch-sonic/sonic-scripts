+#!/bin/bash
+
+# Platform init script for qn-sr-400
+
+qn-sr-400_profile()
+{
+    MAC_ADDR=$(fw_printenv -n ethaddr 2>/dev/null)
+    if [ -z "$MAC_ADDR" ]; then
+        echo "$(basename "$0"): could not read ethaddr from the U-Boot environment;"
+        echo "$(basename "$0"): leaving switchMacAddress in profile.ini untouched" >&2
+        return 0
+    fi
+    find /usr/share/sonic/device/*qn-sr-400* -name profile.ini | xargs sed -i "s/switchMacAddress=.*/switchMacAddress=$MAC_ADDR/g"
+    echo "qn-sr-400: Updating switch mac address ${MAC_ADDR}"
+    sudo ifconfig eth0 hw ether $MAC_ADDR
+    
+    sudo modprobe optoe
+    # all peripheral related i2c devices are instantiated via device tree
+
+    echo "pmbus 0x58" > /sys/bus/i2c/devices/i2c-3/new_device
+    echo "24c02 0x50" > /sys/bus/i2c/devices/i2c-3/new_device
+    echo "pmbus 0x58" > /sys/bus/i2c/devices/i2c-4/new_device
+    echo "24c02 0x50" > /sys/bus/i2c/devices/i2c-4/new_device
+
+    rebrand # this platform is for customer who requires another name of nos
+}
+
+rebrand()
+{
+    # change a console pre-login banner
+    sudo bash -c "printf 'QNOS \S \\\r \m \l \n\n' > /etc/issue"
+
+    # The hostname is not set here. This unit runs before CONFIG_DB exists, and
+    # hostname-config.service would overwrite whatever is set now with the value
+    # from the database. qn-sr-400-rebrand.service puts qnos into CONFIG_DB in
+    # time for that service to apply it properly.
+}
+
+# - Main entry
+qn-sr-400_profile
+
+exit 0
diff --git a/platform/marvell-prestera/sonic-platform-larch/qn-sr-400/scripts/qn-sr-400-rebrand.sh b/platform/marvell-prestera/sonic-platform-larch/qn-sr-400/scripts/qn-sr-400-rebrand.sh
