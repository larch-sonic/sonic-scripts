+/*
+ * Caspian/SIP7 GDMA use plan:
+ * GDMA unit 1 To CPU (RX) rings 0..31 - GDMA 3 interrupt summary
+ * GDMA unit 3 from CPU (TX) rings 0..31 - GDMA 7 interrupt summary
+*/
+
+#define NUM_OF_TX_QUEUES NUM_OF_RX_QUEUES
+#define NUM_OF_ATU_WINDOWS_SIP6 8
+#define SIP7_ATU_CNT 32
+#define MAX_OATU_CNT 8
+#define NUM_OF_MG_WINDOWS 6
+#define ATU_OFFS_SIP6 0x1200 /* iATU offset in bar0 */
+#define ATU_OFFS_SIP7 0x0 /* iATU offset in bar0 */
+#define ATU_WIN_SIZE 0x000FFFFF
+
+/* Caspian MSI-X client: */
+#define MSI_X_CLIENT_ATU_WIN_NUM 30
+#define MSI_X_OFS     0x20000
+#define ID_MASK_OFFSET 0xC
+#define MSIX_INT_TBL_OFFSET 0x1000
+
+#define MAX_MSIX_INTS 256
+#define MSIX_TBL_INT_ID_BITSHIFT 5
+#define INT_TBL_CTL_MASK 0x1F
