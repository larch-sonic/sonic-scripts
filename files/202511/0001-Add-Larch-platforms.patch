+    # NOTE: value is wrapped in double quotes so U-Boot 'setenv' receives it as a
+    # single argument. Without quotes the fully-expanded token count can exceed
+    # CONFIG_SYS_MAXARGS (~16 on U-Boot 2023.01), making setenv fail with a usage
+    # error and leaving bootargs at the default (root=/dev/ram0) -> boot hangs.
+    sonic_bootargs_old='setenv bootargs "root='$demo_dev' rw rootwait rootfstype=ext4 panic=1 ${console} ${othbootargs} ${mtdparts} ${linuxargs_old}"'
+    fw_setenv ${FW_ARG} sonic_bootargs_old "$sonic_bootargs_old" > /dev/null || true
