index 000000000..83f0bbba8
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/thermal.py
@@ -0,0 +1,180 @@
+#!/usr/bin/env python3
+
+#############################################################################
+# Larch LN-4332Z4-V7
+#
+# The CPU package (coretemp hwmon), the Falcon (ASIC_TEMPERATURE_INFO in
+# STATE_DB, published by orchagent's ASIC sensor poller, see "asic_sensors"
+# in platform.json) and the board sensors read by the EC: thermistors, the
+# switch card TMP75s and the Falcon/3.3V voltage regulators (ec.py). The PSU
+# temperatures belong to psu.py.
+#
+#############################################################################
+
+import glob
+import os
+
+try:
+    import redis
+    from sonic_platform_base.thermal_base import ThermalBase
+    from sonic_platform.ec import EcHwmon
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+STATE_DB_INDEX = 6
+ASIC_TEMP_KEY = "ASIC_TEMPERATURE_INFO"
+
+# Falcon limit from the HW Programmer Guide sensor list (Appendix D); the
+# guide gives no critical limit.
+ASIC_HIGH_THRESHOLD = 105.0
+
+# EC sensors (hwmon label) and their high limit in °C, from the sensor list
+# of the HW Programmer Guide (Appendix D, MHO-200 values where they differ).
+# The EC also reports a CPU PECI reading, which duplicates coretemp.
+EC_THERMALS = [
+    ("Ambient", 95.0),
+    ("Core VR", 110.0),
+    ("DDR", 85.0),
+    ("CPU", 100.0),
+    ("SW Amb Left", 70.0),
+    ("SW Amb Right", 70.0),
+    ("Core Temp", 110.0),
+    ("GOP Temp", 110.0),
+    ("VDDA Temp", 105.0),
+    ("VDDH Temp", 100.0),
+    ("3.3V Left Temp", 100.0),
+    ("3.3V Right Temp", 100.0),
+]
+
+CPU_THERMAL = 0
+ASIC_THERMAL = 1
+EC_THERMAL_START = 2
+NUM_THERMAL = EC_THERMAL_START + len(EC_THERMALS)
+
+
+def _read_file(path):
+    try:
+        with open(path) as f:
+            return f.read().strip()
+    except OSError:
+        return None
+
+
+def _coretemp_package_input():
+    """temp*_input of the coretemp "Package id 0" sensor, or None."""
+    for hwmon in glob.glob("/sys/class/hwmon/hwmon*"):
+        if _read_file(os.path.join(hwmon, "name")) != "coretemp":
+            continue
+        for label in glob.glob(os.path.join(hwmon, "temp*_label")):
+            if _read_file(label) == "Package id 0":
+                return label.replace("_label", "_input")
+    return None
+
+
+class Thermal(ThermalBase):
+    """Platform-specific Thermal class"""
+
+    _NAMES = ["CPU Package", "ASIC"] + [label for label, _ in EC_THERMALS]
+    _redis = redis.Redis(db=STATE_DB_INDEX)
+
+    def __init__(self, index):
+        ThermalBase.__init__(self)
+        self.index = index
+        self._cpu_input = None
+        self.minimum_recorded = None
+        self.maximum_recorded = None
+
+    def _cpu_file(self, attr):
+        if self._cpu_input is None or not os.path.exists(self._cpu_input):
+            self._cpu_input = _coretemp_package_input()
+        if self._cpu_input is None:
+            return None
+        return self._cpu_input.replace("_input", "_" + attr)
+
+    def _cpu_millideg(self, attr):
+        path = self._cpu_file(attr)
+        val = _read_file(path) if path else None
+        try:
+            return float(val) / 1000
+        except (TypeError, ValueError):
+            return None
+
+    def _asic_temp(self):
+        try:
+            data = self._redis.hgetall(ASIC_TEMP_KEY)
+        except redis.exceptions.RedisError:
+            return None
+        for field in (b"maximum_temperature", b"temperature_0"):
+            try:
+                val = float(data[field])
+            except (KeyError, ValueError):
+                continue
+            # The poller reports 0 until the SAI returns a reading.
+            return val if val > 0 else None
+        return None
+
+    def _record(self, temp):
+        if temp is None:
+            return
+        if self.minimum_recorded is None or temp < self.minimum_recorded:
+            self.minimum_recorded = temp
+        if self.maximum_recorded is None or temp > self.maximum_recorded:
+            self.maximum_recorded = temp
+
+    def get_name(self):
+        return self._NAMES[self.index]
+
+    def get_presence(self):
+        return True
+
+    def get_model(self):
+        return "N/A"
+
+    def get_serial(self):
+        return "N/A"
+
+    def get_status(self):
+        return self.get_temperature() is not None
+
+    def _ec_label(self):
+        return EC_THERMALS[self.index - EC_THERMAL_START][0]
+
+    def get_temperature(self):
+        if self.index == CPU_THERMAL:
+            temp = self._cpu_millideg("input")
+        elif self.index == ASIC_THERMAL:
+            temp = self._asic_temp()
+        else:
+            temp = EcHwmon.read_scaled("temp", self._ec_label())
+        self._record(temp)
+        return temp
+
+    def get_high_threshold(self):
+        if self.index == CPU_THERMAL:
+            return self._cpu_millideg("max")
+        if self.index == ASIC_THERMAL:
+            return ASIC_HIGH_THRESHOLD
+        return EC_THERMALS[self.index - EC_THERMAL_START][1]
+
+    def get_high_critical_threshold(self):
+        if self.index == CPU_THERMAL:
+            return self._cpu_millideg("crit")
+        return None
+
+    def get_low_threshold(self):
+        return None
+
+    def get_low_critical_threshold(self):
+        return None
+
+    def get_minimum_recorded(self):
+        return self.minimum_recorded
+
+    def get_maximum_recorded(self):
+        return self.maximum_recorded
+
+    def get_position_in_parent(self):
+        return self.index + 1
+
+    def is_replaceable(self):
+        return False
diff --git a/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/watchdog.py b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/watchdog.py
new file mode 100644
index 000000000..797d852f5
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/watchdog.py
@@ -0,0 +1,98 @@
+#!/usr/bin/env python3
+
+#############################################################################
+# Larch LN-4332Z4-V7
+#
+# Hardware watchdog: the Intel PCH TCO timer (iTCO_wdt, /dev/watchdog0,
+# 2-613 s), driven through the standard Linux watchdog ioctls. The EC has a
+# watchdog of its own (datasheet 10.5.6), but it is not reachable from the
+# host without the Silicom EC driver.
+#
+#############################################################################
+
+import array
+import fcntl
+import os
+
+try:
+    from sonic_platform_base.watchdog_base import WatchdogBase
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+WATCHDOG_DEVICE = "/dev/watchdog0"
+
+# <linux/watchdog.h>
+_IOC_READ = 0x80000000
+_IOC_READ_WRITE = 0xC0000000
+_IOC_SIZE_INT = 0x00040000
+_IOC_TYPE_WATCHDOG = ord('W') << 8
+
+WDIOC_SETOPTIONS = 4 | _IOC_READ | _IOC_SIZE_INT | _IOC_TYPE_WATCHDOG
+WDIOC_KEEPALIVE = 5 | _IOC_READ | _IOC_SIZE_INT | _IOC_TYPE_WATCHDOG
+WDIOC_SETTIMEOUT = 6 | _IOC_READ_WRITE | _IOC_SIZE_INT | _IOC_TYPE_WATCHDOG
+WDIOC_GETTIMEOUT = 7 | _IOC_READ | _IOC_SIZE_INT | _IOC_TYPE_WATCHDOG
+WDIOC_GETTIMELEFT = 10 | _IOC_READ | _IOC_SIZE_INT | _IOC_TYPE_WATCHDOG
+
+WDIOS_DISABLECARD = 0x0001
+WDIOS_ENABLECARD = 0x0002
+
+WD_COMMON_ERROR = -1
+
+
+class Watchdog(WatchdogBase):
+    """Platform-specific Watchdog class"""
+
+    def __init__(self, device=WATCHDOG_DEVICE):
+        WatchdogBase.__init__(self)
+        self._fd = os.open(device, os.O_WRONLY)
+        # Opening the device starts the timer: keep it stopped until armed.
+        self._set_options(WDIOS_DISABLECARD)
+        self.armed = False
+        self.timeout = self._get_int(WDIOC_GETTIMEOUT)
+
+    def _set_options(self, options):
+        fcntl.ioctl(self._fd, WDIOC_SETOPTIONS, array.array('h', [options]), False)
+
+    def _get_int(self, request):
+        buf = array.array('I', [0])
+        fcntl.ioctl(self._fd, request, buf, True)
+        return int(buf[0])
+
+    def _set_timeout(self, seconds):
+        buf = array.array('I', [seconds])
+        fcntl.ioctl(self._fd, WDIOC_SETTIMEOUT, buf, True)
+        return int(buf[0])
+
+    def arm(self, seconds):
+        if seconds < 0:
+            return WD_COMMON_ERROR
+        try:
+            if self.timeout != seconds:
+                self.timeout = self._set_timeout(seconds)
+            if self.armed:
+                fcntl.ioctl(self._fd, WDIOC_KEEPALIVE)
+            else:
+                self._set_options(WDIOS_ENABLECARD)
+                self.armed = True
+        except OSError:
+            return WD_COMMON_ERROR
+        return self.timeout
+
+    def disarm(self):
+        try:
+            self._set_options(WDIOS_DISABLECARD)
+        except OSError:
+            return False
+        self.armed = False
+        return True
+
+    def is_armed(self):
+        return self.armed
+
+    def get_remaining_time(self):
+        if not self.armed:
+            return WD_COMMON_ERROR
+        try:
+            return self._get_int(WDIOC_GETTIMELEFT)
+        except OSError:
+            return WD_COMMON_ERROR
diff --git a/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/utils/ln4332z4-v7-falcon-temp.sh b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/utils/ln4332z4-v7-falcon-temp.sh
new file mode 100644
index 000000000..f473bb71f
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/utils/ln4332z4-v7-falcon-temp.sh
@@ -0,0 +1,25 @@
+#!/bin/bash
+
+# The EC reads the Falcon temperature from CPLD CTRL register 0x17 (via
+# I2C_TEL) for its telemetry; the CPU has to write it there. Copy the ASIC
+# temperature published by orchagent's sensor poller into the CPLD.
+
+INTERVAL=10
+
+ctrl_cpld()
+{
+    for dev in /sys/bus/i2c/devices/*-0040; do
+        [ "$(cat $dev/name 2>/dev/null)" = "ln4332z4_cpld_ctrl" ] && echo $dev && return 0
+    done
+    return 1
+}
+
+while true; do
+    temp=$(redis-cli -n 6 hget ASIC_TEMPERATURE_INFO maximum_temperature 2>/dev/null)
+    temp=${temp%%.*}
+    # 0 until the SAI returns a reading
+    if [ -n "$temp" ] && [ "$temp" -gt 0 ] 2>/dev/null; then
+        dev=$(ctrl_cpld) && echo $temp > $dev/falcon_temp
+    fi
+    sleep $INTERVAL
+done
diff --git a/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/utils/ln4332z4-v7-init.sh b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/utils/ln4332z4-v7-init.sh
new file mode 100755
index 000000000..019d2065f
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/utils/ln4332z4-v7-init.sh
@@ -0,0 +1,129 @@
+#!/bin/bash
+
+# Platform init script for ln4332z4-v7
+
+PLATFORM_DIR=/usr/share/sonic/device/x86_64-larch_ln4332z4-v7
+SYSEEPROM_ADDR=0x56
+
+# optoe fails an EEPROM access the module does not ACK within its
+# write_timeout (25 ms by default). Some modules NACK for longer after a
+# page change (the OEM QDD-400G-DR4: "Restore page register to 0
+# failed:-110"), which fails the read and leaves the module on the wrong
+# page. The kernel optoe accepts up to 500 ms.
+OPTOE_WRITE_TIMEOUT_MS=100
+
+# The ONIE TlvInfo EEPROM is the host FRU at 0x56 on the i801 SMBus. The
+# adapter number depends on probe order, so find the adapter by name.
+syseeprom_init()
+{
+    for adapter in /sys/bus/i2c/devices/i2c-*; do
+        case "$(cat $adapter/name 2>/dev/null)" in
+        SMBus\ I801\ adapter*)
+            bus=${adapter##*/i2c-}
+            if [ ! -e /sys/bus/i2c/devices/${bus}-0056 ]; then
+                echo "24c02 $SYSEEPROM_ADDR" > $adapter/new_device || true
+            fi
+            return 0
+            ;;
+        esac
+    done
+    echo "ln4332z4-v7: i801 SMBus adapter not found - system EEPROM unavailable" >&2
+    return 1
+}
+
+# The switch card buses are the DesignWare controllers of the PCH, found by
+# their ACPI node (the adapter numbers depend on probe order):
+#   I2C1 = I2C_IO   CPLD IO left 0x70 / right 0x71 (QSFP sideband)
+#   I2C2 = I2C_MUX  the same CPLDs as EEPROM muxes, port EEPROM at 0x50
+#   I2C5 = I2C_MAIN CPLD CTRL 0x40
+acpi_i2c_bus()
+{
+    for adapter in /sys/bus/i2c/devices/i2c-*; do
+        if [ "$(cat $adapter/../firmware_node/path 2>/dev/null)" = "\\_SB_.PC00.$1" ]; then
+            echo ${adapter##*/i2c-}
+            return 0
+        fi
+    done
+    return 1
+}
+
+new_i2c_device()
+{
+    # $1 bus, $2 driver name, $3 address (0xNN)
+    [ -e /sys/bus/i2c/devices/$1-00${3#0x} ] && return 0
+    echo "$2 $3" > /sys/bus/i2c/devices/i2c-$1/new_device
+}
+
+cpld_init()
+{
+    modprobe ln4332z4_cpld || { echo "ln4332z4-v7: cannot load ln4332z4_cpld" >&2; return 1; }
+    # Load optoe before the cage devices are created. Left to udev it loads
+    # while the loop below runs, so the first cages are not bound yet, their
+    # port_name and write_timeout do not exist, and the writes are lost.
+    modprobe optoe || echo "ln4332z4-v7: cannot load optoe" >&2
+
+    io_bus=$(acpi_i2c_bus I2C1)
+    mux_bus=$(acpi_i2c_bus I2C2)
+    main_bus=$(acpi_i2c_bus I2C5)
+    if [ -z "$io_bus" ] || [ -z "$mux_bus" ] || [ -z "$main_bus" ]; then
+        echo "ln4332z4-v7: switch card I2C buses not found (io=$io_bus mux=$mux_bus main=$main_bus)" >&2
+        return 1
+    fi
+
+    new_i2c_device $main_bus ln4332z4_cpld_ctrl 0x40
+    for addr in 0x70 0x71; do
+        [ $addr = 0x70 ] && first_port=1 || first_port=17
+        new_i2c_device $io_bus ln4332z4_cpld_io $addr
+        new_i2c_device $mux_bus ln4332z4_qsfp_mux $addr
+        mux=/sys/bus/i2c/devices/$mux_bus-00${addr#0x}
+        for chan in $(seq 0 15); do
+            bus=$(readlink $mux/channel-$chan 2>/dev/null) || continue
+            bus=${bus##*/i2c-}
+            new_i2c_device $bus optoe3 0x50
+            echo "QSFP-DD$((first_port + chan))" > /sys/bus/i2c/devices/$bus-0050/port_name 2>/dev/null || true
+            echo $OPTOE_WRITE_TIMEOUT_MS > /sys/bus/i2c/devices/$bus-0050/write_timeout 2>/dev/null || true
+        done
+        # Port LED brightness (reg 0x1C) as the HW Programmer Guide gives it
+        # for reset: green 100%, amber 50%. The board comes up with green at
+        # 50%, whose PWM shows as blinking.
+        io=/sys/bus/i2c/devices/$io_bus-00${addr#0x}
+        echo 7 > $io/led_pwm_green 2>/dev/null || true
+        echo 3 > $io/led_pwm_amber 2>/dev/null || true
+    done
+}
+
+# Give the SAI the switch's own base MAC instead of the template value.
+switch_mac_init()
+{
+    mac=$(python3 -c 'from sonic_platform.eeprom import Eeprom; print(Eeprom().base_mac_addr())' 2>/dev/null)
+    case "$mac" in
+    ??:??:??:??:??:??)
+        find $PLATFORM_DIR -name profile.ini | xargs sed -i "s/switchMacAddress=.*/switchMacAddress=$mac/"
+        echo "ln4332z4-v7: switch MAC address $mac"
+        ;;
+    *)
+        echo "ln4332z4-v7: no base MAC in the system EEPROM; profile.ini left unchanged" >&2
+        ;;
+    esac
+}
+
+# EC telemetry (fans, board sensors, PSU readings) and LEDs: Silicom drivers
+# for the ACPI devices SILC1004 (hwmon) and SILC1005 (LEDs, reset button).
+# udev loads them by modalias too, but not on the boot that installs them.
+ec_init()
+{
+    modprobe silicom-ec-hwmon || echo "ln4332z4-v7: cannot load silicom-ec-hwmon" >&2
+    modprobe silicom-mec || echo "ln4332z4-v7: cannot load silicom-mec" >&2
+    # status LED blinking (led.py) uses the timer trigger
+    modprobe ledtrig-timer || true
+}
+
+# /dev/i2c-N for i2c-tools (i2cdetect, i2cget) and Silicom's mho_info.sh
+modprobe i2c-dev || echo "ln4332z4-v7: cannot load i2c-dev" >&2
+
+syseeprom_init
+switch_mac_init
+cpld_init
+ec_init
+
+exit 0
diff --git a/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/utils/ln4332z4-v7-reset-button.py b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/utils/ln4332z4-v7-reset-button.py
new file mode 100755
index 000000000..265bdab15
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/utils/ln4332z4-v7-reset-button.py
@@ -0,0 +1,365 @@
+#!/usr/bin/env python3
+"""
+Reset button handler for ln4332z4-v7 (Silicom MHO-200).
+
+The recessed reset button on the rear panel goes to the EC (MEC1723). Left to
+the EC it is the documented hardware reset: a press of about 4 s resets the
+CPU and the switch card (datasheet table 6, HW Programmer Guide 3.2.1.10).
+The silicom-mec driver puts the button in "soft" mode at probe (ACPI RSTB(1),
+EC RAM 0x4D bit 0): the EC then resets nothing and reports the press and the
+release as ACPI notifications 0xC5 / 0xC6 on SILC1005, which the driver
+forwards to the ACPI netlink family "acpi_event".
+
+This daemon listens to those events, times the press and acts on release.
+The 4 s threshold is the documented one; the factory reset band and the LED
+cues follow ln4332z-v1:
+
+    < 4 s                nothing
+    4 s .. < 10 s        reboot          - power LED blinks twice at 4 s
+    10 s .. < 15 s       reset-factory   - power LED blinks three times at 10 s
+    >= 15 s              the press is abandoned; releasing does nothing
+
+The blinks fire while the button is still held, so the operator holds until
+the LED answers instead of counting seconds.
+
+When an operator stops the daemon (--unmask, ExecStopPost) the button is
+handed back to the EC hardware reset (RSTB(0)); not when the system is going
+down or the daemon is being restarted, where a press would then reset the
+box in the middle of it.
+"""
+
+import argparse
+import logging
+import logging.handlers
+import os
+import select
+import socket
+import struct
+import subprocess
+import sys
+import threading
+import time
+
+ACPI_DEVICE = "SILC1005:00"
+RSTBTN_SOFT = "/sys/bus/acpi/devices/%s/rstbtn_soft" % ACPI_DEVICE
+EC_IO = "/sys/kernel/debug/ec/ec0/io"
+EC_RSTE_OFFSET = 0x4D            # bit 0: 1 = soft mode (EC reports, host acts)
+
+EV_PRESSED = 0xC5
+EV_RELEASED = 0xC6
+
+UNIT = "ln4332z4-v7-reset-button.service"
+
+REBOOT_MIN = 4                   # documented long press
+FACTORY_MIN = 10
+ABANDON_AFTER = 15
+
+POWER_LED = "/sys/class/leds/rgb"
+REBOOT_BLINKS = 2
+FACTORY_BLINKS = 3
+BLINK_ON = 0.25
+BLINK_OFF = 0.25
+
+PERMLOG = "/var/log/systemlog"   # survives reset-factory
+
+log = logging.getLogger("reset_button")
+
+# ---------------------------------------------------------------- netlink ---
+
+NETLINK_GENERIC = 16
+GENL_ID_CTRL = 16
+CTRL_CMD_GETFAMILY = 3
+CTRL_ATTR_FAMILY_ID = 1
+CTRL_ATTR_FAMILY_NAME = 2
+CTRL_ATTR_MCAST_GROUPS = 7
+CTRL_ATTR_MCAST_GRP_NAME = 1
+CTRL_ATTR_MCAST_GRP_ID = 2
+NLMSG_ERROR = 2
+SOL_NETLINK = 270
+NETLINK_ADD_MEMBERSHIP = 1
+ACPI_GENL_ATTR_EVENT = 1
+# struct acpi_genl_event { char device_class[20]; char bus_id[15]; u32 type; u32 data; }
+ACPI_GENL_EVENT = struct.Struct("=20s15sII")
+
+
+def _attrs(data):
+    """Parse netlink attributes into {type: payload}."""
+    out = {}
+    while len(data) >= 4:
+        alen, atype = struct.unpack_from("HH", data)
+        if alen < 4:
+            break
+        out[atype & 0x3FFF] = data[4:alen]
+        data = data[(alen + 3) & ~3:]
+    return out
+
+
+def acpi_event_socket():
+    """Netlink socket subscribed to the "acpi_event" multicast group."""
+    s = socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, NETLINK_GENERIC)
+    s.bind((0, 0))
+
+    name = b"acpi_event\0"
+    attr = struct.pack("HH", 4 + len(name), CTRL_ATTR_FAMILY_NAME) + name
+    attr += b"\0" * ((4 - len(attr) % 4) % 4)
+    payload = struct.pack("BBH", CTRL_CMD_GETFAMILY, 1, 0) + attr
+    s.send(struct.pack("IHHII", 16 + len(payload), GENL_ID_CTRL, 1, 1, 0) + payload)
+
+    reply = s.recv(65536)
+    mtype = struct.unpack_from("IHHII", reply)[1]
+    if mtype == NLMSG_ERROR:
+        raise RuntimeError("netlink family acpi_event not found")
+    attrs = _attrs(reply[20:])
+    groups = _attrs(attrs.get(CTRL_ATTR_MCAST_GROUPS, b""))
+    for grp in groups.values():
+        g = _attrs(grp)
+        if CTRL_ATTR_MCAST_GRP_ID in g:
+            gid = struct.unpack("I", g[CTRL_ATTR_MCAST_GRP_ID][:4])[0]
+            s.setsockopt(SOL_NETLINK, NETLINK_ADD_MEMBERSHIP, gid)
+            return s
+    raise RuntimeError("acpi_event has no multicast group")
+
+
+def read_events(s):
+    """Yield (bus_id, data) of every ACPI netlink event read from s.
+
+    silicom-mec sends the notification code (0xC5/0xC6) as the event data,
+    with type 1 (its HOTKEY event type)."""
+    data = s.recv(65536)
+    while len(data) >= 16:
+        mlen = struct.unpack_from("I", data)[0]
+        if mlen < 16:
+            break
+        attrs = _attrs(data[20:mlen])
+        ev = attrs.get(ACPI_GENL_ATTR_EVENT)
+        if ev and len(ev) >= ACPI_GENL_EVENT.size:
+            _cls, bus_id, _type, edata = ACPI_GENL_EVENT.unpack_from(ev)
+            yield bus_id.split(b"\0")[0].decode(errors="replace"), edata
+        data = data[(mlen + 3) & ~3:]
+
+# ------------------------------------------------------------------ helpers ---
+
+
+def permlog(message):
+    """One line in the log that survives reset-factory; best effort."""
+    try:
+        stamp = time.strftime("%Y/%m/%d %H:%M:%S")
+        host = socket.gethostname().split(".")[0]
+        with open(PERMLOG, "a") as f:
+            f.write("%s %s reset_button: %s\n" % (stamp, host, message))
+    except Exception as e:
+        log.warning("cannot write %s: %s", PERMLOG, e)
+
+
+def soft_mode():
+    """True/False from EC RAM, None if it cannot be read."""
+    try:
+        fd = os.open(EC_IO, os.O_RDONLY)
+        try:
+            return bool(os.pread(fd, 1, EC_RSTE_OFFSET)[0] & 1)
+        finally:
+            os.close(fd)
+    except OSError:
+        return None
+
+
+def set_soft_mode(enable):
+    with open(RSTBTN_SOFT, "w") as f:
+        f.write("1" if enable else "0")
+
+
+def blink_power_led(count):
+    """Blink the power LED, then restore it; best effort."""
+    try:
+        bpath = os.path.join(POWER_LED, "brightness")
+        tpath = os.path.join(POWER_LED, "trigger")
+        with open(tpath) as f:
+            trigger = next((t.strip("[]") for t in f.read().split() if t.startswith("[")), "none")
+        with open(bpath) as f:
+            brightness = f.read().strip()
+        with open(tpath, "w") as f:
+            f.write("none")
+        for _ in range(count):
+            for value, pause in (("0", BLINK_OFF), ("255", BLINK_ON)):
+                with open(bpath, "w") as f:
+                    f.write(value)
+                time.sleep(pause)
+        with open(bpath, "w") as f:
+            f.write(brightness if brightness != "0" else "255")
+        if trigger != "none":
+            with open(tpath, "w") as f:
+                f.write(trigger)
+    except Exception as e:
+        log.warning("cannot blink the power LED: %s", e)
+
+
+def act_on_release(duration, abandoned):
+    if abandoned:
+        msg = "press of %.2f s was abandoned at %d s - ignored" % (duration, ABANDON_AFTER)
+        log.info(msg)
+        permlog(msg)
+    elif REBOOT_MIN <= duration < FACTORY_MIN:
+        log.info("press of %.2f s - rebooting", duration)
+        permlog("press of %.2f s - rebooting" % duration)
+        subprocess.run(["reboot"], check=False)
+    elif FACTORY_MIN <= duration < ABANDON_AFTER:
+        log.info("press of %.2f s - running reset-factory", duration)
+        permlog("press of %.2f s - running reset-factory" % duration)
+        subprocess.run(["reset-factory"], check=False)
+    else:
+        msg = "press of %.2f s is in no band - ignored" % duration
+        log.info(msg)
+        permlog(msg)
+
+# --------------------------------------------------------------------- loop ---
+
+
+class Press(object):
+    """Times one press and gives the band cues while it is held."""
+
+    def __init__(self):
+        self.start = None
+        self.cued = set()
+        self.abandoned = False
+        self.lock = threading.Lock()
+
+    def pressed(self):
+        with self.lock:
+            self.start = time.monotonic()
+            self.cued = set()
+            self.abandoned = False
+        log.info("button pressed")
+        permlog("button pressed")
+
+    def released(self):
+        with self.lock:
+            if self.start is None:
+                return None
+            duration = time.monotonic() - self.start
+            abandoned = self.abandoned
+            self.start = None
+        return duration, abandoned
+
+    def tick(self):
+        """Called while waiting for events: cue the band that just opened."""
+        with self.lock:
+            if self.start is None:
+                return
+            held = time.monotonic() - self.start
+            if held >= ABANDON_AFTER and not self.abandoned:
+                self.abandoned = True
+                cue = None
+                log.info("held past %d s - press abandoned", ABANDON_AFTER)
+            elif held >= FACTORY_MIN and "factory" not in self.cued:
+                self.cued.add("factory")
+                cue = FACTORY_BLINKS
+                log.info("held %d s - release now for reset-factory", FACTORY_MIN)
+            elif held >= REBOOT_MIN and "reboot" not in self.cued:
+                self.cued.add("reboot")
+                cue = REBOOT_BLINKS
+                log.info("held %d s - release now to reboot", REBOOT_MIN)
+            else:
+                return
+        if cue:
+            # blinking takes ~1.5 s: keep reading events meanwhile
+            threading.Thread(target=blink_power_led, args=(cue,), daemon=True).start()
+
+
+def run():
+    s = acpi_event_socket()
+    if soft_mode() is False:
+        # the driver sets it at probe; make sure the EC does not reset by itself
+        set_soft_mode(True)
+    log.info("listening for reset button events (soft mode %s)", soft_mode())
+
+    press = Press()
+    while True:
+        ready, _, _ = select.select([s], [], [], 0.1)
+        press.tick()
+        if not ready:
+            continue
+        for bus_id, code in read_events(s):
+            if bus_id != ACPI_DEVICE:
+                continue
+            if code == EV_PRESSED:
+                press.pressed()
+            elif code == EV_RELEASED:
+                result = press.released()
+                if result is not None:
+                    act_on_release(*result)
+
+# ----------------------------------------------------------------- stopping ---
+
+
+def _system_is_shutting_down():
+    try:
+        out = subprocess.run(["systemctl", "is-system-running"], stdout=subprocess.PIPE,
+                             stderr=subprocess.DEVNULL, text=True)
+        return out.stdout.strip() == "stopping"
+    except Exception:
+        return False
+
+
+def _stopping_for_restart():
+    result = os.environ.get("SERVICE_RESULT", "success")
+    if result != "success":
+        return "SERVICE_RESULT=%s" % result
+    try:
+        out = subprocess.run(["systemctl", "list-jobs", "--no-legend", "--no-pager", UNIT],
+                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
+        for line in out.stdout.splitlines():
+            fields = line.split()
+            if len(fields) >= 3 and fields[1] == UNIT and fields[2] != "stop":
+                return "a %s job is queued" % fields[2]
+    except Exception:
+        pass
+    return None
+
+
+def unmask():
+    if _system_is_shutting_down():
+        log.info("system is stopping - the button stays in soft mode")
+        return 0
+    restart = _stopping_for_restart()
+    if restart:
+        log.info("daemon is coming back (%s) - the button stays in soft mode", restart)
+        return 0
+    try:
+        set_soft_mode(False)
+    except Exception as e:
+        log.error("cannot hand the button back to the EC: %s", e)
+        return 1
+    log.info("button handed back to the EC hardware reset (~4 s press)")
+    permlog("daemon stopped by operator - EC hardware reset restored")
+    return 0
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__,
+                                     formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--unmask", action="store_true",
+                        help="hand the button back to the EC hardware reset and exit")
+    parser.add_argument("--blink", type=int, metavar="N",
+                        help="blink the power LED N times and exit (panel check)")
+    args = parser.parse_args()
+
+    handler = logging.handlers.SysLogHandler(address="/dev/log")
+    handler.setFormatter(logging.Formatter("reset_button: %(message)s"))
+    log.addHandler(handler)
+    log.addHandler(logging.StreamHandler())
+    log.setLevel(logging.INFO)
+
+    if args.unmask:
+        return unmask()
+    if args.blink is not None:
+        blink_power_led(args.blink)
+        return 0
+    try:
+        run()
+    except KeyboardInterrupt:
+        pass
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
