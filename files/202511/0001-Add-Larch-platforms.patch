+
+static u8 current_reg = 0x00;  // default
+
+static ssize_t reg_rw_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+    struct i2c_client *client = to_i2c_client(dev);
+    int data = hwmon_cpld_read(client->addr, current_reg);
+    if (data < 0)
+        return data;
+    return sprintf(buf, "0x%02X\n", data);
+}
+
+static ssize_t reg_rw_store(struct device *dev, struct device_attribute *attr, const char *buf, size_t count)
+{
+    unsigned int reg, val;
+
+    // If two values are provided, it's a write operation
+    if (sscanf(buf, "%x %x", &reg, &val) == 2) {
+        current_reg = reg;  // set register
+        struct i2c_client *client = to_i2c_client(dev);
+        return hwmon_cpld_write(client->addr, reg, val) == 0 ? count : -EIO;
+    }
+
+    // If only one value is provided, just set the register selector
+    if (sscanf(buf, "%x", &reg) == 1) {
+        current_reg = reg;  // just set the internal state
+        return count;
+    }
+
+    return -EINVAL;
+}
