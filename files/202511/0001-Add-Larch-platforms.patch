+static inline u32 mvppnd_read_reg(struct mvppnd_dev *ppdev, u32 reg_addr)
+{
+	u32 reg_addr_offs = reg_addr & ppdev->atu_mask;
+	u32 val;
+
+	val = ioread32(ppdev->regs + ppdev->regs_offs + reg_addr_offs);
+
+	/*
+	dev_info(ppdev->dev, "read : 0x%x(%x,%x)=0x%x\n", reg_addr, ppdev->regs_offs, reg_addr_offs, val);
+	*/
+
+	return val;
+}
