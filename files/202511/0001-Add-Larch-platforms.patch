+    # argument — unquoted expansion stores only the first word (e.g.
+    # sonic_image_2 became just "run", breaking autoboot after remove/install).
+    fw_setenv ${FW_ARG} sonic_bootcmd "$SONIC_BOOT_CMD" > /dev/null
+    fw_setenv ${FW_ARG} sonic_image_2 "$SONIC_BOOT_CMD_OLD" > /dev/null
+    fw_setenv ${FW_ARG} sonic_image_1 "$SONIC_BOOT_CMD" > /dev/null
+    fw_setenv ${FW_ARG} boot_next  'run sonic_image_1'> /dev/null
+    fw_setenv ${FW_ARG} autoload 'no' # prevent bootp and dhcp from implicit image loading
+    #TODO: is this net_fix appropriate for all platforms, need to check!
+    fw_setenv ${FW_ARG} net_fix 'mii write 0 0x1f 0xdc8;mii write 0 0x14 0x2;dhcp' > /dev/null
+    
+    if [ $PLATFORM_CANISMINOR -eq 1 ]; then
+        fw_setenv ${FW_ARG} net_fix '' > /dev/null
+        fw_setenv ${FW_ARG} wd_off 'i2c mw 0x33 0x40 0x30' > /dev/null
+        fw_setenv ${FW_ARG} platf_custom 'run wd_off'
+    elif [ $PLATFORM_LANAOTEK_AC5X -eq 1 ]; then
+        # We have two issues with Lanaotek AC5X platform: Netfix setting PHY to SGMII mode,
+        # and i2c md 0x33 0x1 0 setting fan speed to 0 because sometimes it leads to kernel stuck on boot.
+        fw_setenv ${FW_ARG} platf_custom 'run net_fix; i2c dev 0; i2c md 0x33 0x1 0' > /dev/null
+    elif [[ $PLATFORM_QNSR400 -eq 1 || $PLATFORM_QNSR200 -eq 1 || $PLATFORM_QNSR100 -eq 1 || $PLATFORM_QNSR50 -eq 1 ]]; then
+        fw_setenv ${FW_ARG} print_menu true  # to hide Sonic boot options
+        if [ $PLATFORM_LANAOTEK_AC5X -eq 0 ]; then
+            fw_setenv ${FW_ARG} platf_custom true
         fi
+    elif [[ $PLATFORM_CN9131_VIRGO -eq 1 || $PLATFORM_QNSR200 -eq 1 ]]; then
+        fw_setenv ${FW_ARG} set_main_flash 'i2c dev 0; i2c mw 0x72 0x0 0x01; i2c mw 0x18 0x04 0x7f'
+        fw_setenv ${FW_ARG} set_back_flash 'i2c dev 0; i2c mw 0x72 0x0 0x01; i2c mw 0x18 0x04 0x7e'
+        fw_setenv ${FW_ARG} check_flash    'i2c dev 0; i2c mw 0x72 0x0 0x01; i2c md 0x18 0x04 1'
+    #elif [ $PLATFORM_AC5X -eq 1 ]; then
+        # disable hw wd activation till we fix the issue with Linux softlockup
+        #fw_setenv ${FW_ARG} wd_timeout 90    
+        #fw_setenv ${FW_ARG} wd_on 'wdt dev watchdog@80216000; wdt start $wd_timeout' > /dev/null
+        #fw_setenv ${FW_ARG} platf_custom 'run wd_on; echo "Setup watchdog with ${wd_timeout} s timeout"'
+        #fw_setenv ${FW_ARG} platf_custom true
+    elif [ $PLATFORM_LN3548XGF_6Z_V5 -eq 1 ]; then
+        fw_setenv ${FW_ARG} platf_custom true
+
+        # prevent autoload of mcp2221 driver which may mess up order of i2c buses, we'll load it manually
+        fw_setenv ${FW_ARG} othbootargs 'modprobe.blacklist=hid_mcp2221'
+    else
+        fw_setenv ${FW_ARG} platf_custom true
+    fi
 
