+class QSFPManagement():
+    def __init__(self, port_num, ctrl_cpld):
+        self.port_num = port_num
+        self.ctrl_cpld = ctrl_cpld
+
+    def is_module_present(self) -> bool:
+        value = self.ctrl_cpld.read_register(0x22)
