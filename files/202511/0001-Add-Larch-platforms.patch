+++ b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/sonic_platform/fan.py
@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+
+#############################################################################
+# Larch LN-4332Z4-V7
+#
+# 8 fans in 4 hot-swap cages (2 per cage), driven by the EC from its thermal
+# profile: the host can read the speed but not set it (datasheet 10.5.4.1).
+# Speeds come from the EC hwmon ("Fan_<n> RPM"). The cage presence lines go
+# to the EC only, so a fan that does not turn is reported as absent.
+#
+#############################################################################
+
+try:
+    from sonic_platform_base.fan_base import FanBase
+    from sonic_platform.ec import EcHwmon
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+NUM_FAN_DRAWERS = 4
+FANS_PER_DRAWER = 2
+
+# Speed range per fan from the HW Programmer Guide sensor list (Appendix D):
+# the first fan of a cage is the faster rotor.
+FAN_RPM_RANGE = {0: (2760, 24800), 1: (2460, 22140)}
+
+
+class Fan(FanBase):
+    """Platform-specific Fan class"""
+
+    def __init__(self, drawer_index, fan_index):
+        FanBase.__init__(self)
+        self.drawer_index = drawer_index    # 0-based cage
+        self.fan_index = fan_index          # 0-based within the cage
+        self.fan_num = drawer_index * FANS_PER_DRAWER + fan_index + 1
+        self.min_rpm, self.max_rpm = FAN_RPM_RANGE[fan_index]
+
+    def _rpm(self):
+        return EcHwmon.read("fan", "Fan_%d RPM" % self.fan_num)
+
+    def get_name(self):
+        return "FAN-%d" % self.fan_num
+
+    def get_presence(self):
+        rpm = self._rpm()
+        return rpm is not None and rpm > 0
+
+    def get_status(self):
+        rpm = self._rpm()
+        return rpm is not None and rpm >= self.min_rpm
+
+    def get_model(self):
+        return "N/A"
+
+    def get_serial(self):
+        return "N/A"
+
+    def get_direction(self):
+        return self.FAN_DIRECTION_NOT_APPLICABLE
+
+    def get_speed(self):
+        rpm = self._rpm()
+        if rpm is None:
+            return 0
+        return min(100, int(round(rpm * 100.0 / self.max_rpm)))
+
+    def get_speed_rpm(self):
+        return self._rpm()
+
+    def get_target_speed(self):
+        # The EC sets the speed; report the current one as the target.
+        return self.get_speed()
+
+    def get_speed_tolerance(self):
+        return 20
+
+    def is_under_speed(self):
+        rpm = self._rpm()
+        return rpm is not None and 0 < rpm < self.min_rpm
+
+    def is_over_speed(self):
+        return False
+
+    def set_speed(self, speed):
+        return False
+
+    def set_status_led(self, color):
+        # The EC drives the fan fail LEDs itself.
+        return False
+
+    def get_status_led(self):
+        return self.STATUS_LED_COLOR_GREEN if self.get_status() else self.STATUS_LED_COLOR_RED
+
+    def get_position_in_parent(self):
+        return self.fan_index + 1
+
+    def is_replaceable(self):
+        return False
