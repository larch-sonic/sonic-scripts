+import threading, time, syslog
+
+import common
+
+TOTAL_PORT_NUM = 56
+SFP_MAX_NUM = 48
+CPLDA_SFP_NUM = 28
+CPLDB_SFP_NUM = 12
+CPLDC_SFP_NUM = 16
+FAN_NUM = 5
+
+DEVICE_BUS = {'cpld': ['6-0074', '7-0075', '8-0076'],
+              'fan': ['4-0070'],
