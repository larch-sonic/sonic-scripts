+#!/usr/bin/env python3
+
+#############################################################################
+# WNC Phantom
+#
+# Module contains an implementation of SONiC Platform Base API and
+# provides the platform information
+#
+#############################################################################
+
+try:
+    import os
+    import time
+    import struct
+    import mmap
+    import subprocess
+    from sonic_platform_base.sonic_xcvr.sfp_optoe_base import SfpOptoeBase
+    from sonic_py_common import syslogger
+
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+QSFP_PORT_END = 32
+SFP_PORT_END = 32
+
+helper_logger = syslogger.SysLogger("sfp", enable_runtime_config=True)
+
+class Sfp(SfpOptoeBase):
+    """
+    Platform-specific Sfp class
+    """
+
+    PORT_START = 1
+    PORT_END = QSFP_PORT_END
+
+    port_to_i2c_mapping = {
+         1 : 30,  2 : 31,  3 : 32,  4 : 33,  5 : 34,  6 : 35,
+         7 : 38,  8 : 39,  9 : 40, 10 : 41, 11 : 42, 12 : 43,
+        13 : 46, 14 : 47, 15 : 48, 16 : 49, 17 : 50, 18 : 51,
+        19 : 54, 20 : 55, 21 : 56, 22 : 57, 23 : 58, 24 : 59,
+        25 : 62, 26 : 63, 27 : 64, 28 : 65, 29 : 66, 30 : 67,
+        31 : 70, 32 : 71
+    }
+    port_to_i2c_mapping_10 = { 1 : 72, 2 : 73 }
+
+    _sfp_port = range(PORT_START, PORT_END + 1)
+
+    EEPROM_PATH = '/sys/bus/i2c/devices/{0}-0050/sfp_eeprom'
+    QSFP_RESET_PATH = "/sys/wnc_sfp/qsfp{}_reset"
+    QSFP_PRS_PATH = "/sys/wnc_sfp/qsfp{}_present"
+    QSFP_LPMODE_PATH = "/sys/wnc_sfp/qsfp{}_lowpower"
+
+    SFP_RESET_PATH = "/sys/wnc_sfp/sfpS{}_reset"
+    SFP_PRS_PATH = "/sys/wnc_sfp/sfpS{}_present"
+
+    PLATFORM_ROOT_PATH = '/usr/share/sonic/device'
+    PMON_HWSKU_PATH = '/usr/share/sonic/hwsku'
+    HOST_CHK_CMD = "docker > /dev/null 2>&1"
+    PLATFORM = "x86_64-larch_wnc-rsem-w1-32"
+    HWSKU = "phantom_32x400G"
+
+    def __init__(self, index, sfp_type):
+        SfpOptoeBase.__init__(self)
+        self.sfp_type = sfp_type
+        self.port_type = sfp_type
+        self.index = index
+        self.port_num = self.index + 1
+
+        # Init eeprom path
+        if self.sfp_type == 'QSFP':
+            self.eeprom_path = self.EEPROM_PATH.format( self.port_to_i2c_mapping[self.port_num] )
+            self.prs_path = self.QSFP_PRS_PATH.format( self.port_num )
+            self.reset_path = self.QSFP_RESET_PATH.format( self.port_num )
+            self.lpmode_path = self.QSFP_LPMODE_PATH.format( self.port_num )
+        elif self.sfp_type == 'SFP':
+            self.eeprom_path = self.EEPROM_PATH.format( self.port_to_i2c_mapping_10[self.port_num] )
+            self.prs_path = self.SFP_PRS_PATH.format( self.port_num )
+            self.reset_path = self.SFP_RESET_PATH.format( self.port_num )
+        else:
+            raise ImportError("Unknown SFP type = %s\n" % self.sfp_type)
+
+    def get_eeprom_path(self):
+        return self.eeprom_path
+
+    def get_name(self):
+        return "QSFP28 or later" if self.sfp_type == 'QSFP' else "SFP/SFP+/SFP28"
+
+    def get_presence(self):
+        """
+        Retrieves the presence of the sfp
+        Returns : True if sfp is present and false if it is absent
+        """
+        try:
+            with open(self.prs_path, 'r') as sfp_presence:
+                presence = int(sfp_presence.read(), 16)
+            # we have inverted values, 0 means prence
+            if presence == 0:
+                presence = 1
+            else:
+                presence = 0
+        except IOError:
+            return False
+        return presence
+
+        return False
+
+    def get_reset_status(self):
+        """
+        Retrives the reset status of SFP
+        """
+        reset_status = False
+        return reset_status
+
+    def get_lpmode(self):
+        """
+        Retrieves the lpmode(low power mode) of this SFP
+        """
+        if self.sfp_type != 'QSFP':
+            # SFP doesn't support this feature
+            return False
+
+        lp_data = 0
+
+        try:
+            with open(self.lpmode_path, 'r') as sfp_lowpower:
+                lp_data = int(sfp_lowpower.read(), 16)
+        except IOError:
+            return False
+        
+        if lp_data == 1:
+            lpmode_state = True
+        else:
+            lpmode_state = False
+
+        return lpmode_state
+
+    def reset(self):
+        """
+        Reset SFP and return all user module settings to their default srate.
+        Returns:
+            A boolean, True if successful, False if not
+        """
+        try:
+            with open(self.reset_path, 'r') as sfp_reset:
+                sfp_reset.write('1')
+        except:
+            return False
+
+        return True
+
+    def set_lpmode(self, lpmode):
+        """
+        Sets the lpmode(low power mode) of this SFP
+        """
+        if self.sfp_type != 'QSFP':
+            # SFP doesn't support this feature
+            return False
+
+        try:
+            with open(self.lpmode_path, 'r') as sfp_lowpower:
+                if lpmode:
+                    sfp_lowpower.write('1')
+                else:
+                    sfp_lowpower.write('0')
+        except IOError:
+            return False
+
+        return True
+
+    def get_transceiver_info(self):
+        port_info = SfpOptoeBase.get_transceiver_info(self)
+        if port_info is not None:
+            port_info['hardware_rev'] = 'N/A'
+        return port_info
+
+    def get_status(self):
+        """
+        Retrieves the operational status of the device
+        """
+        reset = self.get_reset_status()
+
+        if (reset == True):
+            status = False
+        else:
+            status = True
+
+        return status
+
+    def read_eeprom(self, offset, num_bytes):
+        ret = SfpOptoeBase.read_eeprom(self, offset, num_bytes)
+
+        # EEPROM driver read only 256 bytes, append other with 0x00
+        if (ret is not None and len(ret) < num_bytes):
+            ret.extend(bytearray(num_bytes - len(ret)))
+
+        return ret
+    
+    def enable_high_power_class(self):
+        """
+        Sets the QSFP module to high power class
+        """
+        if self.sfp_type != 'QSFP':
+            return # SFP doesn't support this feature
+
+        power_override = 1
+        high_power_class_en = 1 << 2
+
+        power_class = self._get_power_class()
+
+        helper_logger.log_debug("QSFP port Ethernet{} power class: {}".format(self.port_num, power_class))
+
+        if power_class <= 4:
+            # turn on high power mode (not high power class) even if module doesn't support high power classes
+            if self._read_eeprom_byte(93) & power_override != power_override:
+                self._write_eeprom_byte(93, power_override)
+            return
+        
+        if self._read_eeprom_byte(93) != high_power_class_en | power_override:
+            helper_logger.log_notice("Enable QSFP module high power class for port {}".format(self.port_num))
+            self._write_eeprom_byte(93, high_power_class_en | power_override)
+
+    def _get_power_class(self) -> int:
+        value = self._read_eeprom_byte(129)
+        if value & 0x3 == 0:
+            return ((value & 0xc0) >> 3) + 1
+        else: 
+            return (value & 0x3) + 4
+
+    def _read_eeprom_byte(self, offset):
+        helper_logger.log_debug("Reading byte from EEPROM at offset {}".format(offset))
+
+        with open(self.eeprom_path, "rb") as f:
+            f.seek(offset)
+            byte = f.read(1)
+            if not byte:
+                raise IOError("Failed to read byte from EEPROM")
+            helper_logger.log_debug("Read byte: {}".format(byte[0]))
+            return byte[0]
+    
+    def _write_eeprom_byte(self, offset, value):
+        helper_logger.log_debug("Writing byte to EEPROM at offset {} with value {}".format(offset, value))
+    
+        if not (0 <= value <= 0xFF):
+            raise ValueError("Value must be a single byte (0-255)")
+
+        with open(self.eeprom_path, "r+b") as f:
+            f.seek(offset)
+            f.write(bytes([value]))
