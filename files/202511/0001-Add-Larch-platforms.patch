+/*
+ * HWMON
+ */
+struct silicom_ec_sdata {
+	unsigned int reg_input;
+	unsigned int reg_max;
+	unsigned int reg_crit;
+	unsigned int reg_hyst;
+	unsigned int reg_min;
+	unsigned int reg_alarm;
+	unsigned int reg_target;
+	unsigned int multiplier;
+	unsigned int status;
+	unsigned int reg_cfg;
+	unsigned int type;	/* 0=V/Pwr, 1=Fan, 4=thermistor, 6=PECI */
+				/* 0=Temp, 1=Vin, 2=Curr, 3=Pwr, 4=Energy, 5=Fan, 6=PWM */
+	const char *label;
+};
+
+struct silicom_ec_peci {
+	unsigned int reg_in;
+	unsigned int reg_tjmax;
+	unsigned int reg_raw;
+	unsigned int rsvd[4];
+	unsigned int multiplier;
+};
+
+struct silicom_ec_hwmon_board_data {
+	const struct silicom_ec_sdata *tables[hwmon_max];
+	int table_size[hwmon_max];
+	const struct hwmon_channel_info **hinfo;
+};
+
+struct silicom_ec_hwmon {
+	struct device *dev;
+	struct hwmon_chip_info chip;
+	char *hw_name;
+	const struct silicom_ec_hwmon_board_data *bdata;
+	struct resource *io_addr;
+};
