+    def tx_disable(self, tx_disable):
+        """
+        Disable SFP TX for all channels
+
+        Args:
+            tx_disable : A Boolean, True to enable tx_disable mode, False to disable
+                         tx_disable mode.
+
+        Returns:
+            A boolean, True if tx_disable is set successfully, False if not
+        """
+        #  SFP Status Control Register #4 (0x14): SFP5 - SFP12
+        # ZSFP Status Control Register #4 (0x0F): ZSFP13 - ZSFP18
+        # 0:Normal operation
+        # 1:Transmitter Disable
+        DEVICE_ADDRESS = self.CPLD_ADDRESS
+        if self.sfp_type == "SFP":
+            DEVICE_REG = 0x14
+        elif self.sfp_type == "ZSFP":
+            DEVICE_REG = 0x0F
+
+        if smbus_present == 0:  # if called from sfputil outside of pmon
+            cmdstatus, value = cmd.getstatusoutput('sudo i2cget -y 0 {} {}'.format(DEVICE_ADDRESS, DEVICE_REG))
+            if cmdstatus:
+                sonic_logger.log_warning("Failed to retrieve register value %s", cmdstatus)
+                return [False]
+            value = int(value, 16)
+        else:
+            bus = smbus.SMBus(0)
+            try:
+                value = bus.read_byte_data(DEVICE_ADDRESS, DEVICE_REG)
+            except Exception as e:
+                sonic_logger.log_warning("Failed to retrieve register value")
+
+        if self.port_num >= ZSFP_PORT_START:
+             offset_bit = self.port_num - ZSFP_PORT_START
+        elif self.port_num >= SFP_PORT_START:
+            offset_bit = self.port_num - SFP_PORT_START
+
+        bit_value = value & (1 << (offset_bit))
+        if (bit_value != 0 and tx_disable == True) or (bit_value == 0 and tx_disable == False) :
+            # nothing to do
+            return True
+        
+        if tx_disable == True:
+            new_value  = value | (1 << offset_bit)
+        else:
+            new_value  = value & ~(1 << offset_bit)
+
+        if smbus_present == 0:  # if called from sfputil outside of pmon
+            cmdstatus, output = cmd.getstatusoutput('sudo i2cset -y 0 {} {} {}'.format(DEVICE_ADDRESS, DEVICE_REG, new_value))
+            if cmdstatus:
+                sonic_logger.log_warning("Failed to set register value %s", cmdstatus)
+                return False
+        else:
+            bus = smbus.SMBus(0)
+            try:
+                output = bus.write_byte_data(DEVICE_ADDRESS, DEVICE_REG, new_value)
+            except Exception as e:
+                sonic_logger.log_warning("Failed to set register value")
+                return False
+
+        return True
