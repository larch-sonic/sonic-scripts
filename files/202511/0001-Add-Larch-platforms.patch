index 000000000..b83dd4d01
--- /dev/null
+++ b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/modules/ln4332z4_cpld.c
@@ -0,0 +1,446 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CPLDs of the Larch LN-4332Z4-V7 switch card (Silicom MHO-200).
+ *
+ * ln4332z4_cpld_io   CPLD IO left (0x70, QSFP 1-16) and right (0x71,
+ *                    QSFP 17-32) on I2C_IO: QSFP sideband signals.
+ * ln4332z4_cpld_ctrl CPLD CTRL (0x40) on I2C_MAIN: power sequence, PSU
+ *                    status, QSFP power, Falcon temperature for the EC.
+ * ln4332z4_qsfp_mux  The same two CPLD IOs seen on I2C_MUX: writing the
+ *                    port's index within its CPLD (0-15: QSFP 1-16 on the
+ *                    left, 17-32 on the right) connects that port's
+ *                    management interface (EEPROM at 0x50) to the bus, 0xff
+ *                    disconnects it (Silicom's mho_info.sh reference).
+ *                    Registered as an i2c mux with 16 channels per CPLD.
+ *
+ * Register maps: Silicom IS Switches HW Programmer Guide R123, sections 2.9,
+ * 4.2 (CPLD IO MHO-180/200) and 5.1-5.2 (CPLD I2C Main).
+ *
+ * Copyright (C) 2026 Larch Networks.
+ */
+
+#include <linux/module.h>
+#include <linux/i2c.h>
+#include <linux/i2c-mux.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/sysfs.h>
+
+#define DRV_NAME "ln4332z4_cpld"
+
+enum cpld_type {
+	CPLD_IO,
+	CPLD_CTRL,
+	QSFP_MUX,
+};
+
+/* CPLD IO */
+#define IO_ABS_REG          0x00	/* 1 = module absent */
+#define IO_RXLOS_REG        0x04	/* 1 = rx loss */
+#define IO_INT_REG          0x08	/* IntL as seen by the CPLD */
+#define IO_REV_REG          0x0c	/* bit7 location (1 = right), 6:5 SKU, 4:0 rev */
+#define IO_RESET_REG        0x10	/* 0 = ResetL asserted */
+#define IO_GRN_LED_REG      0x14
+#define IO_SPLIT_GRN_REG    0x16
+#define IO_AMB_LED_REG      0x18
+#define IO_SPLIT_AMB_REG    0x1a
+#define IO_LED_PWM_REG      0x1c
+#define IO_CMD_REG          0x1e	/* bit0 take LED control from the Falcon */
+#define IO_PORTS            16
+
+/* CPLD CTRL */
+#define CTRL_PWR_SEQ_HI_REG 0x00
+#define CTRL_PWR_SEQ_LO_REG 0x01
+#define CTRL_PSU_REG        0x02
+#define CTRL_INT1_REG       0x03
+#define CTRL_INT2_REG       0x04
+#define CTRL_QSFP_PWR_REG   0x05
+#define CTRL_GPI_REG        0x07
+#define CTRL_REV_REG        0x0c	/* 7:5 SKU, 4:0 rev */
+#define CTRL_GPO_REG        0x10	/* bit7 Falcon reset, bit5 buzzer, bit4 split */
+#define CTRL_QSFP_PWR_EN    0x11
+#define CTRL_SPLIT_REG      0x13	/* 0x13-0x16: split ports 1-8 .. 25-32 */
+#define CTRL_FALCON_TEMP    0x17
+
+#define MUX_DESELECT        0xff
+
+struct cpld_data {
+	struct i2c_client *client;
+	struct mutex lock;
+	enum cpld_type type;
+	int first_port;
+};
+
+/* A bit field of one CPLD register. */
+struct cpld_attr {
+	struct device_attribute dev_attr;
+	u8 reg;
+	u8 shift;
+	u8 width;
+	bool invert;
+};
+
+#define to_cpld_attr(a) container_of(a, struct cpld_attr, dev_attr)
+
+static ssize_t field_show(struct device *dev, struct device_attribute *da,
+			  char *buf)
+{
+	struct cpld_data *data = dev_get_drvdata(dev);
+	struct cpld_attr *attr = to_cpld_attr(da);
+	u8 mask = GENMASK(attr->width - 1, 0);
+	int val;
+
+	mutex_lock(&data->lock);
+	val = i2c_smbus_read_byte_data(data->client, attr->reg);
+	mutex_unlock(&data->lock);
+	if (val < 0)
+		return val;
+
+	val = (val >> attr->shift) & mask;
+	if (attr->invert)
+		val ^= mask;
+	return attr->width == 8 ? sysfs_emit(buf, "0x%02x\n", val) :
+				  sysfs_emit(buf, "%d\n", val);
+}
+
+static ssize_t field_store(struct device *dev, struct device_attribute *da,
+			   const char *buf, size_t count)
+{
+	struct cpld_data *data = dev_get_drvdata(dev);
+	struct cpld_attr *attr = to_cpld_attr(da);
+	u8 mask = GENMASK(attr->width - 1, 0);
+	unsigned int val;
+	int reg, ret;
+
+	ret = kstrtouint(buf, 0, &val);
+	if (ret)
+		return ret;
+	if (val > mask)
+		return -EINVAL;
+	if (attr->invert)
+		val ^= mask;
+
+	mutex_lock(&data->lock);
+	reg = i2c_smbus_read_byte_data(data->client, attr->reg);
+	if (reg >= 0) {
+		reg &= ~(mask << attr->shift);
+		reg |= val << attr->shift;
+		reg = i2c_smbus_write_byte_data(data->client, attr->reg, reg);
+	}
+	mutex_unlock(&data->lock);
+
+	return reg < 0 ? reg : count;
+}
+
+#define CPLD_FIELD(_name, _mode, _reg, _shift, _width, _inv)		\
+	static struct cpld_attr cpld_attr_##_name = {			\
+		.dev_attr = __ATTR(_name, _mode, field_show, field_store), \
+		.reg = _reg, .shift = _shift, .width = _width,		\
+		.invert = _inv,						\
+	}
+#define CPLD_RO(_name, _reg, _shift, _width, _inv) \
+	CPLD_FIELD(_name, 0444, _reg, _shift, _width, _inv)
+#define CPLD_RW(_name, _reg, _shift, _width, _inv) \
+	CPLD_FIELD(_name, 0644, _reg, _shift, _width, _inv)
+#define CPLD_ATTR(_name) (&cpld_attr_##_name.dev_attr.attr)
+
+/*
+ * QSFP n (1-16 within this CPLD; the global port is first_port + n - 1):
+ * present 1 = module inserted, reset 1 = held in reset, rx_los 1 = loss,
+ * intl = raw IntL bit.
+ */
+#define IO_PORT(n)							\
+	CPLD_RO(qsfp##n##_present, IO_ABS_REG + ((n) - 1) / 8,		\
+		((n) - 1) % 8, 1, true);				\
+	CPLD_RW(qsfp##n##_reset, IO_RESET_REG + ((n) - 1) / 8,		\
+		((n) - 1) % 8, 1, true);				\
+	CPLD_RO(qsfp##n##_rx_los, IO_RXLOS_REG + ((n) - 1) / 8,	\
+		((n) - 1) % 8, 1, false);				\
+	CPLD_RO(qsfp##n##_intl, IO_INT_REG + ((n) - 1) / 8,		\
+		((n) - 1) % 8, 1, false)
+
+#define IO_PORT_ATTRS(n)						\
+	CPLD_ATTR(qsfp##n##_present), CPLD_ATTR(qsfp##n##_reset),	\
+	CPLD_ATTR(qsfp##n##_rx_los), CPLD_ATTR(qsfp##n##_intl)
+
+IO_PORT(1); IO_PORT(2); IO_PORT(3); IO_PORT(4);
+IO_PORT(5); IO_PORT(6); IO_PORT(7); IO_PORT(8);
+IO_PORT(9); IO_PORT(10); IO_PORT(11); IO_PORT(12);
+IO_PORT(13); IO_PORT(14); IO_PORT(15); IO_PORT(16);
+
+CPLD_RO(io_cpld_version, IO_REV_REG, 0, 5, false);
+CPLD_RO(io_board_sku, IO_REV_REG, 5, 2, false);
+CPLD_RW(led_green_lo, IO_GRN_LED_REG, 0, 8, false);
+CPLD_RW(led_green_hi, IO_GRN_LED_REG + 1, 0, 8, false);
+CPLD_RW(led_amber_lo, IO_AMB_LED_REG, 0, 8, false);
+CPLD_RW(led_amber_hi, IO_AMB_LED_REG + 1, 0, 8, false);
+CPLD_RW(led_split_green_lo, IO_SPLIT_GRN_REG, 0, 8, false);
+CPLD_RW(led_split_green_hi, IO_SPLIT_GRN_REG + 1, 0, 8, false);
+CPLD_RW(led_split_amber_lo, IO_SPLIT_AMB_REG, 0, 8, false);
+CPLD_RW(led_split_amber_hi, IO_SPLIT_AMB_REG + 1, 0, 8, false);
+CPLD_RW(led_pwm_green, IO_LED_PWM_REG, 0, 3, false);
+CPLD_RW(led_pwm_amber, IO_LED_PWM_REG, 4, 3, false);
+CPLD_RW(led_take_control, IO_CMD_REG, 0, 1, false);
+
+static ssize_t first_port_show(struct device *dev,
+			       struct device_attribute *da, char *buf)
+{
+	struct cpld_data *data = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n", data->first_port);
+}
+static DEVICE_ATTR_RO(first_port);
+
+static struct attribute *cpld_io_attrs[] = {
+	&dev_attr_first_port.attr,
+	CPLD_ATTR(io_cpld_version), CPLD_ATTR(io_board_sku),
+	IO_PORT_ATTRS(1), IO_PORT_ATTRS(2), IO_PORT_ATTRS(3), IO_PORT_ATTRS(4),
+	IO_PORT_ATTRS(5), IO_PORT_ATTRS(6), IO_PORT_ATTRS(7), IO_PORT_ATTRS(8),
+	IO_PORT_ATTRS(9), IO_PORT_ATTRS(10), IO_PORT_ATTRS(11), IO_PORT_ATTRS(12),
+	IO_PORT_ATTRS(13), IO_PORT_ATTRS(14), IO_PORT_ATTRS(15), IO_PORT_ATTRS(16),
+	CPLD_ATTR(led_green_lo), CPLD_ATTR(led_green_hi),
+	CPLD_ATTR(led_amber_lo), CPLD_ATTR(led_amber_hi),
+	CPLD_ATTR(led_split_green_lo), CPLD_ATTR(led_split_green_hi),
+	CPLD_ATTR(led_split_amber_lo), CPLD_ATTR(led_split_amber_hi),
+	CPLD_ATTR(led_pwm_green), CPLD_ATTR(led_pwm_amber),
+	CPLD_ATTR(led_take_control),
+	NULL
+};
+
+/*
+ * CPLD CTRL. PSU register 0x2: bit5/4 PWOK PSU1/2 (0 = ok), bit3/2 present
+ * PSU1/2 (0 = present). The raw registers are exported for debugging.
+ */
+CPLD_RO(psu1_present, CTRL_PSU_REG, 3, 1, true);
+CPLD_RO(psu2_present, CTRL_PSU_REG, 2, 1, true);
+CPLD_RO(psu1_power_good, CTRL_PSU_REG, 5, 1, true);
+CPLD_RO(psu2_power_good, CTRL_PSU_REG, 4, 1, true);
+CPLD_RO(psu_status, CTRL_PSU_REG, 0, 8, false);
+CPLD_RO(pwr_seq_status_hi, CTRL_PWR_SEQ_HI_REG, 0, 8, false);
+CPLD_RO(pwr_seq_status_lo, CTRL_PWR_SEQ_LO_REG, 0, 8, false);
+CPLD_RO(interrupt1, CTRL_INT1_REG, 0, 8, false);
+CPLD_RO(interrupt2, CTRL_INT2_REG, 0, 8, false);
+CPLD_RO(qsfp_power_status, CTRL_QSFP_PWR_REG, 0, 8, false);
+CPLD_RO(dip_switches, CTRL_GPI_REG, 0, 4, false);
+CPLD_RO(ctrl_cpld_version, CTRL_REV_REG, 0, 5, false);
+CPLD_RO(ctrl_board_sku, CTRL_REV_REG, 5, 3, false);
+CPLD_RO(falcon_in_reset, CTRL_GPO_REG, 7, 1, false);
+CPLD_RW(buzzer, CTRL_GPO_REG, 5, 1, false);
+CPLD_RW(split_enable, CTRL_GPO_REG, 4, 1, false);
+CPLD_RW(qsfp_power_enable, CTRL_QSFP_PWR_EN, 0, 8, false);
+CPLD_RW(split_ports_1_8, CTRL_SPLIT_REG, 0, 8, false);
+CPLD_RW(split_ports_9_16, CTRL_SPLIT_REG + 1, 0, 8, false);
+CPLD_RW(split_ports_17_24, CTRL_SPLIT_REG + 2, 0, 8, false);
+CPLD_RW(split_ports_25_32, CTRL_SPLIT_REG + 3, 0, 8, false);
+
+static ssize_t falcon_temp_show(struct device *dev,
+				struct device_attribute *da, char *buf)
+{
+	struct cpld_data *data = dev_get_drvdata(dev);
+	int val;
+
+	mutex_lock(&data->lock);
+	val = i2c_smbus_read_byte_data(data->client, CTRL_FALCON_TEMP);
+	mutex_unlock(&data->lock);
+
+	return val < 0 ? val : sysfs_emit(buf, "%d\n", val);
+}
+
+/* Degrees C, clamped to the 8-bit register; read by the EC on I2C_TEL. */
+static ssize_t falcon_temp_store(struct device *dev,
+				 struct device_attribute *da,
+				 const char *buf, size_t count)
+{
+	struct cpld_data *data = dev_get_drvdata(dev);
+	int val, ret;
+
+	ret = kstrtoint(buf, 0, &val);
+	if (ret)
+		return ret;
+	val = clamp(val, 0, 255);
+
+	mutex_lock(&data->lock);
+	ret = i2c_smbus_write_byte_data(data->client, CTRL_FALCON_TEMP, val);
+	mutex_unlock(&data->lock);
+
+	return ret < 0 ? ret : count;
+}
+static DEVICE_ATTR_RW(falcon_temp);
+
+static struct attribute *cpld_ctrl_attrs[] = {
+	CPLD_ATTR(psu1_present), CPLD_ATTR(psu2_present),
+	CPLD_ATTR(psu1_power_good), CPLD_ATTR(psu2_power_good),
+	CPLD_ATTR(psu_status),
+	CPLD_ATTR(pwr_seq_status_hi), CPLD_ATTR(pwr_seq_status_lo),
+	CPLD_ATTR(interrupt1), CPLD_ATTR(interrupt2),
+	CPLD_ATTR(qsfp_power_status), CPLD_ATTR(dip_switches),
+	CPLD_ATTR(ctrl_cpld_version), CPLD_ATTR(ctrl_board_sku),
+	CPLD_ATTR(falcon_in_reset), CPLD_ATTR(buzzer), CPLD_ATTR(split_enable),
+	CPLD_ATTR(qsfp_power_enable),
+	CPLD_ATTR(split_ports_1_8), CPLD_ATTR(split_ports_9_16),
+	CPLD_ATTR(split_ports_17_24), CPLD_ATTR(split_ports_25_32),
+	&dev_attr_falcon_temp.attr,
+	NULL
+};
+
+static enum cpld_type cpld_dev_type(struct kobject *kobj)
+{
+	struct i2c_client *client = to_i2c_client(kobj_to_dev(kobj));
+
+	return i2c_client_get_device_id(client)->driver_data;
+}
+
+static umode_t cpld_io_visible(struct kobject *kobj, struct attribute *attr,
+			       int n)
+{
+	return cpld_dev_type(kobj) == CPLD_IO ? attr->mode : 0;
+}
+
+static umode_t cpld_ctrl_visible(struct kobject *kobj, struct attribute *attr,
+				 int n)
+{
+	return cpld_dev_type(kobj) == CPLD_CTRL ? attr->mode : 0;
+}
+
+static const struct attribute_group cpld_io_group = {
+	.attrs = cpld_io_attrs,
+	.is_visible = cpld_io_visible,
+};
+
+static const struct attribute_group cpld_ctrl_group = {
+	.attrs = cpld_ctrl_attrs,
+	.is_visible = cpld_ctrl_visible,
+};
+
+static const struct attribute_group *cpld_groups[] = {
+	&cpld_io_group,
+	&cpld_ctrl_group,
+	NULL
+};
+
+/*
+ * The mux is parent-locked: the parent adapter stays locked from select to
+ * deselect, so the two CPLDs on I2C_MUX never have a port connected at the
+ * same time (all modules answer at 0x50). Hence the unlocked transfers here.
+ */
+static int qsfp_mux_write(struct i2c_mux_core *muxc, u8 val)
+{
+	struct cpld_data *data = i2c_mux_priv(muxc);
+	struct i2c_client *client = data->client;
+
+	return __i2c_smbus_xfer(muxc->parent, client->addr, client->flags,
+				I2C_SMBUS_WRITE, val, I2C_SMBUS_BYTE, NULL);
+}
+
+static int qsfp_mux_select(struct i2c_mux_core *muxc, u32 chan)
+{
+	return qsfp_mux_write(muxc, chan);
+}
+
+static int qsfp_mux_deselect(struct i2c_mux_core *muxc, u32 chan)
+{
+	return qsfp_mux_write(muxc, MUX_DESELECT);
+}
+
+static int qsfp_mux_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct i2c_mux_core *muxc;
+	struct cpld_data *data;
+	int chan, ret;
+
+	muxc = i2c_mux_alloc(client->adapter, dev, IO_PORTS, sizeof(*data), 0,
+			     qsfp_mux_select, qsfp_mux_deselect);
+	if (!muxc)
+		return -ENOMEM;
+
+	data = i2c_mux_priv(muxc);
+	data->client = client;
+	data->type = QSFP_MUX;
+	/* A read on I2C_MUX returns the select register, not the revision. */
+	data->first_port = client->addr == 0x70 ? 1 : 1 + IO_PORTS;
+	i2c_set_clientdata(client, muxc);
+
+	ret = i2c_smbus_write_byte(client, MUX_DESELECT);
+	if (ret < 0)
+		return ret;
+
+	for (chan = 0; chan < IO_PORTS; chan++) {
+		ret = i2c_mux_add_adapter(muxc, 0, chan);
+		if (ret) {
+			i2c_mux_del_adapters(muxc);
+			return ret;
+		}
+	}
+
+	dev_info(dev, "QSFP mux for ports %d-%d\n", data->first_port,
+		 data->first_port + IO_PORTS - 1);
+	return 0;
+}
+
+static int cpld_probe(struct i2c_client *client)
+{
+	const struct i2c_device_id *id = i2c_client_get_device_id(client);
+	struct device *dev = &client->dev;
+	struct cpld_data *data;
+	int rev;
+
+	if (id->driver_data == QSFP_MUX)
+		return qsfp_mux_probe(client);
+
+	rev = i2c_smbus_read_byte_data(client, IO_REV_REG);
+	if (rev < 0)
+		return dev_err_probe(dev, rev, "cannot read CPLD revision\n");
+
+	data = devm_kzalloc(dev, sizeof(*data), GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+
+	data->client = client;
+	data->type = id->driver_data;
+	mutex_init(&data->lock);
+	i2c_set_clientdata(client, data);
+
+	if (data->type == CPLD_IO) {
+		data->first_port = (rev & BIT(7)) ? 1 + IO_PORTS : 1;
+		dev_info(dev, "CPLD IO rev %d, ports %d-%d\n", rev & 0x1f,
+			 data->first_port, data->first_port + IO_PORTS - 1);
+	} else {
+		dev_info(dev, "CPLD CTRL rev %d, board SKU %d\n", rev & 0x1f,
+			 rev >> 5);
+	}
+
+	/* The sysfs attributes are the driver's dev_groups. */
+	return 0;
+}
+
+static void cpld_remove(struct i2c_client *client)
+{
+	const struct i2c_device_id *id = i2c_client_get_device_id(client);
+
+	if (id->driver_data == QSFP_MUX)
+		i2c_mux_del_adapters(i2c_get_clientdata(client));
+}
+
+static const struct i2c_device_id cpld_ids[] = {
+	{ "ln4332z4_cpld_io", CPLD_IO },
+	{ "ln4332z4_cpld_ctrl", CPLD_CTRL },
+	{ "ln4332z4_qsfp_mux", QSFP_MUX },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, cpld_ids);
+
+static struct i2c_driver cpld_driver = {
+	.driver = {
+		.name = DRV_NAME,
+		.dev_groups = cpld_groups,
+	},
+	.probe = cpld_probe,
+	.remove = cpld_remove,
+	.id_table = cpld_ids,
+};
+module_i2c_driver(cpld_driver);
+
+MODULE_AUTHOR("Larch Networks");
+MODULE_DESCRIPTION("LN-4332Z4-V7 CPLD IO/CTRL and QSFP EEPROM mux driver");
+MODULE_LICENSE("GPL");
diff --git a/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/modules/silicom-ec-hwmon.c b/platform/marvell-prestera/sonic-platform-larch/ln4332z4-v7/modules/silicom-ec-hwmon.c
