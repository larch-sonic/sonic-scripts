+[Unit]
+Description=Sera DCS-T3200K Platform modules
+# Runs before pmon so that /dev/ipmi0 and /dev/i2c-* already exist when
+# the pmon container is created: docker_image_ctl.j2 only passes device
+# nodes that are present at creation time, and without /dev/ipmi0 inside
+# pmon there is no path to the fans, PSUs and thermals.
+Before=pmon.service
+After=sysinit.target
+DefaultDependencies=no
+
+[Service]
+Type=oneshot
+ExecStart=/usr/local/bin/sera-dcs-t3200k-init.sh
+RemainAfterExit=yes
+
+[Install]
+WantedBy=multi-user.target
