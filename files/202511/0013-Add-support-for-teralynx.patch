index 000000000..83b7fb3e2
--- /dev/null
+++ b/platform/marvell-teralynx/sonic-platform-modules-larch/sera-dcs-t3200k/sonic_platform/ipmi.py
@@ -0,0 +1,478 @@
+#!/usr/bin/env python
+
+########################################################################
+#
+# IPMI access layer for the Sera DCS-T3200K (RDS2000-32F, Teralynx TL7).
+#
+# Every peripheral on this board (thermals, fans, PSUs, DC rails) is owned
+# by the AST2620 BMC.  The BMC's host interface is *SSIF* (IPMI over SMBus)
+# at slave 0x31, behind PCA9548 0x75 channel 0 on the CPU SMBus (i801,
+# i2c-0) -- see spec section 2.11.3.1.  There is no KCS responder, so
+# `ipmi_si` never binds; `sera-dcs-t3200k-init.sh` instantiates `ipmi_ssif`
+# explicitly and that is what creates /dev/ipmi0.
+#
+# All data therefore comes from `ipmitool` over /dev/ipmi0:
+#   * the 59-entry SDR repository  -> thermals, fan tachos, PSU V/I/P/T,
+#                                     DC rail voltages and currents
+#   * SERA OEM commands (NetFn 0x30) -> presence/status bits, board and
+#                                     CPLD revisions
+#
+# Timing measured on the board (2026-08-12):
+#   ipmitool sdr elist               3.1 s   (re-reads the whole SDR repo)
+#   ipmitool -S <dump> sdr elist     0.7 s   (SDR repo cached in a file)
+#   ipmitool raw 0x30 ...            0.25 s
+# so the SDR repository is dumped once to a file and every reading refresh
+# goes through `-S`, with the parsed result cached for CACHE_TTL seconds.
+#
+# NOTE ON CONTAINERS: pmon gets /dev/ipmi0 and /dev/i2c-* passed in
+# automatically by get_pmon_device_mounts() in docker_image_ctl.j2 -- but
+# only for device nodes that already exist when the container is created.
+# That is why the platform init service is ordered Before=pmon.service.
+# If /dev/ipmi0 is missing anyway, every accessor here degrades to
+# "no data" instead of raising, so no daemon crash-loops.
+#
+########################################################################
+
+import os
+import re
+import subprocess
+import threading
+import time
+
+try:
+    from sonic_py_common.logger import Logger
+except ImportError:
+    Logger = None
+
+IPMI_DEV = '/dev/ipmi0'
+IPMITOOL = 'ipmitool'
+
+# The SDR repository is static, so it is dumped once and reused.
+SDR_DUMP_DIRS = ['/var/cache/sonic-platform', '/var/cache', '/tmp']
+SDR_DUMP_NAME = 'sera-dcs-t3200k-sdr.dump'
+
+# How long a parsed set of readings stays valid.
+#
+# This has to be generous.  SSIF is slow (a full SDR pass is ~0.7 s and
+# every OEM read ~0.25 s), the kernel serialises all IPMI traffic through
+# one message handler, and three pmon daemons poll concurrently --
+# psud every 3 s, sensormond and thermalctld every 60 s.  With a 5 s TTL
+# thermalctld logged "Update fan and temperature status took 83 seconds",
+# i.e. its pass outran its own 60 s interval.  At 15 s each daemon does
+# at most one refresh per cycle and a full pass costs a couple of
+# seconds; PSU and thermal readings that are up to 15 s old are still far
+# fresher than the 60 s at which thermalctld publishes them.
+CACHE_TTL = 15.0
+
+CMD_TIMEOUT = 20
+
+_logger = Logger() if Logger else None
+
+
+def _log_warning(msg):
+    if _logger:
+        _logger.log_warning(msg)
+
+
+def _log_error(msg):
+    if _logger:
+        _logger.log_error(msg)
+
+
+def _run(cmd):
+    """Run a command, return stdout as text, or None on any failure."""
+    try:
+        return subprocess.check_output(cmd, stderr=subprocess.DEVNULL,
+                                       universal_newlines=True,
+                                       timeout=CMD_TIMEOUT)
+    except (subprocess.SubprocessError, OSError):
+        return None
+
+
+def is_available():
+    """True when the in-band IPMI interface is usable from this context."""
+    return os.path.exists(IPMI_DEV)
+
+
+class _SdrCache(object):
+    """Cached view of the BMC's sensor readings.
+
+    Holds the parsed output of `ipmitool sdr elist`, refreshed at most
+    once per CACHE_TTL seconds.  Thread-safe: thermalctld runs its
+    policies on a separate thread from the sensor updates.
+    """
+
+    def __init__(self):
+        self._lock = threading.Lock()
+        self._readings = {}
+        self._stamp = 0.0
+        self._dump_file = None
+
+    def _sdr_dump_file(self):
+        """Path of the cached SDR repository dump, creating it if needed."""
+        if self._dump_file and os.path.isfile(self._dump_file):
+            return self._dump_file
+
+        for directory in SDR_DUMP_DIRS:
+            path = os.path.join(directory, SDR_DUMP_NAME)
+            if os.path.isfile(path):
+                self._dump_file = path
+                return path
+            try:
+                os.makedirs(directory, exist_ok=True)
+            except OSError:
+                continue
+            if _run([IPMITOOL, 'sdr', 'dump', path]) is not None \
+                    and os.path.isfile(path):
+                self._dump_file = path
+                return path
+
+        return None
+
+    def _invalidate_dump(self):
+        if self._dump_file:
+            try:
+                os.remove(self._dump_file)
+            except OSError:
+                pass
+        self._dump_file = None
+
+    def _elist(self):
+        dump = self._sdr_dump_file()
+        if dump:
+            out = _run([IPMITOOL, '-S', dump, 'sdr', 'elist'])
+            if out:
+                return out
+            # A stale or truncated dump makes every read fail; drop it and
+            # fall back to the slow path once.
+            self._invalidate_dump()
+        return _run([IPMITOOL, 'sdr', 'elist'])
+
+    def _refresh(self):
+        out = self._elist()
+        if out is None:
+            self._readings = {}
+            self._stamp = time.time()
+            _log_warning('sera-dcs-t3200k: no response from BMC over IPMI')
+            return
+
+        readings = {}
+        for line in out.splitlines():
+            # NAME             | 20h | ok  |  0.1 | 60 degrees C
+            fields = [f.strip() for f in line.split('|')]
+            if len(fields) < 5:
+                continue
+            name, status, value = fields[0], fields[2], fields[4]
+            readings[name] = (status, value)
+
+        self._readings = readings
+        self._stamp = time.time()
+
+    def get(self, name):
+        """Return (status, raw_reading) for an SDR entry, or (None, None)."""
+        if not is_available():
+            return (None, None)
+        with self._lock:
+            if time.time() - self._stamp > CACHE_TTL:
+                self._refresh()
+            return self._readings.get(name, (None, None))
+
+    def names(self):
+        if not is_available():
+            return []
+        with self._lock:
+            if time.time() - self._stamp > CACHE_TTL:
+                self._refresh()
+            return list(self._readings.keys())
+
+
+_sdr = _SdrCache()
+
+# "60 degrees C", "19650 RPM", "12.02 Volts", "389.40 Watts", "0 Amps"
+_VALUE_RE = re.compile(r'^(-?\d+(?:\.\d+)?)\s')
+
+
+def sensor_value(name):
+    """Numeric reading of an SDR sensor, or None when it has no reading.
+
+    Sensors that are absent, disabled or report "No Reading"/"ns" yield
+    None -- callers must surface that as N/A rather than as 0.
+    """
+    status, raw = _sdr.get(name)
+    if raw is None:
+        return None
+    match = _VALUE_RE.match(raw)
+    if not match:
+        return None
+    try:
+        return float(match.group(1))
+    except ValueError:
+        return None
+
+
+def sensor_ok(name):
+    """True when the BMC reports the sensor in its 'ok' state."""
+    status, _ = _sdr.get(name)
+    return status == 'ok'
+
+
+def sensor_present(name):
+    """True when the SDR repository contains this sensor at all."""
+    return name in _sdr.names()
+
+
+class _RawCache(object):
+    """Short-lived cache of OEM raw-command responses.
+
+    Every OEM command used here is a read of a CPLD register, and each
+    one costs ~0.25 s over SSIF.  Without a cache a single pass of
+    `show platform fan` would issue three dozen of them (presence,
+    status and direction for twelve fans) and take half a minute.
+    """
+
+    def __init__(self):
+        self._lock = threading.Lock()
+        self._entries = {}
+
+    def get(self, key, producer):
+        now = time.time()
+        with self._lock:
+            entry = self._entries.get(key)
+            if entry and now - entry[0] <= CACHE_TTL:
+                return entry[1]
+        value = producer()
+        with self._lock:
+            self._entries[key] = (time.time(), value)
+        return value
+
+
+_raw_cache = _RawCache()
+
+
+def raw_command(netfn, *data):
+    """Issue an IPMI raw command; return a list of response bytes or None.
+
+    Used for the SERA OEM set (NetFn 0x30).  Anything the firmware does
+    not implement answers 0xC1 and ipmitool exits non-zero, which lands
+    here as None.  Responses are cached for CACHE_TTL seconds; every
+    command issued by this package is a pure read.
+    """
+    if not is_available():
+        return None
+
+    cmd = [IPMITOOL, 'raw', hex(netfn)] + [hex(b) for b in data]
+
+    def produce():
+        out = _run(cmd)
+        if out is None:
+            return None
+        try:
+            return [int(token, 16) for token in out.split()]
+        except ValueError:
+            return None
+
+    return _raw_cache.get(tuple(cmd), produce)
+
+
+# ----------------------------------------------------------------------
+# SERA OEM commands (NetFn 0x30).
+#
+# The OEM "command" byte names the target's I2C identity and the
+# sub-command is a register offset on it:
+#   0x34 -> CPLD slave 0x34 (BMC-side board/power map)
+#   0x35 -> CPLD slave 0x35 (fan / PSU / DC-rail map)
+#   0x73 -> the thermal / VR / power-sequencer branch
+#   0x77 -> the PSU PMBus and fan-board branch
+#
+# Measured on BMC firmware 2.15 (man_id 0x005566, prod_id 0x2600):
+# ONLY the 0x34 and 0x35 groups are implemented.  The whole 0x73 group
+# and the whole 0x77 group -- which the OEM document specifies for the
+# per-sensor thermal reads, the VR/POWR1014A rails and the complete PSU
+# PMBus set including MFR_MODEL/MFR_SERIAL/MFR_POUT_MAX/READ_VIN --
+# answer 0xC1 Invalid Command on every documented sub-command.
+#
+# Consequence: PSU model, serial, rated power and AC-input telemetry are
+# NOT obtainable on this board, and the per-rail data comes from the SDR
+# repository instead.  Both gaps are on the vendor escalation list.
+# ----------------------------------------------------------------------
+
+OEM_NETFN = 0x30
+OEM_CMD_BOARD = 0x34        # CPLD 0x34: 0x00 HW version, 0x01 CPLD version
+OEM_CMD_STATUS = 0x35       # CPLD 0x35: PSU / DC rails / fans
+
+OEM_REG_PSU_STATUS = 0x00       # 4 B: PS1_PRNT PS2_PRNT PS1_GOOD PS2_GOOD
+OEM_REG_FAN_DETAIL = 0x03       # + tray index -> 6 B aggregate record
+OEM_REG_FAN_PRESENT_F2B = 0xB0  # 6 B: front-to-back module inserted
+OEM_REG_FAN_PRESENT_B2F = 0xB1  # 6 B: back-to-front module inserted
+OEM_REG_FAN_POWER = 0xB2        # 6 B: module powered
+OEM_REG_FAN_STATUS = 0xB3       # 6 B: 0 = fail, 1 = good
+OEM_REG_CPU_WDT = 0x21          # on 0x34: watchdog_en, watchdog_flag
+
+FAN_RPM_UNIT = 150          # OEM fan tacho byte is RPM / 150
+
+
+def get_hw_version():
+    """Hardware PCB revision byte, or None."""
+    resp = raw_command(OEM_NETFN, OEM_CMD_BOARD, 0x00)
+    if not resp:
+        return None
+    return resp[0]
+
+
+def get_cpld_version():
+    """Switch-board CPLD version as an integer, or None.
+
+    The OEM command answers with one byte per bit of version_ID -- e.g.
+    `00 00 00 00 00 01 00 01` means bits 5 and 7 are set, i.e. 0xA0,
+    which matches a direct SMBus read of CPLD 0x30 register 0x01.
+    """
+    resp = raw_command(OEM_NETFN, OEM_CMD_BOARD, 0x01)
+    if not resp or len(resp) < 8:
+        return None
+    version = 0
+    for bit, value in enumerate(resp[:8]):
+        if value:
+            version |= (1 << bit)
+    return version
+
+
+def get_psu_status():
+    """(presence, power_good) tuples for PSU1/PSU2, or None.
+
+    `ipmitool raw 0x30 0x35 0x00` answers `01 01 01 00` on this board:
+    PSU1 present, PSU2 present, PSU1 power-good, PSU2 not powered.
+    The flags are whole bytes, not packed bits, and power-good is only
+    meaningful when the matching presence byte is 1.
+    """
+    resp = raw_command(OEM_NETFN, OEM_CMD_STATUS, OEM_REG_PSU_STATUS)
+    if not resp or len(resp) < 4:
+        return None
+    return ((bool(resp[0]), bool(resp[2])), (bool(resp[1]), bool(resp[3])))
+
+
+def get_fan_presence():
+    """Per-tray presence booleans, or None.
+
+    A tray is present when it is reported in either the front-to-back
+    (0xB0) or the back-to-front (0xB1) insertion register -- the CPLD
+    detects the module type from the tray's keying, so the two registers
+    together are the presence signal.
+    """
+    f2b = raw_command(OEM_NETFN, OEM_CMD_STATUS, OEM_REG_FAN_PRESENT_F2B)
+    b2f = raw_command(OEM_NETFN, OEM_CMD_STATUS, OEM_REG_FAN_PRESENT_B2F)
+    if not f2b and not b2f:
+        return None
+    f2b = f2b or [0] * len(b2f)
+    b2f = b2f or [0] * len(f2b)
+    return [bool(a) or bool(b) for a, b in zip(f2b, b2f)]
+
+
+def get_fan_directions():
+    """Per-tray airflow: 'f2b', 'b2f' or None, as a list, or None.
+
+    The CPLD detects the module variant from the tray's keying and
+    reports the two types in separate registers.
+    """
+    f2b = raw_command(OEM_NETFN, OEM_CMD_STATUS, OEM_REG_FAN_PRESENT_F2B)
+    b2f = raw_command(OEM_NETFN, OEM_CMD_STATUS, OEM_REG_FAN_PRESENT_B2F)
+    if not f2b and not b2f:
+        return None
+    f2b = f2b or [0] * len(b2f)
+    b2f = b2f or [0] * len(f2b)
+    return ['f2b' if a else ('b2f' if b else None)
+            for a, b in zip(f2b, b2f)]
+
+
+def get_fan_status():
+    """Per-tray health booleans (0 = fail, 1 = good), or None."""
+    resp = raw_command(OEM_NETFN, OEM_CMD_STATUS, OEM_REG_FAN_STATUS)
+    if not resp:
+        return None
+    return [bool(b) for b in resp]
+
+
+def get_fan_info(tray_index):
+    """Per-tray OEM fan record, or None.
+
+    `ipmitool raw 0x30 0x35 0x03 <tray>` answers 6 bytes; observed on
+    this board: `01 01 00 01 83 90`
+      [0] fan status          0 = fail, 1 = good
+      [1] module power        0 = off,  1 = on
+      [2] back-to-front (AFI) module inserted
+      [3] front-to-back (AFO) module inserted
+      [4] rotor 1 tacho, [5] rotor 2 tacho, both in units of 150 RPM
+
+    Kept for diagnostics.  The device classes deliberately do NOT use it:
+    it costs one IPMI round trip per tray, where the 0xB0/0xB1/0xB3
+    bitmaps answer for all six trays in three, which matters on a link
+    this slow.
+    """
+    resp = raw_command(OEM_NETFN, OEM_CMD_STATUS, OEM_REG_FAN_DETAIL, tray_index)
+    if not resp or len(resp) < 6:
+        return None
+    return resp
+
+
+def get_watchdog_flag():
+    """True when the CPLD reports that its watchdog fired, else False/None.
+
+    CPLD 0x34 register 0x21 answers `<watchdog_en> <watchdog_flag>`.
+    """
+    resp = raw_command(OEM_NETFN, OEM_CMD_BOARD, OEM_REG_CPU_WDT)
+    if not resp or len(resp) < 2:
+        return None
+    return bool(resp[1])
+
+
+# ----------------------------------------------------------------------
+# CPU-side CPLD window.
+#
+# CPLD slave 0x30 on i2c-0 is the CPU's own CPLD interface.  It answers
+# from the CPU at all times, independently of the BMC, and carries the
+# board and CPLD revisions plus the system-LED controls.  This is the one
+# in-band control path on the board that does not depend on the BMC.
+#
+# GUARD: the watchdog register must never be read from here -- reading it
+# kicks/clears the CPLD watchdog timer.  The board spec (Table 38) puts
+# the watchdog at 0x12; the vendor register spreadsheet we were given
+# labels 0x11.  Both are blocked so a documentation discrepancy cannot
+# turn into an accidental watchdog kick.
+# ----------------------------------------------------------------------
+
+CPLD_BUS = 0
+CPLD_ADDR = 0x30
+CPLD_REG_HW_VERSION = 0x00
+CPLD_REG_VERSION_SWITCH = 0x01
+CPLD_REG_VERSION_FAN = 0x02
+CPLD_REG_STATUS1 = 0x20         # bit0 BMC_EN, bit4 push button
+CPLD_REG_SYS_LED1 = 0xA1        # LOC + DIAG system LEDs
+
+CPLD_FORBIDDEN_REGS = (0x11, 0x12)
+
+
+def cpld_read(register):
+    """Read one CPLD register over SMBus, or None when not reachable."""
+    if register in CPLD_FORBIDDEN_REGS:
+        raise ValueError(
+            'CPLD register %#x must not be read: it kicks the watchdog'
+            % register)
+    if not os.path.exists('/dev/i2c-%d' % CPLD_BUS):
+        return None
+    out = _run(['i2cget', '-y', str(CPLD_BUS), hex(CPLD_ADDR), hex(register)])
+    if out is None:
+        return None
+    try:
+        return int(out.strip(), 16)
+    except ValueError:
+        return None
+
+
+def cpld_write(register, value):
+    """Write one CPLD register over SMBus.  Returns True on success."""
+    if register in CPLD_FORBIDDEN_REGS:
+        raise ValueError(
+            'CPLD register %#x must not be written' % register)
+    if not os.path.exists('/dev/i2c-%d' % CPLD_BUS):
+        return False
+    return _run(['i2cset', '-y', str(CPLD_BUS), hex(CPLD_ADDR),
+                 hex(register), hex(value)]) is not None
