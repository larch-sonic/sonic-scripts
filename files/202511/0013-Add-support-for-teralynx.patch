@@ -0,0 +1,345 @@
+#!/usr/bin/env python
+
+########################################################################
+#
+# System EEPROM implementation for the Sera DCS-T3200K.
+#
+# The board carries a GIANTEC GT24C04 (512 B) system/ONIE EEPROM.  A
+# 24C04 occupies two slave addresses -- 0x54 for bytes 0-255 and 0x55 for
+# bytes 256-511 -- and it sits behind PCA9548 0x75 channel 1 on the CPU
+# SMBus, which is CPU-reachable: an i2cdetect of that child bus finds
+# both addresses.
+#
+# There are two ways to read it, and both are implemented because the
+# first one is not always available:
+#
+#  1. Through a bound at24 driver, as /sys/bus/i2c/devices/<bus>-0054/
+#     eeprom.  This is what `sera-dcs-t3200k-init.sh` tries to set up.
+#
+#  2. Directly over SMBus with i2cdump, used when the at24 client cannot
+#     be registered.  That happens on this board because the BIOS reports
+#     eight memory devices, so i2c-i801 runs its SPD auto-registration
+#     across 0x50-0x57 during its own probe -- before the PCA9548 driver
+#     binds and while the mux still has a channel open from the previous
+#     master -- and claims 0x54/0x55 as DDR4 SPD EEPROMs:
+#
+#       i2c i2c-0: Successfully instantiated SPD at 0x54
+#       ee1004 0-0054: Failed to select page 0 (-6)
+#
+#     Those clients are kernel-owned, so they cannot be removed through
+#     sysfs `delete_device`, and while they hold the address our at24
+#     client is refused with -EBUSY.  The ee1004 binding is useless in
+#     its own right -- it needs DDR4 page-select devices at 0x36/0x37
+#     that do not exist here, so every read of its `eeprom` attribute
+#     fails with ENXIO.  Reading the chip directly over SMBus sidesteps
+#     the whole collision.  This is reported to the vendor (#35709): a
+#     BIOS that does not advertise phantom memory devices, or an ONIE
+#     EEPROM outside the 0x50-0x57 SPD window, would remove the clash.
+#
+# Writes are blocked in hardware: CPLD 0x30 register 0xA0 bit 5
+# (eeprom_wp_onie) resets to 1 = write-protected.  This class only ever
+# reads, and deliberately does not touch that bit.
+#
+# *** ON THE UNIT UNDER TEST THE EEPROM IS BLANK. ***
+#
+# Every one of its 512 bytes reads 0xFF -- it was never programmed at
+# manufacturing.  That is also why ONIE exported no onie_serial_num and
+# why `show platform summary` had no serial or model number.  Rather than
+# failing, this class then synthesises a valid TlvInfo image from data
+# that genuinely is known about the box:
+#
+#   0x21 Product Name    <- onie_machine        from /host/machine.conf
+#   0x24 Base MAC        <- the eth0 MAC address
+#   0x26 Device Version  <- onie_machine_rev
+#   0x28 Platform Name   <- onie_platform
+#   0x29 ONIE Version    <- onie_version
+#   0x23 Serial Number   <- onie_serial_num, only if ONIE exported one
+#
+# Nothing is invented: fields with no source are simply absent, so a
+# blank EEPROM yields "N/A" for serial number rather than a fake one.
+# Once Sera programs the EEPROM at manufacturing, the hardware path
+# takes over automatically and this fallback stops being used.
+#
+########################################################################
+
+import glob
+import os
+import re
+import subprocess
+
+try:
+    from sonic_platform_base.sonic_eeprom import eeprom_tlvinfo
+    from sonic_py_common.logger import Logger
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+logger = Logger()
+
+I2C_DEVICE_PATH = '/sys/bus/i2c/devices'
+# PCA9548 0x75 lives on i2c-0; the system EEPROM hangs off its channel 1.
+SYSEEPROM_MUX = '0-0075'
+SYSEEPROM_MUX_CHANNEL = 1
+SYSEEPROM_ADDR = 0x54
+
+# /host is not mounted into the pmon container, so the init script also
+# leaves a copy of machine.conf under the platform's api_files directory,
+# which pmon does see (as /usr/share/sonic/platform).  Without it,
+# syseepromd would fall back to the base MAC alone while the same code
+# running on the host produced the full set.
+MACHINE_CONF_PATHS = [
+    '/host/machine.conf',
+    '/usr/share/sonic/platform/api_files/machine.conf',
+    '/etc/machine.conf',
+]
+BASE_MAC_PATH = '/sys/class/net/eth0/address'
+
+# machine.conf key -> ONIE TlvInfo type code
+MACHINE_CONF_TLV_MAP = [
+    ('onie_machine', 0x21),         # Product Name
+    ('onie_serial_num', 0x23),      # Serial Number
+    ('onie_machine_rev', 0x26),     # Device Version
+    ('onie_platform', 0x28),        # Platform Name
+    ('onie_version', 0x29),         # ONIE Version
+]
+
+
+def _read_file(path):
+    try:
+        with open(path, 'r') as handle:
+            return handle.read().strip()
+    except (IOError, OSError):
+        return None
+
+
+def _read_machine_conf():
+    """ONIE's exported environment, as a dict."""
+    for path in MACHINE_CONF_PATHS:
+        content = _read_file(path)
+        if not content:
+            continue
+        values = {}
+        for line in content.splitlines():
+            if '=' in line and not line.startswith('#'):
+                key, value = line.split('=', 1)
+                value = value.strip()
+                if value:
+                    values[key.strip()] = value
+        if values:
+            return values
+    return {}
+
+
+def find_syseeprom_bus():
+    """Number of the I2C bus the system EEPROM sits on, or None."""
+    channel = os.path.join(I2C_DEVICE_PATH, SYSEEPROM_MUX,
+                           'channel-%d' % SYSEEPROM_MUX_CHANNEL)
+    bus = os.path.basename(os.path.realpath(channel))
+    if bus.startswith('i2c-'):
+        return bus[len('i2c-'):]
+    return None
+
+
+def read_eeprom_smbus(bus, addr):
+    """Read one 256-byte EEPROM page over SMBus, or None.
+
+    `-f` forces the access even though a kernel-owned client holds the
+    address; this is a read of an EEPROM, so it cannot disturb anything.
+    """
+    try:
+        out = subprocess.check_output(
+            ['i2cdump', '-y', '-f', str(bus), hex(addr), 'b'],
+            stderr=subprocess.DEVNULL, universal_newlines=True, timeout=30)
+    except (subprocess.SubprocessError, OSError):
+        return None
+
+    data = bytearray()
+    for line in out.splitlines():
+        # "00: ff ff ... ff    ................"
+        match = re.match(r'^([0-9a-f]{2}):((?:\s+[0-9a-fX]{2}){16})', line)
+        if not match:
+            continue
+        for token in match.group(2).split():
+            data.append(0xFF if 'X' in token else int(token, 16))
+
+    return data if len(data) == 256 else None
+
+
+def find_syseeprom_path():
+    """Absolute path of the system EEPROM sysfs file, or None.
+
+    The mux child bus number is not fixed, so it is resolved through the
+    pca954x driver's channel-N symlink rather than being hard-coded.  A
+    glob over any bus is kept as a fallback for the case where the
+    EEPROM ends up bound on a different bus than the init script chose.
+    """
+    channel = os.path.join(I2C_DEVICE_PATH, SYSEEPROM_MUX,
+                           'channel-%d' % SYSEEPROM_MUX_CHANNEL)
+    bus = os.path.basename(os.path.realpath(channel))
+    if bus.startswith('i2c-'):
+        path = os.path.join(I2C_DEVICE_PATH,
+                            '%s-%04x' % (bus[len('i2c-'):], SYSEEPROM_ADDR),
+                            'eeprom')
+        if os.path.isfile(path):
+            return path
+
+    for path in sorted(glob.glob(os.path.join(
+            I2C_DEVICE_PATH, '*-%04x' % SYSEEPROM_ADDR, 'eeprom'))):
+        if os.path.isfile(path):
+            return path
+
+    return None
+
+
+class _TlvCollector(eeprom_tlvinfo.EepromDefaultVisitor):
+    """Collects decoded TLVs into {'0x21': 'value', ...}."""
+
+    def __init__(self):
+        self.tlvs = {}
+
+    def visit_header(self, eeprom_id, version, header_length):
+        pass
+
+    def visit_tlv(self, name, code, length, value):
+        if code != 0xFE:                        # skip the CRC-32 TLV
+            self.tlvs[hex(code)] = str(value).strip()
+
+    def visit_end(self, e):
+        pass
+
+
+class Eeprom(eeprom_tlvinfo.TlvInfoDecoder):
+    """Platform-specific EEPROM class"""
+
+    def __init__(self):
+        self.eeprom_path = find_syseeprom_path()
+        self.eeprom_source = self.eeprom_path
+        self.is_synthesized = False
+
+        super(Eeprom, self).__init__(self.eeprom_path or '', 0, '', True)
+
+        self._eeprom_data = self._load()
+        self._tlv_dict = self._decode_to_dict(self._eeprom_data)
+
+    # -- loading --------------------------------------------------------
+
+    def _validate(self, data):
+        """Return the image if it is a valid ONIE TlvInfo one, else None."""
+        if not data:
+            return None
+        if not self.is_valid_tlvinfo_header(data):
+            return None
+        valid, _ = self.is_checksum_valid(data)
+        if not valid:
+            logger.log_warning(
+                'sera-dcs-t3200k: system EEPROM checksum invalid')
+            return None
+        return data
+
+    def _read_hardware(self):
+        """Contents of the physical EEPROM, or None when unusable."""
+        if self.eeprom_path:
+            try:
+                data = self._validate(super(Eeprom, self).read_eeprom())
+            except Exception as error:          # noqa: BLE001 - must not raise
+                logger.log_info(
+                    'sera-dcs-t3200k: cannot read system EEPROM via %s: %s'
+                    % (self.eeprom_path, repr(error)))
+                data = None
+            if data is not None:
+                return data
+
+        bus = find_syseeprom_bus()
+        if bus is None:
+            return None
+
+        page = read_eeprom_smbus(bus, SYSEEPROM_ADDR)
+        if page is None:
+            return None
+        # Page 2 of the 24C04 answers at the next address; it is only
+        # needed for images longer than 256 bytes.
+        second = read_eeprom_smbus(bus, SYSEEPROM_ADDR + 1)
+        if second:
+            page += second
+
+        self.eeprom_source = 'i2c-%s address %#04x' % (bus, SYSEEPROM_ADDR)
+        return self._validate(page)
+
+    def _synthesize(self):
+        """Build a valid TlvInfo image out of ONIE's own exported data."""
+        machine_conf = _read_machine_conf()
+
+        tlvs = bytearray()
+        for key, code in MACHINE_CONF_TLV_MAP:
+            value = machine_conf.get(key)
+            if value:
+                tlvs += self.encoder((code,), value)
+
+        base_mac = _read_file(BASE_MAC_PATH)
+        if base_mac:
+            tlvs += self.encoder((0x24,), base_mac.upper())
+
+        total_len = len(tlvs) + 6       # + the CRC-32 TLV
+        image = bytearray(self._TLV_INFO_ID_STRING)
+        image += bytearray([self._TLV_INFO_VERSION,
+                            (total_len >> 8) & 0xFF,
+                            total_len & 0xFF])
+        image += tlvs
+        image += bytearray([self._TLV_CODE_CRC_32, 4])
+        image += self.encode_checksum(self.calculate_checksum(image))
+        return image
+
+    def _load(self):
+        data = self._read_hardware()
+        if data is not None:
+            return data
+
+        self.is_synthesized = True
+        logger.log_notice(
+            'sera-dcs-t3200k: system EEPROM (%s) is blank or unreadable; '
+            'deriving system information from ONIE machine.conf'
+            % (self.eeprom_source or 'not found'))
+        return self._synthesize()
+
+    def _decode_to_dict(self, data):
+        """TlvInfo image -> {'0x21': 'value', ...}.
+
+        Uses the decoder's own visitor so that every TLV type is
+        formatted exactly as `decode-syseeprom` prints it (the MAC as
+        colon-separated hex, the device version as a decimal, and so on).
+        """
+        visitor = _TlvCollector()
+        try:
+            self.visit_eeprom(data, visitor)
+        except Exception as error:              # noqa: BLE001 - must not raise
+            logger.log_warning(
+                'sera-dcs-t3200k: cannot decode system EEPROM: %s'
+                % repr(error))
+        return visitor.tlvs
+
+    # -- TlvInfoDecoder overrides ---------------------------------------
+
+    def read_eeprom(self):
+        """Return the cached image (real hardware, or the ONIE-derived one)."""
+        return self._eeprom_data
+
+    # -- accessors used by Chassis --------------------------------------
+
+    def get_eeprom(self):
+        """TlvInfo contents as {type code: value}."""
+        return self._tlv_dict
+
+    def get_mac(self):
+        mac = self._tlv_dict.get(hex(self._TLV_CODE_MAC_BASE))
+        return mac if mac else 'N/A'
+
+    def get_serial(self):
+        serial = self._tlv_dict.get(hex(self._TLV_CODE_SERIAL_NUMBER))
+        return serial if serial else 'N/A'
+
+    def get_model(self):
+        model = self._tlv_dict.get(hex(self._TLV_CODE_PRODUCT_NAME))
+        return model if model else 'N/A'
+
+    def get_revision(self):
+        revision = self._tlv_dict.get(hex(self._TLV_CODE_DEVICE_VERSION))
+        return revision if revision else 'N/A'
