index 000000000..d35389384
--- /dev/null
+++ b/platform/marvell-teralynx/sonic-platform-modules-larch/sera-dcs-t3200k/sonic_platform/thermal.py
@@ -0,0 +1,152 @@
+#!/usr/bin/env python
+
+########################################################################
+#
+# Thermal implementation for the Sera DCS-T3200K (Teralynx TL7).
+#
+# All temperatures come from the BMC's SDR repository over in-band IPMI
+# (see ipmi.py).  The nine board sensors match the nine the board spec
+# documents (Table 14): one ADS1110 ADC on the TL7 die, five TMP75s
+# (TS1-TS4 on the mainboard, TS5 on the fan extension board) and the
+# three channels of an NCT7511Y (two remote diodes plus its local
+# sensor).
+#
+# *** NO TEMPERATURE THRESHOLDS ARE AVAILABLE FOR THIS BOARD. ***
+#
+# The BMC publishes readings but no threshold records -- `ipmitool
+# sensor` shows "na" in all six threshold columns for every temperature
+# sensor -- and the 163-page hardware specification documents no
+# warning/critical limit for any of them either (the only temperature
+# figures in it are the 0-40 C ambient operating range and worked
+# examples in the NCT7511Y register-encoding section, which are not the
+# board's provisioned values).
+#
+# So the thresholds here are None.  Inventing plausible-looking limits
+# would put fabricated numbers into STATE_DB and make `show platform
+# temperature` look authoritative when it is not; N/A is the truthful
+# answer.  Over-temperature protection meanwhile still exists in
+# hardware: the TMP75 ALERT pins and the NCT7511Y T_CRIT output are
+# wired to CPLD 0x35 register 0xB4, and the BMC runs the fan curve.
+#
+# Getting real limits requires Sera's thermal report -- it is on the
+# vendor escalation list for #35709.  When they arrive, fill the two
+# threshold columns of THERMAL_INFO in and nothing else changes.
+#
+########################################################################
+
+try:
+    from sonic_platform_base.thermal_base import ThermalBase
+    from . import ipmi
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+
+# (SDR name, display name, high threshold, high critical threshold)
+THERMAL_INFO = [
+    ('MAC', 'Teralynx TL7 ASIC die (ADS1110)',            None, None),
+    ('TS1', 'Board sensor TS1, rear centre (TMP75)',      None, None),
+    ('TS2', 'Board sensor TS2, beside ASIC (TMP75)',      None, None),
+    ('TS3', 'Board sensor TS3, mid left (TMP75)',         None, None),
+    ('TS4', 'Board sensor TS4, mid right (TMP75)',        None, None),
+    ('TS5', 'Fan board sensor TS5 (TMP75)',               None, None),
+    ('Q1',  'NCT7511Y remote diode 1, CPU area',          None, None),
+    ('Q11', 'NCT7511Y remote diode 2, ASIC area',         None, None),
+    ('U77', 'NCT7511Y local sensor, front left',          None, None),
+]
+
+# The one threshold the BMC does publish: PSU<n>_MCU_Temp carries an
+# upper-critical of 125 C in the SDR.
+PSU_THERMAL_HIGH = None
+PSU_THERMAL_CRIT = 125.0
+
+
+class Thermal(ThermalBase):
+    """Platform-specific Thermal class backed by the BMC SDR repository."""
+
+    def __init__(self, index, is_psu_thermal=False, psu_index=0):
+        ThermalBase.__init__(self)
+        self.is_psu_thermal = is_psu_thermal
+        self.psu_index = psu_index
+
+        if is_psu_thermal:
+            self.index = psu_index
+            self.sdr_name = 'PSU%d_MCU_Temp' % (psu_index + 1)
+            self.name = 'PSU%d Temp' % (psu_index + 1)
+            self.description = 'PSU%d internal temperature' % (psu_index + 1)
+            self.high_threshold = PSU_THERMAL_HIGH
+            self.high_critical_threshold = PSU_THERMAL_CRIT
+        else:
+            self.index = index
+            sdr_name, description, high, crit = THERMAL_INFO[index]
+            self.sdr_name = sdr_name
+            self.name = sdr_name
+            self.description = description
+            self.high_threshold = high
+            self.high_critical_threshold = crit
+
+    # -- DeviceBase -----------------------------------------------------
+
+    def get_name(self):
+        return self.name
+
+    def get_presence(self):
+        """The sensor exists when the BMC lists it in the SDR repository."""
+        return ipmi.sensor_present(self.sdr_name)
+
+    def get_model(self):
+        return 'N/A'
+
+    def get_serial(self):
+        return 'N/A'
+
+    def get_status(self):
+        """True when the BMC reports the sensor healthy."""
+        return ipmi.sensor_ok(self.sdr_name)
+
+    def get_position_in_parent(self):
+        return self.index + 1
+
+    def is_replaceable(self):
+        return False
+
+    # -- ThermalBase ----------------------------------------------------
+
+    def get_temperature(self):
+        """Current temperature in Celsius, or None when unreadable."""
+        value = ipmi.sensor_value(self.sdr_name)
+        if value is None:
+            return None
+        # The PSU FRU sensors report -128 C when the PSU is not powered;
+        # the MCU sensors used here do not, but guard anyway so a bogus
+        # reading never reaches thermalctld as a real temperature.
+        if value <= -100.0:
+            return None
+        return value
+
+    def get_high_threshold(self):
+        return self.high_threshold
+
+    def get_high_critical_threshold(self):
+        return self.high_critical_threshold
+
+    def get_low_threshold(self):
+        # The BMC publishes no lower limits for temperature sensors.
+        return None
+
+    def get_low_critical_threshold(self):
+        return None
+
+    def set_high_threshold(self, temperature):
+        # Thresholds live in the BMC firmware and are not writable through
+        # any implemented OEM command.
+        return False
+
+    def set_low_threshold(self, temperature):
+        return False
+
+    def get_minimum_recorded(self):
+        # The BMC exposes no min/max history for these sensors.
+        return None
+
+    def get_maximum_recorded(self):
+        return None
