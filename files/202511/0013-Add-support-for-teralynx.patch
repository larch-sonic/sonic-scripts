+++ b/platform/marvell-teralynx/sonic-platform-modules-larch/sera-dcs-t3200k/sonic_platform/chassis.py
@@ -0,0 +1,257 @@
+#!/usr/bin/env python
+
+########################################################################
+#
+# Chassis implementation for the Sera DCS-T3200K (RDS2000-32F).
+#
+# 32 x QSFP-DD 400G, Marvell Teralynx TL7 (IVM77700), x86 COMe Type-7
+# CPU module and an AST2620 BMC on a DC-SCM module.
+#
+# Everything environmental is read from the BMC over in-band IPMI (SSIF)
+# -- see ipmi.py -- while the system EEPROM, the CPLD revisions and the
+# system LEDs are read from the CPU side, so `show platform` keeps
+# working for those even if the BMC stops answering.
+#
+########################################################################
+
+try:
+    import sys
+    import time
+
+    from sonic_platform_base.chassis_base import ChassisBase
+    from sonic_platform.component import COMPONENT_LIST
+    from sonic_platform.component import Component
+    from sonic_platform.eeprom import Eeprom
+    from sonic_platform.fan_drawer import FanDrawer
+    from sonic_platform.psu import Psu
+    from sonic_platform.sensor import CURRENT_SENSOR_INFO
+    from sonic_platform.sensor import CurrentSensor
+    from sonic_platform.sensor import VOLTAGE_SENSOR_INFO
+    from sonic_platform.sensor import VoltageSensor
+    from sonic_platform.sfp import Sfp
+    from sonic_platform.thermal import THERMAL_INFO
+    from sonic_platform.thermal import Thermal
+    from sonic_platform.watchdog import Watchdog
+    from . import ipmi
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+NUM_FANTRAY = 6
+NUM_PSU = 2
+NUM_SFP = 32
+
+HOST_REBOOT_CAUSE_PATH = '/host/reboot-cause/'
+PMON_REBOOT_CAUSE_PATH = '/usr/share/sonic/platform/api_files/reboot-cause/'
+REBOOT_CAUSE_FILE = 'reboot-cause.txt'
+
+# CPLD 0x30 register 0xA1, the system LED control register.  The DIAG
+# LED is the one SONiC drives as the chassis status LED; its two-bit
+# fields encode 01 = amber, 10 = green, 11 = off.
+SYS_LED_DIAG_AMBER = 0x01
+SYS_LED_DIAG_GREEN = 0x02
+SYS_LED_DIAG_OFF = 0x03
+SYS_LED_DIAG_MASK = 0x03
+SYS_LED_DIAG_BLINK = 0x04
+
+
+class Chassis(ChassisBase):
+    """Platform-specific Chassis class"""
+
+    # The blink LED colour constants are missing from this
+    # sonic_platform_base revision; healthd asks for green_blink while
+    # booting, and get/set_status_led reference them, so define the
+    # standard string values here (harmlessly shadowed if the base
+    # class grows them later).
+    STATUS_LED_COLOR_GREEN_BLINK = 'green_blink'
+    STATUS_LED_COLOR_AMBER_BLINK = 'amber_blink'
+
+    def __init__(self):
+        ChassisBase.__init__(self)
+
+        self._eeprom = Eeprom()
+
+        for index in range(NUM_FANTRAY):
+            fan_drawer = FanDrawer(index)
+            self._fan_drawer_list.append(fan_drawer)
+            self._fan_list.extend(fan_drawer.get_all_fans())
+
+        for index in range(NUM_PSU):
+            self._psu_list.append(Psu(index))
+
+        for index in range(len(THERMAL_INFO)):
+            self._thermal_list.append(Thermal(index))
+
+        for index in range(len(VOLTAGE_SENSOR_INFO)):
+            self._voltage_sensor_list.append(VoltageSensor(index))
+
+        for index in range(len(CURRENT_SENSOR_INFO)):
+            self._current_sensor_list.append(CurrentSensor(index))
+
+        for index in range(len(COMPONENT_LIST)):
+            self._component_list.append(Component(index))
+
+        # Real transceiver access over NCT5525 -> 0x74 -> 0x72 -> optoe;
+        # presence/reset/lpmode via the TCA9555 expanders.  See sfp.py.
+        for index in range(NUM_SFP):
+            self._sfp_list.append(Sfp(index))
+
+        self._watchdog = Watchdog()
+
+    # -- DeviceBase -----------------------------------------------------
+
+    def get_name(self):
+        return self._eeprom.get_model()
+
+    def get_presence(self):
+        return True
+
+    def get_model(self):
+        return self._eeprom.get_model()
+
+    def get_serial(self):
+        return self._eeprom.get_serial()
+
+    def get_revision(self):
+        return self._eeprom.get_revision()
+
+    def get_status(self):
+        return True
+
+    def get_position_in_parent(self):
+        return -1
+
+    def is_replaceable(self):
+        return False
+
+    # -- ChassisBase ----------------------------------------------------
+
+    def get_base_mac(self):
+        return self._eeprom.get_mac()
+
+    def get_system_eeprom_info(self):
+        return self._eeprom.get_eeprom()
+
+    def get_eeprom(self):
+        return self._eeprom
+
+    def is_modular_chassis(self):
+        return False
+
+    def get_sfp(self, index):
+        """Retrieve the SFP object for the 1-based port <index>."""
+        try:
+            return self._sfp_list[index - 1]
+        except IndexError:
+            sys.stderr.write('SFP index {} out of range (1-{})\n'.format(
+                index, len(self._sfp_list)))
+            return None
+
+    def get_change_event(self, timeout=0):
+        """Poll transceiver presence on the TCA9555 ModPrsL expanders.
+
+        Presence is read through sfp.get_presence() (NCT5525 -> 0x74
+        ch6 -> TCA9555), diffed against the last snapshot, and reported
+        in the {'sfp': {port: '1'|'0'}} shape xcvrd expects.  Polling
+        once a second keeps the mux traffic negligible.
+        """
+        poll_interval = 1.0
+        deadline = None if timeout == 0 else time.time() + timeout / 1000.0
+
+        if not hasattr(self, '_presence_snapshot'):
+            self._presence_snapshot = {}
+            for idx, sfp in enumerate(self._sfp_list, start=1):
+                self._presence_snapshot[idx] = sfp.get_presence()
+
+        while True:
+            changed = {}
+            for idx, sfp in enumerate(self._sfp_list, start=1):
+                now = sfp.get_presence()
+                if now != self._presence_snapshot[idx]:
+                    self._presence_snapshot[idx] = now
+                    changed[idx] = '1' if now else '0'
+            if changed:
+                return True, {'sfp': changed}
+            if deadline is not None and time.time() >= deadline:
+                return True, {'sfp': {}}
+            time.sleep(poll_interval)
+
+    def get_reboot_cause(self):
+        """Cause of the previous reboot.
+
+        The board has no reset-cause register.  The one hardware signal
+        available is the CPLD watchdog flag (slave 0x34 register 0x21,
+        second byte), which the BMC exposes over IPMI; everything else
+        falls back to the software reboot-cause file that SONiC writes on
+        a clean shutdown.
+        """
+        if ipmi.get_watchdog_flag():
+            return (self.REBOOT_CAUSE_WATCHDOG, 'CPLD watchdog expired')
+
+        for directory in (HOST_REBOOT_CAUSE_PATH, PMON_REBOOT_CAUSE_PATH):
+            try:
+                with open(directory + REBOOT_CAUSE_FILE, 'r') as handle:
+                    cause = handle.read().strip()
+            except (IOError, OSError):
+                continue
+            if cause:
+                return (self.REBOOT_CAUSE_NON_HARDWARE, cause)
+
+        return (self.REBOOT_CAUSE_NON_HARDWARE, None)
+
+    def get_watchdog(self):
+        return self._watchdog
+
+    # -- system LED -----------------------------------------------------
+    #
+    # The DIAG LED is driven from CPLD 0x30 register 0xA1, which is on
+    # the CPU's own CPLD interface and therefore always reachable.  Bits
+    # 1:0 are the colour and bit 2 is the blink enable.
+
+    def initizalize_system_led(self):
+        return True
+
+    def get_status_led(self):
+        value = ipmi.cpld_read(ipmi.CPLD_REG_SYS_LED1)
+        if value is None:
+            return 'N/A'
+        colour = value & SYS_LED_DIAG_MASK
+        blink = bool(value & SYS_LED_DIAG_BLINK)
+        if colour == SYS_LED_DIAG_GREEN:
+            return self.STATUS_LED_COLOR_GREEN_BLINK if blink \
+                else self.STATUS_LED_COLOR_GREEN
+        if colour == SYS_LED_DIAG_AMBER:
+            return self.STATUS_LED_COLOR_AMBER_BLINK if blink \
+                else self.STATUS_LED_COLOR_AMBER
+        return self.STATUS_LED_COLOR_OFF
+
+    def set_status_led(self, color):
+        colours = {
+            self.STATUS_LED_COLOR_GREEN: (SYS_LED_DIAG_GREEN, False),
+            self.STATUS_LED_COLOR_GREEN_BLINK: (SYS_LED_DIAG_GREEN, True),
+            self.STATUS_LED_COLOR_AMBER: (SYS_LED_DIAG_AMBER, False),
+            self.STATUS_LED_COLOR_AMBER_BLINK: (SYS_LED_DIAG_AMBER, True),
+            self.STATUS_LED_COLOR_OFF: (SYS_LED_DIAG_OFF, False),
+        }
+        if color not in colours:
+            return False
+
+        current = ipmi.cpld_read(ipmi.CPLD_REG_SYS_LED1)
+        if current is None:
+            return False
+
+        colour, blink = colours[color]
+        # Preserve the LOC LED bits (7:4) that share this register.
+        value = (current & 0xF8) | colour
+        if blink:
+            value |= SYS_LED_DIAG_BLINK
+        return ipmi.cpld_write(ipmi.CPLD_REG_SYS_LED1, value)
+
+    def get_thermal_manager(self):
+        """No platform thermal policy.
+
+        Fan speed is controlled autonomously by the BMC and cannot be set
+        from the host on this board (see fan.py), so there is nothing for
+        a thermal manager to act on.  Returning None makes thermalctld
+        run in monitor-only mode instead of failing to import a policy.
+        """
+        return None
diff --git a/platform/marvell-teralynx/sonic-platform-modules-larch/sera-dcs-t3200k/sonic_platform/component.py b/platform/marvell-teralynx/sonic-platform-modules-larch/sera-dcs-t3200k/sonic_platform/component.py
