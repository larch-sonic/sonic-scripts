diff --git a/platform/marvell-teralynx/sai/build_sai_debin_pkg.sh b/platform/marvell-teralynx/sai/build_sai_debin_pkg.sh
new file mode 100755
index 000000000..3b45ec8e5
--- /dev/null
+++ b/platform/marvell-teralynx/sai/build_sai_debin_pkg.sh
@@ -0,0 +1,73 @@
+#!/bin/bash
+
+set -e
+
+SCRIPT_DIR=$(dirname "$(realpath "$0")")
+SAI_DIR="${SCRIPT_DIR}/sai-teralynx"
+INNOVIUM_DIR="${SAI_DIR}/innovium"
+
+LIBIFCS="${INNOVIUM_DIR}/ifcs/install/lib/libifcs.so"
+LIBIFCSSAI="${INNOVIUM_DIR}/install/lib/libifcssai.so"
+SAIHDR_DIR="${INNOVIUM_DIR}/sai/inc/sai"
+
+DEST="${1:-${SCRIPT_DIR}}"
+VERSION="${2}"
+ARCH="${3}"
+
+# Environment variables required by the sai-teralynx build
+export CROSS_COMPILE="x86_64-linux-gnu-"
+export XTOOLS_BASE="/usr/bin/x86_64-linux-gnu"
+export TARGET_INCLUDES="/"
+export PYTHON_BASE="/usr"
+
+# libpython3.so must exist so the build can link against -lpython3
+sudo ln -s /usr/lib/x86_64-linux-gnu/libpython3.11.so /usr/lib/x86_64-linux-gnu/libpython3.so
+
+
+# Build tps (third-party packages) and sdk targets
+cd "${SAI_DIR}"
+./build_sai.sh device x86_64 tps sdk
+
+
+# Make a deb package
+if [ ! -f "${LIBIFCSSAI}" ]; then
+    echo "ERROR: ${LIBIFCSSAI} not found after build" >&2
+    exit 1
+fi
+
+TMPDIR="/tmp/teralynx_sai_pkg_$$"
+mkdir -p "${TMPDIR}"
+
+LIBSAI_PKG="${TMPDIR}/mrvllibsai_${VERSION}_${ARCH}"
+mkdir -p "${LIBSAI_PKG}/DEBIAN"
+mkdir -p "${LIBSAI_PKG}/usr/lib"
+mkdir -p "${LIBSAI_PKG}/usr/include/sai"
+
+cp "${LIBIFCSSAI}" "${LIBSAI_PKG}/usr/lib/"
+cp "${LIBIFCS}" "${LIBSAI_PKG}/usr/lib/"
+
+find "${SAIHDR_DIR}/" -type f -exec cp -t ${LIBSAI_PKG}/usr/include/sai/ {} +
+
+cat > "${LIBSAI_PKG}/usr/lib/libsai.so" << EOF
+/* GNU ld linker script for mrvl-teralynx libsai.
+ * Lists libifcssai.so + Python unconditionally (no AS_NEEDED) so that all
+ * Python symbols referenced by libifcssai.so are resolved at link time.
+ * This allows syncd configure checks (e.g. sai_query_api_version) to succeed. */
+GROUP ( /usr/lib/libifcssai.so -lpython3.11 )
+EOF
+#/usr/lib/x86_64-linux-gnu/libpython3.11.so.1
+
+cat > "${LIBSAI_PKG}/DEBIAN/control" << EOF
+Package: mrvllibsai
+Version: ${VERSION}
+Section: base
+Priority: optional
+Architecture: ${ARCH}
+Maintainer: Larch Networks
+Description: Marvell Teralynx SAI library. libsai.so - SAI implementation for Marvell Teralynx platform.
+EOF
+
+dpkg-deb -Zgzip --build "${LIBSAI_PKG}" "${DEST}/mrvllibsai_${VERSION}_${ARCH}.deb"
+echo "Built ${DEST}/mrvllibsai_${VERSION}_${ARCH}.deb"
+
+rm -rf "${TMPDIR}"
