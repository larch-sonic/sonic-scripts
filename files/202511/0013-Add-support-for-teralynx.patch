+++ b/platform/marvell-teralynx/sonic-platform-modules-larch/sera-dcs-t3200k/sonic_platform/sensor.py
@@ -0,0 +1,143 @@
+#!/usr/bin/env python
+
+########################################################################
+#
+# Voltage and current sensor implementation for the Sera DCS-T3200K.
+#
+# The board's power sequencer feeds the BMC with the DC rail monitors
+# (VMON1..VMON8) and with the VOUT/IOUT/POUT telemetry of the four ASIC
+# rails.  Those are published as ordinary SDR entries, so they surface
+# through `show platform voltage` and `show platform current` with no
+# extra plumbing.
+#
+# The power sequencer is an ispPAC-POWR1014A with ten VMON inputs, but
+# the BMC only publishes six of them (VMON1, 2, 3, 5, 6, 8 = 5VSB, 12V,
+# 5V, 3V3_SYS, 1.8V, PLL_AVDD).  VMON4, 7, 9 and 10 -- 3.3VDD, AVDDH_1V1,
+# AVDD_0V9 and VDD_0V8 -- are not exposed; those four ASIC rails are
+# covered instead by the VOUT_*/IOUT_* entries below, which come from the
+# voltage regulators themselves and are the more accurate source anyway.
+# Missing rails are simply absent from these tables rather than reported
+# as zero.
+#
+########################################################################
+
+try:
+    from sonic_platform_base.sensor_base import VoltageSensorBase
+    from sonic_platform_base.sensor_base import CurrentSensorBase
+    from . import ipmi
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+
+# (SDR name, display name)
+VOLTAGE_SENSOR_INFO = [
+    ('VMON1',          'VMON1 5V standby rail'),
+    ('VMON2',          'VMON2 12V rail'),
+    ('VMON3',          'VMON3 5V rail'),
+    ('VMON5',          'VMON5 3.3V system rail'),
+    ('VMON6',          'VMON6 1.8V rail'),
+    ('VMON8',          'VMON8 PLL AVDD rail'),
+    ('VOUT_33VDD',     'ASIC 3.3VDD rail voltage'),
+    ('VOUT_AVDDH_1V1', 'ASIC AVDDH 1.1V rail voltage'),
+    ('VOUT_AVDD_0V9',  'ASIC AVDD 0.9V rail voltage'),
+    ('VOUT_VDD_0V8',   'ASIC VDD 0.8V core rail voltage'),
+]
+
+CURRENT_SENSOR_INFO = [
+    ('IOUT_33VDD',     'ASIC 3.3VDD rail current'),
+    ('IOUT_AVDDH_1V1', 'ASIC AVDDH 1.1V rail current'),
+    ('IOUT_AVDD_0V9',  'ASIC AVDD 0.9V rail current'),
+    ('IOUT_VDD_0V8',   'ASIC VDD 0.8V core rail current'),
+]
+
+
+class _IpmiSensor(object):
+    """Common behaviour for the SDR-backed sensors.
+
+    SensorBase declares the voltage unit as mV and the current unit as
+    mA, while the BMC reports volts and amps, so every reading is scaled
+    by SCALE on the way out.
+    """
+
+    SCALE = 1000.0
+
+    def __init__(self, index, sdr_name, name):
+        self.index = index
+        self.sdr_name = sdr_name
+        self.name = name
+
+    def get_name(self):
+        return self.name
+
+    def get_presence(self):
+        return ipmi.sensor_present(self.sdr_name)
+
+    def get_model(self):
+        return 'N/A'
+
+    def get_serial(self):
+        return 'N/A'
+
+    def get_status(self):
+        return ipmi.sensor_ok(self.sdr_name)
+
+    def get_position_in_parent(self):
+        return self.index + 1
+
+    def is_replaceable(self):
+        return False
+
+    def get_value(self):
+        """Reading in the unit SensorBase declares (mV / mA)."""
+        value = ipmi.sensor_value(self.sdr_name)
+        if value is None:
+            return None
+        return value * self.SCALE
+
+    # The BMC publishes no thresholds for these rails, and none of them
+    # are writable through an implemented OEM command.
+    def get_high_threshold(self):
+        return None
+
+    def get_low_threshold(self):
+        return None
+
+    def get_high_critical_threshold(self):
+        return None
+
+    def get_low_critical_threshold(self):
+        return None
+
+    def set_high_threshold(self, value):
+        return False
+
+    def set_low_threshold(self, value):
+        return False
+
+    def set_high_critical_threshold(self, value):
+        return False
+
+    def set_low_critical_threshold(self, value):
+        return False
+
+    def get_minimum_recorded(self):
+        return None
+
+    def get_maximum_recorded(self):
+        return None
+
+
+class VoltageSensor(_IpmiSensor, VoltageSensorBase):
+    """Platform-specific voltage sensor class"""
+
+    def __init__(self, index):
+        sdr_name, name = VOLTAGE_SENSOR_INFO[index]
+        _IpmiSensor.__init__(self, index, sdr_name, name)
+
+
+class CurrentSensor(_IpmiSensor, CurrentSensorBase):
+    """Platform-specific current sensor class"""
+
+    def __init__(self, index):
+        sdr_name, name = CURRENT_SENSOR_INFO[index]
+        _IpmiSensor.__init__(self, index, sdr_name, name)
diff --git a/platform/marvell-teralynx/sonic-platform-modules-larch/sera-dcs-t3200k/sonic_platform/sfp.py b/platform/marvell-teralynx/sonic-platform-modules-larch/sera-dcs-t3200k/sonic_platform/sfp.py
new file mode 100644
index 000000000..490f0e5c9
--- /dev/null
+++ b/platform/marvell-teralynx/sonic-platform-modules-larch/sera-dcs-t3200k/sonic_platform/sfp.py
@@ -0,0 +1,279 @@
+#!/usr/bin/env python3
+
+########################################################################
+#
+# SFP/QSFP-DD implementation for the Sera DCS-T3200K (Teralynx TL7).
+#
+# The 32 QSFP-DD cages hang off the NCT5525D Super-I/O SMBus master:
+#
+#   NCT5525 bus -> PCA9548 @0x74 -> ch0..3 -> PCA9548 @0x72 -> EEPROM @0x50
+#                                   ch4 -> TCA9555 @0x22/@0x23  LPMode
+#                                   ch5 -> TCA9555 @0x22/@0x23  ResetL
+#                                   ch6 -> TCA9555 @0x22/@0x23  ModPrsL
+#                                   ch7 -> TCA9555 @0x22/@0x23  INT
+#
+# Port fan-out: 0x74 ch0 carries ports 1-8, ch1 9-16, ch2 17-24,
+# ch3 25-32; within each 0x72, channel k is port base+k+1.  On the
+# status expanders 0x22 carries ports 1-16 (input reg 0 = P1-8, reg 1 =
+# P9-16) and 0x23 carries ports 17-32, one bit per port, LSB first.
+#
+# The platform init script (sera-dcs-t3200k-init.sh) instantiates the
+# whole tree with the kernel pca954x driver and an optoe3 client per
+# cage, which is what makes this file possible: the i2c-nct5525 v2
+# driver emulates SMBus send-byte with a register phase, so pca954x
+# channel selects actually reach the muxes (see modules/i2c-nct5525.c).
+# EEPROM access goes through optoe's paged sysfs `eeprom` file;
+# presence/reset/lpmode are read (and written) on the TCA9555 expanders
+# through the mux child buses, where pca954x arbitrates the channel per
+# transaction.
+#
+# The per-bit port order on the expanders (LSB = lowest port of the
+# group, 0x22 = ports 1-16, 0x23 = ports 17-32) was cross-checked on a
+# mixed-population board: ModPrsL reads 0 exactly on the cages that
+# hold modules (1-8, 31-32 on the bring-up unit) and 1 on the empty
+# ones, and the EEPROM serials behind the per-port mux channels are
+# distinct and match the fitted DACs.
+#
+########################################################################
+
+import os
+import threading
+import time
+
+try:
+    from sonic_platform_base.sonic_xcvr.sfp_optoe_base import SfpOptoeBase
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+try:
+    from smbus2 import SMBus
+except ImportError:
+    from smbus import SMBus  # noqa: F401
+
+PORT_START = 1
+PORT_END = 32
+
+I2C_DEVICES = '/sys/bus/i2c/devices'
+
+OPTICS_MUX_ADDR = '0074'    # level-1 PCA9548 on the NCT5525 bus
+PORT_MUX_ADDR = '0072'      # level-2 PCA9548, one per 8 ports
+
+# Level-1 mux channels of the TCA9555 status expanders
+CH_LPMODE = 4
+CH_RESETL = 5
+CH_MODPRSL = 6
+
+# TCA9555 register map
+TCA9555_INPUT0 = 0
+TCA9555_OUTPUT0 = 2
+TCA9555_CONFIG0 = 6         # 1 = input (Hi-Z), 0 = output
+
+# Serialise expander read-modify-write across Sfp instances
+_expander_lock = threading.Lock()
+
+
+def _read_link_bus(path):
+    """Return the bus number a channel-N symlink points at, or None."""
+    try:
+        target = os.path.realpath(path)
+        name = os.path.basename(target)
+        if name.startswith('i2c-'):
+            return int(name[4:])
+    except (OSError, ValueError):
+        pass
+    return None
+
+
+class Sfp(SfpOptoeBase):
+    """QSFP-DD cage on the Sera DCS-T3200K, reached over NCT5525.
+
+    The chassis constructs instances with a 0-based index; port numbers
+    towards the hardware tables are 1-based.
+    """
+
+    # Class-level caches, shared by all 32 instances
+    _nct_bus = None
+    _l1_bus_cache = {}      # level-1 channel -> child bus number
+
+    def __init__(self, index, sfp_type='QSFP_DD'):
+        SfpOptoeBase.__init__(self)
+        self.index = index
+        self.port_num = index + 1
+        self.sfp_type = sfp_type
+        self._eeprom_path = None
+
+    # -- topology resolution ---------------------------------------------
+
+    @classmethod
+    def _find_nct_bus(cls):
+        if cls._nct_bus is not None:
+            return cls._nct_bus
+        try:
+            for entry in sorted(os.listdir(I2C_DEVICES)):
+                if not entry.startswith('i2c-'):
+                    continue
+                name_path = os.path.join(I2C_DEVICES, entry, 'name')
+                try:
+                    with open(name_path) as f:
+                        if 'NCT67xx' in f.read():
+                            cls._nct_bus = int(entry[4:])
+                            return cls._nct_bus
+                except (OSError, ValueError):
+                    continue
+        except OSError:
+            pass
+        return None
+
+    @classmethod
+    def _l1_channel_bus(cls, channel):
+        """Bus number behind level-1 mux channel <channel>, cached."""
+        if channel in cls._l1_bus_cache:
+            return cls._l1_bus_cache[channel]
+        nct = cls._find_nct_bus()
+        if nct is None:
+            return None
+        link = os.path.join(I2C_DEVICES, '%d-%s' % (nct, OPTICS_MUX_ADDR),
+                            'channel-%d' % channel)
+        bus = _read_link_bus(link)
+        if bus is not None:
+            cls._l1_bus_cache[channel] = bus
+        return bus
+
+    def _port_eeprom_path(self):
+        if self._eeprom_path and os.path.exists(self._eeprom_path):
+            return self._eeprom_path
+        l1ch = (self.port_num - 1) // 8
+        l2ch = (self.port_num - 1) % 8
+        child = self._l1_channel_bus(l1ch)
+        if child is None:
+            return None
+        link = os.path.join(I2C_DEVICES, '%d-%s' % (child, PORT_MUX_ADDR),
+                            'channel-%d' % l2ch)
+        gbus = _read_link_bus(link)
+        if gbus is None:
+            return None
+        path = os.path.join(I2C_DEVICES, '%d-0050' % gbus, 'eeprom')
+        if not os.path.exists(path):
+            return None
+        self._eeprom_path = path
+        return path
+
+    # -- expander access ---------------------------------------------------
+
+    def _expander_target(self):
+        """(i2c address, register offset, bit) of this port's status bit."""
+        addr = 0x22 if self.port_num <= 16 else 0x23
+        reg_off = 0 if ((self.port_num - 1) % 16) < 8 else 1
+        bit = (self.port_num - 1) % 8
+        return addr, reg_off, bit
+
+    def _expander_read(self, l1_channel, base_reg):
+        bus = self._l1_channel_bus(l1_channel)
+        if bus is None:
+            return None
+        addr, reg_off, bit = self._expander_target()
+        try:
+            with _expander_lock:
+                with SMBus(bus) as smb:
+                    val = smb.read_byte_data(addr, base_reg + reg_off)
+            return (val >> bit) & 1
+        except OSError:
+            return None
+
+    def _expander_write_bit(self, l1_channel, drive, level=0):
+        """Drive (or release) this port's pin on the given expander.
+
+        drive=True  -> configure the pin as an output at <level>
+        drive=False -> configure the pin back to input (Hi-Z, board pull)
+        """
+        bus = self._l1_channel_bus(l1_channel)
+        if bus is None:
+            return False
+        addr, reg_off, bit = self._expander_target()
+        try:
+            with _expander_lock:
+                with SMBus(bus) as smb:
+                    if drive:
+                        out = smb.read_byte_data(addr,
+                                                 TCA9555_OUTPUT0 + reg_off)
+                        if level:
+                            out |= (1 << bit)
+                        else:
+                            out &= ~(1 << bit)
+                        smb.write_byte_data(addr, TCA9555_OUTPUT0 + reg_off,
+                                            out)
+                        cfg = smb.read_byte_data(addr,
+                                                 TCA9555_CONFIG0 + reg_off)
+                        smb.write_byte_data(addr, TCA9555_CONFIG0 + reg_off,
+                                            cfg & ~(1 << bit))
+                    else:
+                        cfg = smb.read_byte_data(addr,
+                                                 TCA9555_CONFIG0 + reg_off)
+                        smb.write_byte_data(addr, TCA9555_CONFIG0 + reg_off,
+                                            cfg | (1 << bit))
+            return True
+        except OSError:
+            return False
+
+    # -- DeviceBase --------------------------------------------------------
+
+    def get_name(self):
+        return 'Ethernet{}'.format(self.index * 8)
+
+    def get_presence(self):
+        # ModPrsL is active low
+        val = self._expander_read(CH_MODPRSL, TCA9555_INPUT0)
+        return val == 0
+
+    def get_model(self):
+        info = self.get_transceiver_info()
+        if info:
+            return info.get('model', 'N/A')
+        return 'N/A'
+
+    def get_serial(self):
+        info = self.get_transceiver_info()
+        if info:
+            return info.get('serial', 'N/A')
+        return 'N/A'
+
+    def get_status(self):
+        return self.get_presence()
+
+    def get_position_in_parent(self):
+        return self.port_num
+
+    def is_replaceable(self):
+        return True
+
+    def get_error_description(self):
+        if not self.get_presence():
+            return self.SFP_STATUS_UNPLUGGED
+        return self.SFP_STATUS_OK
+
+    # -- SfpOptoeBase ------------------------------------------------------
+
+    def get_eeprom_path(self):
+        return self._port_eeprom_path()
+
+    def get_reset_status(self):
+        # ResetL is active low: in reset when the pin reads 0
+        val = self._expander_read(CH_RESETL, TCA9555_INPUT0)
+        return val == 0
+
+    def reset(self):
+        # Open-drain pulse: drive ResetL low, then release to the board
+        # pull-up.  CMIS t_reset is milliseconds; hold 0.5 s to be safe.
+        if not self._expander_write_bit(CH_RESETL, drive=True, level=0):
+            return False
+        time.sleep(0.5)
+        return self._expander_write_bit(CH_RESETL, drive=False)
+
+    def get_lpmode(self):
+        val = self._expander_read(CH_LPMODE, TCA9555_INPUT0)
+        return val == 1
+
+    def set_lpmode(self, lpmode):
+        # LPMode is a plain level pin: drive it to the requested state.
+        return self._expander_write_bit(CH_LPMODE, drive=True,
+                                        level=1 if lpmode else 0)
