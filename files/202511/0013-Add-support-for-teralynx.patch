+#!/usr/bin/env python
+
+########################################################################
+#
+# Fan drawer implementation for the Sera DCS-T3200K (Teralynx TL7).
+#
+# Six field-replaceable trays, two counter-rotating rotors each.
+#
+########################################################################
+
+try:
+    from sonic_platform_base.fan_drawer_base import FanDrawerBase
+    from sonic_platform.fan import Fan, FANS_PER_TRAY
+    from . import ipmi
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+
+class FanDrawer(FanDrawerBase):
+    """Platform-specific Fan drawer class"""
+
+    def __init__(self, tray_index):
+        FanDrawerBase.__init__(self)
+        self.index = tray_index
+        for fan_index in range(FANS_PER_TRAY):
+            self._fan_list.append(Fan(tray_index, fan_index))
+
+    # -- DeviceBase -----------------------------------------------------
+
+    def get_name(self):
+        return 'Fantray{}'.format(self.index + 1)
+
+    def get_presence(self):
+        presence = ipmi.get_fan_presence()
+        if presence is not None and self.index < len(presence):
+            return presence[self.index]
+        return any(fan.get_presence() for fan in self._fan_list)
+
+    def get_model(self):
+        return 'N/A'
+
+    def get_serial(self):
+        return 'N/A'
+
+    def get_status(self):
+        """A tray is healthy only when both of its rotors are."""
+        if not self.get_presence():
+            return False
+        return all(fan.get_status() for fan in self._fan_list)
+
+    def get_position_in_parent(self):
+        return self.index + 1
+
+    def is_replaceable(self):
+        return True
+
+    # -- FanDrawerBase --------------------------------------------------
+
+    def get_status_led(self):
+        if not self.get_presence():
+            return self.STATUS_LED_COLOR_OFF
+        return self.STATUS_LED_COLOR_GREEN if self.get_status() \
+            else self.STATUS_LED_COLOR_RED
+
+    def set_status_led(self, color):
+        """Not supported: fan-tray LEDs are driven by the BMC."""
+        return False
+
+    def get_maximum_consumed_power(self):
+        return None
diff --git a/platform/marvell-teralynx/sonic-platform-modules-larch/sera-dcs-t3200k/sonic_platform/ipmi.py b/platform/marvell-teralynx/sonic-platform-modules-larch/sera-dcs-t3200k/sonic_platform/ipmi.py
