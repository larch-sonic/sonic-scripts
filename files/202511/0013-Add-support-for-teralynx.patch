index 000000000..1c2a45cad
--- /dev/null
+++ b/platform/marvell-teralynx/sonic-platform-modules-larch/sera-dcs-t3200k/sonic_platform/component.py
@@ -0,0 +1,176 @@
+#!/usr/bin/env python
+
+########################################################################
+#
+# Component (firmware version) implementation for the Sera DCS-T3200K.
+#
+# Four components carry a readable version on this board:
+#
+#   BIOS        - SMBIOS, via /sys/class/dmi/id/bios_version
+#   BMC         - AST2620 firmware revision, from `ipmitool mc info`
+#   CPLD-SWITCH - Lattice LCMXO3LF on the switch board.  Readable two
+#                 ways: directly from the CPU at CPLD slave 0x30
+#                 register 0x01 over i2c-0, or through the BMC with
+#                 `raw 0x30 0x34 0x01`.  The CPU path is preferred
+#                 because it works even when the BMC is unresponsive.
+#   CPLD-FAN    - the fan extension board's own CPLD, mirrored into
+#                 slave 0x30 register 0x02.
+#
+# ONIE's version is reported too, from /host/machine.conf, matching the
+# convention used by the other Larch platforms.
+#
+########################################################################
+
+import os
+import re
+import subprocess
+
+try:
+    from sonic_platform_base.component_base import ComponentBase
+    from . import ipmi
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+BIOS_VERSION_PATH = '/sys/class/dmi/id/bios_version'
+MACHINE_CONF_PATHS = ['/host/machine.conf', '/etc/machine.conf']
+
+COMPONENT_BIOS = 0
+COMPONENT_BMC = 1
+COMPONENT_CPLD_SWITCH = 2
+COMPONENT_CPLD_FAN = 3
+COMPONENT_ONIE = 4
+
+COMPONENT_LIST = [
+    ('BIOS', 'Basic Input/Output System'),
+    ('BMC', 'Baseboard Management Controller (AST2620)'),
+    ('CPLD-SWITCH', 'Switch board CPLD'),
+    ('CPLD-FAN', 'Fan extension board CPLD'),
+    ('ONIE', 'Open Network Install Environment'),
+]
+
+
+def _read_file(path):
+    try:
+        with open(path, 'r') as handle:
+            return handle.read().strip()
+    except (IOError, OSError):
+        return None
+
+
+class Component(ComponentBase):
+    """Platform-specific Component class"""
+
+    def __init__(self, component_index=0):
+        ComponentBase.__init__(self)
+        self.index = component_index
+        self.name = COMPONENT_LIST[component_index][0]
+        self.description = COMPONENT_LIST[component_index][1]
+
+    # -- version helpers ------------------------------------------------
+
+    @staticmethod
+    def _bios_version():
+        return _read_file(BIOS_VERSION_PATH)
+
+    @staticmethod
+    def _bmc_version():
+        """BMC firmware revision from `ipmitool mc info`."""
+        if not ipmi.is_available():
+            return None
+        try:
+            out = subprocess.check_output(['ipmitool', 'mc', 'info'],
+                                          stderr=subprocess.DEVNULL,
+                                          universal_newlines=True,
+                                          timeout=ipmi.CMD_TIMEOUT)
+        except (subprocess.SubprocessError, OSError):
+            return None
+        match = re.search(r'Firmware Revision\s*:\s*(\S+)', out)
+        return match.group(1) if match else None
+
+    @staticmethod
+    def _cpld_version(register):
+        """CPLD revision, preferring the BMC-independent CPU-side read."""
+        value = ipmi.cpld_read(register)
+        if value is None and register == ipmi.CPLD_REG_VERSION_SWITCH:
+            value = ipmi.get_cpld_version()
+        if value is None:
+            return None
+        return '{:#04x}'.format(value)
+
+    @staticmethod
+    def _onie_version():
+        for path in MACHINE_CONF_PATHS:
+            content = _read_file(path)
+            if not content:
+                continue
+            for line in content.splitlines():
+                if line.startswith('onie_version='):
+                    return line.split('=', 1)[1].strip()
+        return None
+
+    # -- DeviceBase -----------------------------------------------------
+
+    def get_name(self):
+        return self.name
+
+    def get_description(self):
+        return self.description
+
+    def get_presence(self):
+        if self.index == COMPONENT_BMC:
+            # CPLD 0x30 register 0x20 bit 0 (BMC_EN) is the authoritative
+            # "is the BMC module fitted" signal, readable from the CPU.
+            status = ipmi.cpld_read(ipmi.CPLD_REG_STATUS1)
+            if status is not None:
+                return bool(status & 0x01)
+            return ipmi.is_available()
+        return True
+
+    def get_model(self):
+        return 'N/A'
+
+    def get_serial(self):
+        return 'N/A'
+
+    def get_status(self):
+        return True
+
+    def get_position_in_parent(self):
+        return self.index + 1
+
+    def is_replaceable(self):
+        return False
+
+    # -- ComponentBase --------------------------------------------------
+
+    def get_firmware_version(self):
+        version = None
+        if self.index == COMPONENT_BIOS:
+            version = self._bios_version()
+        elif self.index == COMPONENT_BMC:
+            version = self._bmc_version()
+        elif self.index == COMPONENT_CPLD_SWITCH:
+            version = self._cpld_version(ipmi.CPLD_REG_VERSION_SWITCH)
+        elif self.index == COMPONENT_CPLD_FAN:
+            version = self._cpld_version(ipmi.CPLD_REG_VERSION_FAN)
+        elif self.index == COMPONENT_ONIE:
+            version = self._onie_version()
+        return version if version else 'N/A'
+
+    def get_available_firmware_version(self, image_path):
+        return 'N/A'
+
+    def get_firmware_update_notification(self, image_path):
+        return 'None'
+
+    def install_firmware(self, image_path):
+        """Not implemented.
+
+        BIOS and BMC images are flashed with the vendor's own tools, and
+        the CPLDs are programmed over JTAG; none of that is exposed as a
+        SONiC-driven update path on this board.
+        """
+        return False
+
+    def update_firmware(self, image_path):
+        return False
