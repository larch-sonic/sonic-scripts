@@ -0,0 +1,279 @@
+#!/bin/bash
+#
+# Platform init for the Sera DCS-T3200K (RDS2000-32F, Teralynx TL7).
+#
+# Brings up the two I2C devices SONiC needs and that nothing else on the
+# system instantiates:
+#
+#   1. PCA9548 at 0x75 on the CPU SMBus (i2c-0).  Its channel 0 carries
+#      the BMC and its channel 1 the system EEPROM.
+#
+#   2. ipmi_ssif at 0x31 on the mux's channel-0 child bus.  The BMC's
+#      host interface on this board is IPMI-over-SMBus (SSIF) at TWSI9
+#      slave 0x31 -- not KCS -- and the BIOS publishes no SMBIOS type 38
+#      record for it, so nothing is auto-detected: `ipmi_si` finds no
+#      system interface and /dev/ipmi0 never appears on its own.
+#      Instantiating ipmi_ssif here is what creates /dev/ipmi0, and
+#      /dev/ipmi0 is the only path to the fans, PSUs, thermals and DC
+#      rails on this board.
+#
+#   3. The 24C04 system/ONIE EEPROM at 0x54 on the mux's channel-1 child
+#      bus, giving /sys/bus/i2c/devices/<bus>-0054/eeprom.
+#
+# Two traps this script exists to avoid:
+#
+#   * The i2c client name must be `ipmi_ssif` with an UNDERSCORE.
+#     `ipmi-ssif` with a hyphen is accepted by new_device and matches no
+#     driver, so the probe silently never runs.
+#
+#   * The device must be instantiated on the mux CHILD bus, not on i2c-0
+#     with the channel latched open.  On the child bus the kernel
+#     pca954x driver arbitrates the channel per transaction, which is
+#     what makes this safe on a bus the BMC also masters.
+#
+# Ordering matters: this unit runs Before=pmon.service because
+# get_pmon_device_mounts() in docker_image_ctl.j2 passes /dev/ipmi0 and
+# /dev/i2c-* into the pmon container only if those nodes already exist
+# when the container is created.  If pmon came up first, thermalctld and
+# psud would have no way to reach the BMC.
+#
+# The script is idempotent and safe to re-run.
+#
+
+set -u
+
+LOCKFILE=/var/lock/sera-dcs-t3200k-init.lock
+I2C_DEVICES=/sys/bus/i2c/devices
+
+SMBUS=0
+MUX_ADDR=0x75
+MUX_DEV="${SMBUS}-0075"
+BMC_SSIF_ADDR=0x31
+BMC_MUX_CHANNEL=0
+SYSEEPROM_ADDR=0x54
+SYSEEPROM_TYPE=24c04
+SYSEEPROM_MUX_CHANNEL=1
+
+# The BMC answers over SMBus; give the mux and the SSIF probe time to
+# settle before giving up on /dev/ipmi0.
+IPMI_WAIT_SECONDS=15
+
+log() {
+    echo "sera-dcs-t3200k-init: $*"
+    logger -t sera-dcs-t3200k-init "$*" 2>/dev/null || true
+}
+
+load_modules() {
+    # i2c-i801 is the CPU SMBus controller, pca954x the mux, at24 the
+    # EEPROM, and the ipmi trio is what binds the BMC at 0x31.
+    # i2c-nct5525 (platform-built, /lib/modules/<kver>/extra) is the
+    # Super-I/O SMBus master carrying the SFP/QSFP optics tree
+    # (0x74 -> 0x72 -> 0x50); v2 of the driver emulates SMBus send-byte
+    # with a register phase so the kernel pca954x channel selects work.
+    for module in i2c-i801 i2c-dev i2c-nct5525 i2c-mux-pca954x at24 optoe \
+                  ipmi_msghandler ipmi_devintf ipmi_ssif; do
+        modprobe "$module" 2>/dev/null || true
+    done
+}
+
+# new_i2c_device <bus> <driver-name> <address> <sysfs-name>
+# Instantiates an i2c client unless it is already bound.
+new_i2c_device() {
+    local bus="$1" driver="$2" addr="$3" name="$4"
+
+    if [ -d "${I2C_DEVICES}/${name}" ]; then
+        return 0
+    fi
+    if [ ! -d "${I2C_DEVICES}/i2c-${bus}" ]; then
+        log "bus i2c-${bus} not present, cannot create ${driver}@${addr}"
+        return 1
+    fi
+
+    echo "${driver} ${addr}" > "${I2C_DEVICES}/i2c-${bus}/new_device" 2>/dev/null
+
+    # The kernel creates the sysfs node synchronously, but the driver
+    # probe (and udev) may still be running.
+    local retry=0
+    while [ ! -d "${I2C_DEVICES}/${name}" ] && [ $retry -lt 20 ]; do
+        sleep 0.1
+        retry=$((retry + 1))
+    done
+
+    if [ -d "${I2C_DEVICES}/${name}" ]; then
+        log "created ${driver} at ${addr} on i2c-${bus}"
+        return 0
+    fi
+    return 1
+}
+
+# The kernel mistakes the system EEPROM for a DIMM SPD and claims it.
+#
+# i2c-i801 runs i2c_register_spd() at probe time: the BIOS reports eight
+# memory devices, so it scans 0x50-0x57 on the SMBus and instantiates an
+# `ee1004` client for every address that answers.  At that moment the
+# PCA9548 driver has not bound yet, the mux still has whatever channel
+# the previous master left open, and the system EEPROM at 0x54/0x55
+# answers straight through it.  dmesg shows the result:
+#
+#   i2c i2c-0: Successfully instantiated SPD at 0x54
+#   ee1004 0-0054: Failed to select page 0 (-6)
+#
+# The binding is useless: ee1004 needs DDR4 page-select devices at
+# 0x36/0x37 that do not exist here, so every read of its `eeprom`
+# attribute fails with ENXIO.  Those clients are kernel-owned, so sysfs
+# `delete_device` refuses them ("Can't find device in list") and they go
+# on holding the address, which makes our own at24 client fail with
+# -EBUSY.
+#
+# What we can do is unbind the bogus driver, so nothing offers an
+# `eeprom` file that can only ever return an error.  eeprom.py then reads
+# the chip directly over SMBus.  The clean fix belongs in the BIOS and is
+# on the vendor list (#35709).
+unbind_misdetected_spd() {
+    local addr dev name driver
+
+    for addr in 0054 0055; do
+        dev="${I2C_DEVICES}/${SMBUS}-${addr}"
+        [ -d "$dev" ] || continue
+        # No driver symlink means nothing is bound: nothing to undo.
+        [ -L "${dev}/driver" ] || continue
+
+        driver=$(basename "$(readlink -f "${dev}/driver")")
+        [ "$driver" = "at24" ] && continue
+
+        name=$(cat "${dev}/name" 2>/dev/null)
+        echo "${SMBUS}-${addr}" \
+            > "/sys/bus/i2c/drivers/${driver}/unbind" 2>/dev/null
+        log "unbound ${driver} from misdetected SPD client ${SMBUS}-${addr} (${name:-unknown})"
+    done
+}
+
+# Resolve a pca954x child bus number from its channel symlink, so the
+# bus numbering is never hard-coded.
+# mux_channel_bus <mux-sysfs-name> <channel>
+mux_channel_bus() {
+    local dev="$1" channel="$2"
+    local link="${I2C_DEVICES}/${dev}/channel-${channel}"
+    local target
+
+    [ -L "$link" ] || return 1
+    target=$(readlink -f "$link") || return 1
+    basename "$target" | sed -n 's/^i2c-//p'
+}
+
+# The 32 QSFP-DD cages sit behind the NCT5525 Super-I/O SMBus master:
+# PCA9548 @0x74 -> ch0..3 -> PCA9548 @0x72 -> port EEPROM @0x50 (optoe3),
+# ch4..7 carry the TCA9555 present/reset/lpmode expanders, which sfp.py
+# reads directly over the mux child buses.  This only works with the
+# platform-built i2c-nct5525 v2 driver (send-byte emulation) -- see
+# modules/i2c-nct5525.c.
+optics_init() {
+    local nct_bus l1 l2 child gbus ports
+
+    nct_bus=""
+    for d in "${I2C_DEVICES}"/i2c-*; do
+        if grep -q "NCT67xx" "${d}/name" 2>/dev/null; then
+            nct_bus=$(basename "$d" | sed 's/^i2c-//')
+            break
+        fi
+    done
+    if [ -z "$nct_bus" ]; then
+        log "NCT5525 SMBus master not found; optics tree not instantiated"
+        return 1
+    fi
+
+    new_i2c_device "$nct_bus" pca9548 0x74 "${nct_bus}-0074" \
+        || { log "ERROR: level-1 optics mux 0x74 did not probe"; return 1; }
+
+    ports=0
+    for l1 in 0 1 2 3; do
+        child=$(mux_channel_bus "${nct_bus}-0074" "$l1")
+        [ -n "${child:-}" ] || { log "no child bus for 0x74 ch${l1}"; continue; }
+        new_i2c_device "$child" pca9548 0x72 "${child}-0072" \
+            || { log "level-2 mux 0x72 on 0x74 ch${l1} did not probe"; continue; }
+        for l2 in 0 1 2 3 4 5 6 7; do
+            gbus=$(mux_channel_bus "${child}-0072" "$l2")
+            [ -n "${gbus:-}" ] || continue
+            new_i2c_device "$gbus" optoe3 0x50 "${gbus}-0050" \
+                && ports=$((ports + 1))
+        done
+    done
+    log "optics tree up: ${ports}/32 cages instantiated (optoe3)"
+}
+
+# The pmon container does not get /host mounted, but it does get the
+# platform's own device directory (as /usr/share/sonic/platform).  Leave
+# ONIE's machine.conf there so syseepromd can fall back to it while the
+# board's system EEPROM is still unprogrammed -- see eeprom.py.
+publish_machine_conf() {
+    local platform api_files
+
+    [ -r /host/machine.conf ] || return 0
+
+    platform=$(sed -n 's/^onie_platform=//p' /host/machine.conf | head -1)
+    [ -n "$platform" ] || return 0
+
+    api_files="/usr/share/sonic/device/${platform}/api_files"
+    [ -d "/usr/share/sonic/device/${platform}" ] || return 0
+
+    mkdir -p "$api_files" 2>/dev/null || return 0
+    cp -f /host/machine.conf "${api_files}/machine.conf" 2>/dev/null || true
+}
+
+platform_init() {
+    load_modules
+    publish_machine_conf
+
+    new_i2c_device "$SMBUS" pca9548 "$MUX_ADDR" "$MUX_DEV" || return 1
+
+    local bmc_bus syseeprom_bus
+    bmc_bus=$(mux_channel_bus "$MUX_DEV" "$BMC_MUX_CHANNEL")
+    if [ -n "${bmc_bus:-}" ]; then
+        new_i2c_device "$bmc_bus" ipmi_ssif "$BMC_SSIF_ADDR" \
+            "${bmc_bus}-0031" \
+            || log "ERROR: could not attach ipmi_ssif at ${BMC_SSIF_ADDR} on i2c-${bmc_bus}"
+    else
+        log "cannot resolve mux channel ${BMC_MUX_CHANNEL}, BMC not attached"
+    fi
+
+    unbind_misdetected_spd
+
+    # The QSFP-DD optics tree over NCT5525.  Best effort: the platform
+    # keeps working (minus transceivers) if the Super-I/O bus is absent.
+    optics_init || log "WARNING: optics tree unavailable; transceivers will read as absent"
+
+    syseeprom_bus=$(mux_channel_bus "$MUX_DEV" "$SYSEEPROM_MUX_CHANNEL")
+    if [ -n "${syseeprom_bus:-}" ]; then
+        # Best effort: this fails while the kernel's SPD client still
+        # holds 0x54, in which case eeprom.py reads over SMBus instead.
+        new_i2c_device "$syseeprom_bus" "$SYSEEPROM_TYPE" "$SYSEEPROM_ADDR" \
+            "${syseeprom_bus}-0054" \
+            || log "system EEPROM address is held by the kernel SPD client; reading it over SMBus instead"
+    else
+        log "cannot resolve mux channel ${SYSEEPROM_MUX_CHANNEL}, no system EEPROM"
+    fi
+
+    # pmon only inherits /dev/ipmi0 if it exists before the container is
+    # created, so wait for the SSIF probe to finish before returning.
+    local waited=0
+    while [ ! -c /dev/ipmi0 ] && [ $waited -lt $IPMI_WAIT_SECONDS ]; do
+        sleep 1
+        waited=$((waited + 1))
+    done
+
+    if [ -c /dev/ipmi0 ]; then
+        log "BMC reachable in band, /dev/ipmi0 ready after ${waited}s"
+    else
+        log "WARNING: /dev/ipmi0 did not appear; platform sensors will be unavailable"
+    fi
+}
+
+# Serialise against a concurrent invocation (postinst plus systemd).
+if command -v flock >/dev/null 2>&1; then
+    exec 9>"$LOCKFILE"
+    flock 9
+fi
+
+platform_init
+
+exit 0
