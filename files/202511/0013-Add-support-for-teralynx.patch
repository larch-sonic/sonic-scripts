@@ -0,0 +1,186 @@
+#!/usr/bin/env python
+
+########################################################################
+#
+# Fan implementation for the Sera DCS-T3200K (Teralynx TL7).
+#
+# The board carries six hot-swap fan trays (5+1 redundant), two
+# counter-rotating rotors each -- twelve tachometers in total.  Every
+# tacho is published by the BMC as an SDR entry (FAN_<tray>_<rotor>,
+# 1-based).  Presence, airflow type and health come from three SERA OEM
+# bitmap registers that each answer for all six trays at once
+# (0xB0 front-to-back inserted, 0xB1 back-to-front inserted, 0xB3
+# fail/good) -- see ipmi.get_fan_info() for why the per-tray record is
+# not used here.
+#
+# Fan speed is regulated in hardware by an NCT7511Y at I2C 0x2E in
+# Smart-Fan-IV mode, on the SMBus branch the CPLD hands to the BMC while
+# the BMC module is fitted.  There is no PWM/duty register in any CPLD
+# map and no OEM command to set a duty cycle -- the SERA OEM SET list is
+# exactly {0x10, 0x11, 0x12, 0xA0, 0xD0-0xD5, 0xF0, 0x7D, 0x81, 0x03,
+# 0x66} and none of them touch fan speed.  So set_speed() reports failure
+# rather than pretending to have taken effect, and get_target_speed()
+# returns the measured speed of the BMC's own control loop.  Adding an
+# OEM fan-control command is on the vendor escalation list (#35709).
+#
+########################################################################
+
+try:
+    from sonic_platform_base.fan_base import FanBase
+    from . import ipmi
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+FANS_PER_TRAY = 2
+
+# Board spec, fan PWM table: duty 0-100 %% maps linearly to 0-30000 RPM
+# for the intake rotor and 0-27000 RPM for the exhaust rotor (3000 resp.
+# 2700 RPM per 10 %% step).  These are the 100 %% references behind the
+# percentage that `show platform fan` prints.  The SDR upper-critical
+# thresholds (33000 / 29700) sit 10 %% above them, matching the spec's
+# +-10 %% tolerance.
+MAX_RPM_PER_ROTOR = [30000, 27000]
+
+# The PSU fans are inside the CRPS modules and the spec gives no rating
+# for them; the BMC's own upper-critical threshold for PSU<n>_MCU_Speed
+# is the only published reference, so it is what the percentage uses.
+PSU_FAN_MAX_RPM = 32895
+
+# `show platform fan` marks a fan not-OK when the speed deviates from the
+# target by more than this many percent.
+SPEED_TOLERANCE = 20
+
+
+class Fan(FanBase):
+    """Platform-specific Fan class backed by the BMC SDR repository."""
+
+    def __init__(self, tray_index, fan_index=0, is_psu_fan=False, psu_index=0):
+        FanBase.__init__(self)
+        self.is_psu_fan = is_psu_fan
+        self.psu_index = psu_index
+        self.tray_index = tray_index
+        self.fan_index = fan_index
+
+        if is_psu_fan:
+            self.sdr_name = 'PSU%d_MCU_Speed' % (psu_index + 1)
+            self.name = 'PSU%d Fan' % (psu_index + 1)
+            self.max_rpm = PSU_FAN_MAX_RPM
+        else:
+            self.sdr_name = 'FAN_%d_%d' % (tray_index + 1, fan_index + 1)
+            self.name = 'Fantray%d Fan%d' % (tray_index + 1, fan_index + 1)
+            self.max_rpm = MAX_RPM_PER_ROTOR[fan_index % len(MAX_RPM_PER_ROTOR)]
+
+    def _tray_flag(self, getter):
+        """Value of a per-tray OEM bitmap for this fan's tray, or None."""
+        if self.is_psu_fan:
+            return None
+        values = getter()
+        if values is None or self.tray_index >= len(values):
+            return None
+        return values[self.tray_index]
+
+    # -- DeviceBase -----------------------------------------------------
+
+    def get_name(self):
+        return self.name
+
+    def get_presence(self):
+        if self.is_psu_fan:
+            status = ipmi.get_psu_status()
+            if status is None:
+                return False
+            return status[self.psu_index][0]
+
+        present = self._tray_flag(ipmi.get_fan_presence)
+        if present is not None:
+            return present
+        # Fall back to the SDR: an absent tray stops reporting a tacho.
+        return ipmi.sensor_present(self.sdr_name)
+
+    def get_model(self):
+        return 'N/A'
+
+    def get_serial(self):
+        # The board has no per-tray EEPROM at all: the spec provides a
+        # single AT24C256 for the whole fan extension board, and that one
+        # sits on the I2C branch the CPLD hands to the BMC.  `ipmitool
+        # fru` also reports "Device not present".
+        return 'N/A'
+
+    def get_status(self):
+        """True when the fan is spinning and the BMC reports it healthy."""
+        if not self.get_presence():
+            return False
+        healthy = self._tray_flag(ipmi.get_fan_status)
+        if healthy is False:
+            # The CPLD's own fail/good verdict for the tray.
+            return False
+        if not ipmi.sensor_ok(self.sdr_name):
+            return False
+        speed = self.get_speed_rpm()
+        return speed is not None and speed > 0
+
+    def get_position_in_parent(self):
+        if self.is_psu_fan:
+            return self.psu_index + 1
+        return self.fan_index + 1
+
+    def is_replaceable(self):
+        return not self.is_psu_fan
+
+    # -- FanBase --------------------------------------------------------
+
+    def get_direction(self):
+        """Airflow direction of the tray this fan belongs to.
+
+        The CPLD detects the module variant from the tray keying and
+        reports the two types in separate registers: front-to-back (AFO,
+        blue handle) and back-to-front (AFI, red handle).  SONiC calls
+        front-to-back EXHAUST and back-to-front INTAKE.
+        """
+        direction = self._tray_flag(ipmi.get_fan_directions)
+        if direction == 'f2b':
+            return self.FAN_DIRECTION_EXHAUST
+        if direction == 'b2f':
+            return self.FAN_DIRECTION_INTAKE
+        return self.FAN_DIRECTION_NOT_APPLICABLE
+
+    def get_speed_rpm(self):
+        """Measured rotor speed in RPM, or None when unreadable."""
+        value = ipmi.sensor_value(self.sdr_name)
+        if value is None:
+            return None
+        return int(value)
+
+    def get_speed(self):
+        """Rotor speed as a percentage of its maximum."""
+        rpm = self.get_speed_rpm()
+        if rpm is None:
+            return None
+        return min(int(round(rpm * 100.0 / self.max_rpm)), 100)
+
+    def get_target_speed(self):
+        """The BMC owns the fan control loop and publishes no setpoint.
+
+        Returning the measured speed keeps thermalctld's
+        |target - actual| comparison inside the tolerance instead of
+        flagging every fan as failed against a fabricated target.
+        """
+        return self.get_speed()
+
+    def get_speed_tolerance(self):
+        return SPEED_TOLERANCE
+
+    def set_speed(self, speed):
+        """Not supported: no OEM fan-control command in this firmware."""
+        return False
+
+    def set_status_led(self, color):
+        """Not supported: fan LEDs are driven by the BMC."""
+        return False
+
+    def get_status_led(self):
+        if not self.get_presence():
+            return self.STATUS_LED_COLOR_OFF
+        return self.STATUS_LED_COLOR_GREEN if self.get_status() \
+            else self.STATUS_LED_COLOR_RED
