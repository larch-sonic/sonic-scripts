+++ b/platform/marvell-teralynx/sonic-platform-modules-larch/sera-dcs-t3200k/sonic_platform/psu.py
@@ -0,0 +1,164 @@
+#!/usr/bin/env python
+
+########################################################################
+#
+# PSU implementation for the Sera DCS-T3200K (Teralynx TL7).
+#
+# Two hot-swap CRPS slots, 1+1 redundant.  Presence and power-good come
+# from the SERA OEM command `raw 0x30 0x35 0x00`; voltage, current,
+# power, temperature and fan speed come from the BMC SDR entries
+# PSU<n>_MCU_*.
+#
+# What is NOT available, and why:
+#
+#  * Model, serial, revision and rated power.  The OEM document
+#    specifies a PSU PMBus group at `raw 0x30 0x77 <psu> <0x59|0x51>
+#    <command>` covering MFR_MODEL, MFR_SERIAL, MFR_REVISION,
+#    MFR_POUT_MAX, READ_VIN, READ_IIN and more -- but this firmware
+#    (rev 2.15) answers 0xC1 Invalid Command to every one of them, on
+#    both PSUs and both the MCU (0x59) and FRU (0x51) targets.  Verified
+#    command by command on the board.  `ipmitool fru` likewise reports
+#    "Device not present".  So there is no path to the PSU inventory
+#    data, and these accessors return N/A instead of guessing.
+#
+#  * AC input voltage and current, for the same reason (READ_VIN 0x88 /
+#    READ_IIN 0x89 live in that same unimplemented group).
+#
+#  * Rated maximum power.  MFR_POUT_MAX is unreachable and the hardware
+#    spec contradicts itself (1300 W in the feature summary, 1600 W in
+#    the slot table, and the OEM document's own capture shows an 800 W
+#    CRPS), so no number here would be trustworthy.
+#
+# The parallel PSU<n>_FRU_* SDR entries are the PSU's FRU-side telemetry.
+# On this board they never produce a reading (0 V / 0 W / -128 C), so
+# they are deliberately unused: publishing them would put zeroes into
+# STATE_DB that look exactly like a dead PSU.
+#
+# All of the above is on the vendor escalation list for #35709.
+#
+########################################################################
+
+try:
+    from sonic_platform_base.psu_base import PsuBase
+    from sonic_platform.fan import Fan
+    from sonic_platform.thermal import Thermal
+    from . import ipmi
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+# The only PSU limits the BMC publishes, from the PSU1_MCU_* SDRs.
+PSU_VOLTAGE_HIGH = 13.011
+PSU_TEMPERATURE_HIGH = 125.0
+# The BMC publishes no lower-critical limit for the 12V rail, but the
+# system-health checker requires a numeric pair (psud publishes None as
+# "N/A" and healthd rejects the record as invalid).  Mirror the margin
+# of the published upper limit around the 12V nominal.
+PSU_VOLTAGE_LOW = round(12.0 - (PSU_VOLTAGE_HIGH - 12.0), 3)  # 10.989
+
+
+class Psu(PsuBase):
+    """Platform-specific PSU class backed by the BMC"""
+
+    def __init__(self, index):
+        PsuBase.__init__(self)
+        self.index = index
+        self.name = 'PSU{}'.format(index + 1)
+
+        self._fan_list.append(Fan(0, 0, is_psu_fan=True, psu_index=index))
+        self._thermal_list.append(Thermal(0, is_psu_thermal=True, psu_index=index))
+
+    def _sdr(self, suffix):
+        return ipmi.sensor_value('PSU%d_MCU_%s' % (self.index + 1, suffix))
+
+    def _oem_status(self):
+        status = ipmi.get_psu_status()
+        if status is None or self.index >= len(status):
+            return None
+        return status[self.index]
+
+    # -- DeviceBase -----------------------------------------------------
+
+    def get_name(self):
+        return self.name
+
+    def get_presence(self):
+        status = self._oem_status()
+        if status is not None:
+            return status[0]
+        # Fall back to the SDR: an empty slot publishes no MCU sensors.
+        return ipmi.sensor_present('PSU%d_MCU_Voltage' % (self.index + 1))
+
+    def get_model(self):
+        # Needs the PSU PMBus group, which this BMC firmware does not
+        # implement -- see the module docstring.
+        return 'N/A'
+
+    def get_serial(self):
+        return 'N/A'
+
+    def get_revision(self):
+        return 'N/A'
+
+    def get_status(self):
+        return self.get_powergood_status()
+
+    def get_position_in_parent(self):
+        return self.index + 1
+
+    def is_replaceable(self):
+        return True
+
+    # -- PsuBase --------------------------------------------------------
+
+    def get_powergood_status(self):
+        status = self._oem_status()
+        if status is not None:
+            return status[1]
+        voltage = self.get_voltage()
+        return voltage is not None and voltage > 0
+
+    def get_voltage(self):
+        return self._sdr('Voltage')
+
+    def get_current(self):
+        return self._sdr('Current')
+
+    def get_power(self):
+        return self._sdr('Power')
+
+    def get_temperature(self):
+        value = self._sdr('Temp')
+        if value is not None and value <= -100.0:
+            return None
+        return value
+
+    def get_temperature_high_threshold(self):
+        return PSU_TEMPERATURE_HIGH
+
+    def get_voltage_high_threshold(self):
+        return PSU_VOLTAGE_HIGH
+
+    def get_voltage_low_threshold(self):
+        return PSU_VOLTAGE_LOW
+
+    def get_maximum_supplied_power(self):
+        # MFR_POUT_MAX is unreachable and the spec's own rating is
+        # inconsistent -- see the module docstring.
+        return None
+
+    def get_input_voltage(self):
+        # READ_VIN lives in the unimplemented OEM PMBus group.
+        return None
+
+    def get_input_current(self):
+        return None
+
+    def get_status_led(self):
+        if not self.get_presence():
+            return self.STATUS_LED_COLOR_OFF
+        return self.STATUS_LED_COLOR_GREEN if self.get_powergood_status() \
+            else self.STATUS_LED_COLOR_RED
+
+    def set_status_led(self, color):
+        """Not supported: the PSU LED is driven by the BMC."""
+        return False
