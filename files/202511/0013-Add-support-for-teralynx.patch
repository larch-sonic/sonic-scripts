@@ -0,0 +1,66 @@
+#!/usr/bin/env python
+
+########################################################################
+#
+# Watchdog implementation for sera-dcs-t3200k platform.
+#
+# The board exposes no /dev/watchdog device.  A CPLD watchdog does
+# exist -- slave 0x30 register 0x12 bit 0 enables it, and reading that
+# register kicks the timer -- but the hardware specification documents
+# no timeout value and no register to set one, so it cannot be driven
+# through the SONiC watchdog API in any meaningful way.  Its expiry flag
+# is still useful and is read for the reboot cause (see chassis.py).
+#
+# This implementation is therefore a no-op that satisfies the SONiC
+# WatchdogBase API without printing errors or raising exceptions during
+# reboot/reset-factory operations.  Making the CPLD watchdog usable
+# needs a documented timeout register from the vendor (#35709).
+#
+########################################################################
+
+try:
+    from sonic_platform_base.watchdog_base import WatchdogBase
+except ImportError as e:
+    raise ImportError(str(e) + "- required module not found")
+
+
+class Watchdog(WatchdogBase):
+    """
+    No-op watchdog for sera-dcs-t3200k. Hardware watchdog is not
+    available on this platform; all operations return safe defaults.
+    """
+
+    def __init__(self):
+        pass
+
+    def arm(self, seconds):
+        """
+        Arm the hardware watchdog with a timeout of <seconds> seconds.
+        Returns:
+            -1 (watchdog not available on this platform)
+        """
+        return -1
+
+    def disarm(self):
+        """
+        Disarm the hardware watchdog.
+        Returns:
+            False (watchdog not available on this platform)
+        """
+        return False
+
+    def is_armed(self):
+        """
+        Retrieves the armed state of the hardware watchdog.
+        Returns:
+            False (watchdog not available on this platform)
+        """
+        return False
+
+    def get_remaining_time(self):
+        """
+        Retrieve the number of seconds remaining on the watchdog timer.
+        Returns:
+            -1 (watchdog not available on this platform)
+        """
+        return -1
